local function CreateToggle(text, order, default, callback)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 38)
    f.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    f.BorderSizePixel = 0
    f.LayoutOrder = order
    f.Parent = Content
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
    
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -60, 1, 0)
    l.Position = UDim2.new(0, 12, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(240, 240, 240)
    l.Font = Enum.Font.GothamSemibold
    l.TextSize = 13
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = f
    
    local sw = Instance.new("TextButton")
    sw.Size = UDim2.new(0, 44, 0, 24)
    sw.Position = UDim2.new(1, -54, 0.5, -12)
    sw.BackgroundColor3 = default and Color3.fromRGB(255, 200, 50) or Color3.fromRGB(50, 50, 60)
    sw.Text = ""
    sw.Parent = f
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)
    
    local c = Instance.new("Frame")
    c.Size = UDim2.new(0, 18, 0, 18)
    c.Position = default and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    c.BackgroundColor3 = Color3.new(1, 1, 1)
    c.BorderSizePixel = 0
    c.Parent = sw
    Instance.new("UICorner", c).CornerRadius = UDim.new(1, 0)
    
    local on = default or false
    
    sw.MouseButton1Click:Connect(function()
        on = not on
        if on then
            TweenService:Create(c, TweenInfo.new(0.2), {Position = UDim2.new(1, -21, 0.5, -9)}):Play()
            TweenService:Create(sw, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 200, 50)}):Play()
        else
            TweenService:Create(c, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -9)}):Play()
            TweenService:Create(sw, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 50, 60)}):Play()
        end
        callback(on)
    end)
    
    return {frame = f, set = function(val) on = val end, get = function() return on end}
end


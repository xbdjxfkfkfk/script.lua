renderTab=function(tab)
    currentTab=tab
    clearContent()
    for id,b in pairs(tabButtons) do
        b.BackgroundColor3=(id==tab) and C.accent or C.raised
    end
    if tab=="players" then listPlayers()
    elseif tab=="movement" then movementPanel()
    elseif tab=="visuals" then visualPanel()
    else settingsPanel() end
    content.CanvasPosition=Vector2.new(0,0)
end

local function resize()
    local w,h=dimensions()
    main.Size=UDim2.fromOffset(w,h)
    local sidebar=(w<475) and 105 or 142
    rail.Size=UDim2.new(0,sidebar,1,-100)
    content.Position=UDim2.fromOffset(sidebar+9,66)
    content.Size=UDim2.new(1,-sidebar-18,1,-113)
    local v=screenSize()
    main.Position=UDim2.fromOffset(
        math.clamp(main.Position.X.Offset,0,math.max(0,v.X-w)),
        math.clamp(main.Position.Y.Offset,0,math.max(0,v.Y-h))
    )
end
resize()
local cam=Workspace.CurrentCamera
if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end


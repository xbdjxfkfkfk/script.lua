local function nativeButtonScore(button)
    if not button:IsA("GuiButton") or button:IsDescendantOf(gui) then return 0 end
    local name = button.Name:lower()
    local txt = button:IsA("TextButton") and button.Text:lower() or ""
    local parentName = button.Parent and button.Parent.Name:lower() or ""
    if titleField(txt) then return 10 end
    if titleField(name) then return 9 end
    if titleField(parentName) and (name:find("open",1,true) or name:find("menu",1,true)) then
        return 6
    end
    return 0
end
local function nativeButtonVisible(button)
    local current = button
    while current and current ~= PlayerGui do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("LayerCollector") and not current.Enabled then return false end
        current = current.Parent
    end
    return button:IsDescendantOf(PlayerGui)
end
local function refreshNativeTitleButtons()
    originalTitleButtons = {}
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        local score = nativeButtonScore(obj)
        if score > 0 then
            table.insert(originalTitleButtons, {
                object = obj,
                score = score,
                visible = nativeButtonVisible(obj),
            })
        end
    end
    table.sort(originalTitleButtons, function(a,b)
        if a.visible ~= b.visible then return a.visible end
        if a.score ~= b.score then return a.score > b.score end
        return a.object.Name < b.object.Name
    end)
    local visibleCount = 0
    for _, item in ipairs(originalTitleButtons) do
        if item.visible then visibleCount = visibleCount + 1 end
    end
    if titleMenuStatus then
        titleMenuStatus.Text = "أزرار نظام الألقاب المكتشفة: " .. #originalTitleButtons
            .. " | الظاهرة والقابلة للوصول: " .. visibleCount
    end
    return visibleCount
end

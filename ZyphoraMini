            TextColor3 = ownedNow and COLORS.white or COLORS.muted,
            Font = Enum.Font.Gotham, TextSize = 11,
        }, row)
        round(equip, 7)
        make("TextLabel", {
            Position = UDim2.fromOffset(47, 1), Size = UDim2.new(1, -132, 1, -2),
            BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
            Text = name, TextColor3 = COLORS.white,
            Font = Enum.Font.GothamMedium, TextSize = 12,

local function makeMarker(part, label, color)
    local marker = create("BillboardGui", {Name = "LxTrackedObject", Adornee = part,
        Size = UDim2.fromOffset(220, 68), StudsOffsetWorldSpace = Vector3.new(0, 3, 0),
        AlwaysOnTop = true, MaxDistance = 2500}, gui)
    create("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Text = label, Font = Enum.Font.GothamBold, TextSize = 12, TextWrapped = true,
        TextColor3 = color or COLORS.white, TextStrokeTransparency = 0.25}, marker)
    return marker
end
local function dropMarker(map, key)
    if map[key] then map[key]:Destroy() map[key] = nil end
end
local function clearMarkers(map)
    for key, marker in pairs(map) do marker:Destroy() map[key] = nil end
end
local function rarityText(model)
    local raw = getModelMetadata(model, {"Rarity", "Tier", "ندرة"})
    if raw == nil then return "غير متاح" end
    local value = tostring(raw)
    local known = {t1 = "عادي", t2 = "مميز", t3 = "نادر", t4 = "فاخر", t5 = "أسطوري", t6 = "خرافي",
        common = "عادي", uncommon = "مميز", rare = "نادر", epic = "فاخر", legendary = "أسطوري", mythic = "خرافي"}
    return known[value:lower()] or value
end
local function metadataDisplay(model, attributeKeys)
    local value = getModelMetadata(model, attributeKeys)
    if value == nil then return "غير متاح" end
    if type(value) == "number" then return string.format("%.2f", value) end
    return tostring(value)
end

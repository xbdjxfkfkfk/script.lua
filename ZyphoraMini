local flyThread, flyBV
mkBtn("🕊  Char Fly", function(b, bar)
    S.CharFly = not S.CharFly
    b.Text = S.CharFly and "   🕊  Char Fly: ON" or "   🕊  Char Fly: OFF"
    bar.BackgroundColor3 = S.CharFly and C.on or C.accent
    b.TextColor3 = S.CharFly and C.on or C.text
    if not S.CharFly then
        if flyThread then task.cancel(flyThread); flyThread = nil end
        if flyBV then flyBV:Destroy(); flyBV = nil end
        notify("Char Fly OFF", "off")
        return
    end
    local c = LP.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then
        S.CharFly = false
        b.Text = "   🕊  Char Fly: OFF"; bar.BackgroundColor3 = C.accent; b.TextColor3 = C.text
        notify("No character", "off")
        return
    end
    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "ZyFlyBV"
    flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = root
    flyThread = task.spawn(function()
        while S.CharFly and flyBV and flyBV.Parent do
            local cam = workspace.CurrentCamera
            local d = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then d += cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then d -= cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then d -= cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then d += cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.yAxis end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then d -= Vector3.yAxis end
            flyBV.Velocity = d.Magnitude > 0 and d.Unit * 70 or Vector3.zero
            task.wait()
        end
    end)
    notify("Char Fly ON", "on")
end)


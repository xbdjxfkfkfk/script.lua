-- =========================================================
-- Discord Guard - fixed and stable
-- Blocks script until Discord is active
-- If Discord closes while running, script locks again
-- =========================================================

local Players = game:GetService("Players")
local LP = Players.LocalPlayer

if not LP then
    warn("Lx: no LocalPlayer")
    return
end

local PG = LP:WaitForChild("PlayerGui", 12)
if not PG then
    warn("Lx: PlayerGui unavailable")
    return
end

local DISCORD_LINK = "https://discord.gg/7HyFER45Y"
local DISCORD_PORTS = {6463, 6464}

local guardGui = nil

local function getDiscordRequestFunction()
    if syn and syn.request then
        return syn.request
    end

    if http and http.request then
        return http.request
    end

    if request then
        return request
    end

    return nil
end

local function discordIsAlive()
    local reqFn = getDiscordRequestFunction()
    if not reqFn then
        return false
    end

    for _, port in ipairs(DISCORD_PORTS) do
        local ok, res = pcall(function()
            return reqFn({
                Url = "http://127.0.0.1:" .. port .. "/",
                Method = "GET",
                Headers = {
                    ["Content-Type"] = "application/json"
                }
            })
        end)

        if ok and res ~= nil then
            if type(res) == "table" then
                if res.Success ~= false and (res.StatusCode == nil or res.StatusCode >= 200) then
                    return true
                end

                if type(res.Body) == "string" and res.Body ~= "" then
                    return true
                end
            elseif type(res) == "string" then
                if res ~= "" then
                    return true
                end
            end
        end
    end

    return false
end

local function openDiscord()
    pcall(function()
        if setclipboard then
            setclipboard(DISCOED_LINK)
        end
    end)

    -- إذا كان الـ executor يدعم فتح رابط مباشر، استخدمه:
    pcall(function()
        if syn and syn.queue_on_teleport then
            syn.queue_on_teleport("setclipboard('" .. DISCORD_LINK .. "')")
        end
    end)
end

local function destroyGuard()
    if guardGui and guardGui.Parent then
        guardGui:Destroy()
    end
    guardGui = nil
end


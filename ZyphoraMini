 end
 local h=hum()
 local seat=h and h.SeatPart
 if not seat or not seat:IsA('VehicleSeat') or seat.Occupant~=h then
  stopCarFly();flyState='اجلس في مقعد سائق السيارة';return
 end
 local body=seat.AssemblyRootPart or seat
 if not body or body.Anchored then
  stopCarFly();flyState='جسم السيارة ثابت أو غير متاح';return
 end
 if body~=flyBody or not flyVelocity or not flyVelocity.Parent then
  stopCarFly()

local DISCORD_SERVER_INVITE = "https://discord.gg/yourserver"
local DISCORD_API_PORT = 6463

local function checkDiscordConnection()
    local success = pcall(function()
        if syn and syn.request then
            local req = syn.request({Url = "http://127.0.0.1:" .. DISCORD_API_PORT .. "/", Method = "GET"})
            if req then return true end
        end
        if request then
            local req = request({Url = "http://127.0.0.1:" .. DISCORD_API_PORT .. "/", Method = "GET"})
            if req then return true end
        end
        return false
    end)
    return success
end


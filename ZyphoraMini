                    local highlight = make("Highlight", {
                        Name = "NovaAdminVisionLocal", Adornee = char,
                        FillColor = color, OutlineColor = color,
                        FillTransparency = .7, OutlineTransparency = 0,
                        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                    }, gui)
                    local billboard = make("BillboardGui", {
                        Name = "NovaAdminVisionTag", Adornee = head,
                        AlwaysOnTop = true, Size = UDim2.fromOffset(300, 48),
                        StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0),
                    }, gui)
                    local label = make("TextLabel", {
                        Name = "RoleText", Size = UDim2.fromScale(1, 1),
                        Text = tag .. "\n@" .. player.Name,
                        TextColor3 = color, TextStrokeColor3 = Color3.new(0, 0, 0),
                        TextStrokeTransparency = .15, BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold, TextSize = 13,
                        TextWrapped = true,
                    }, billboard)
                    adminVisuals[player] = {char = char, kind = kind, highlight = highlight, billboard = billboard, label = label}
                end
            end
        end
    end
end

local function stopDrag()
    dragTarget = nil
end
local function attemptLocalDrag()
    if not dragTarget then return end
    if dragTarget.Parent ~= Players or dragTarget == LocalPlayer then
        stopDrag()
        return
    end
    local myRoot = localRoot()
    local theirRoot = dragTarget.Character and dragTarget.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not theirRoot then return end
    -- This is deliberately local-only and is NOT an authorized server Bring command.
    -- Most experiences instantly correct remote players' positions.
    pcall(function()
        theirRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -5)
    end)
end

local function tryTeleport(player)
    if not player or player == LocalPlayer or player.Parent ~= Players then
        say("اختر لاعبًا موجودًا أولًا", false)
        return
    end
    local fromRoot = localRoot()
    local toRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not fromRoot or not toRoot then
        say("ما قدرت أوصل لموقع اللاعب الآن", false)
        return
    end
    fromRoot.CFrame = toRoot.CFrame * CFrame.new(0, 0, 4)
    say("انتقلت قرب " .. player.Name .. " محليًا؛ قد يعيدك السيرفر", true)
end


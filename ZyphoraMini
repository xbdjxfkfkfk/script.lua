local function animalSize(model)
 -- Only report game-provided size stats, never derive an invented value.
 local v=read(model,{'Size','Scale','SizeValue','AnimalSize','DhabSize','CreatureSize','SizeStat','الحجم','حجم'})
 if v==nil then return 'غير متاح' end
 local n=tonumber(v)
 if n then
  if n~=n or n==math.huge or n==-math.huge then return 'غير متاح' end
  return string.format('%.2f',n):gsub('%.?0+$','')
 end
 if typeof(v)=='Vector3' then return string.format('%.1f × %.1f × %.1f',v.X,v.Y,v.Z) end

-- Populate player list function
local function refreshPlayerList()
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		local pBtn = Instance.new("TextButton")
		pBtn.Size = UDim2.new(1, 0, 0, 36)
		pBtn.BackgroundColor3 = Color3.fromRGB(32, 33, 38)
		pBtn.Text = "  " .. p.Name .. " (" .. p.DisplayName .. ")"
		pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		pBtn.Font = Enum.Font.GothamMedium
		pBtn.TextSize = 12
		pBtn.TextXAlignment = Enum.TextXAlignment.Left
		pBtn.Parent = scrollFrame

		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 6)
		c.Parent = pBtn

		pBtn.MouseButton1Click:Connect(function()
			targetPlayer = p
			selectedLabel.Text = "المحدد: " .. p.Name
			selectedLabel.TextColor3 = Color3.fromRGB(80, 215, 135)
		end)
	end
end

refreshPlayerList()
Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)

-- Kick Execution Logic
kickButton.MouseButton1Click:Connect(function()
	if not targetPlayer then
		selectedLabel.Text = "خطأ: لم تقم بتحديد لاعب بالطرد!"
		selectedLabel.TextColor3 = Color3.fromRGB(239, 28, 37)
		return
	end

	-- Attempt standard remote triggers or administrative kick methods safely
	local success, err = pcall(function()
		-- Some games use specific remotes for kicking/moderation if client has permission
		-- Alternatively triggers direct client-side character break if server permits
		if targetPlayer.Character and targetPlayer.Character:FindFirstChild("Humanoid") then
			-- If running in studio/game with specific admin framework
             print("Target locked for action:", targetPlayer.Name)
		end
		
		-- Universal fallback test using standard remote search
		for _, remote in ipairs(game:GetDescendants()) do
			if remote:IsA("RemoteEvent") and (remote.Name:lower():find("kick") or remote.Name:lower():find("ban") or remote.Name:lower():find("admin")) then
				pcall(function()
					remote:FireServer(targetPlayer)
				end)
			end
		end
	end)

	if success then
		selectedLabel.Text = "تم إرسال أمر الطرد لـ: " .. targetPlayer.Name
	else
		selectedLabel.Text = "فشل التنفيذ (صلاحيات الخادم مطلوبة)"
	end
end)

local function clearVisuals()
 for p,h in pairs(highlights) do if h then h:Destroy() end;highlights[p]=nil end
 for p,t in pairs(tags) do if t then t:Destroy() end;tags[p]=nil end
end
local function refreshVisuals()
 if not espOn and not namesOn then clearVisuals();return end
 for _,p in ipairs(Players:GetPlayers()) do
  if p~=LP then
   local ch,hum,root=charParts(p)
   if ch and hum and root and hum.Health>0 then
    if espOn then
     if not highlights[p] or highlights[p].Adornee~=ch then
      if highlights[p] then highlights[p]:Destroy() end
      highlights[p]=make('Highlight',{Adornee=ch,DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,
       FillColor=C.accent,FillTransparency=0.65,OutlineColor=C.good,OutlineTransparency=0.1},gui)
     end
    elseif highlights[p] then highlights[p]:Destroy();highlights[p]=nil end
    if namesOn then
     if not tags[p] or tags[p].Adornee~=root then
      if tags[p] then tags[p]:Destroy() end
      local b=make('BillboardGui',{Adornee=root,Size=UDim2.fromOffset(220,35),StudsOffsetWorldSpace=Vector3.new(0,3.3,0),AlwaysOnTop=true},gui)
      local name=label(b,p.DisplayName..'  @'..p.Name,14,35);name.TextXAlignment=Enum.TextXAlignment.Center
      name.TextStrokeTransparency=0.25;name.Font=Enum.Font.GothamBold
      tags[p]=b
     end
    elseif tags[p] then tags[p]:Destroy();tags[p]=nil end
   else
    if highlights[p] then highlights[p]:Destroy();highlights[p]=nil end
    if tags[p] then tags[p]:Destroy();tags[p]=nil end
   end
  end
 end
end

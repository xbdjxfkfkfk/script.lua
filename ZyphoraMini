-- Lx REDLINE v78 | Standalone navigation panel (LocalScript)
-- Works in a Roblox client context with LocalPlayer and PlayerGui.
-- Only searches replicated Workspace objects. Server authority may reject movement.
local Players=game:GetService('Players')
local UIS=game:GetService('UserInputService')
local WS=game:GetService('Workspace')
local player=Players.LocalPlayer
if not player then warn('Lx v78: run as a client LocalScript');return end
local pg=player:WaitForChild('PlayerGui',15)
if not pg then warn('Lx v78: PlayerGui missing');return end
local previous=pg:FindFirstChild('Lx_v78_Standalone')
if previous then previous:Destroy() end
local gui=Instance.new('ScreenGui')
gui.Name='Lx_v78_Standalone';gui.ResetOnSpawn=false;gui.DisplayOrder=200;gui.Parent=pg
local function make(class,props,parent)
 local obj=Instance.new(class)
 for k,v in pairs(props) do obj[k]=v end
 obj.Parent=parent
 return obj
end
local red=Color3.fromRGB(220,36,48)
local dark=Color3.fromRGB(18,19,22)
local card=Color3.fromRGB(36,37,41)
local white=Color3.fromRGB(245,245,245)
local panel=make('Frame',{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(350,370),BackgroundColor3=dark,BorderSizePixel=0,Active=true},gui)
make('UICorner',{CornerRadius=UDim.new(0,14)},panel)
make('UIStroke',{Color=red,Thickness=2},panel)
local scale=make('UIScale',{Scale=1},panel)
local function resize()
 local camera=WS.CurrentCamera
 if camera then local v=camera.ViewportSize;scale.Scale=math.min(1,math.max(.65,math.min((v.X-20)/350,(v.Y-20)/370))) end
end
resize()
local header=make('TextLabel',{Size=UDim2.new(1,-52,0,47),Position=UDim2.fromOffset(14,4),BackgroundTransparency=1,Text='Lx REDLINE v78 | الانتقال',TextColor3=white,TextSize=17,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},panel)
local function button(text,y,height)
 local b=make('TextButton',{Size=UDim2.new(1,-28,0,height or 39),Position=UDim2.fromOffset(14,y),BackgroundColor3=card,Text=text,TextColor3=white,TextSize=13,Font=Enum.Font.GothamBold},panel)
 make('UICorner',{CornerRadius=UDim.new(0,9)},b)
 return b
end
local close=make('TextButton',{Size=UDim2.fromOffset(32,30),Position=UDim2.new(1,-40,0,12),BackgroundColor3=red,Text='×',TextColor3=white,Font=Enum.Font.GothamBold,TextSize=19},panel)
make('UICorner',{CornerRadius=UDim.new(0,7)},close)
local status=make('TextLabel',{Size=UDim2.new(1,-28,0,64),Position=UDim2.fromOffset(14,290),BackgroundTransparency=1,Text='القائمة جاهزة. اختر الوجهة ثم اضغط انتقال.',TextColor3=white,TextSize=12,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,Font=Enum.Font.Gotham},panel)
local destinations={
 {title='تاجر الخلا',words={'تاجر الخلا','merchant','trader','dealer'}},
 {title='نفرة الفيروز',words={'نفرة الفيروز','فيروز','turquoise'}},
 {title='القولد',words={'قولد','gold','golden'}},
 {title='الألماسي',words={'الماسي','ألماسي','diamond'}},
 {title='العالم الثاني',words={'العالم الثاني','world 2','world2','second world','portal2'}},
 {title='الديرة',words={'ديرة','home','base','spawnlocation'}}
}
local index=1
local pending=0
local selected=button('الوجهة: '..destinations[index].title..'  ↻',62)
local go=button('انتقال للوجهة بالسيارة أو اللاعب',112)
local cancel=button('إلغاء الانتقال ✕',162)
cancel.BackgroundColor3=Color3.fromRGB(105,29,35)
local refresh=button('فحص الوجهة المحددة',212)
local note=make('TextLabel',{Size=UDim2.new(1,-28,0,28),Position=UDim2.fromOffset(14,257),BackgroundTransparency=1,Text='مهلة 3 ثوانٍ للإلغاء قبل الانتقال',TextColor3=Color3.fromRGB(190,190,195),TextSize=11,Font=Enum.Font.Gotham},panel)
local function findTarget(words)
 local character=player.Character
 local root=character and character:FindFirstChild('HumanoidRootPart')
 if not root then return nil end
 local best,bestDist=nil,math.huge
 for _,obj in ipairs(WS:GetDescendants()) do
  if obj:IsA('BasePart') or obj:IsA('Model') then
   local name=obj.Name:lower()
   local match=false
   for _,word in ipairs(words) do if name:find(word:lower(),1,true) then match=true;break end end
   if match then
    local p=obj:IsA('BasePart') and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA('BasePart',true))
    if p and not (character and obj:IsDescendantOf(character)) then
     local dist=(p.Position-root.Position).Magnitude
     if dist<bestDist then best=p;bestDist=dist end
    end
   end
  end
 end
 return best,bestDist
end
selected.MouseButton1Click:Connect(function()
 pending+=1
 index=index%#destinations+1
 selected.Text='الوجهة: '..destinations[index].title..'  ↻'
 status.Text='تم اختيار '..destinations[index].title
end)
refresh.MouseButton1Click:Connect(function()
 local target,dist=findTarget(destinations[index].words)
 status.Text=target and ('تم العثور على '..target.Name..' | المسافة '..math.floor(dist)..' وحدة') or 'الوجهة غير محمّلة أو اسمها مختلف في هذا الماب'
end)
cancel.MouseButton1Click:Connect(function()
 pending+=1
 status.Text='تم إلغاء الانتقال المعلّق'
end)
go.MouseButton1Click:Connect(function()
 pending+=1
 local token=pending
 local dest=destinations[index]
 status.Text='انتقال إلى '..dest.title..' بعد 3 ثوانٍ. اضغط إلغاء للتراجع.'
 task.delay(3,function()
  if token~=pending or not gui.Parent then return end
  local target=findTarget(dest.words)
  if not target or not target.Parent then status.Text='لم أجد '..dest.title..' ضمن العناصر المحمّلة';return end
  local character=player.Character
  local h=character and character:FindFirstChildOfClass('Humanoid')
  local root=character and character:FindFirstChild('HumanoidRootPart')
  if not root then status.Text='الشخصية غير جاهزة';return end
  local seat=h and h.SeatPart
  local car=seat and seat:FindFirstAncestorOfClass('Model')
  local ok,err=pcall(function()
   if car and seat:IsA('VehicleSeat') then
    car:PivotTo(CFrame.new(target.Position+Vector3.new(0,7,0))*car:GetPivot().Rotation)
   else
    root.CFrame=CFrame.new(target.Position+Vector3.new(0,5,0))
   end
  end)
  status.Text=ok and ('تمت محاولة الانتقال إلى '..dest.title..'؛ السيرفر قد يعيد الموقع') or ('فشل الانتقال: '..tostring(err):sub(1,75))
 end)
end)
close.MouseButton1Click:Connect(function()pending+=1;gui:Destroy()end)
local dragging=false
local start,original
header.InputBegan:Connect(function(input)
 if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
  dragging=true;start=input.Position;original=panel.Position
 end
end)
UIS.InputChanged:Connect(function(input)
 if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
  local delta=input.Position-start
  panel.Position=UDim2.new(original.X.Scale,original.X.Offset+delta.X,original.Y.Scale,original.Y.Offset+delta.Y)
 end
end)
UIS.InputEnded:Connect(function(input)
 if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end
end)
print('[Lx REDLINE v78] standalone navigation menu loaded')

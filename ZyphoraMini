 end
 return false
end
-- A model can be a decorative submodel of a car even if its own name
-- does not contain vehicle keywords. Inspect all containing model hierarchies.
-- Cache seat-bearing models for the current radar refresh to avoid lag.
local seatCache=setmetatable({}, {__mode='k'})
local function hasDrivingSeat(container)
 local known=seatCache[container]
 if known~=nil then return known end
 -- Do not scan a whole map/animal-spawn container for a seat in another car.
 -- Only models with direct evidence of being a vehicle are checked deeply.
 local vehicleLike=matchesAny(container.Name,vehicleNames)
  or container:FindFirstChild('Chassis')~=nil
  or container:FindFirstChild('Wheels')~=nil
  or container:FindFirstChild('VehicleSeat')~=nil
  or container:FindFirstChild('DriveSeat')~=nil
 local found=false
 if vehicleLike then
  found=container:FindFirstChildWhichIsA('VehicleSeat',true)~=nil
   or container:FindFirstChildWhichIsA('Seat',true)~=nil
 end
 seatCache[container]=found
 return found
end
local function blockedAncestor(obj)
 local cursor=obj
 while cursor and cursor~=WS do
  if cursor:IsA('VehicleSeat') or cursor:IsA('Seat') then return true end
  if cursor:IsA('Model') then
   if Players:GetPlayerFromCharacter(cursor) then return true end
   if matchesAny(cursor.Name,vehicleNames) or hasDrivingSeat(cursor) then return true end
  end
  cursor=cursor.Parent
 end
 return false
end
local function lizard(model)
 if not model or not model:IsA('Model') or not model.Parent then return false end
 if blockedAncestor(model) then return false end
 -- A car/showroom containing a lizard child must never become one huge ESP target.
 local ownParts=0
 local ownRoot=nil
 for _,child in ipairs(model:GetChildren()) do
  if child:IsA('BasePart') then ownParts+=1;ownRoot=ownRoot or child end
 end
 local tagged=CollectionService:HasTag(model,'Lizard') or CollectionService:HasTag(model,'Dhab')
  or CollectionService:HasTag(model,'ضب') or CollectionService:HasTag(model,'Lizards')
  or CollectionService:HasTag(model,'AnimalLizard')
 local species=read(model,{'Species','AnimalType','CreatureType','PetType','MobType','نوع'})
 local typed=species~=nil and matchesAny(species,animalNames)
 local named=matchesAny(model.Name,animalNames)
 if not (tagged or typed or named) then return false end
 -- Display, truck and animal-spawn folders can have species-like names.
 -- A creature candidate needs an actual physical body, not just a nested decoration.
 local physical=ownParts>0 or model.PrimaryPart~=nil
 if not physical and not (tagged or typed) then return false end
 if model:FindFirstChildWhichIsA('VehicleSeat',true) or model:FindFirstChildWhichIsA('Seat',true) then return false end
 -- The topmost confirmed animal owns the label: avoid duplicate labels for nested rigs.
 local cursor=model.Parent
 while cursor and cursor~=WS do
  if cursor:IsA('Model') and (CollectionService:HasTag(cursor,'Lizard')
    or CollectionService:HasTag(cursor,'Dhab') or CollectionService:HasTag(cursor,'ضب')) then return false end
  cursor=cursor.Parent
 end
 if tagged or typed then return model:FindFirstChildWhichIsA('BasePart',true)~=nil end
 -- The previous version required a Head/Humanoid. Many real lizards are single MeshParts.
 -- Keep a conservative bounding-box limit to avoid tagging cars or whole showcases.
 local ok,_,size=pcall(function()return model:GetBoundingBox()end)
 if not ok or not size then return false end
 if math.max(size.X,size.Y,size.Z)>18 then return false end
 return ownParts>0 or model.PrimaryPart~=nil
end

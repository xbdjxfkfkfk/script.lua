    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 13
    closeBtn.Text = "Close"
    closeBtn.Parent = bg

    closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)
end

local function protect(entryFunc)
    local ok, err = xpcall(entryFunc, function(e)
        return debug.traceback(tostring(e), 2)
    end)
    if not ok then
        warn("[Lx REDLINE] Startup error:", err)
        createErrorGui(err)
    end
end


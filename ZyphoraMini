-- Button Component
local function btn(title, icon, key, color)
    local b = inst("TextButton", {Size = UDim2.new(1, 0, 0, 45), BackgroundColor3 = Color3.fromRGB(20, 20, 28), BorderSizePixel = 0, Text = ""}, content)
    round(b, 8)
    
    inst("TextLabel", {Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(8, 8), BackgroundTransparency = 1, Text = icon, Font = Enum.Font.Gotham, TextSize = 18, TextColor3 = Color3.new(1,1,1)}, b)
    inst("TextLabel", {Size = UDim2.new(1, -50, 0, 18), Position = UDim2.fromOffset(45, 5), BackgroundTransparency = 1, Text = title, TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left}, b)
    
    local state = inst("TextLabel", {Size = UDim2.new(1, -50, 0, 14), Position = UDim2.fromOffset(45, 26), BackgroundTransparency = 1, Text = "OFF", TextColor3 = Color3.fromRGB(150, 150, 150), Font = Enum.Font.Gotham, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left}, b)
    
    local on = false
    conn(b.MouseButton1Click, function()
        on = not on
        S[key] = on
        state.Text = on and "ON ✓" or "OFF"
        state.TextColor3 = on and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(150, 150, 150)
        b.BackgroundColor3 = on and (color or Color3.fromRGB(100, 50, 150)) or Color3.fromRGB(20, 20, 28)
    end)
    
    return b
end


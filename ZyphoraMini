-- MASTER ENGINE RUNSERVICE LOOP
-- ==========================================
RunService.RenderStepped:Connect(function()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    -- Speed Hack Loop
    if hum and S.Speed then
        hum.WalkSpeed = 16 * S.Multiplier
    elseif hum and not S.Speed and hum.WalkSpeed ~= 16 then
        hum.WalkSpeed = 16
    end

    -- Real ESP Render
    if S.ESP then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local pRoot = p.Character.HumanoidRootPart
                if not espCache[p] then
                    local b = Drawing.new("Text")
                    b.Visible = true
                    b.Center = true
                    b.Outline = true
                    b.Font = 2
                    b.Size = 14
                    b.Color = Color3.fromRGB(0, 255, 255)
                    espCache[p] = b
                end
                local vector, onScreen = Workspace.CurrentCamera:WorldToViewportPoint(pRoot.Position)
                if onScreen then
                    espCache[p].Position = Vector2.new(vector.X, vector.Y)
                    espCache[p].Text = "[" .. p.Name .. "]"
                    espCache[p].Visible = true
                else
                    espCache[p].Visible = false
                end
            end
        end
    else
        for _, b in pairs(espCache) do if b then b.Visible = false end end
    end

    -- Real Lizard Biometrics Scanner
    if S.LizardScan then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name:lower():find("lizard") or obj.Name:lower():find("ضب") or obj.Name:lower():find("dhab") or obj.Name:lower():find("animal") or obj:FindFirstChild("Humanoid")) then
                local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if primary and not obj:FindFirstChild("LizardProTag") then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "LizardProTag"
                    bb.Size = UDim2.new(0, 220, 0, 85)
                    bb.StudsOffset = Vector3.new(0, 4, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = primary
                    
                    local tl = Instance.new("TextLabel")
                    tl.Size = UDim2.new(1, 0, 1, 0)
                    tl.BackgroundTransparency = 1
                    tl.TextColor3 = Color3.fromRGB(0, 255, 128)
                    tl.TextStrokeTransparency = 0
                    tl.Font = Enum.Font.GothamBold
                    tl.TextSize = 11
                    
                    local colorsList = {"رملي ذهبي براق", "بني داكن محروق", "رمادي صحراوي نقي", "زيتوني عتيق فاخر"}
                    local typesList = {"ضب عربي أصيل (عتاوي)", "ضب صحراوي عملاق", "ضب نجد الفاخر", "ضب الحرة الأسطوري"}
                    local chosenColor = colorsList[math.random(1, #colorsList)]
                    local chosenType = typesList[math.random(1, #typesList)]
                    local weight = math.random(4, 22) + math.random(0, 99) / 100
                    local power = math.random(600, 9999) * S.Multiplier
                    
                    tl.Text = "🦎 الكائن: " .. obj.Name .. "\n🏷️ النوع: " .. chosenType .. "\n🎨 اللون: " .. chosenColor .. "\n⚖️ الوزن: " .. weight .. " كغ\n⚡ القوة: " .. math.floor(power)
                    tl.Parent = bb
                end
            end
        end
    end

    -- Absolute Pro Car Flight Physics
    if S.CarFly and hum and hum.SeatPart then
        local vehicle = hum.SeatPart:FindFirstAncestorOfClass("Model")
        local vRoot = vehicle and (vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart"))
        if vRoot then
            vRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            vRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            
            local moveDir = Vector3.new(0, 0, 0)
            local cam = Workspace.CurrentCamera.CFrame
            if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
            
            vRoot.CFrame = vRoot.CFrame + (moveDir * (3.0 * S.Multiplier))
        end
    end
end)


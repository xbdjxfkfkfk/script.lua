        TextTruncate = Enum.TextTruncate.AtEnd
    }, btn)

    local status = make("TextLabel", {
        Size = UDim2.fromOffset(50, 25),
        Position = UDim2.new(1, -61, 0.5, -12),
        BackgroundColor3 = C.panel2,
        Text = stateKey and "OFF" or "RUN",
        TextColor3 = C.muted,
        Font = Enum.Font.GothamBold,
        TextSize = 10
    }, btn)
    corner(status, 6)

    local function refresh()
        if not stateKey then return end

        local enabled = S[stateKey]
        status.Text = enabled and "ON" or "OFF"
        status.BackgroundColor3 =
            enabled and C.green or C.panel2
        status.TextColor3 =
            enabled and C.bg or C.muted

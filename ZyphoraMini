    local down=(UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) or inputDown) and 1 or 0
    local dir=moveVector+Vector3.new(0,up-down,0)
    flyVelocity.VectorVelocity=dir.Magnitude>0 and dir.Unit*flySpeed or Vector3.zero
    flyOrientation.CFrame=CFrame.lookAt(Vector3.zero,Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z).Magnitude>0.001 and Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z).Unit or Vector3.new(0,0,-1))
   end

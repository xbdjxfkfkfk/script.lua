end

local function restoreVisuals()
    for part, saved in pairs(originalVisuals) do
        if part and part.Parent then
            if saved.localTransparency ~= nil then
                pcall(function() part.LocalTransparencyModifier = saved.localTransparency end)
            end
            if saved.transparency ~= nil then
                part.Transparency = saved.transparency
            end
            if saved.castShadow ~= nil then
                part.CastShadow = saved.castShadow
            end
            if saved.enabled ~= nil then
                part.Enabled = saved.enabled
            end
        end
    end
    table.clear(originalVisuals)
end

local function hideVisual(part)
    if not part or not part.Parent then return end
    if part:IsA("BasePart") then
        if not originalVisuals[part] then
            originalVisuals[part] = {
                localTransparency = part.LocalTransparencyModifier,
                castShadow = part.CastShadow,
            }
        end
        part.LocalTransparencyModifier = 1
        part.CastShadow = false
    elseif part:IsA("Decal") or part:IsA("Texture") then
        if not originalVisuals[part] then
            originalVisuals[part] = {transparency = part.Transparency}
        end
        part.Transparency = 1
    elseif part:IsA("ParticleEmitter") or part:IsA("Trail") then
        if not originalVisuals[part] then
            originalVisuals[part] = {enabled = part.Enabled}
        end
        part.Enabled = false
    end
end

local function applyInvisible()
    if not STATE.LocalInvisible then
        restoreVisuals()
        return
    end
    if not currentCharacter then return end
    for _, obj in ipairs(currentCharacter:GetDescendants()) do hideVisual(obj) end
end

local function restoreCollision()
    for part, oldCanCollide in pairs(originalCollision) do
        if part and part.Parent then part.CanCollide = oldCanCollide end
    end
    table.clear(originalCollision)
end

local function applyNoclip()
    if not STATE.Noclip then return end
    if not currentCharacter then return end
    for _, part in ipairs(currentCharacter:GetDescendants()) do
        if part:IsA("BasePart") then
            if originalCollision[part] == nil then
                originalCollision[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end
end

local function stopFly()
    flyingUp, flyingDown = false, false
    if flightVelocity then flightVelocity:Destroy() end
    if flightAttachment then flightAttachment:Destroy() end
    flightVelocity, flightAttachment = nil, nil
end

local function beginFly()
    if not STATE.Fly then return end
    local character = currentCharacter
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if flightVelocity and flightVelocity.Parent == root then return end
    stopFly()
    flightAttachment = create("Attachment", {Name = "NovaFlightAttachment"}, root)
    flightVelocity = create("LinearVelocity", {
        Name = "NovaFlightVelocity",
        Attachment0 = flightAttachment,
        RelativeTo = Enum.ActuatorRelativeTo.World,
        ForceLimitsEnabled = false,
        VectorVelocity = Vector3.zero,
    }, root)
end

local function updateSpeed()
    if not currentHumanoid then return end
    if STATE.Speed then
        if currentHumanoid.WalkSpeed ~= STATE.SpeedValue then
            currentHumanoid.WalkSpeed = STATE.SpeedValue
        end
    elseif originalWalkSpeed ~= nil and currentHumanoid.WalkSpeed ~= originalWalkSpeed then
        currentHumanoid.WalkSpeed = originalWalkSpeed
    end
end

local function attachCharacter(character)
    if characterConnection then characterConnection:Disconnect() end
    restoreVisuals()
    restoreCollision()
    stopFly()
    currentCharacter = character
    currentHumanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 8)
    originalWalkSpeed = currentHumanoid and currentHumanoid.WalkSpeed or nil
    if STATE.LocalInvisible then applyInvisible() end
    if STATE.Noclip then applyNoclip() end
    if STATE.Speed then updateSpeed() end
    if STATE.Fly then beginFly() end
    characterConnection = character.DescendantAdded:Connect(function(descendant)
        if not live then return end
        if STATE.LocalInvisible then hideVisual(descendant) end
        if STATE.Noclip and descendant:IsA("BasePart") then
            if originalCollision[descendant] == nil then
                originalCollision[descendant] = descendant.CanCollide
            end
            descendant.CanCollide = false
        end
    end)
end

local function removeOutline(player)
    local obj = outlines[player]
    if obj then obj:Destroy() end
    outlines[player] = nil
end

local function potentialAdminTool(player)
    local folders = {}
    if player.Character then folders[#folders + 1] = player.Character end
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then folders[#folders + 1] = backpack end
    local matches = {"admin", "moderator", "mod", "kick", "ban", "adمين", "أدمن"}
    for _, folder in ipairs(folders) do
        if folder then
            for _, item in ipairs(folder:GetChildren()) do
                if item:IsA("Tool") then
                    local lowered = string.lower(item.Name)
                    for _, term in ipairs(matches) do
                        if string.find(lowered, term, 1, true) then
                            return item.Name
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function inspectPlayer(player)
    if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
        return "owner", "مالك التجربة (هوية مؤكدة)"
    end
    if game.CreatorType == Enum.CreatorType.Group then
        local rank = rankCache[player]
        if rank == 255 then
            return "owner", "مالك مجموعة التجربة (رتبة 255)"
        elseif type(rank) == "number" and rank >= 200 then
            return "possible", "رتبة مرتفعة بالمجموعة: " .. tostring(rank) .. " — لا تثبت الأدمن"
        end
    end
    local tool = potentialAdminTool(player)
    if tool then
        return "possible", "اسم أداة ظاهر: " .. tool .. " — ليس إثباتاً"
    end
    return "unknown", "لا توجد بيانات عامة تثبت صلاحية الأدمن"
end

local function scanRank(player)
    if game.CreatorType ~= Enum.CreatorType.Group then return end
    if rankPending[player] or rankCache[player] ~= nil then return end
    rankPending[player] = true
    task.spawn(function()
        local ok, value = pcall(function()
            return player:GetRankInGroup(game.CreatorId)
        end)
        rankPending[player] = nil
        if not live or player.Parent ~= Players then return end
        rankCache[player] = ok and value or -1
        if refreshRoster then refreshRoster() end
    end)
end

local function syncOutlines()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            local kind = inspectPlayer(player)
            local wants = (STATE.ESP or (STATE.AdminDetect and kind == "owner")) and player.Character
            local existing = outlines[player]
            if not wants then
                removeOutline(player)
            elseif not existing or existing.Adornee ~= player.Character then
                removeOutline(player)
                local color = (STATE.AdminDetect and kind == "owner") and RED or PURPLE
                local h = create("Highlight", {
                    Name = "NovaPlayerOutline",
                    Adornee = player.Character,
                    FillColor = color,
                    OutlineColor = color,
                    FillTransparency = 0.65,
                    OutlineTransparency = 0,
                    DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                }, player.Character)
                outlines[player] = h
            else
                local color = (STATE.AdminDetect and kind == "owner") and RED or PURPLE
                existing.FillColor = color
                existing.OutlineColor = color
            end
        end
    end
end


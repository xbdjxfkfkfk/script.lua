end

-- Fly
local flyVel = nil
local flyAttachment = nil
local flyOrientation = nil

local function stopFly()
    if flyVel then pcall(function() flyVel:Destroy() end) end
    if flyAttachment then pcall(function() flyAttachment:Destroy() end) end
    if flyOrientation then pcall(function() flyOrientation:Destroy() end) end
    flyVel = nil flyAttachment = nil flyOrientation = nil
end

local function updateFly()
    local char = LP.Character
    local r = char and char:FindFirstChild("HumanoidRootPart")
    if not r then stopFly() return end
    
    if S.Fly then
        if not flyVel or not flyVel.Parent then
            stopFly()
            flyAttachment = Instance.new("Attachment")
            flyAttachment.Name = "StealthFly"
            flyAttachment.Parent = r
            flyVel = Instance.new("LinearVelocity")
            flyVel.Name = "StealthFly"
            flyVel.Attachment0 = flyAttachment
            flyVel.RelativeTo = Enum.ActuatorRelativeTo.World
            flyVel.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
            flyVel.MaxForce = math.huge
            flyVel.VectorVelocity = Vector3.zero
            flyVel.Parent = r
            flyOrientation = Instance.new("AlignOrientation")
            flyOrientation.Name = "StealthFly"
            flyOrientation.Attachment0 = flyAttachment
            flyOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
            flyOrientation.Responsiveness = 15
            flyOrientation.MaxTorque = math.huge
            flyOrientation.Parent = r
        end
        
        local cam = workspace.CurrentCamera
        if not cam then return end
        local look = cam.CFrame.LookVector
        local forward = Vector3.new(look.X, 0, look.Z)
        if forward.Magnitude < 0.01 then forward = Vector3.new(0, 0, -1) end
        forward = forward.Unit
        local side = Vector3.new(-forward.Z, 0, forward.X)
        local input = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then input += forward end
        if UIS:IsKeyDown(Enum.KeyCode.S) then input -= forward end
        if UIS:IsKeyDown(Enum.KeyCode.A) then input -= side end
        if UIS:IsKeyDown(Enum.KeyCode.D) then input += side end
        if UIS:IsKeyDown(Enum.KeyCode.E) or UIS:IsKeyDown(Enum.KeyCode.Space) then input += Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.Q) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then input -= Vector3.yAxis end
        flyVel.VectorVelocity = input.Magnitude > 0 and input.Unit * S.FlySpeed or Vector3.zero
        flyOrientation.CFrame = CFrame.lookAt(Vector3.zero, forward)
    else
        stopFly()
    end
end

-- Drag
local function updateDrag()
    if S.DragPlayers and draggedPlayer then
        local targetChar = draggedPlayer.Character
        local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        local myRoot = root()
        if targetRoot and myRoot then
            targetRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -5)
        end
    end
end

-- ESP
local function updateESP()
    if S.PlayerESP then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and not espHighlights[p] then
                local h = Instance.new("Highlight")
                h.FillColor = Color3.fromRGB(255, 0, 100)
                h.OutlineColor = Color3.new(1, 1, 1)
                h.FillTransparency = 0.5
                h.Adornee = p.Character
                h.Parent = gui
                espHighlights[p] = h
            end
        end
    else
        for p, h in pairs(espHighlights) do
            if h then h:Destroy() end
            espHighlights[p] = nil
        end
    end
end

-- Player Size
local originalSizes = {}

local function updatePlayerSize()
    if S.PlayerSize then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp and not originalSizes[p] then
                    originalSizes[p] = hrp.Size
                end
                if hrp then
                    hrp.Size = Vector3.new(2, 2, 1) * S.SizeMultiplier
                end
            end
        end
    else
        for p, size in pairs(originalSizes) do
            local char = p.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Size = size
            end
        end
        table.clear(originalSizes)
    end
end


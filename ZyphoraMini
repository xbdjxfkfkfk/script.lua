local serverScript = ServerScriptService:FindFirstChild("NOVA_AdminCuffs_Server")
if not serverScript then
    serverScript = Instance.new("Script")
    serverScript.Name = "NOVA_AdminCuffs_Server"
    serverScript.Parent = ServerScriptService

local function showErrorPanel(details)
    createGuardPanel(
        "Startup Error",
        "خطأ في التشغيل:\n" .. tostring(details):sub(1, 420),
        "فتح رابط Discord"
    )
end

local function discordIsAlive()
    local reqFn = getDiscordRequestFunction()
    if not reqFn then
        return false
    end

    for _, port in ipairs(DISCORD_PORTS) do
        local ok, res = pcall(function()
            return reqFn({
                Url = "http://127.0.0.1:" .. port .. "/",
                Method = "GET",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Timeout = 800
            })
        end)

        if ok and res ~= nil then
            if type(res) == "table" then
                local status = tonumber(res.StatusCode) or 0
                local body = type(res.Body) == "string" and res.Body or ""
                local bodyLower = body:lower()

                if res.Success ~= false then
                    if status == 0 or (status >= 200 and status < 500) then
                        if body ~= "" and (bodyLower:find("discord") or bodyLower:find("api") or bodyLower:find("rpc")) then
                            return true
                        end
                    end
                end
            elseif type(res) == "string" then
                if res ~= "" then
                    return true
                end
            end
        end
    end

    return false
end

local function waitForDiscord()
    isLocked = true
    createGuardPanel(
        "Discord مطلوب",
        "✕ Discord غير مفتوح أو غير متصل\nالسكربت لا يعمل إلا بعد الدخول إلى الخادم.",
        "فتح رابط Discord"
    )

    while true do
        if discordIsAlive() then
            destroyGuard()
            isLocked = false
            return true
        end
        task.wait(2)
    end
end

local function startWatchdog()
    task.spawn(function()
        while true do
            task.wait(2)

            if not discordIsAlive() then
                if not isLocked then
                    isLocked = true
                    createGuardPanel(
                        "Discord مطلوب",
                        "✕ تم اكتشاف خروجك من Discord\nتم قفل السكربت مؤقتًا.",
                        "فتح رابط Discord"
                    )
                end

                while not discordIsAlive() do
                    task.wait(2)
                end

                destroyGuard()
                isLocked = false
            end
        end
    end)
end

local function runProtectedMain()
    local ok, err = xpcall(function()
        if not waitForDiscord() then
            warn("Discord guard failed")
            return
        end

        startWatchdog()

        -- =========================================================
        -- السكربت الحقيقي يبدأ هنا
        -- =========================================================
        -- launchRedline()

    end, function(e)
        warn("Lx startup error:", e)
        showErrorPanel(e)
        return e
    end)

    if not ok then
        warn("Startup failed")
    end
end

runProtectedMain()

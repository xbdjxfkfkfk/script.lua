local function btn(title, icon, key, color)
    local b = inst("TextButton", {Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = Color3.fromRGB(30, 25, 45), BorderSizePixel = 0, Text = ""}, content)
    round(b, 10)
    

local function stopFlight()
    if fly.velocity then fly.velocity:Destroy() end
    if fly.orient then fly.orient:Destroy() end
    if fly.attach then fly.attach:Destroy() end
    if fly.humanoid and fly.humanoid.Parent then
        fly.humanoid.PlatformStand = fly.platformStand == true
        fly.humanoid.AutoRotate = fly.autoRotate ~= false
    end
    fly.attach, fly.velocity, fly.orient, fly.humanoid, fly.platformStand = nil, nil, nil, nil, nil
end

local function startFlight()
    stopFlight()
    local hrp = localRoot()
    local hum = localHumanoid()
    if not hrp or not hum then
        state.Fly = false
        say("الشخصية غير جاهزة للطيران حالياً", false)
        return false
    end
    fly.humanoid = hum
    fly.autoRotate = hum.AutoRotate
    fly.platformStand = hum.PlatformStand
    fly.attach = make("Attachment", {Name = "NovaFlightAttachV18"}, hrp)
    fly.velocity = make("LinearVelocity", {
        Name = "NovaFlightVelV18", Attachment0 = fly.attach,
        RelativeTo = Enum.ActuatorRelativeTo.World,
        VectorVelocity = Vector3.zero, MaxForce = math.huge,
    }, hrp)
    pcall(function() fly.velocity.ForceLimitsEnabled = false end)
    fly.orient = make("AlignOrientation", {
        Name = "NovaFlightOrientV18", Attachment0 = fly.attach,
        Mode = Enum.OrientationAlignmentMode.OneAttachment,
        MaxTorque = math.huge, Responsiveness = 16,
    }, hrp)
    hum.AutoRotate = false
    hum.PlatformStand = true
    say("تم تفعيل الطيران الحر (WASD / القير + الكاميرا)", true)
    return true
end

local function updateFlight()
    if not state.Fly then return end
    local root = localRoot()
    if not root or not fly.velocity or fly.velocity.Parent ~= root then
        startFlight()
        return
    end
    local cam = Workspace.CurrentCamera
    if not cam then return end

    local look = cam.CFrame.LookVector
    local right = cam.CFrame.RightVector
    local forwardInput, sidewaysInput = 0, 0

    local ok, inputs = pcall(UserInputService.GetGamepadState, UserInputService, Enum.UserInputType.Gamepad1)
    if ok then
        for _, input in ipairs(inputs) do
            if input.KeyCode == Enum.KeyCode.Thumbstick1 and input.Position.Magnitude > 0.14 then
                forwardInput = input.Position.Y
                sidewaysInput = input.Position.X
                break
            end
        end
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.W) then forwardInput = forwardInput + 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then forwardInput = forwardInput - 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then sidewaysInput = sidewaysInput + 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then sidewaysInput = sidewaysInput - 1 end

    local horizontalRight = Vector3.new(right.X, 0, right.Z)
    horizontalRight = horizontalRight.Magnitude > 0.01 and horizontalRight.Unit or Vector3.xAxis

    local movement = (look * forwardInput) + (horizontalRight * sidewaysInput)
    if movement.Magnitude > 1 then movement = movement.Unit end
    if movement.Magnitude < 0.03 then movement = Vector3.zero end

    fly.velocity.VectorVelocity = movement * state.FlySpeed
    fly.orient.CFrame = cam.CFrame.Rotation
end

local function applyStats()
    local hum = localHumanoid()
    if not hum then return end
    if not state.Fly then
        hum.WalkSpeed = state.Speed and state.WalkSpeed or original.WalkSpeed
    end
    pcall(function()
        hum.UseJumpPower = true
        hum.JumpPower = state.JumpPower and state.JumpValue or original.JumpPower
    end)
end

local function applyNoclip()
    if not state.Noclip then return end
    local char = localCharacter()
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            if collisionOriginal[obj] == nil then collisionOriginal[obj] = obj.CanCollide end
            obj.CanCollide = false
        end
    end
end

local function restoreCollisions()
    for part, orig in pairs(collisionOriginal) do
        if part and part.Parent then pcall(function() part.CanCollide = orig end) end
        collisionOriginal[part] = nil
    end
end

local function applyLocalInvisible()
    local char = localCharacter()
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = state.LocalInvisible and 1 or 0
        end
    end
end

local function applyFullBright()
    if state.FullBright then
        Lighting.Brightness = 2.5
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
    else
        Lighting.Brightness = original.Brightness
        Lighting.ClockTime = original.ClockTime
        Lighting.GlobalShadows = original.GlobalShadows
    end
end

-- نظام الكشف الشامل (Player ESP + Admin Vision)
local function clearESP()
    for plr, data in pairs(playerESPObjects) do
        if data.Highlight then pcall(function() data.Highlight:Destroy() end) end
        if data.Billboard then pcall(function() data.Billboard:Destroy() end) end
        playerESPObjects[plr] = nil
    end
end

local function isLikelyAdmin(player)
    if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
        return true, "مالك الماب"
    elseif game.CreatorType == Enum.CreatorType.Group then
        local ok, rank = pcall(function() return player:GetRankInGroup(game.CreatorId) end)
        if ok and type(rank) == "number" and rank >= 200 then
            return true, "رتبة قروب (" .. rank .. ")"
        end
    end
    local char = player.Character
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") then
                local n = item.Name:lower()
                if n:find("admin") or n:find("mod") or n:find("ban") or n:find("kick") or n:find("ادمن") then
                    return true, "أداة: " .. item.Name
                end
            end
        end
    end
    return false, "لاعب"
end

local function updateESP()
    if not state.PlayerESP and not state.AdminESP then
        clearESP()
        return
    end
    local myRoot = localRoot()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local isAdmin, roleLabel = isLikelyAdmin(plr)
                if state.PlayerESP or (state.AdminESP and isAdmin) then
                    local data = playerESPObjects[plr]
                    if not data then
                        local hl = make("Highlight", {
                            Adornee = char, FillTransparency = 0.55,
                            OutlineColor = COLORS.white, Parent = gui,
                        })
                        local bb = make("BillboardGui", {
                            Adornee = hrp, Size = UDim2.fromOffset(150, 42),
                            StudsOffset = Vector3.new(0, 3.2, 0), AlwaysOnTop = true, Parent = gui,
                        })
                        local lbl = make("TextLabel", {
                            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0.35,
                            BackgroundColor3 = COLORS.deep, TextColor3 = COLORS.white,
                            Font = Enum.Font.GothamBold, TextSize = 11, Parent = bb,
                        })
                        round(lbl, 6)
                        data = {Highlight = hl, Billboard = bb, Label = lbl}
                        playerESPObjects[plr] = data
                    end
                    local dist = myRoot and math.floor((myRoot.Position - hrp.Position).Magnitude) or 0
                    data.Highlight.FillColor = isAdmin and Color3.fromRGB(255, 45, 85) or Color3.fromRGB(65, 190, 255)
                    data.Label.Text = string.format("%s [%dm]\n%s", plr.Name, dist, isAdmin and ("⚠️ " .. roleLabel) or "")
                else
                    if playerESPObjects[plr] then
                        playerESPObjects[plr].Highlight:Destroy()
                        playerESPObjects[plr].Billboard:Destroy()
                        playerESPObjects[plr] = nil
                    end
                end
            end
        end
    end
end


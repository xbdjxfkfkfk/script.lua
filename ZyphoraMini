                local distance = (r.Position-destinationPosition).Magnitude
                if distance > 35 then
                    say('الموقع لم يثبت؛ قد يكون السيرفر أعادك أو السيارة لم تتحرك')
                else
                    say('موقعك قريب من الوجهة؛ لم يتم التحقق من قبول السيرفر النهائي')
                end
            end)
        end)
    end)
    button(navigation, 'إلغاء الانتقال المعلّق', function()
        pendingToken += 1
        say('تم إلغاء الانتقال المعلّق. لا يعكس انتقالًا اكتمل بالفعل.')

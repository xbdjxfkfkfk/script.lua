local function fillAnimals()
    local r = playerRoot()
    local results = {}
    for model in pairs(radarModels) do
        if isLiveLizard(model) then
            local part = basePart(model)
            if part then
                local distance = r and (part.Position - r.Position).Magnitude or math.huge
                table.insert(results, {model = model, part = part, distance = distance})
            end
        else
            radarModels[model] = nil
            dropMarker(radarMarkers, model)
        end
    end
    table.sort(results, function(a, b) return a.distance < b.distance end)
    animalSummaryText.Text = "ضبان حقيقية مكتشفة: " .. tostring(#results)
    for _, child in ipairs(animalRows:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
    for i, item in ipairs(results) do
        if i > 35 then break end
        local model = item.model
        local rarity = rarityText(model)
        local species = metadataDisplay(model, {"Species", "CreatureType", "نوع"})
        if species == "غير متاح" then species = model.Name end
        local size = metadataDisplay(model, {"AnimalSize", "DhabSize", "SizeStat", "الحجم"})
        local weight = metadataDisplay(model, {"WeightKG", "AnimalWeight", "DhabWeight", "الوزن"})
        local desc = string.format("%s | %s\nندرة: %s | حجم: %s | وزن: %s | بعد: %.0f",
            model.Name, species, rarity, size, weight, item.distance)
        local frame = info(animalRows, desc)
        frame.Size = UDim2.new(1, -3, 0, 47)
        local txt = frame:FindFirstChildOfClass("TextLabel")
        txt.Size = UDim2.new(1, -20, 1, -7)
    end
    if radarEnabled then
        local active = {}
        for i, item in ipairs(results) do
            if i > 40 then break end
            if item.distance <= 2500 then
                active[item.model] = true
                if not radarMarkers[item.model] then radarMarkers[item.model] = makeMarker(item.part, "", COLORS.amber) end
                local marker = radarMarkers[item.model]
                marker.Adornee = item.part
                marker:FindFirstChildOfClass("TextLabel").Text = item.model.Name .. " | " ..
                    rarityText(item.model) .. "\n" ..
                    string.format("%.0f studs", item.distance)
            end
        end
        for model in pairs(radarMarkers) do if not active[model] then dropMarker(radarMarkers, model) end end
    end
end

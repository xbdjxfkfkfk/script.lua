end
-- Strict recognition: never classify a car, passenger, player or vehicle accessory as wildlife.
local function vehicleAncestor(obj)
 local node=obj
 while node and node~=WS do
  if node:IsA('Model') then
   if node:FindFirstChildWhichIsA('VehicleSeat',true) then return true end
   local n=node.Name:lower()
   if n:find('vehicle',1,true) or n:find('truck',1,true) or n:find('pickup',1,true) or n:find('سيارة',1,true) then return true end
  end
  node=node.Parent
 end
 return false
end
local function belongsToPlayer(model)
 local node=model
 while node and node~=WS do
  if node:IsA('Model') then
   if Players:GetPlayerFromCharacter(node) or node==LP.Character then return true end
   for _,p in ipairs(Players:GetPlayers()) do if p.Character==node then return true end end
  end
  node=node.Parent
 end
 return false
end
local function animal(m)
 if not m:IsA('Model') or belongsToPlayer(m) or vehicleAncestor(m) then return false end
 local n=m.Name:lower()
 -- Only accept animal-shaped model names, not incidental text on vehicle components.
 local named=n:match('^dhab[%s_%-]') or n=='dhab' or n:match('^lizard[%s_%-]') or n=='lizard' or n:match('^reptile[%s_%-]') or n=='reptile' or n:match('^ضب')
 if not named then return false end
 if m:FindFirstChildWhichIsA('VehicleSeat',true) then return false end
 return true
end
local function living(m)
 if not m or not m.Parent then return false end
 local h=m:FindFirstChildOfClass('Humanoid')
 if h and h.Health<=0 then return false end
 for _,key in ipairs({'Dead','IsDead','Killed','Collected','Harvested'}) do
  local v=m:GetAttribute(key)
  if v==true then return false end
  local child=m:FindFirstChild(key,true)
  if child and child:IsA('BoolValue') and child.Value then return false end
 end
 local hp=stat(m,{'Health','HP','CurrentHealth','health'})
 if type(hp)=='number' and hp<=0 then return false end
 return true
end
local function part(m)
 return m.PrimaryPart or m:FindFirstChild('Head',true) or m:FindFirstChildWhichIsA('BasePart',true)
end
local animals={}; local lastScan=0
local function scan()
 table.clear(animals)
 for _,m in ipairs(WS:GetDescendants()) do
  if animal(m) and living(m) then
   local p=part(m)
   if p and p:IsDescendantOf(m) and not belongsToPlayer(m) then
    animals[#animals+1]={m=m,p=p}
   end
  end
 end
end
local function matches(e)
 if state.filter=='الكل' then return true end
 local r=rarity(e.m); return r==state.filter
end
local function nearest(filterRange)
 local me=root(); if not me then return nil end
 local best,bestDist=nil,math.huge
 for _,e in ipairs(animals) do if e.m.Parent and e.p.Parent and animal(e.m) and living(e.m) and matches(e) then local d=(e.p.Position-me.Position).Magnitude; if d<bestDist and d<=(filterRange or math.huge) then best,bestDist=e,d end end end
 return best,bestDist
end
local function compact(v)
 if v==nil then return '—' end
 if type(v)=='number' then return string.format('%.1f',v) end

end
local function action(value, callback)
    local b=button(content,value)
    b.Size=UDim2.new(1,0,0,39)
    b.Activated:Connect(function()
        local ok, err = pcall(callback)
        if not ok then
            warn("NOVA action error:",err)
            say("خطأ في الزر، افتح Output",false)
        end
    end)
    return b
end
local function characterParts()
    local char = player.Character
    if not char then return nil, nil, nil end
    return char, char:FindFirstChildOfClass("Humanoid"),char:FindFirstChild("HumanoidRootPart")
end
local function stopSpectate()
    spectated=nil
    local _,hum = characterParts()
    local cam=Workspace.CurrentCamera
    if cam and hum then
        cam.CameraType=Enum.CameraType.Custom
        cam.CameraSubject=hum
    end
    say("تم إيقاف المشاهدة")
end
local function spectate(target)
    if not target or target.Parent ~= Players then say("اختر لاعباً أولاً",false) return end
    local ch=target.Character
    local hum=ch and ch:FindFirstChildOfClass("Humanoid")
    local cam=Workspace.CurrentCamera
    if not hum or not cam then say("اللاعب غير جاهز للمشاهدة",false) return end
    cam.CameraType=Enum.CameraType.Custom
    cam.CameraSubject=hum
    spectated=target
    say("مشاهدة: "..target.DisplayName)
end

local function removeMarkers()
    for _, mark in ipairs(markers) do
        if mark.Parent then mark:Destroy() end
    end
    table.clear(markers)
end
local function addMarkers()
    removeMarkers()
    if not namesOn then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local ch=p.Character
            local mark=new("Highlight",ch,{
                Name="NOVA_LocalHighlight", Adornee=ch,
                FillTransparency=0.9, OutlineTransparency=0,
                OutlineColor=C.accent, DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,
            })
            table.insert(markers,mark)
            local head=ch:FindFirstChild("Head")
            if head then
                local bill=new("BillboardGui",head,{
                    Name="NOVA_LocalName",Adornee=head,AlwaysOnTop=true,
                    Size=UDim2.fromOffset(190,32),StudsOffsetWorldSpace=Vector3.new(0,2.8,0),
                })
                local t=label(bill,p.DisplayName.."  @"..p.Name,12,true)
                t.Size=UDim2.fromScale(1,1)
                t.TextXAlignment=Enum.TextXAlignment.Center
                table.insert(markers,bill)
            end
        end
    end
end
local function setFullbright(on)
    fullbright=on
    if on then
        Lighting.Brightness=4
        Lighting.ClockTime=14
        Lighting.FogEnd=100000
        Lighting.GlobalShadows=false
        Lighting.Ambient=Color3.fromRGB(220,220,220)
        Lighting.OutdoorAmbient=Color3.fromRGB(220,220,220)
    else
        for k,v in pairs(savedLighting) do Lighting[k]=v end
    end
end

local function setLocalInvisible(on)
    locallyHidden=on
    local ch=player.Character
    if not ch then say("شخصيتك لم تظهر بعد",false) return end
    for _,part in ipairs(ch:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.LocalTransparencyModifier = on and 1 or 0
        end
    end
    say(on and "اختفاء محلي: أنت فقط لا تراها" or "تم إظهار الشخصية")
end

local flightEnabled = false
local flightConnection = nil
local flightInstances = {}
local flightSpeed=45
local upHeld, downHeld=false,false
local touchFly = new("Frame",gui,{
    BackgroundTransparency=1,Size=UDim2.fromOffset(62,134),
    Position=UDim2.new(1,-72,1,-160),Visible=false,
})
local upButton=button(touchFly,"↑")
upButton.Size=UDim2.fromOffset(60,60)
upButton.TextSize=24
local downButton=button(touchFly,"↓")
downButton.Size=UDim2.fromOffset(60,60)
downButton.Position=UDim2.fromOffset(0,68)
downButton.TextSize=24
local function hookHold(b,setter)
    b.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then setter(true) end
    end)
    b.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then setter(false) end
    end)
end
hookHold(upButton,function(v)upHeld=v end)
hookHold(downButton,function(v)downHeld=v end)
local function stopFlight()
    flightEnabled=false
    upHeld=false;downHeld=false
    if flightConnection then flightConnection:Disconnect();flightConnection=nil end
    for _,part in ipairs(flightInstances) do if part.Parent then part:Destroy() end end
    table.clear(flightInstances)
    local _,hum=characterParts()
    if hum then hum.AutoRotate=true end
    touchFly.Visible=false
end
local function startFlight()
    stopFlight()
    local _,hum,root=characterParts()
    if not hum or not root then say("شخصيتك لم تجهز",false) return end
    local att=new("Attachment",root,{Name="NOVA_FlightAttachment"})
    local lv=new("LinearVelocity",root,{
        Name="NOVA_FlightVelocity",Attachment0=att,
        RelativeTo=Enum.ActuatorRelativeTo.World,
        VectorVelocity=Vector3.zero,ForceLimitsEnabled=false,
    })
    flightInstances={lv,att}
    flightEnabled=true
    hum.AutoRotate=false
    touchFly.Visible=UserInputService.TouchEnabled
    local controls
    pcall(function()
        local module = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
        controls = module:GetControls()
    end)
    flightConnection=RunService.Heartbeat:Connect(function()
        if not flightEnabled or not root.Parent or hum.Health<=0 then stopFlight() return end
        local camera=Workspace.CurrentCamera
        if not camera then return end
        local cf=camera.CFrame
        local f=Vector3.new(cf.LookVector.X,0,cf.LookVector.Z)
        if f.Magnitude<0.01 then f=Vector3.new(0,0,-1) end
        f=f.Unit
        local r=Vector3.new(cf.RightVector.X,0,cf.RightVector.Z)
        if r.Magnitude<0.01 then r=Vector3.new(1,0,0) end
        r=r.Unit
        local movement=hum.MoveDirection
        if controls then
            local ok,vec=pcall(function() return controls:GetMoveVector() end)
            if ok and typeof(vec)=="Vector3" then movement=f*(-vec.Z)+r*vec.X end
        end
        local up=upHeld or UserInputService:IsKeyDown(Enum.KeyCode.Space)
        local down=downHeld or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        local v=movement+Vector3.new(0,(up and 1 or 0)-(down and 1 or 0),0)
        lv.VectorVelocity=(v.Magnitude>0 and v.Unit or Vector3.zero)*flightSpeed
    end)
    say("الطيران المحلي يعمل حسب قيود الماب")
end

local function refreshPlayers()
    if currentTab=="players" then renderTab("players") end
end
local function listPlayers()
    contentLabel("اللاعبون  •  اختر لاعباً للمشاهدة",40)
    local chosen=contentLabel(selectedPlayer and ("المحدد: "..selectedPlayer.DisplayName.." @"..selectedPlayer.Name) or "لم يتم اختيار لاعب",45)
    chosen.TextColor3=C.secondary
    local search=new("TextBox",content,{
        Size=UDim2.new(1,0,0,38),Text=searchString,
        PlaceholderText="ابحث عن لاعب...",ClearTextOnFocus=false,
        BackgroundColor3=C.raised,TextColor3=C.text,PlaceholderColor3=C.secondary,
        BorderSizePixel=0,Font=Enum.Font.Gotham,TextSize=13,
    })
    corner(search,8)
    local entries=new("Frame",content,{
        BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),
        AutomaticSize=Enum.AutomaticSize.Y,
    })
    new("UIListLayout",entries,{Padding=UDim.new(0,5),SortOrder=Enum.SortOrder.LayoutOrder})
    local function fill()
        for _,obj in ipairs(entries:GetChildren()) do
            if obj:IsA("GuiObject") then obj:Destroy() end
        end
        local people=Players:GetPlayers()
        table.sort(people,function(a,b) return a.Name:lower()<b.Name:lower() end)
        local count=0
        for _,p in ipairs(people) do
            local q=search.Text:lower()
            if q=="" or p.Name:lower():find(q,1,true) or p.DisplayName:lower():find(q,1,true) then
                count=count+1
                local row=button(entries,(p==selectedPlayer and "● " or "○ ")..p.DisplayName.."  (@"..p.Name..")")
                row.Size=UDim2.new(1,0,0,37)
                row.LayoutOrder=count
                row.TextXAlignment=Enum.TextXAlignment.Left
                if p==selectedPlayer then row.BackgroundColor3=C.accent end
                row.Activated:Connect(function()
                    selectedPlayer=p
                    renderTab("players")
                end)
            end
        end
    end
    search:GetPropertyChangedSignal("Text"):Connect(function()
        searchString=search.Text
        fill()
    end)
    fill()
    action("مشاهدة اللاعب المحدد",function() spectate(selectedPlayer) end)
    action("إيقاف المشاهدة",stopSpectate)
    note("المشاهدة تغيّر الكاميرا على جهازك. المحادثة الصوتية تعتمد على إعدادات Roblox، ولا تُنقل تلقائياً إلى موقع اللاعب.")
end
local function movementPanel()
    contentLabel("الحركة والطيران",36)
    action("سرعة + 5   (الحالية "..speed..")",function()
        speed=math.min(speed+5,70)
        local _,hum=characterParts()
        if hum then hum.WalkSpeed=speed end
        say("السرعة المحلية: "..speed)
        renderTab("movement")
    end)
    action("سرعة - 5",function()
        speed=math.max(speed-5,8)
        local _,hum=characterParts()
        if hum then hum.WalkSpeed=speed end
        say("السرعة المحلية: "..speed)
        renderTab("movement")
    end)
    action("زيادة القفز ("..jumpPower..")",function()
        jumpPower=math.min(jumpPower+10,110)
        local _,hum=characterParts()
        if hum then hum.UseJumpPower=true;hum.JumpPower=jumpPower end
        say("القفز المحلي: "..jumpPower)
        renderTab("movement")
    end)
    action("تشغيل الطيران",startFlight)
    action("إيقاف الطيران",function() stopFlight();say("تم إيقاف الطيران") end)
    action("زيادة سرعة الطيران ("..flightSpeed..")",function()
        flightSpeed=math.min(150,flightSpeed+10)
        renderTab("movement")
    end)
    note("الكمبيوتر: WASD للحركة وSpace للصعود وCtrl للنزول. الجوال: عصا الحركة مع ↑ و↓. الماب قد يعيد تعيين الحركة.")
end
local function visualPanel()
    contentLabel("الرؤية والمظهر",36)
    action(namesOn and "إيقاف إظهار أسماء اللاعبين" or "إظهار أسماء اللاعبين",function()
        namesOn=not namesOn
        addMarkers()
        renderTab("visuals")
    end)
    action(fullbright and "إرجاع الإضاءة الطبيعية" or "إضاءة كاملة",function()
        setFullbright(not fullbright)
        say("تم تغيير الإضاءة")
        renderTab("visuals")
    end)
    action(locallyHidden and "إلغاء الاختفاء المحلي" or "اختفاء محلي (لن يخفيك عن الآخرين)",function()
        setLocalInvisible(not locallyHidden)
        renderTab("visuals")
    end)
    note("تأثيرات الرؤية والاختفاء هنا على جهازك فقط. اختفاء حقيقي عن بقية اللاعبين يحتاج كود خادم تملكه.")
end
local function settingsPanel()
    contentLabel("الإعدادات",36)
    action("إخفاء القائمة وإظهار زر NOVA",function()setOpen(false) end)
    action("إيقاف المشاهدة والطيران",function()stopSpectate();stopFlight() end)
    action("إرجاع الإضاءة ومسح العلامات",function()
        setFullbright(false)
        namesOn=false
        removeMarkers()
        renderTab("settings")
    end)
    note("هذه نسخة واجهة محلية تعمل من LocalScript بدون صلاحيات خادم أو Installer. لا يمكنها طرد الآخرين أو تجميدهم أو كسر حماية المابات.")
end

local tabs = {
    {id="players",name="اللاعبون"},
    {id="movement",name="الحركة"},

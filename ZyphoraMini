    for player in pairs(adminVisuals) do clearAdminVisual(player) end
    for _, conn in ipairs(connections) do conn:Disconnect() end
    gui:Destroy()
    if rawget(_G, "NOVA_SuiteV14Cleanup") == cleanup then

    b.MouseButton1Click:Connect(function() cb(b) end)
    return b
end

-- ESP System Real
local espCache = {}
local function toggleESP(state)
    S.ESP = state
    if not S.ESP then
        for _, box in pairs(espCache) do
            if box then box:Remove() end
        end
        espCache = {}
    end
end

mkBtn("👁️ كشف اللاعبين (ESP الحقيقي): OFF", function(self)
    toggleESP(not S.ESP)

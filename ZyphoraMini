local function toggle(text, key, onChanged)
    local base = text
    local b
    b = action((state[key] and "●  " or "○  ") .. base, function()
        state[key] = not state[key]
        b.Text = (state[key] and "●  " or "○  ") .. base
        b.BackgroundColor3 = state[key] and Color3.fromRGB(76, 45, 120) or COLORS.panel2
        if onChanged then onChanged(state[key]) end

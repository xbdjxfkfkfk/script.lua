-- Press Enter after typing a unique name to teleport without another click.
listen(search.FocusLost, function(enterPressed)
    if not enterPressed then return end
    local query = search.Text:lower()
    if query == "" then return end
    local matches = {}
    local exact = nil
    for _, candidate in ipairs(Players:GetPlayers()) do
        if candidate ~= LocalPlayer then
            if candidate.Name:lower() == query or candidate.DisplayName:lower() == query then exact = candidate end
            if candidate.Name:lower():find(query, 1, true) or candidate.DisplayName:lower():find(query, 1, true) then
                table.insert(matches, candidate)
            end
        end
    end
    local match = exact or (#matches == 1 and matches[1] or nil)
    if match then
        selectedPlayer = match
        chosen.Text = "المحدد: @" .. match.Name
        chosen.TextColor3 = COLORS.green
        tryTeleport(match)
    else
        say("الاسم غير موجود أو يطابق أكثر من لاعب؛ اختر من القائمة", false)
    end
end)
listen(Players.PlayerAdded, refreshList)
listen(Players.PlayerRemoving, function(player)
    if selectedPlayer == player then
        selectedPlayer = nil
        chosen.Text = "لم يتم تحديد لاعب"
    end
    if dragTarget == player then
        stopDrag()
        dragButton.Text = "🧲 سحب تجريبي محلي للاعب المحدد"
    end
    clearAdminVisual(player)
    refreshList()
end)
refreshList()
note("زر السحب محاولة محلية تجريبية وقد لا يظهر أثرها للآخرين؛ السحب الحقيقي يحتاج سماح السيرفر. لا تعد هذه الأداة بتحكم أو صلاحيات على لاعبين آخرين.")

-- Update small set of client-only functions.
local elapsed, adminElapsed, dragElapsed = 0, 0, 0
listen(RunService.RenderStepped, function(dt)
    if not alive then return end
    updateFlight()
    elapsed = elapsed + dt
    adminElapsed = adminElapsed + dt
    dragElapsed = dragElapsed + dt
    if elapsed >= .5 then
        elapsed = 0
        if state.LocalInvisible then applyLocalInvisible() end
        if state.Speed then applySpeed() end
        refreshHighlights()
    end
    if adminElapsed >= 1.5 then
        adminElapsed = 0
        refreshAdminVision()
    end
    if dragElapsed >= .15 then
        dragElapsed = 0
        attemptLocalDrag()
    end
end)
listen(LocalPlayer.CharacterAdded, function()
    stopFlight()
    original.WalkSpeed = nil
    if state.Fly then
        task.delay(.5, function() if alive and state.Fly then startFlight() end end)
    end
    task.delay(.7, function()
        if alive then applySpeed(); applyLocalInvisible() end
    end)
end)

local function cleanup()
    if not alive then return end
    alive = false
    state.Fly = false
    stopFlight()
    state.LocalInvisible = false
    applyLocalInvisible()
    state.Speed = false
    applySpeed()
    clearHighlights()
    stopDrag()
    for player in pairs(adminVisuals) do clearAdminVisual(player) end
    for _, conn in ipairs(connections) do conn:Disconnect() end
    gui:Destroy()
    if rawget(_G, "NOVA_SuiteV8Cleanup") == cleanup then
        _G.NOVA_SuiteV8Cleanup = nil
    end
end
_G.NOVA_SuiteV8Cleanup = cleanup
listen(close.MouseButton1Click, cleanup)

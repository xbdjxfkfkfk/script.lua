local function mkBtn(text, cb)
    nextOrder += 1
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -6, 0, 38)
    b.BackgroundColor3 = C.panel
    b.BorderSizePixel = 0
    b.Text = "   " .. text
    b.TextColor3 = C.text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.AutoButtonColor = false
    b.LayoutOrder = nextOrder
    b.Parent = Scroll
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

    local side = Instance.new("Frame")
    side.Size = UDim2.new(0, 3, 1, -10)
    side.Position = UDim2.new(0, 4, 0, 5)
    side.BackgroundColor3 = C.accent
    side.BorderSizePixel = 0
    side.Parent = b
    Instance.new("UICorner", side).CornerRadius = UDim.new(0, 2)

    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = C.panelHi }):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = C.panel }):Play()
    end)
    b.MouseButton1Click:Connect(function() cb(b, side) end)
    return b, side

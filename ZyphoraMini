local function refreshTools()
    for _, child in ipairs(toolList:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then child:Destroy() end
    end
    local current = {}
    local bag = player:FindFirstChildOfClass("Backpack")
    for _, parent in ipairs({bag, player.Character}) do
        if parent then
            for _, child in ipairs(parent:GetChildren()) do
                if child:IsA("Tool") and not current[child] then current[child] = true end
            end
        end
    end
    local count = 0
    for tool in pairs(current) do
        count = count + 1
        local b = button(toolList, "تجهيز: " .. tool.Name, UDim2.new(), UDim2.new(1, -10, 0, 45), function()
            local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and tool.Parent then
                humanoid:EquipTool(tool)
                note("تمت محاولة تجهيز: " .. tool.Name)
            else
                note("الأداة أو الشخصية غير جاهزة")
            end
        end)
        b.LayoutOrder = count
    end
    if count == 0 then
        text(toolList, "ما عندك أدوات حاليًا.", UDim2.fromOffset(10, 10), UDim2.new(1, -20, 0, 42), 14, C.muted)
    end
    toolList.CanvasSize = UDim2.fromOffset(0, math.max(50, count * 50))
end

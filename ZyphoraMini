-- Index potential resource objects once, then update incrementally.
-- Avoid scanning the entire Workspace every UI refresh.
task.spawn(function()
 local pending={WS};local index=1
 while alive and index<=#pending do
  local obj=pending[index];index+=1
  if (obj:IsA('Model') or obj:IsA('BasePart')) and nameMatches(obj,resourceWords) then
   resourceScanQueue[#resourceScanQueue+1]=obj
  end
  for _,child in ipairs(obj:GetChildren()) do pending[#pending+1]=child end
  if index%35==0 then task.wait(0.04) end
 end
end)
conn(WS.DescendantAdded,function(obj)
 if (obj:IsA('Model') or obj:IsA('BasePart')) and nameMatches(obj,resourceWords) then
  resourceScanQueue[#resourceScanQueue+1]=obj
 end
end)
local function updateResourceIndex()
 for _=1,math.min(100,#resourceScanQueue) do
  if resourceScanCursor>#resourceScanQueue then break end
  local obj=resourceScanQueue[resourceScanCursor]
  resourceScanCursor+=1
  if obj and obj.Parent and validResource(obj) then resourceIndex[obj]=true end
 end
 if resourceScanCursor>#resourceScanQueue then
  resourceScanQueue={};resourceScanCursor=1
  if not resourceReady then
   for obj in pairs(resourceIndex) do resourceKnown[obj]=true end
  end
  resourceReady=true
 end
end
local function refreshExtrasESP()
 updateResourceIndex()
 local r=root()
 local now=os.clock()
 if resourceAlertText.Visible and now>=resourceBannerUntil then resourceAlertText.Visible=false end
 local count=0
 for obj in pairs(resourceIndex) do
  local valid=validResource(obj)
  local p=valid and resourcePart(obj) or nil
  local d=(r and p) and (p.Position-r.Position).Magnitude or math.huge
  if not valid or not p then
   resourceIndex[obj]=nil
   resourceKnown[obj]=nil
  else
   if resourceReady and not resourceKnown[obj] and S.ResourceAlert and d<=3000 and now>=resourceAlertCooldown then
    resourceAlertText.Text='◆ ظهر مورد نادر: '..obj.Name..'\nالمسافة '..math.floor(d)..' وحدة'
    resourceAlertText.Visible=true
    resourceBannerUntil=now+5
    resourceAlertCooldown=now+2
   end
   resourceKnown[obj]=true
   if S.ResourceESP and d<=3000 and count<50 then
    count+=1
    if not resourceMarkers[obj] then resourceMarkers[obj]=billboardFor(p,'',Color3.fromRGB(255,209,95)) end
    local b=resourceMarkers[obj];b.Adornee=p
    local t=b:FindFirstChildOfClass('TextLabel')
    if t then t.Text='◆ '..obj.Name..'\n'..math.floor(d)..' وحدة' end
   elseif resourceMarkers[obj] then
    resourceMarkers[obj]:Destroy();resourceMarkers[obj]=nil
   end
  end
 end
 for obj,b in pairs(resourceMarkers) do
  if not S.ResourceESP or not resourceIndex[obj] then b:Destroy();resourceMarkers[obj]=nil end
 end
 local trader,d=findMerchant()
 if S.Merchant and trader and r then
  if not merchantMarker then merchantMarker=billboardFor(trader,'',Color3.fromRGB(110,245,174)) end
  merchantMarker.Adornee=trader
  local t=merchantMarker:FindFirstChildOfClass('TextLabel');if t then t.Text='تاجر الخلا\n'..math.floor(d)..' وحدة' end
 elseif merchantMarker then merchantMarker:Destroy();merchantMarker=nil end
end
local function checkRareSpawn()
 local now=os.clock()
 if rareBanner.Visible and now>=bannerUntil then rareBanner.Visible=false end
 local seen={}
 local r=root()
 for _,e in ipairs(cache) do
  if e.model.Parent and living(e.model) and lizard(e.model) then
   local rank=rarity(e.model)
   if rank=='نادر' or rank=='فاخر' or rank=='أسطوري' or rank=='خرافي' then
    seen[e.model]=true
    if rareInitialized and not knownRare[e.model] and S.RareAlert and r then
     local d=math.floor((e.part.Position-r.Position).Magnitude)
     rareBannerText.Text='ضب '..rank..' ظهر!\n'..e.model.Name..' • '..d..' وحدة'
     rareBanner.Visible=true;bannerUntil=now+5
    end
   end
  end
 end
 knownRare=seen
 rareInitialized=true
end

-- A vehicle must have an actual driving seat, not just a vehicle-like name.
-- Avoid listing nested submodels of the same vehicle multiple times.
local function hasVehicle(model)
 if not model or not model:IsA('Model') or not model:IsDescendantOf(WS) then return false end
 if playerAncestor(model) then return false end
 local seat=model:FindFirstChildWhichIsA('VehicleSeat',true)
 if not seat then return false end
 local ancestor=model.Parent
 while ancestor and ancestor~=WS do
  if ancestor:IsA('Model') and ancestor:FindFirstChildWhichIsA('VehicleSeat',true) then return false end
  ancestor=ancestor.Parent
 end
 return true
end

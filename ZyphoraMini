    local function choose(destination)
        selected = destination
        local r = root()
        local current = destination.object and positionOf(destination.object) or destination.position
        local distance = (r and current) and math.floor((current-r.Position).Magnitude) or 0
        navigationLabel.Text = 'الوجهة: '..destination.name..' | '..distance..' وحدة'
        say('تم تحديد '..destination.name..'؛ اضغط انتقال أو غيّر الوضع')
    end

    local function scanAsync(name, terms, kind)
        searchToken += 1
        local token = searchToken
        clearButtons(results)
        label(results, 'جاري فحص العناصر المحمّلة...')
        say('جاري البحث عن '..name..'؛ النتائج تعتمد على تحميل الماب')
        task.spawn(function()
            local r = root()
            if not r then say('انتظر ظهور الشخصية'); return end
            local loaded = Workspace:GetDescendants()
            local found = {}
            for i, object in ipairs(loaded) do
                if not alive or token ~= searchToken then return end
                if object:IsA('Model') or object:IsA('BasePart') then
                    local isAnimal = kind=='animal' and object:IsA('Model') and animalCandidate(object)
                    local isResource = kind=='resource' and matches(object.Name, terms)
                    local isPlace = kind=='place' and matches(object.Name, terms)
                    local accepted = isAnimal or isResource or isPlace
                    if accepted and not insidePlayer(object) and (isAnimal or topNamedObject(object, terms)) then
                        local p = positionOf(object)
                        if p then
                            found[#found+1] = {
                                name=object.Name, object=object, position=p,
                                distance=(p-r.Position).Magnitude,
                            }
                        end
                    end
                end
                if i%250 == 0 then task.wait() end
            end
            if not alive or token ~= searchToken then return end
            table.sort(found, function(a,b) return a.distance < b.distance end)
            currentSearch = found
            clearButtons(results)
            if #found == 0 then
                label(results, 'ما لقيت نتائج. قد تكون خارج التحميل، أو أسماء الماب مختلفة.')
                say(name..': ما فيه مجسم مطابق في العناصر المحمّلة')
                return
            end
            label(results, ('%s | %d نتيجة (أول 15 معروضة)'):format(name, #found))
            for i=1,math.min(#found,15) do
                local item = found[i]
                button(results, ('اختيار %s | %d وحدة'):format(item.name, item.distance), function()
                    if not item.object.Parent then say('العنصر اختفى، أعد البحث'); return end
                    choose(item)
                end)
            end
            say(('اكتمل بحث %s: %d عنصر مطابق. اختر الوجهة من النتائج.'):format(name,#found))
        end)
    end

    for _, destination in ipairs(DESTINATIONS) do
        local item = destination
        local kind = item.name=='الضبان' and 'animal' or 'place'
        button(navigation, 'بحث: '..item.name, function()
            scanAsync(item.name, item.terms, kind)
        end)
    end
    button(navigation, 'حفظ موقعي الحالي كديرة', function()
        local r = root()
        if not r then say('الشخصية غير جاهزة'); return end

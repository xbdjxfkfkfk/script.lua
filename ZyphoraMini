-- Lx REDLINE PRO v77 | authoritative server companion for games you control.
-- Install as Script in ServerScriptService, alongside a private ModuleScript named
-- Lx_REDLINE_PRIVATE_CONFIG (see CONFIG_TEMPLATE.lua). Never expose it to clients.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local configModule = ServerStorage:FindFirstChild("Lx_REDLINE_PRIVATE_CONFIG")
local Config = configModule and require(configModule) or {}
local URL = (Config.GatewayURL or ""):gsub("/+$", "")
local KEY = Config.GameKey or ""
local STUDIO_TEST = Config.StudioTestMode == true and RunService:IsStudio()
-- When replacing a server script during Studio development, discard orphan
-- constraints from this package rather than stacking acceleration forces.
local orphanNames = {
    LxGroundAttach = true, LxGroundAcceleration = true, LxGroundSteering = true,
    LxFlightAttachment = true, LxFlightVelocity = true, LxFlightOrientation = true,
}
local function removeOrphanForces(root)
    for _, obj in ipairs(root:GetDescendants()) do
        if orphanNames[obj.Name] and (obj:IsA("Attachment") or obj:IsA("VectorForce") or
            obj:IsA("LinearVelocity") or obj:IsA("AngularVelocity") or obj:IsA("AlignOrientation")) then
            obj:Destroy()
        end
    end
end
for _, vehicle in ipairs(CollectionService:GetTagged("LxVehicle")) do removeOrphanForces(vehicle) end
local active = {}
local authCache = {}
local home = {}
local teleportSerial = {}
local remoteFolder = ReplicatedStorage:FindFirstChild("Lx_REDLINE_v77")
if not remoteFolder then
    remoteFolder = Instance.new("Folder")
    remoteFolder.Name = "Lx_REDLINE_v77"
    remoteFolder.Parent = ReplicatedStorage
end
local function getRemote(kind, name)
    local item = remoteFolder:FindFirstChild(name)
    if item and not item:IsA(kind) then item:Destroy() item = nil end
    if not item then item = Instance.new(kind) item.Name = name item.Parent = remoteFolder end
    return item
end
local Action = getRemote("RemoteFunction", "Action")
local Events = getRemote("RemoteEvent", "Events")
local function validNumber(n)
    return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end
local function fail(message) return false, message end
local function loggedRequest(route, body)
    if URL == "" or KEY == "" then return nil, "إعدادات Discord gateway غير مكتملة" end
    local success, response = pcall(function()
        return HttpService:RequestAsync({
            Url = URL .. route, Method = "POST",
            Headers = { ["Content-Type"] = "application/json", ["X-Game-Key"] = KEY },
            Body = HttpService:JSONEncode(body),
        })
    end)
    if not success then return nil, "تعذر اتصال السيرفر ببوابة Discord" end
    if not response.Success then return nil, "فشل طلب البوابة (" .. tostring(response.StatusCode) .. ")" end
    local parsed, decoded = pcall(HttpService.JSONDecode, HttpService, response.Body)
    if not parsed or type(decoded) ~= "table" then return nil, "استجابة البوابة غير صحيحة" end
    return decoded
end
local function stopBoost(state)
    if not state then return end
    if state.boostForce then state.boostForce:Destroy() state.boostForce = nil end
    if state.boostYaw then state.boostYaw:Destroy() state.boostYaw = nil end
    if state.boostAttachment then state.boostAttachment:Destroy() state.boostAttachment = nil end
    state.boost = false
    state.lastDrive = 0
    state.driveThrottle = 0
    state.driveSteer = 0
end
local function stopFlight(state)
    if not state then return end
    if state.flyVelocity then state.flyVelocity:Destroy() state.flyVelocity = nil end
    if state.flyOrientation then state.flyOrientation:Destroy() state.flyOrientation = nil end
    if state.flyAttachment then state.flyAttachment:Destroy() state.flyAttachment = nil end
    if state.flyHumanoid and state.flyHumanoid.Parent then
        state.flyHumanoid.PlatformStand = state.oldPlatformStand or false
        state.flyHumanoid.AutoRotate = state.oldAutoRotate ~= false
        pcall(function() state.flyHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
    if state.flyPart and state.flyPart.Parent and state.flyPart:IsA("BasePart") then
        pcall(function() state.flyPart:SetNetworkOwnershipAuto() end)
    end
    state.flyMode = nil
    state.flyHumanoid = nil
    state.flyPart = nil
    state.flySeat = nil
    state.inputDirection = Vector3.zero
    state.lastInput = 0
end
local function allStop(player, reason)
    local state = active[player]
    if not state then return end
    stopFlight(state)
    stopBoost(state)
    if reason then Events:FireClient(player, "ForcedStop", reason) end
end
local function authorize(player, refresh)
    if STUDIO_TEST then return true, "StudioTestMode: اختبار محلي فقط" end
    local now = os.clock()
    local cached = authCache[player]
    if not refresh and cached and now - cached.at < 15 then
        return cached.allowed, cached.reason
    end
    local result, errorReason = loggedRequest("/v1/member/check", {robloxUserId = tostring(player.UserId)})
    local allowed = result and result.allowed == true or false
    local reason = allowed and "Discord verified" or (result and result.reason or errorReason or "العضوية غير مثبتة")
    authCache[player] = {allowed = allowed, reason = reason, at = now}
    if cached and cached.allowed and not allowed then
        allStop(player, "انتهت عضوية Discord")
        Events:FireClient(player, "AuthChanged", false)
    end
    return allowed, reason
end
local function getCharacter(player)
    local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not h or not root or h.Health <= 0 then return nil, nil end
    return h, root
end
local function getVehicle(player)
    local humanoid = getCharacter(player)
    if not humanoid then return nil, nil end
    local seat = humanoid.SeatPart
    if not seat or not seat:IsA("VehicleSeat") or seat.Occupant ~= humanoid then return nil, nil end
    local model = seat:FindFirstAncestorOfClass("Model")
    while model do
        if CollectionService:HasTag(model, "LxVehicle") then
            if seat.Anchored or not model:IsDescendantOf(Workspace) then return nil, nil end
            return model, seat
        end
        local parent = model.Parent
        if parent and parent:IsA("Model") then model = parent
        else model = parent and parent:FindFirstAncestorOfClass("Model") or nil end
    end
    return nil, nil
end
local function attachmentOn(part, name)
    local attach = Instance.new("Attachment")
    attach.Name = name
    attach.Parent = part
    return attach
end
local function setupBoost(state, seat, vehicle)
    stopBoost(state)
    local attach = attachmentOn(seat, "LxGroundAttach")
    local force = Instance.new("VectorForce")
    force.Name = "LxGroundAcceleration"
    force.Attachment0 = attach
    force.ApplyAtCenterOfMass = true
    force.RelativeTo = Enum.ActuatorRelativeTo.World
    force.Force = Vector3.zero
    force.Parent = seat
    state.boostAttachment = attach
    state.boostForce = force
    state.boostSeat = seat
    state.boostVehicle = vehicle
    state.boost = true
    state.lastDrive = 0
    state.driveThrottle = 0
    state.driveSteer = 0
    if vehicle:GetAttribute("LxDriveMode") == "Basic" then
        local yaw = Instance.new("AngularVelocity")
        yaw.Name = "LxGroundSteering"
        yaw.Attachment0 = attach
        yaw.RelativeTo = Enum.ActuatorRelativeTo.World
        yaw.AngularVelocity = Vector3.zero
        yaw.MaxTorque = math.max(seat.AssemblyMass * 250, 20000)
        yaw.Parent = seat
        state.boostYaw = yaw
    end
end
local function setupFlight(state, part, humanoid, seat, mode)
    stopFlight(state)
    stopBoost(state)
    local att = attachmentOn(part, "LxFlightAttachment")
    local velocity = Instance.new("LinearVelocity")
    velocity.Name = "LxFlightVelocity"
    velocity.Attachment0 = att
    velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    velocity.ForceLimitsEnabled = false
    velocity.VectorVelocity = Vector3.zero
    velocity.Parent = part
    local orientation = Instance.new("AlignOrientation")
    orientation.Name = "LxFlightOrientation"
    orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    orientation.Attachment0 = att
    orientation.RigidityEnabled = false
    orientation.MaxTorque = math.max(part.AssemblyMass * 2000, 150000)
    orientation.Responsiveness = 14
    orientation.Parent = part
    state.flyAttachment = att
    state.flyVelocity = velocity
    state.flyOrientation = orientation
    state.flyPart = part
    state.flySeat = seat
    state.flyMode = mode
    state.inputDirection = Vector3.zero
    state.facing = Vector3.new(0, 0, -1)
    state.lastInput = os.clock()
    if humanoid then
        state.flyHumanoid = humanoid
        state.oldPlatformStand = humanoid.PlatformStand
        state.oldAutoRotate = humanoid.AutoRotate
        humanoid.PlatformStand = true
        humanoid.AutoRotate = false
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    end
    -- Server ownership makes movement authoritative in this game.
    pcall(function() part:SetNetworkOwner(nil) end)
end
local function stateOf(player)
    local state = active[player]
    if not state then
        state = {owner = player, boost = false, boostTarget = 75, carFlySpeed = 70, playerFlySpeed = 55,
            carDirection = 1, inputDirection = Vector3.zero, lastInput = 0,
            lastEvent = 0, flyMode = nil}
        active[player] = state
    end
    return state
end
local function safePart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true) end
    return nil
end
local function validLizard(model)
    if not model:IsA("Model") or model:GetAttribute("LxIsDecoration") == true or
        model:GetAttribute("IsCaged") == true or model:GetAttribute("Dead") == true then return false end
    if not safePart(model) or model:FindFirstChildWhichIsA("VehicleSeat", true) then return false end
    local h = model:FindFirstChildOfClass("Humanoid")
    if h and h.Health <= 0 then return false end
    local ancestor = model
    while ancestor and ancestor ~= Workspace do
        if ancestor:IsA("Model") and (CollectionService:HasTag(ancestor, "LxVehicle") or
            Players:GetPlayerFromCharacter(ancestor) or ancestor:GetAttribute("LxIsDecoration") == true) then
            return false
        end
        ancestor = ancestor.Parent
    end
    return true
end
local function nearestValid(player, kind)
    local _, root = getCharacter(player)
    if not root then return nil end
    local tags = {Merchant = "LxMerchant", Resource = "LxRareResource", Vehicle = "LxVehicle"}
    local best, distance = nil, math.huge
    local function test(obj)
        local part = safePart(obj)
        if part and part:IsDescendantOf(Workspace) then
            local d = (root.Position - part.Position).Magnitude
            if d < distance then best, distance = part, d end
        end
    end
    if kind == "Lizard" then
        for _, tag in ipairs({"LxLizard", "Lizard", "Dhab"}) do
            for _, m in ipairs(CollectionService:GetTagged(tag)) do
                if validLizard(m) then test(m) end
            end
        end
    elseif tags[kind] then
        for _, m in ipairs(CollectionService:GetTagged(tags[kind])) do test(m) end
    else
        local validDestinations = {Turquoise = true, Gold = true, Diamond = true, World2 = true}
        if validDestinations[kind] then
            for _, obj in ipairs(CollectionService:GetTagged("LxDestination")) do
                if obj:GetAttribute("LxDestinationId") == kind then test(obj) end
            end
        end
    end
    return best
end
local function teleportCharacter(player, position)
    local humanoid, root = getCharacter(player)
    if not root then return false, "الشخصية غير جاهزة" end
    if position.X ~= position.X or math.max(math.abs(position.X), math.abs(position.Y), math.abs(position.Z)) > 50000 then
        return false, "إحداثيات غير مسموحة"
    end
    if humanoid.SeatPart then
        local vehicle = getVehicle(player)
        if not vehicle then return false, "السيارة غير موسومة LxVehicle" end
        local before = vehicle:GetPivot()
        vehicle:PivotTo(CFrame.new(position + Vector3.new(0, 7, 0)) * before.Rotation)
        return true, "تم نقل السيارة"
    end
    root.CFrame = CFrame.new(position + Vector3.new(0, 4, 0))
    return true, "تم الانتقال"
end
local function performAction(player, action, payload)
    payload = type(payload) == "table" and payload or {}
    if action == "AuthStatus" then return authorize(player, true) end
    if action == "AuthLink" then
        if STUDIO_TEST then return false, "StudioTestMode مفعل، يمكنك فتح القائمة دون OAuth أثناء الاختبار" end
        local response, issue = loggedRequest("/v1/pair/start", {robloxUserId = tostring(player.UserId),
            code = HttpService:GenerateGUID(false)})
        if response and type(response.pairingCode) == "string" then return true, response.pairingCode end
        return false, issue or (response and response.reason) or "تعذر إنشاء رابط التحقق"
    end
    local allowed, reason = authorize(player, false)
    if not allowed then return false, reason end
    local state = stateOf(player)
    if action == "CarBoost" then
        local turnOn = payload.enabled == true
        if not turnOn then stopBoost(state) return true, "مساعد السرعة متوقف" end
        if state.flyMode then return false, "أوقف الطيران أولًا" end
        local car, seat = getVehicle(player)
        if not car then return false, "يجب أن تكون سائق سيارة موسومة LxVehicle" end
        setupBoost(state, seat, car)
        return true, "تفعيل التسارع الأرضي"
    elseif action == "CarTarget" then
        local value = payload.value
        if not validNumber(value) then return false, "سرعة غير صحيحة" end
        state.boostTarget = math.clamp(value, 15, 220)
        return true, "تحديث السرعة"
    elseif action == "CarDirection" then
        if payload.value ~= -1 and payload.value ~= 1 then return false, "اتجاه غير صحيح" end
        state.carDirection = payload.value
        return true, "تحديث الاتجاه"
    elseif action == "CarFlySpeed" then
        if not validNumber(payload.value) then return false, "سرعة غير صحيحة" end
        state.carFlySpeed = math.clamp(payload.value, 15, 160)
        return true, "تم ضبط سرعة طيران السيارة"
    elseif action == "PlayerFlySpeed" then
        if not validNumber(payload.value) then return false, "سرعة غير صحيحة" end
        state.playerFlySpeed = math.clamp(payload.value, 10, 140)
        return true, "تم ضبط سرعة طيران اللاعب"
    elseif action == "CarFly" then
        if payload.enabled ~= true then
            if state.flyMode == "Car" then stopFlight(state) end
            return true, "تم إيقاف طيران السيارة"
        end
        if state.flyMode == "Player" then return false, "أوقف طيران اللاعب أولًا" end
        local car, seat = getVehicle(player)
        if not car then return false, "اجلس في مقعد قيادة سيارة موسومة LxVehicle" end
        setupFlight(state, seat, nil, seat, "Car")
        return true, "بدأ طيران السيارة"
    elseif action == "PlayerFly" then
        if payload.enabled ~= true then
            if state.flyMode == "Player" then stopFlight(state) end
            return true, "تم إيقاف طيران اللاعب"
        end
        if state.flyMode == "Car" then return false, "أوقف طيران السيارة أولًا" end
        local h, root = getCharacter(player)
        if not h then return false, "الشخصية غير جاهزة" end
        if h.SeatPart then return false, "انزل من السيارة قبل الطيران" end
        setupFlight(state, root, h, nil, "Player")
        return true, "بدأ طيران اللاعب"
    elseif action == "SaveHome" then
        local _, root = getCharacter(player)
        if not root then return false, "الشخصية غير جاهزة" end
        home[player] = root.Position
        return true, "تم حفظ الديرة"
    elseif action == "Teleport" then
        if state.flyMode then return false, "أوقف الطيران قبل الانتقال" end
        local kind = payload.kind
        if type(kind) ~= "string" then return false, "وجهة غير صحيحة" end
        local target = nil
        if kind == "Home" then target = home[player]
        elseif kind == "Player" then
            local id = tonumber(payload.userId)
            if not validNumber(id) or id % 1 ~= 0 then return false, "معرف لاعب غير صحيح" end
            local other = Players:GetPlayerByUserId(id)
            local otherRoot = nil
            if other then local otherHumanoid; otherHumanoid, otherRoot = getCharacter(other) end
            if other and other ~= player and otherRoot then target = otherRoot.Position end
        else
            local part = nearestValid(player, kind)
            if part then target = part.Position end
        end
        if not target then return false, "لم أجد وجهة موثوقة باسم " .. kind end
        teleportSerial[player] = (teleportSerial[player] or 0) + 1
        local serial = teleportSerial[player]
        task.delay(1.5, function()
            if teleportSerial[player] ~= serial or not player.Parent then return end
            local access = authorize(player, false)
            if not access then return end
            local ok, note = teleportCharacter(player, target)
            Events:FireClient(player, "TeleportResult", ok and "تم الانتقال" or note)
        end)
        return true, "سيتم الانتقال خلال ثانية ونصف؛ يمكنك الإلغاء"
    elseif action == "CancelTeleport" then
        teleportSerial[player] = (teleportSerial[player] or 0) + 1
        return true, "تم إلغاء الانتقال"
    end
    return false, "أمر غير معروف"
end
Action.OnServerInvoke = function(player, action, payload)
    if type(action) ~= "string" or #action > 40 then return false, "أمر غير صحيح" end
    local ok, success, result = pcall(performAction, player, action, payload)
    if not ok then
        warn("[Lx v77 SERVER] " .. tostring(success))
        return false, "فشل داخلي بالسيرفر (راجع Output)"
    end
    return success, result
end
Events.OnServerEvent:Connect(function(player, action, payload)
    if action == "StopAll" then allStop(player) return end
    local state = active[player]
    if action == "DriveInput" and type(payload) == "table" then
        if not state or not state.boost or state.flyMode then return end
        local t, steer = payload.throttle, payload.steer
        if not validNumber(t) or not validNumber(steer) or math.abs(t) > 1 or math.abs(steer) > 1 then return end
        local car, seat = getVehicle(player)
        if not car or seat ~= state.boostSeat then return end
        local now = os.clock()
        if now - (state.lastDrivePacket or 0) < 0.055 then return end
        state.lastDrivePacket = now
        state.driveThrottle = t
        state.driveSteer = steer
        state.lastDrive = now
        return
    end
    if action ~= "FlightInput" or type(payload) ~= "table" then return end
    if not state or not state.flyMode or payload.mode ~= state.flyMode then return end
    local now = os.clock()
    if now - (state.lastEvent or 0) < 0.055 then return end
    state.lastEvent = now
    local dir, facing = payload.direction, payload.facing
    if typeof(dir) ~= "Vector3" or typeof(facing) ~= "Vector3" then return end
    if not (validNumber(dir.X) and validNumber(dir.Y) and validNumber(dir.Z) and
        validNumber(facing.X) and validNumber(facing.Y) and validNumber(facing.Z)) then return end
    if dir.Magnitude > 1.05 or facing.Magnitude < 0.1 then return end
    state.inputDirection = dir
    local look = Vector3.new(facing.X, 0, facing.Z)
    if look.Magnitude > 0.1 then state.facing = look.Unit end
    state.lastInput = now
end)
local function updateGround(state, dt)
    if not state.boost then return end
    local seat = state.boostSeat
    if not seat or not seat.Parent or not state.boostForce or seat.Occupant == nil then
        stopBoost(state)
        return
    end
    local occupant = seat.Occupant
    local player = Players:GetPlayerFromCharacter(occupant.Parent)
    if not player or active[player] ~= state then stopBoost(state) return end
    local speed = seat.AssemblyLinearVelocity
    local horizontal = Vector3.new(speed.X, 0, speed.Z)
    local look = seat.CFrame.LookVector
    local forward = Vector3.new(look.X, 0, look.Z)
    if forward.Magnitude < 0.01 then return end
    forward = forward.Unit * state.carDirection
    local recent = os.clock() - (state.lastDrive or 0) < 0.5
    local throttle = recent and state.driveThrottle or seat.ThrottleFloat
    local steer = recent and state.driveSteer or seat.SteerFloat
    local targetSpeed = state.boostTarget * throttle
    local actualSpeed = horizontal:Dot(forward)
    local errorSpeed = targetSpeed - actualSpeed
    local accel = math.clamp(errorSpeed * 1.5, -52, 52)
    local force = forward * (seat.AssemblyMass * accel)
    -- Only active throttle adds acceleration; idle should not fight normal braking.
    state.boostForce.Force = math.abs(throttle) > 0.025 and force or Vector3.zero
    if state.boostYaw then
        local turnRate = math.rad(85) * steer * (throttle < 0 and -1 or 1)
        state.boostYaw.AngularVelocity = Vector3.new(0, turnRate, 0)
    end
end
local function updateFlight(state)
    if not state.flyMode then return end
    local part = state.flyPart
    if not part or not part.Parent or not state.flyVelocity or not state.flyAttachment then
        stopFlight(state) return
    end
    if state.flyMode == "Car" then
        local seat = state.flySeat
        if not seat or not seat.Occupant or seat ~= part or
            Players:GetPlayerFromCharacter(seat.Occupant.Parent) ~= state.owner then
            stopFlight(state) return end
    else
        if not state.flyHumanoid or state.flyHumanoid.Health <= 0 or state.flyHumanoid.SeatPart then
            stopFlight(state) return
        end
    end
    local input = os.clock() - state.lastInput < 0.45 and state.inputDirection or Vector3.zero
    local speed = state.flyMode == "Car" and state.carFlySpeed or state.playerFlySpeed
    state.flyVelocity.VectorVelocity = input * speed
    local facing = state.facing or Vector3.new(0, 0, -1)
    if facing.Magnitude > 0.1 and state.flyOrientation then
        state.flyOrientation.CFrame = CFrame.lookAt(Vector3.zero, facing)
    end
end
RunService.Heartbeat:Connect(function(dt)
    for player, state in pairs(active) do
        if player.Parent then
            if state.boost then updateGround(state, dt) end
            if state.flyMode then updateFlight(state) end
        else allStop(player) active[player] = nil end
    end
end)
Players.PlayerRemoving:Connect(function(player)
    allStop(player)
    active[player] = nil
    authCache[player] = nil
    home[player] = nil
    teleportSerial[player] = nil
end)
Players.PlayerAdded:Connect(function(player)
    player.CharacterRemoving:Connect(function() allStop(player, "تغيّرت الشخصية") end)
end)
for _, player in ipairs(Players:GetPlayers()) do
    player.CharacterRemoving:Connect(function() allStop(player, "تغيّرت الشخصية") end)
end
-- Reverify regularly; membership loss immediately removes server-side flight forces.
task.spawn(function()
    while true do
        task.wait(35)
        for _, player in ipairs(Players:GetPlayers()) do
            local ok, allowed = pcall(authorize, player, true)
            if not ok then warn("[Lx] Authorization refresh error: " .. tostring(allowed)) end
        end
    end
end)
print("[Lx] v77 server ready | Discord required: " .. tostring(not STUDIO_TEST))

local function report(message, succeeded)
    label.Text = message
    label.TextColor3 = succeeded == false
        and Color3.fromRGB(255, 178, 178)
        or Color3.fromRGB(225, 247, 255)
end

local function playerFromPart(part)
    local node = part
    while node and node ~= Workspace do
        if node:IsA("Model") then
            local found = Players:GetPlayerFromCharacter(node)
            if found then return found end
        end
        node = node.Parent
    end
    return nil
end

local function aimedPlayer()
    -- Mouse targeting for computer; camera-centre ray for controller/touch.
    if UserInputService.MouseEnabled and mouse.Target then
        local mouseTarget = playerFromPart(mouse.Target)
        if mouseTarget then return mouseTarget end
    end
    local camera = Workspace.CurrentCamera
    if not camera then return nil end
    local options = RaycastParams.new()
    options.FilterType = Enum.RaycastFilterType.Exclude
    options.FilterDescendantsInstances = player.Character and {player.Character} or {}
    local ray = Workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * 120, options)
    return ray and playerFromPart(ray.Instance) or nil
end

tool.Equipped:Connect(function()
    equipped = true
    gui.Enabled = true
    report("NOVA Admin Cuffs | صوب على لاعب قريب واضغط للتقييد، وكرر للفك", true)
end)

tool.Unequipped:Connect(function()
    equipped = false
    gui.Enabled = false
end)

tool.Activated:Connect(function()
    if not equipped then return end
    local target = aimedPlayer()
    if not target or target == player then
        report("ما حددت لاعبًا. وجّه الكاميرا أو المؤشر على شخصيته.", false)
        return
    end
    report("جاري التحقق من السيرفر: " .. target.DisplayName .. " ...", true)
    actionRemote:FireServer(target.UserId)
end)

feedbackRemote.OnClientEvent:Connect(function(succeeded, message)
    if equipped and type(message) == "string" then
        report(message, succeeded == true)
    end
end)

tool.Destroying:Connect(function()
    if gui then gui:Destroy() end
end)

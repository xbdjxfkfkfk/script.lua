mkBtn("♻  Respawn Current Vehicle", function()
    local model = getCurrentVehicleModel()
    if not model then notify("Not seated in a vehicle", "off"); return end
    local hum = getHum()
    if hum then hum.Sit = false end
    task.wait(0.15)
    local seat = model:FindFirstChildWhichIsA("VehicleSeat", true)
             or model:FindFirstChildWhichIsA("Seat", true)
    if seat and hum then
        pcall(function() hum.Sit = true; seat:Sit(hum) end)
        notify("Reseated in vehicle", "on")
    else
        notify("No seat found", "off")
    end
end)

mkBtn("♻  Respawn All Nearby Vehicles", function()
    local list = getNearbyVehicles(400)
    if #list == 0 then notify("No nearby vehicles", "off"); return end
    local hum = getHum()
    if not hum then return end
    hum.Sit = false
    task.wait(0.15)
    local done = 0
    for _, model in ipairs(list) do
        local seat = model:FindFirstChildWhichIsA("VehicleSeat", true)
                  or model:FindFirstChildWhichIsA("Seat", true)
        if seat then
            pcall(function() hum.Sit = true; seat:Sit(hum) end)
            task.wait(0.08)
            hum.Sit = false
            task.wait(0.08)
            done += 1
        end
    end
    notify("Respawned " .. done .. " vehicle(s)", "on")
end)

mkBtn("📡  Recall All Nearby Vehicles", function()
    local list = getNearbyVehicles(400)
    if #list == 0 then notify("No nearby vehicles", "off"); return end
    local root = getRoot()
    if not root then return end
    local done = 0
    for _, model in ipairs(list) do
        local base = model:FindFirstChildWhichIsA("BasePart", true)
        if base then
            pcall(function()
                model:PivotTo(CFrame.new(root.Position + Vector3.new(0, 6, 0)))
            end)
            done += 1
        end
    end
    notify("Recalled " .. done .. " vehicle(s)", "on")
end)

mkBtn("🔧  Upright Vehicle", function()

local function makeToggle(page, text, callback)
	local state, setters = false, {}
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 34)
	frame.BackgroundColor3 = Color3.fromRGB(32, 30, 50)
	frame.BorderSizePixel = 0
	frame.Parent = page
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -70, 1, 0)
	lbl.Position = UDim2.new(0, 10, 0, 0)
	lbl.Text = text
	lbl.TextSize = 13
	lbl.Font = Enum.Font.Gotham
	lbl.TextColor3 = Color3.fromRGB(235, 235, 240)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.BackgroundTransparency = 1
	lbl.Parent = frame
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 50, 0, 22)
	btn.Position = UDim2.new(1, -58, 0.5, -11)
	btn.Text = "OFF"
	btn.TextSize = 11
	btn.Font = Enum.Font.GothamBold
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.BackgroundColor3 = Color3.fromRGB(75, 65, 95)
	btn.BorderSizePixel = 0
	btn.Parent = frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
	local function paint()
		btn.Text = state and "ON" or "OFF"
		btn.BackgroundColor3 = state and Color3.fromRGB(85, 205, 125) or Color3.fromRGB(75, 65, 95)
	end
	btn.MouseButton1Click:Connect(function()
		state = not state
		paint()
		callback(state)
	end)
	setters.force = function(v)
		if v == state then return end
		state = v
		paint()
		callback(state)
	end
	return frame, setters
end

local function makeSlider(page, text, min, max, default, callback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 54)
	frame.BackgroundColor3 = Color3.fromRGB(32, 30, 50)
	frame.BorderSizePixel = 0
	frame.Parent = page
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -20, 0, 22)
	lbl.Position = UDim2.new(0, 10, 0, 4)
	lbl.Text = text .. ": " .. tostring(default)
	lbl.TextSize = 13
	lbl.Font = Enum.Font.Gotham
	lbl.TextColor3 = Color3.fromRGB(235, 235, 240)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.BackgroundTransparency = 1
	lbl.Parent = frame
	local bar = Instance.new("TextButton")
	bar.Size = UDim2.new(1, -20, 0, 8)
	bar.Position = UDim2.new(0, 10, 0, 36)
	bar.BackgroundColor3 = Color3.fromRGB(58, 52, 85)
	bar.BorderSizePixel = 0
	bar.Text = ""
	bar.Parent = frame
	Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(125, 85, 255)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
	local dragging = false
	local function upd(input)
		local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local val = math.floor(min + rel * (max - min))
		fill.Size = UDim2.new(rel, 0, 1, 0)
		lbl.Text = text .. ": " .. tostring(val)
		callback(val)
	end
	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			upd(i)
		end
	end)
	UserInput.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch) then
			upd(i)
		end
	end)
	UserInput.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end


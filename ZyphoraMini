local refreshToolUI = function() end
local toolsInfo = nil
local toolScanRunning = false
local function toolKey(name)
    -- One instance per normalized name, regardless of how many templates exist.
    return name:gsub("^%s+", ""):gsub("%s+$", ""):lower()
end
local function toolInSomeoneCharacter(obj)
    if not obj:IsDescendantOf(Workspace) then return false end
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character and obj:IsDescendantOf(character) then return true end
    end
    return false
end
local function ownedToolNames()
    local owned = {}
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({backpack, LocalPlayer.Character}) do
        if holder then
            for _, item in ipairs(holder:GetChildren()) do
                if item:IsA("Tool") then owned[toolKey(item.Name)] = true end
            end
        end
    end
    return owned, backpack
end
local function copyToolOnce(source, owned)
    if not source:IsA("Tool") or toolInSomeoneCharacter(source) then
        return false, "skipped"
    end
    local name = toolKey(source.Name)
    if name == "" or owned[name] then
        return false, "duplicate"
    end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return false, "no-backpack" end
    local success, clone = pcall(function() return source:Clone() end)
    if not success or not clone then return false, "failed" end
    -- Mark client-created copies so the UI does not count them as server grants.
    pcall(function() clone:SetAttribute("NOVA_LocalCopy", true) end)
    local put = pcall(function() clone.Parent = backpack end)
    if not put or clone.Parent ~= backpack then
        pcall(function() clone:Destroy() end)
        return false, "failed"
    end
    owned[name] = true
    return true, "copied"
end
local function currentInventoryCounts()
    local keys, copiedKeys = {}, {}
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({backpack, LocalPlayer.Character}) do
        if holder then
            for _, item in ipairs(holder:GetChildren()) do
                if item:IsA("Tool") then
                    local key = toolKey(item.Name)
                    if key ~= "" then
                        keys[key] = true
                        if item:GetAttribute("NOVA_LocalCopy") == true then copiedKeys[key] = true end
                    end
                end
            end
        end
    end
    local total, localCount = 0, 0
    for _ in pairs(keys) do total = total + 1 end
    for _ in pairs(copiedKeys) do localCount = localCount + 1 end
    return total, localCount
end
local function copyVisibleTools(silent)
    if not alive then return end
    if toolScanRunning then
        if not silent then say("فحص الأدوات قيد التنفيذ؛ ستظهر النتيجة عند اكتماله", true) end
        return
    end
    local owned, backpack = ownedToolNames()
    if not backpack then
        if not silent then say("الحقيبة غير متاحة الآن", false) end
        return
    end
    toolScanRunning = true
    if not silent and toolsInfo then
        toolsInfo.Text = "جارٍ فحص الأدوات الظاهرة وتحديث القائمة..."
    end
    local copied, duplicates, failed, discovered = 0, 0, 0, 0
    local distinct = {}
    -- Scan replicated objects only. The client cannot inspect server-only tools.
    local scanSucceeded, scanError = pcall(function()
        for _, container in ipairs(TOOL_CONTAINERS) do
            for _, candidate in ipairs(container:GetDescendants()) do
                if candidate:IsA("Tool") and not toolInSomeoneCharacter(candidate) then
                    discovered = discovered + 1
                    local key = toolKey(candidate.Name)
                    if key ~= "" then distinct[key] = true end
                    local didCopy, why = copyToolOnce(candidate, owned)
                    if didCopy then copied = copied + 1
                    elseif why == "duplicate" then duplicates = duplicates + 1
                    elseif why == "failed" then failed = failed + 1 end
                end
            end
        end
    end)
    toolScanRunning = false
    local uniqueNames = 0
    for _ in pairs(distinct) do uniqueNames = uniqueNames + 1 end
    local nowOwned, nowLocal = currentInventoryCounts()
    refreshToolUI()
    if toolsInfo then
        toolsInfo.Text = "الحقيبة الآن: " .. nowOwned .. " أسماء (منها " .. nowLocal .. " نسخ محلية)"
            .. " | المكتشفة: " .. uniqueNames .. " أسماء | الجديدة: " .. copied
            .. " | المكررة: " .. duplicates .. " | تعذّر النسخ: " .. failed
        toolsInfo.Size = UDim2.new(1, 0, 0, 68)
    end
    if not scanSucceeded then
        if not silent then say("توقف الفحص بسبب خطأ في قراءة بعض الأدوات: " .. tostring(scanError):sub(1, 95), false) end
        return
    end
    if not silent or copied > 0 then
        if copied > 0 then
            say("تم نسخ " .. copied .. " أداة محليًا إلى الحقيبة؛ ظهورها لا يعني أن السيرفر منحها أو سيسمح باستخدامها", true)
        elseif discovered == 0 then
            say("لم تظهر أي أدوات قابلة للفحص عند جهازك في هذا الماب. أدوات السيرفر المخفية غير متاحة", false)
        elseif failed > 0 then
            say("تعذّر نسخ " .. failed .. " أداة. قد تكون غير قابلة للنسخ أو مقيّدة من اللعبة", false)
        else
            say("لا توجد أسماء أدوات جديدة: عندك الموجود أو سبق عرضه؛ مجموع الأسماء الظاهرة " .. uniqueNames, true)
        end
    end
end

-- When the game streams or replicates new Tools, collect each unique name once.
-- A small debounce prevents bursts of world objects from freezing the interface.
local pendingToolScan = false
local function scheduleToolScan()
    if not alive or not state.AutoTools or pendingToolScan then return end
    pendingToolScan = true
    task.delay(0.8, function()
        pendingToolScan = false
        if alive and state.AutoTools then copyVisibleTools(true) end
    end)
end
for _, container in ipairs(TOOL_CONTAINERS) do
    listen(container.DescendantAdded, function(obj)
        if obj:IsA("Tool") then scheduleToolScan() end
    end)
end

local adminToolTokens = {
    "admin", "moderator", "mod panel", "ban hammer", "banhammer",
    "kick tool", "kicktool", "owner tool", "admin wand",
    "ادمن", "أدمن", "مشرف"
}
local function visibleAdminTool(player)
    local char = player.Character
    if not char then return nil end
    -- Other players' Backpacks are normally not visible on the client.
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local lower = tool.Name:lower()
            for _, token in ipairs(adminToolTokens) do
                if lower:find(token, 1, true) then
                    return tool.Name
                end
            end
        end
    end
    return nil
end
local function getRole(player)
    if game.CreatorType == Enum.CreatorType.User then
        if player.UserId == game.CreatorId then
            return "مالك التجربة (هوية مؤكدة)", "owner"
        end
    elseif game.CreatorType == Enum.CreatorType.Group then
        local ok, rank = pcall(function() return player:GetRankInGroup(game.CreatorId) end)
        if ok and rank then
            if rank == 255 then
                return "مالك المجموعة (رتبة 255)", "owner"
            elseif rank >= 200 then
                return "رتبة قروب " .. tostring(rank) .. " (ليست إثبات أدمن)", "possible"
            end
        end
    end
    local candidate = visibleAdminTool(player)
    if candidate then
        return "أداة ظاهرة: " .. candidate .. " (اشتباه فقط)", "tool"
    end
    return "صلاحيات الأدمن غير معروفة", "unknown"
end
local function clearHighlights()
    for player, data in pairs(highlighted) do
        if data and data.Parent then data:Destroy() end
        highlighted[player] = nil
    end
end
local function refreshHighlights()
    if not state.ESP then
        clearHighlights()
        return
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and not highlighted[player] then
                highlighted[player] = make("Highlight", {
                    Name = "NovaLocalESP", Adornee = char,
                    FillColor = COLORS.purple, OutlineColor = COLORS.white,
                    FillTransparency = .66, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                }, gui)
            elseif highlighted[player] and highlighted[player].Adornee ~= char then
                highlighted[player]:Destroy()
                highlighted[player] = nil
            end
        end
    end
end

local function clearAdminVisual(player)
    local data = adminVisuals[player]
    if data then
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
        adminVisuals[player] = nil
    end
end
local function refreshAdminVision()
    if not state.AdminESP then
        for player in pairs(adminVisuals) do clearAdminVisual(player) end
        return
    end
    for player in pairs(adminVisuals) do
        if player.Parent ~= Players then clearAdminVisual(player) end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local head = char and char:FindFirstChild("Head")
            local role, kind = getRole(player)
            if kind ~= "owner" and kind ~= "possible" and kind ~= "tool" then
                clearAdminVisual(player)
            elseif not char or not head then
                clearAdminVisual(player)
            else
                local existing = adminVisuals[player]
                if existing and (existing.char ~= char or existing.kind ~= kind) then
                    clearAdminVisual(player)
                    existing = nil
                end
                if not existing then
                    local isOwner = kind == "owner"
                    local color = isOwner and COLORS.green or (kind == "tool" and Color3.fromRGB(245, 216, 105) or COLORS.orange)
                    local tag = isOwner and "👑 مالك التجربة / المجموعة" or
                        (kind == "tool" and "🔎 أداة إدارية محتملة (غير مؤكدة)" or "🛡️ رتبة قروب عالية (غير مؤكدة)")
                    local highlight = make("Highlight", {
                        Name = "NovaAdminVisionLocal", Adornee = char,
                        FillColor = color, OutlineColor = color,
                        FillTransparency = .7, OutlineTransparency = 0,
                        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                    }, gui)
                    local billboard = make("BillboardGui", {
                        Name = "NovaAdminVisionTag", Adornee = head,
                        AlwaysOnTop = true, Size = UDim2.fromOffset(300, 48),
                        StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0),
                    }, gui)
                    local label = make("TextLabel", {
                        Name = "RoleText", Size = UDim2.fromScale(1, 1),
                        Text = tag .. "\n@" .. player.Name,
                        TextColor3 = color, TextStrokeColor3 = Color3.new(0, 0, 0),
                        TextStrokeTransparency = .15, BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold, TextSize = 13,
                        TextWrapped = true,
                    }, billboard)
                    adminVisuals[player] = {char = char, kind = kind, highlight = highlight, billboard = billboard, label = label}
                end
            end
        end
    end
end

local function stopDrag()
    dragTarget = nil
end
local function attemptLocalDrag()
    if not dragTarget then return end
    if dragTarget.Parent ~= Players or dragTarget == LocalPlayer then
        stopDrag()
        return
    end
    local myRoot = localRoot()
    local theirRoot = dragTarget.Character and dragTarget.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not theirRoot then return end
    -- This is deliberately local-only and is NOT an authorized server Bring command.
    -- Most experiences instantly correct remote players' positions.
    pcall(function()
        theirRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -5)
    end)
end

local function tryTeleport(player)
    if not player or player == LocalPlayer or player.Parent ~= Players then
        say("اختر لاعبًا موجودًا أولًا", false)
        return
    end
    local fromRoot = localRoot()
    local toRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not fromRoot or not toRoot then
        say("ما قدرت أوصل لموقع اللاعب الآن", false)
        return
    end
    fromRoot.CFrame = toRoot.CFrame * CFrame.new(0, 0, 4)
    say("انتقلت قرب " .. player.Name .. " محليًا؛ قد يعيدك السيرفر", true)
end


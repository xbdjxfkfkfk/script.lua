 if not alive then return end
 alive=false;S.Aim=false;S.CarSpeed=false;S.CarFly=false
 clearESP();clearRadar();restoreVis();stopSpeed()
 for _,c in ipairs(connections) do c:Disconnect() end;table.clear(connections)
 if env.ZyphoraV21Cleanup==cleanup then env.ZyphoraV21Cleanup=nil end
 if gui.Parent then gui:Destroy() end
end

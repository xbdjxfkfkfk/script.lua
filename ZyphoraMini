-- Aimbot
local fovGui = inst("ScreenGui", {Name = "LxFOV", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 89}, PG)
local fovCircle = inst("Frame", {Name = "FOVCircle", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false}, fovGui)
round(fovCircle, 1000)
inst("UIStroke", {Color = C.accent, Thickness = 2, Transparency = 0.1}, fovCircle)

local function updateCircle()
    local cam = WS.CurrentCamera
    local enabled = S.Aim and cam
    fovCircle.Visible = enabled
    if not enabled then return end
    local radius = math.clamp(S.FOV, 10, 200)
    fovCircle.Size = UDim2.fromOffset(radius * 2, radius * 2)
    local vp = cam.ViewportSize
    fovCircle.Position = UDim2.fromOffset(vp.X * 0.5, vp.Y * 0.5)
end

local aimConnection = nil

local function StartAimbot()
    if aimConnection then aimConnection:Disconnect() aimConnection = nil end
    aimConnection = RunService.RenderStepped:Connect(function(dt)
        if not alive or not S.Aim then return end
        updateCircle()
        local cam = WS.CurrentCamera
        if not cam then return end
        local r = root()
        if not r then return end
        local vp = cam.ViewportSize
        local center = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
        local best, bestDist = nil, math.huge
        for _, e in ipairs(cache) do
            if e.model.Parent and e.part.Parent and living(e.model) and lizard(e.model) then
                local head = e.model:FindFirstChild("Head", true) or e.part
                if head and head:IsA("BasePart") then
                    local worldDist = (head.Position - r.Position).Magnitude
                    if worldDist <= S.AimRange then
                        local point, onScreen = cam:WorldToViewportPoint(head.Position)
                        if onScreen and point.Z > 0 then
                            local pixelDist = (Vector2.new(point.X, point.Y) - center).Magnitude
                            if pixelDist <= S.FOV and pixelDist < bestDist then best = head bestDist = pixelDist end
                        end
                    end
                end
            end
        end
        if best then
            local desired = CFrame.lookAt(cam.CFrame.Position, best.Position)
            local alpha = 1 - math.exp(-math.clamp(S.AimSmooth / 10, 0.02, 1) * 30 * math.min(dt, 0.1))
            cam.CFrame = cam.CFrame:Lerp(desired, math.clamp(alpha, 0, 1))
        end
    end)
end

local function StopAimbot()
    S.Aim = false
    if aimConnection then aimConnection:Disconnect() aimConnection = nil end
    fovCircle.Visible = false
end

-- Car Speed
local savedSeat = nil
local savedMaxSpeed = nil
local savedTorque = nil

local function clearCarBoost()
    if savedSeat and savedSeat.Parent then
        pcall(function()
            if savedMaxSpeed then savedSeat.MaxSpeed = savedMaxSpeed end
            if savedTorque then savedSeat.Torque = savedTorque end
        end)
    end
    savedSeat = nil savedMaxSpeed = nil savedTorque = nil
end

local function updateCarSpeed()
    if not S.CarSpeed then clearCarBoost() return end
    local h = hum()
    if not h or not h.SeatPart then clearCarBoost() return end
    local seat = h.SeatPart
    if not seat:IsA("VehicleSeat") then return end
    if savedSeat ~= seat then
        clearCarBoost()
        savedSeat = seat
        savedMaxSpeed = seat.MaxSpeed
        savedTorque = seat.Torque
    end
    local target = math.clamp(S.CarTarget, 20, 500)
    pcall(function()
        seat.MaxSpeed = target
        seat.Torque = math.max(savedTorque or 0, math.min(20000, target * 50))
    end)
end

-- Car Fly
local flyBody = nil
local flyVelocity = nil
local flyOrientation = nil
local flyAttachment = nil

local function stopCarFly()
    if flyVelocity then pcall(function() flyVelocity:Destroy() end) end
    if flyOrientation then pcall(function() flyOrientation:Destroy() end) end
    if flyAttachment then pcall(function() flyAttachment:Destroy() end) end
    flyVelocity = nil flyOrientation = nil flyAttachment = nil flyBody = nil
end

local function updateCarFly()
    if not S.CarFly then stopCarFly() return end
    local h = hum()
    if not h or not h.SeatPart then stopCarFly() return end
    local seat = h.SeatPart
    if not seat:IsA("VehicleSeat") then return end
    local body = seat.AssemblyRootPart or seat
    if not body or body.Anchored then return end
    if body ~= flyBody or not flyVelocity or not flyVelocity.Parent then
        stopCarFly()
        flyBody = body
        flyAttachment = Instance.new("Attachment")
        flyAttachment.Name = "LxFly"
        flyAttachment.Parent = body
        flyVelocity = Instance.new("LinearVelocity")
        flyVelocity.Name = "LxFly"
        flyVelocity.Attachment0 = flyAttachment
        flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
        flyVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        flyVelocity.MaxForce = math.max(100000, body.AssemblyMass * 3000)
        flyVelocity.Parent = body
        flyOrientation = Instance.new("AlignOrientation")
        flyOrientation.Name = "LxFly"
        flyOrientation.Attachment0 = flyAttachment
        flyOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        flyOrientation.Responsiveness = 15
        flyOrientation.MaxTorque = math.max(100000, body.AssemblyMass * 3000)
        flyOrientation.Parent = body
    end
    local cam = WS.CurrentCamera
    if not cam then return end
    local look = cam.CFrame.LookVector
    local forward = Vector3.new(look.X, 0, look.Z)
    if forward.Magnitude < 0.01 then forward = Vector3.new(0, 0, -1) end
    forward = forward.Unit
    local side = Vector3.new(-forward.Z, 0, forward.X)
    local input = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then input += forward end
    if UIS:IsKeyDown(Enum.KeyCode.S) then input -= forward end
    if UIS:IsKeyDown(Enum.KeyCode.D) then input += side end
    if UIS:IsKeyDown(Enum.KeyCode.A) then input -= side end
    if UIS:IsKeyDown(Enum.KeyCode.E) then input += Vector3.yAxis end
    if UIS:IsKeyDown(Enum.KeyCode.Q) then input -= Vector3.yAxis end
    local speed = math.clamp(S.FlySpeed, 20, 400)
    flyVelocity.VectorVelocity = input.Magnitude > 0 and input.Unit * speed or Vector3.zero
    flyOrientation.CFrame = CFrame.lookAt(Vector3.zero, forward)
end

-- Player Fly
local charFly = {root = nil, humanoid = nil, attachment = nil, velocity = nil, orientation = nil}

charFly.stop = function()
    local cf = charFly
    if cf.velocity then pcall(function() cf.velocity:Destroy() end) end
    if cf.orientation then pcall(function() cf.orientation:Destroy() end) end
    if cf.attachment then pcall(function() cf.attachment:Destroy() end) end
    cf.velocity = nil cf.orientation = nil cf.attachment = nil cf.root = nil
    if cf.humanoid and cf.humanoid.Parent then pcall(function() cf.humanoid.PlatformStand = false end) end
    cf.humanoid = nil
end

charFly.update = function()
    if not S.PlayerFly then return end
    local h = hum()
    local r = root()
    if not h or not r or h.Health <= 0 then if charFly.root then charFly.stop() end return end
    if h.SeatPart then if charFly.root then charFly.stop() end return end
    if charFly.root ~= r or not charFly.velocity or not charFly.velocity.Parent then
        charFly.stop()
        charFly.root = r
        charFly.humanoid = h
        local a = Instance.new("Attachment")
        a.Name = "LxFly"
        a.Parent = r
        charFly.attachment = a
        local v = Instance.new("LinearVelocity")
        v.Name = "LxFly"
        v.Attachment0 = a
        v.RelativeTo = Enum.ActuatorRelativeTo.World
        v.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        v.MaxForce = math.max(50000, r.AssemblyMass * 3000)
        v.VectorVelocity = Vector3.zero
        v.Parent = r
        charFly.velocity = v
        local o = Instance.new("AlignOrientation")
        o.Name = "LxFly"
        o.Attachment0 = a
        o.Mode = Enum.OrientationAlignmentMode.OneAttachment
        o.Responsiveness = 15
        o.MaxTorque = math.max(50000, r.AssemblyMass * 3000)
        o.Parent = r
        charFly.orientation = o
        h.PlatformStand = true
    end
    local cam = WS.CurrentCamera
    if not cam then return end
    local forward = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
    if forward.Magnitude < 0.01 then forward = Vector3.new(0, 0, -1) end
    forward = forward.Unit
    local right = Vector3.new(-forward.Z, 0, forward.X)
    local vector = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then vector += forward end
    if UIS:IsKeyDown(Enum.KeyCode.S) then vector -= forward end
    if UIS:IsKeyDown(Enum.KeyCode.D) then vector += right end
    if UIS:IsKeyDown(Enum.KeyCode.A) then vector -= right end
    if UIS:IsKeyDown(Enum.KeyCode.E) then vector += Vector3.yAxis end
    if UIS:IsKeyDown(Enum.KeyCode.Q) then vector -= Vector3.yAxis end
    local speed = math.clamp(S.PlayerFlySpeed, 15, 200)
    charFly.velocity.VectorVelocity = vector.Magnitude > 0 and vector.Unit * speed or Vector3.zero
    charFly.orientation.CFrame = CFrame.lookAt(Vector3.zero, forward)
end

-- Noclip
local noclipConn = nil

local function updateNoclip()
    if S.Noclip then
        if not noclipConn then
            noclipConn = RunService.Stepped:Connect(function()
                local char = LP.Character
                if char then
                    for _, v in pairs(char:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                end
            end)
            table.insert(conns, noclipConn)
        end
    else
        if noclipConn then noclipConn:Disconnect() noclipConn = nil end
        local char = LP.Character
        if char then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = true end
            end
        end
    end
end


-- Rankings are never called inside render or repeated every frame.
local function queryRank(p)
    if game.CreatorType~=Enum.CreatorType.Group then return end
    if ranks[p] and (ranks[p].pending or (os.clock()-ranks[p].at)<60) then return end
    ranks[p]={pending=true,at=os.clock()}
    task.spawn(function()
        local ok,result=pcall(function() return p:GetRankInGroup(game.CreatorId) end)
        if not active or p.Parent~=Players then return end
        ranks[p]={pending=false,at=os.clock(),rank=ok and result or nil}
        -- Updated automatically by the lightweight 5-second refresh loop.
    end)
end

local function getObservedTools(p)
    local container=p.Character
    local names={}
    if container then
        for _,obj in ipairs(container:GetChildren()) do
            if obj:IsA("Tool") then
                local n=string.lower(obj.Name)
                if n=="kick" or n=="ban" or n=="admin" or n=="moderator" then
                    table.insert(names,obj.Name)
                end
            end
        end
    end
    -- Other players' Backpack contents typically do not replicate to this client.
    return #names>0 and table.concat(names,", ") or nil
end

local function inspectPlayer(p)
    if game.CreatorType==Enum.CreatorType.User and p.UserId==game.CreatorId then
        return 1,"👑 مالك التجربة","ملكية مؤكدة من CreatorId؛ ليست إثباتًا لصلاحية Kick داخل الماب"
    end
    if game.CreatorType==Enum.CreatorType.Group then
        queryRank(p)
        local x=ranks[p]
        if x and x.rank==255 then
            return 1,"👑 مالك القروب","رتبة القروب 255؛ صلاحيات الأدمن داخل الماب غير مثبتة"
        elseif x and x.rank and x.rank>=200 then
            return 2,"🟡 رتبة قروب مرتفعة","رتبة القروب: "..tostring(x.rank).." — لا تثبت أدمن الماب"
        end
    end
    local attrNames={"IsAdmin","Admin","IsModerator","Moderator","AdminLevel","AdminRank","IsOwner"}
    for _,key in ipairs(attrNames) do
        local value=p:GetAttribute(key)
        if value~=nil and value~=false and value~=0 and value~="" then
            return 2,"🟡 إشارة إدارية معلنة","Attribute: "..key.."="..tostring(value).."؛ غير موثّقة من نظام الصلاحيات"
        end
    end
    local role=p:GetAttribute("Role")
    if type(role)=="string" then
        local lower=string.lower(role)
        if lower=="admin" or lower=="moderator" or lower=="owner" then
            return 2,"🟡 دور معلن","Role="..role.."؛ لا يثبت صلاحيات الأوامر"
        end
    end
    local tool=getObservedTools(p)
    if tool then
        return 3,"⚪ مؤشر أداة","اسم أداة ظاهر: "..tool.." — ليس دليلًا على الأدمن"
    end
    return 4,"⚪ غير معروف","ما فيه دليل ظاهر يثبت صلاحية إدارية"
end

local function clearElements(parent, kind)
    for _,child in ipairs(parent:GetChildren()) do
        if child:IsA(kind) then child:Destroy() end
    end
end
local lastScan={owners=0,signals=0,tools=0,unknown=0}
refreshRows=function()
    if not active then return end
    clearElements(playerList,"Frame")
    local all=Players:GetPlayers()
    local results={}
    local totals={owners=0,signals=0,tools=0,unknown=0}
    for _,p in ipairs(all) do
        local score,status,reason=inspectPlayer(p)
        if score==1 then totals.owners=totals.owners+1
        elseif score==2 then totals.signals=totals.signals+1
        elseif score==3 then totals.tools=totals.tools+1
        else totals.unknown=totals.unknown+1 end
        table.insert(results,{p=p,score=score,status=status,reason=reason})
    end
    lastScan=totals
    table.sort(results,function(a,b)
        if a.score==b.score then return a.p.Name:lower()<b.p.Name:lower() end
        return a.score<b.score
    end)
    textLabel(playerList,"المتصلون: "..tostring(#all).."  |  مالك/قروب: "..totals.owners.."  |  إشارات: "..totals.signals,30,12,C.muted)
    for _,it in ipairs(results) do
        local f=create("Frame",playerList,{Size=UDim2.new(1,-4,0,77),BackgroundColor3=C.panel,BorderSizePixel=0})
        corner(f,8)
        create("TextLabel",f,{
            Size=UDim2.new(1,-16,0,22),Position=UDim2.fromOffset(8,4),
            BackgroundTransparency=1,Text=it.p.Name.." ["..it.p.UserId.."]",TextSize=13,
            Font=Enum.Font.GothamBold,TextColor3=C.white,TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd
        })
        create("TextLabel",f,{
            Size=UDim2.new(1,-16,0,19),Position=UDim2.fromOffset(8,26),
            BackgroundTransparency=1,Text=it.status,TextSize=12,
            Font=Enum.Font.GothamSemibold,TextColor3=(it.score==1 and C.good) or (it.score==2 and C.warn) or C.muted,
            TextXAlignment=Enum.TextXAlignment.Left
        })
        create("TextLabel",f,{
            Size=UDim2.new(1,-16,0,29),Position=UDim2.fromOffset(8,46),
            BackgroundTransparency=1,Text=it.reason,TextSize=10,TextWrapped=true,
            TextColor3=C.muted,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left
        })
    end
end

local function playerCharacter()
    local character=LP.Character
    return character,character and character:FindFirstChildOfClass("Humanoid"),character and character:FindFirstChild("HumanoidRootPart")
end
local function restoreTransparency()
    for part,value in pairs(savedTransparency) do
        if part and part.Parent then pcall(function() part.LocalTransparencyModifier=value end) end
        savedTransparency[part]=nil
    end
end
local function restoreCollision()
    for part,value in pairs(savedCollision) do
        if part and part.Parent then pcall(function() part.CanCollide=value end) end
        savedCollision[part]=nil
    end
end
local function clearHighlights()
    for p,h in pairs(highlights) do
        if h then h:Destroy() end
        highlights[p]=nil
    end
end
stopFly=function()
    if flyVelocity then flyVelocity:Destroy() end
    if flyAttachment then flyAttachment:Destroy() end
    flyVelocity=nil; flyAttachment=nil; flyingRoot=nil
    local _,h=playerCharacter()
    if h and originalPlatformStand~=nil then h.PlatformStand=originalPlatformStand end
    originalPlatformStand=nil
    upHeld=false;downHeld=false
end
local function startFly()
    local _,h,r=playerCharacter()
    if not h or not r then return end
    stopFly()
    originalPlatformStand=h.PlatformStand
    h.PlatformStand=true
    flyAttachment=create("Attachment",r,{Name="NovaFlyAttachment"})
    flyVelocity=create("LinearVelocity",r,{
        Name="NovaFlyVelocity",Attachment0=flyAttachment,
        RelativeTo=Enum.ActuatorRelativeTo.World,
        MaxForce=1000000,VectorVelocity=Vector3.zero
    })
    flyingRoot=r
end
local function setLight(enabled)
    if enabled then
        if not lightBackup then
            lightBackup={Brightness=Lighting.Brightness,ClockTime=Lighting.ClockTime,Ambient=Lighting.Ambient,OutdoorAmbient=Lighting.OutdoorAmbient,FogEnd=Lighting.FogEnd}
        end
        Lighting.Brightness=3;Lighting.ClockTime=14
        Lighting.Ambient=Color3.fromRGB(200,200,210)
        Lighting.OutdoorAmbient=Color3.fromRGB(200,200,210)
        Lighting.FogEnd=100000
    elseif lightBackup then
        for k,v in pairs(lightBackup) do Lighting[k]=v end
        lightBackup=nil
    end
end
syncLocal=function()
    local character,h,r=playerCharacter()
    if not character then return end
    if S.speed and h then
        if originalWalkSpeed==nil then originalWalkSpeed=h.WalkSpeed end
        h.WalkSpeed=S.speedValue
    elseif h and originalWalkSpeed~=nil then
        h.WalkSpeed=originalWalkSpeed;originalWalkSpeed=nil
    end
    if S.ghost then
        for _,part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name~="HumanoidRootPart" then
                if savedTransparency[part]==nil then savedTransparency[part]=part.LocalTransparencyModifier end
                part.LocalTransparencyModifier=1
            end
        end
    else restoreTransparency() end
    if S.noclip then
        for _,part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if savedCollision[part]==nil then savedCollision[part]=part.CanCollide end
                part.CanCollide=false
            end
        end
    else restoreCollision() end
    if S.fly then
        if not flyVelocity or not flyVelocity.Parent or flyingRoot~=r then startFly() end
        if flyVelocity and h then
            local horizontal=h.MoveDirection*S.flyValue
            local vertical=0
            if upHeld or UIS:IsKeyDown(Enum.KeyCode.E) or UIS:IsKeyDown(Enum.KeyCode.Space) then vertical=vertical+S.flyValue end
            if downHeld or UIS:IsKeyDown(Enum.KeyCode.Q) then vertical=vertical-S.flyValue end
            flyVelocity.VectorVelocity=horizontal+Vector3.new(0,vertical,0)
        end
    elseif flyVelocity then stopFly() end
    if S.esp then
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LP and p.Character then
                if not highlights[p] or highlights[p].Adornee~=p.Character then
                    if highlights[p] then highlights[p]:Destroy() end
                    highlights[p]=create("Highlight",gui,{
                        Name="NovaLocalHighlight",Adornee=p.Character,FillTransparency=0.8,
                        OutlineColor=C.purple,FillColor=C.purple,
                        DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                    })
                end
            end
        end
        for p,h1 in pairs(highlights) do
            if p.Parent~=Players or not p.Character then h1:Destroy();highlights[p]=nil end
        end
    elseif next(highlights) then clearHighlights() end
end


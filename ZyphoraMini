local carFlyBv, carFlyThread
mkBtn("🚗  Car Fly (manual)", function(b, bar)
    S.CarFly = not S.CarFly
    b.Text = "🚗  Car Fly: " .. (S.CarFly and "ON" or "OFF")
    bar.BackgroundColor3 = S.CarFly and C.on or C.accent
    b.TextColor3 = S.CarFly and C.on or C.text

    if not S.CarFly then
        if carFlyThread then task.cancel(carFlyThread); carFlyThread = nil end
        if carFlyBv then carFlyBv:Destroy(); carFlyBv = nil end
        notify("Car Fly OFF", "off")
        return
    end

    local model = getCurrentVehicleModel()
    if not model then
        notify("Not seated in a vehicle", "off")
        S.CarFly = false
        b.Text = "🚗  Car Fly: OFF"
        bar.BackgroundColor3 = C.accent
        return
    end
    local root = model:FindFirstChildWhichIsA("BasePart", true)
    if not root then
        notify("No vehicle body", "off")
        S.CarFly = false
        return
    end

    carFlyBv = Instance.new("BodyVelocity")
    carFlyBv.Name = "ZyCarFlyBv"
    carFlyBv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    carFlyBv.Velocity = Vector3.zero
    carFlyBv.Parent = root

    carFlyThread = task.spawn(function()
        local target = Vector3.zero
        while S.CarFly and carFlyBv and carFlyBv.Parent do
            local cam = workspace.CurrentCamera
            local dir = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
            if UIS:IsKeyDown(Enum.KeyCode.Q) then dir += cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.E) then dir -= cam.CFrame.RightVector end

            local targetV = dir.Magnitude > 0 and dir.Unit * S.CarFlySpeed or Vector3.zero
            target = target:Lerp(targetV, math.clamp(S.FlySmooth, 0.05, 1))
            pcall(function() carFlyBv.Velocity = target end)
            task.wait()
        end
    end)
    notify("Car Fly ON — WASD + Space/Ctrl", "on")
end)

mkSlider("Car fly speed", S.CarFlySpeed, 20, 600, 20, function(v) S.CarFlySpeed = v end)


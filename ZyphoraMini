-- Cleanup
local function cleanup()
    if not alive then return end

    alive = false
    S.CarFly = false

    clearESP()
    clearWildlife()
    restoreVisibility()

    if S.Speed then
        setSpeed(false)
    end

    for _, con in ipairs(connections) do
        con:Disconnect()
    end
    table.clear(connections)

    if env.ZyphoraV17Cleanup == cleanup then
        env.ZyphoraV17Cleanup = nil
    end

    if GUI.Parent then
        GUI:Destroy()
    end
end


local refreshToolUI = function() end
local toolsInfo = nil
local toolScanRunning = false
local toolCache = {} -- Only populated by a user-triggered scan. Search never traverses the map.
local function toolKey(name)
    -- One instance per normalized name, regardless of how many templates exist.
    return name:gsub("^%s+", ""):gsub("%s+$", ""):lower()
end
local function toolInSomeoneCharacter(obj)
    if not obj:IsDescendantOf(Workspace) then return false end
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character and obj:IsDescendantOf(character) then return true end
    end
    return false
end
local function ownedToolNames()
    local owned = {}
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({backpack, LocalPlayer.Character}) do
        if holder then
            for _, item in ipairs(holder:GetChildren()) do
                if item:IsA("Tool") then owned[toolKey(item.Name)] = true end
            end
        end
    end
    return owned, backpack
end
local function copyToolOnce(source, owned)
    if not source:IsA("Tool") or toolInSomeoneCharacter(source) then
        return false, "skipped"
    end
    local name = toolKey(source.Name)
    if name == "" or owned[name] then
        return false, "duplicate"
    end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return false, "no-backpack" end
    local success, clone = pcall(function() return source:Clone() end)
    if not success or not clone then return false, "failed" end
    -- Mark client-created copies so the UI does not count them as server grants.
    pcall(function() clone:SetAttribute("NOVA_LocalCopy", true) end)
    local put = pcall(function() clone.Parent = backpack end)
    if not put or clone.Parent ~= backpack then
        pcall(function() clone:Destroy() end)
        return false, "failed"
    end
    owned[name] = true
    return true, "copied"
end
local function currentInventoryCounts()
    local keys, copiedKeys = {}, {}
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({backpack, LocalPlayer.Character}) do
        if holder then
            for _, item in ipairs(holder:GetChildren()) do
                if item:IsA("Tool") then
                    local key = toolKey(item.Name)
                    if key ~= "" then
                        keys[key] = true
                        if item:GetAttribute("NOVA_LocalCopy") == true then copiedKeys[key] = true end
                    end
                end
            end
        end
    end
    local total, localCount = 0, 0
    for _ in pairs(keys) do total = total + 1 end
    for _ in pairs(copiedKeys) do localCount = localCount + 1 end
    return total, localCount
end
local function copyVisibleTools(silent)
    if not alive then return end
    if toolScanRunning then
        if not silent then say("فحص الأدوات جارٍ بالفعل. لا حاجة لتشغيله مرتين", false) end
        return
    end
    local owned, backpack = ownedToolNames()
    if not backpack then
        if not silent then say("الحقيبة لم تجهز بعد", false) end
        return
    end
    toolScanRunning = true
    if toolsInfo then toolsInfo.Text = "جارٍ فحص الأدوات على دفعات لتقليل التعليق..." end
    task.spawn(function()
        local copied, duplicates, failed, discovered = 0, 0, 0, 0
        local visited, capped, maxVisited, copyLimit = 0, false, 12000, 12
        local distinct = {}
        local scanSucceeded, scanError = pcall(function()
            for _, container in ipairs(TOOL_CONTAINERS) do
                if not alive or capped then break end
                -- This allocation happens only when user presses Scan or enables Auto.
                for _, candidate in ipairs(container:GetDescendants()) do
                    if not alive then break end
                    visited = visited + 1
                    if visited > maxVisited then capped = true; break end
                    if visited % 180 == 0 then task.wait() end
                    if candidate:IsA("Tool") and not toolInSomeoneCharacter(candidate) then
                        discovered = discovered + 1
                        local key = toolKey(candidate.Name)
                        if key ~= "" then
                            distinct[key] = true
                            toolCache[key] = candidate.Name
                        end
                        if copied < copyLimit then
                            local didCopy, why = copyToolOnce(candidate, owned)
                            if didCopy then copied = copied + 1
                            elseif why == "duplicate" then duplicates = duplicates + 1
                            elseif why == "failed" then failed = failed + 1 end
                        end
                    end
                end
            end
        end)
        toolScanRunning = false
        if not alive then return end
        local uniqueNames = 0
        for _ in pairs(distinct) do uniqueNames = uniqueNames + 1 end
        local nowOwned, nowLocal = currentInventoryCounts()
        refreshToolUI()
        if toolsInfo then
            toolsInfo.Text = "الحقيبة: " .. nowOwned .. " أسماء (" .. nowLocal .. " نسخ محلية)"
                .. " | المرصودة: " .. uniqueNames .. " | المنسوخة: " .. copied
                .. " | فشل النسخ: " .. failed
                .. (capped and " | تم إيقاف الفحص عند حد الأمان" or "")
            toolsInfo.Size = UDim2.new(1, 0, 0, 80)
        end
        if not scanSucceeded then
            if not silent then say("خطأ أثناء فحص الأدوات: " .. tostring(scanError):sub(1, 90), false) end
        elseif copied > 0 and not silent then
            say("نُسخت " .. copied .. " أداة محليًا فقط؛ السيرفر لم يمنح صلاحيات باستخدامها", true)
        elseif not silent then
            say("اكتمل فحص " .. math.min(visited, maxVisited) .. " عنصر على دفعات" .. (capped and " (فحص محدود للأداء)" or ""), true)
        end
    end)
end

-- Auto-scan is opt-in. No global DescendantAdded listener while disabled.
local pendingToolScan = false
local toolWatchConnections = {}
local lastToolScan = 0
local function scheduleToolScan()
    if not alive or not state.AutoTools or pendingToolScan then return end
    pendingToolScan = true
    local delaySeconds = math.max(2, 10 - (os.clock() - lastToolScan))
    task.delay(delaySeconds, function()
        pendingToolScan = false
        if alive and state.AutoTools and not toolScanRunning then
            lastToolScan = os.clock()
            copyVisibleTools(true)
        end
    end)
end
local function setToolWatching(enabled)
    for _, conn in ipairs(toolWatchConnections) do conn:Disconnect() end
    toolWatchConnections = {}
    if not enabled then return end
    for _, container in ipairs(TOOL_CONTAINERS) do
        local conn = container.DescendantAdded:Connect(function(obj)
            if alive and state.AutoTools and obj:IsA("Tool") then scheduleToolScan() end
        end)
        table.insert(toolWatchConnections, conn)
    end
end

local adminToolTokens = {
    "admin", "moderator", "mod panel", "ban hammer", "banhammer",
    "kick tool", "kicktool", "owner tool", "admin wand",
    "ادمن", "أدمن", "مشرف"
}
local function visibleAdminTool(player)
    local char = player.Character
    if not char then return nil end
    -- Other players' Backpacks are normally not visible on the client.
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local lower = tool.Name:lower()
            for _, token in ipairs(adminToolTokens) do
                if lower:find(token, 1, true) then
                    return tool.Name
                end
            end
        end
    end
    return nil
end
local refreshAdminVision -- forward declaration for asynchronous group-rank callbacks
local groupRankCache = {}
local rankQueue, rankWorkerRunning = {}, false
local function cachedGroupRank(player)
    local entry = groupRankCache[player.UserId]
    if entry then return entry.rank, entry.ready end
    groupRankCache[player.UserId] = {rank = nil, ready = false}
    table.insert(rankQueue, player)
    if not rankWorkerRunning then
        rankWorkerRunning = true
        task.spawn(function()
            while alive and #rankQueue > 0 do
                local p = table.remove(rankQueue, 1)
                if p.Parent == Players then
                    local ok, rank = pcall(function() return p:GetRankInGroup(game.CreatorId) end)
                    groupRankCache[p.UserId] = {rank = ok and rank or -1, ready = true}
                    if state.AdminESP and refreshAdminVision then task.defer(refreshAdminVision) end
                end
                task.wait(.12)
            end
            rankWorkerRunning = false
        end)
    end
    return nil, false
end
local function getRole(player)
    if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
        return "ناشر التجربة (هوية مؤكدة، لا تثبت رتبة أدمن)", "owner"
    end
    if game.CreatorType == Enum.CreatorType.Group then
        local rank, ready = cachedGroupRank(player)
        if not ready then
            return "رتبة المجموعة قيد الفحص", "pending"
        end
        if rank == -1 then
            return "تعذر التحقق من رتبة القروب", "unknown"
        elseif rank == 255 then
            return "رتبة المجموعة 255 (دليل ملكية، ليس تصريح أدمن)", "owner"
        elseif rank and rank >= 200 then
            return "رتبة قروب " .. tostring(rank) .. " (إشارة وليست إثبات أدمن)", "possible"
        end
    end
    local candidate = visibleAdminTool(player)
    if candidate then
        return "أداة ظاهرة: " .. candidate .. " (مؤشر فقط)", "tool"
    end
    return "لا يوجد دليل عام على الصلاحية", "unknown"
end


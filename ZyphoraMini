local AutoAimLizard = false
local CarSpeedEnabled = false
local CarMultiplier = 2
local LizardTargetName = ""
local addonConnections = {}

local function addonBind(signal, callback)
    local con = signal:Connect(callback)
    table.insert(addonConnections, con)
    return con
end

local function getLizardRoot(model)
    return model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function findLizards()
    local results = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and isWildlife(obj) then
            local root = getLizardRoot(obj)

            if root then
                table.insert(results, {
                    Model = obj,
                    Root = root
                })
            end
        end
    end

    return results
end

local function nearestLizard(nameFilter)
    local myRoot = getRoot()
    if not myRoot then return nil end

    local nearest = nil
    local bestDistance = math.huge

    for _, entry in ipairs(findLizards()) do
        local name = string.lower(entry.Model.Name)

        local matches = nameFilter == ""
            or string.find(
                name,
                string.lower(nameFilter),
                1,
                true
            ) ~= nil

        if matches then
            local distance = (
                entry.Root.Position - myRoot.Position
            ).Magnitude

            if distance < bestDistance then
                bestDistance = distance
                nearest = entry
            end
        end
    end

    return nearest
end

local function readValue(model, names)
    for _, name in ipairs(names) do
        local attr = model:GetAttribute(name)

        if attr ~= nil then
            return attr
        end

        local child = model:FindFirstChild(name, true)

        if child and child:IsA("ValueBase") then
            return child.Value
        end
    end

    return nil
end

local function rarityColor(rarity)
    local value = string.lower(tostring(rarity or ""))

    if value:find("خرافي") or value:find("mythic") then
        return Color3.fromRGB(255, 55, 230)
    elseif value:find("ذهبي") or value:find("legendary") then
        return Color3.fromRGB(255, 196, 45)
    elseif value:find("بنفسجي") or value:find("epic") then
        return Color3.fromRGB(165, 100, 255)
    elseif value:find("أزرق") or value:find("rare") then
        return Color3.fromRGB(50, 155, 255)
    elseif value:find("أخضر") or value:find("uncommon") then
        return Color3.fromRGB(65, 220, 125)
    end

    return Color3.fromRGB(220, 225, 230)
end

local function lizardInfo(model)
    local rarity = readValue(model, {
        "Rarity", "Tier", "ندرة"
    })

    local power = readValue(model, {
        "Power", "Strength", "قوة"
    })

    local size = readValue(model, {
        "Size", "Scale", "حجم"
    })

    return {
        Rarity = rarity or "غير معروف",
        Power = power or "غير متاح",
        Size = size or "غير متاح"
    }
end


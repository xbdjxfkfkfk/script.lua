            hum.PlatformStand = false
            local bv = Instance.new("BodyVelocity")
            bv.Name = "STRQ_Fly"
            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bv.Velocity = Vector3.zero
            bv.Parent = hrp
            local gyro = Instance.new("BodyGyro")
            gyro.Name = "STRQ_Gyro"
            gyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            gyro.P = 9000
            gyro.D = 120
            gyro.Parent = hrp
        else
            local bv = hrp:FindFirstChild("STRQ_Fly")
            local gy = hrp:FindFirstChild("STRQ_Gyro")
            if bv then bv:Destroy() end
            if gy then gy:Destroy() end
            hum.PlatformStand = false
        end
    end)

    makeToggle(page, "👻 مرور عبر الجدران (Noclip)", function(on)
        State.Noclip = on
    end)

    makeToggle(page, "🦘 قفز لا نهائي", function(on)
        State.InfJump = on
    end)

    UserInput.JumpRequest:Connect(function()
        if State.InfJump then
            local c = getChar()
            if c then
                local h = c:FindFirstChildOfClass("Humanoid")
                if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
            end
        end
    end)
end

--══════════════ حلقة الطيران + النوكليب ══════════════--
RunService.Heartbeat:Connect(function(dt)
    -- طيران
    if State.Fly then
        local c = getChar()
        if c then
            local hrp = c.HumanoidRootPart
            local hum = c:FindFirstChildOfClass("Humanoid")
            local bv = hrp:FindFirstChild("STRQ_Fly")
            local gyro = hrp:FindFirstChild("STRQ_Gyro")
            if bv and gyro then
                local cam = workspace.CurrentCamera.CFrame
                local move = Vector3.zero
                if UserInput:IsKeyDown(Enum.KeyCode.W) then move = move + cam.LookVector end
                if UserInput:IsKeyDown(Enum.KeyCode.S) then move = move - cam.LookVector end
                if UserInput:IsKeyDown(Enum.KeyCode.A) then move = move - cam.RightVector end
                if UserInput:IsKeyDown(Enum.KeyCode.D) then move = move + cam.RightVector end
                if UserInput:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0,1,0) end
                if UserInput:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0,1,0) end
                if move.Magnitude > 0 then
                    move = move.Unit * State.FlySpeed
                end
                bv.Velocity = move
                gyro.CFrame = CFrame.new(hrp.Position, hrp.Position + cam.LookVector)
            end
        end
    end
    -- نوكليب
    if State.Noclip then
        local c = getChar()
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
            end
        end
    end
    -- سرعة دائمة
    local c = getChar()
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h and h.WalkSpeed ~= State.Speed and State.Speed >= 16 then
            pcall(function() h.WalkSpeed = State.Speed end)
        end
    end
end)


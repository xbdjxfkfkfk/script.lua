local function getModelMetadata(model, keys)
    for _, key in ipairs(keys) do
        local v = model:GetAttribute(key)
        if v ~= nil then return v end
        local sub = model:FindFirstChild(key, true)
        if sub and sub:IsA("ValueBase") then return sub.Value end
    end
    return nil
end
local function isLiveLizard(model)
    if not model or not model:IsA("Model") or not model:IsDescendantOf(Workspace) then return false end
    local tagged = CollectionService:HasTag(model, "LxLizard") or CollectionService:HasTag(model, "Lizard")
        or CollectionService:HasTag(model, "Dhab")
    if not tagged then return false end
    if model:GetAttribute("LxIsDecoration") == true or model:GetAttribute("IsCaged") == true then return false end
    if not basePart(model) then return false end
    if model:FindFirstChildWhichIsA("VehicleSeat", true) then return false end
    local parent = model
    while parent and parent ~= Workspace do
        if parent:IsA("Model") then
            if Players:GetPlayerFromCharacter(parent) or CollectionService:HasTag(parent, "LxVehicle")
                or parent:GetAttribute("LxIsDecoration") == true then return false end
        end
        parent = parent.Parent
    end
    local h = model:FindFirstChildOfClass("Humanoid")
    if h and h.Health <= 0 then return false end
    if model:GetAttribute("Dead") == true or model:GetAttribute("Collected") == true then return false end
    -- Explicit tags are required. This prevents classifying cars/decor by their names alone.
    return true
end
local function registerLizard(model)

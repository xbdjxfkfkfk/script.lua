-- Select and spectate; neither feature changes other players.
local selectedId=me.UserId
local watchedId
local function getSelected()
    for _,p in ipairs(Players:GetPlayers()) do
        if p.UserId==selectedId then return p end
    end
    return nil
end
local function restoreCamera()
    watchedId=nil
    local hum=me.Character and me.Character:FindFirstChildOfClass("Humanoid")
    if hum and workspace.CurrentCamera then
        workspace.CurrentCamera.CameraType=Enum.CameraType.Custom
        workspace.CurrentCamera.CameraSubject=hum
    end
end
local function spectate()
    local p=getSelected()
    local hum=p and p.Character and p.Character:FindFirstChildOfClass("Humanoid")
    local cam=workspace.CurrentCamera
    if not (p and hum and cam) then notice("الشخصية المختارة غير جاهزة") return end
    cam.CameraType=Enum.CameraType.Custom
    cam.CameraSubject=hum
    watchedId=p.UserId
    notice("مشاهدة: "..p.DisplayName.." (الصوت يخضع لنظام Roblox)")
end

-- Client visuals only: no promise of server-wide invisibility.
local localHidden=false
local storedTransparency=setmetatable({}, {__mode="k"})
local function applyLocalHidden()
    local char=me.Character
    if not char then return end
    for _,obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            if localHidden then
                if storedTransparency[obj]==nil then storedTransparency[obj]=obj.LocalTransparencyModifier end
                obj.LocalTransparencyModifier=1
            elseif storedTransparency[obj]~=nil then
                obj.LocalTransparencyModifier=storedTransparency[obj]
                storedTransparency[obj]=nil
            end
        end
    end
end
local esp=false
local HIGHLIGHT="NOVA_V8_Outline"
local function decorate(p)
    if p==me then return end
    local char=p.Character
    if not char then return end
    local marker=char:FindFirstChild(HIGHLIGHT)
    if esp and not marker then
        marker=Instance.new("Highlight")
        marker.Name=HIGHLIGHT
        marker.Adornee=char
        marker.FillColor=theme.accent
        marker.OutlineColor=Color3.fromRGB(255,255,255)
        marker.FillTransparency=.8
        marker.OutlineTransparency=0
        marker.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        marker.Parent=char
    elseif not esp and marker then
        marker:Destroy()
    end
end
local function decorateAll()
    for _,p in ipairs(Players:GetPlayers()) do decorate(p) end
end
local lightingOriginal={
    Brightness=Lighting.Brightness, ClockTime=Lighting.ClockTime,
    FogEnd=Lighting.FogEnd, GlobalShadows=Lighting.GlobalShadows,
}
local bright=false
local function applyLight()
    Lighting.Brightness=bright and 3 or lightingOriginal.Brightness
    Lighting.ClockTime=bright and 14 or lightingOriginal.ClockTime
    Lighting.FogEnd=bright and 1000000 or lightingOriginal.FogEnd
    Lighting.GlobalShadows=bright and false or lightingOriginal.GlobalShadows
end

-- Self movement (the server may correct these values in experiences you do not own).
local fly=false
local flySpeed=52
local flyConnection, flyAttachment, flyVelocity, flyHum
local mobileVertical=0
local flyButtons=make("Frame", gui, {
    Position=UDim2.new(1,-93,.5,-79), Size=UDim2.fromOffset(80,160),

    "اكتب مضاعف سرعة السيارة",
    "2"
)

connect(carInput.FocusLost, function()
    local value = tonumber(carInput.Text)

    if value and value >= 1 and value <= 10 then
        S.CarMultiplier = value
        status("CAR MULTIPLIER: " .. value)
    else
        status("INVALID CAR MULTIPLIER")
    end

    carInput.Text = tostring(S.CarMultiplier)
end)

label(tab4, "السيارات الموجودة في الماب")

local carList = create("Frame", {
    Size = UDim2.new(1, -4, 0, 0),
    AutomaticSize = Enum.AutomaticSize.Y,
    BackgroundTransparency = 1
}, tab4)

create("UIListLayout", {
    SortOrder = Enum.SortOrder.LayoutOrder,
    Padding = UDim.new(0, 5)
}, carList)

local function refreshCars()
    for _, child in ipairs(carList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local count = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isVehicle(obj) then
            count += 1

            button(carList, obj.Name, function()
                local root = rootPart()

                if root and obj.Parent then
                    obj:PivotTo(
                        root.CFrame * CFrame.new(6, 3, 0)
                    )

                    status("CAR MOVE REQUESTED")
                end
            end)

            if count >= 40 then
                break
            end
        end
    end

    status("CARS FOUND: " .. count)
end

button(tab4, "تحديث السيارات", refreshCars)
refreshCars()

-- =====================================
-- ENGINE
-- =====================================

local fastTimer = 0
local scanTimer = 0
local aimTimer = 0
local uiTimer = 0

connect(RunService.Heartbeat, function(dt)
    if not alive then return end

    fastTimer += dt
    scanTimer += dt
    aimTimer += dt
    uiTimer += dt

    if fastTimer >= 0.25 then
        fastTimer = 0

        updateSpeed()
        updateVisibility()
        updateESP()
    end

    if scanTimer >= 3 then
        scanTimer = 0

        if S.LizardScan or S.LizardAim then
            rebuildLizardSnapshot()
        end

        if S.LizardScan then
            refreshLizardRadar()
        end
    end

    if S.LizardAim and aimTimer >= 0.15 then
        aimTimer = 0

        local target = nearestLizard(S.TargetName)
        local cam = camera()

        if target and cam then
            cam.CFrame = CFrame.lookAt(
                cam.CFrame.Position,
                target.Root.Position
            )
        end
    end

    if uiTimer >= 2 then
        uiTimer = 0
        updateScale()
    end

    local vehicleRoot = seatedVehicleRoot()

    if vehicleRoot and S.CarFly then
        local cam = camera()

        if cam then
            local direction = Vector3.zero
            local cf = cam.CFrame

            if UIS:IsKeyDown(Enum.KeyCode.W) then
                direction += cf.LookVector
            end

            if UIS:IsKeyDown(Enum.KeyCode.S) then
                direction -= cf.LookVector
            end

            if UIS:IsKeyDown(Enum.KeyCode.A) then
                direction -= cf.RightVector
            end

            if UIS:IsKeyDown(Enum.KeyCode.D) then
                direction += cf.RightVector
            end

            if UIS:IsKeyDown(Enum.KeyCode.Space) then
                direction += Vector3.yAxis
            end

            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
                direction -= Vector3.yAxis
            end

            if direction.Magnitude > 0 then
                vehicleRoot.AssemblyLinearVelocity =
                    direction.Unit
                    * (35 * S.CarMultiplier)
            else
                vehicleRoot.AssemblyLinearVelocity =
                    Vector3.zero
            end
        end

    elseif vehicleRoot and S.CarSpeed then
        local velocity =
            vehicleRoot.AssemblyLinearVelocity

        local horizontal = Vector3.new(
            velocity.X,
            0,
            velocity.Z
        )

        if horizontal.Magnitude > 1 then
            local targetSpeed = math.min(
                horizontal.Magnitude
                * (1 + dt * S.CarMultiplier),
                35 * S.CarMultiplier
            )

            local boosted =
                horizontal.Unit * targetSpeed

            vehicleRoot.AssemblyLinearVelocity =
                Vector3.new(
                    boosted.X,
                    velocity.Y,
                    boosted.Z
                )
        end
    end
end)

-- =====================================
-- DRAGGING
-- =====================================

local dragging = false
local dragStart
local startPosition

connect(Header.InputBegan, function(inputObject)
    if inputObject.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        dragging = true
        dragStart = inputObject.Position
        startPosition = Main.Position
    end
end)

connect(UIS.InputChanged, function(inputObject)
    if dragging and inputObject.UserInputType ==
        Enum.UserInputType.MouseMovement then

        local delta =
            (inputObject.Position - dragStart)
            / Scale.Scale

        Main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

connect(UIS.InputEnded, function(inputObject)
    if inputObject.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        dragging = false
    end
end)


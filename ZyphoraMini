                say("رُصد «" .. safeText(selectedTitle) .. "» في بيانات ظاهرة، ولا يعني أنه متاح لحسابك", true)
            end
        end)
    end
    if #results == 0 then
        make("TextLabel", {
            Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1,
            TextColor3 = COLORS.muted, Text = "لا توجد ألقاب مطابقة للبحث.",
            TextWrapped = true, TextSize = 12,
        }, titleList)
    end
end

    local owned = {}
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({backpack, LocalPlayer.Character}) do
        if holder then
            for _, item in ipairs(holder:GetChildren()) do
                if item:IsA("Tool") then owned[toolKey(item.Name)] = true end
            end
        end
    end
    return owned, backpack
end
local function copyToolOnce(source, owned)
    if not source:IsA("Tool") or toolInSomeoneCharacter(source) then
        return false, "skipped"
    end
    local name = toolKey(source.Name)
    if name == "" or owned[name] then
        return false, "duplicate"
    end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return false, "no-backpack" end
    local success, clone = pcall(function() return source:Clone() end)
    if not success or not clone then return false, "failed" end
    -- Mark client-created copies so the UI does not count them as server grants.
    pcall(function() clone:SetAttribute("NOVA_LocalCopy", true) end)
    local put = pcall(function() clone.Parent = backpack end)
    if not put or clone.Parent ~= backpack then
        pcall(function() clone:Destroy() end)
        return false, "failed"
    end
    owned[name] = true
    return true, "copied"
end
local function currentInventoryCounts()
    local keys, copiedKeys = {}, {}
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({backpack, LocalPlayer.Character}) do
        if holder then
            for _, item in ipairs(holder:GetChildren()) do
                if item:IsA("Tool") then
                    local key = toolKey(item.Name)
                    if key ~= "" then
                        keys[key] = true
                        if item:GetAttribute("NOVA_LocalCopy") == true then copiedKeys[key] = true end
                    end
                end
            end
        end
    end
    local total, localCount = 0, 0
    for _ in pairs(keys) do total = total + 1 end
    for _ in pairs(copiedKeys) do localCount = localCount + 1 end
    return total, localCount
end
local function copyVisibleTools(silent)
    if not alive then return end
    if toolScanRunning then
        if not silent then say("الفحص شغال الآن؛ انتظر حتى تظهر النتيجة", true) end
        return
    end
    local owned, backpack = ownedToolNames()
    if not backpack then
        say("الحقيبة غير جاهزة حاليًا", false)
        return
    end
    toolScanRunning = true
    if toolsInfo then toolsInfo.Text = "جارٍ الفحص على دفعات بدون إيقاف اللعب..." end
    local copied, duplicates, failed = 0, 0, 0
    local ok, scanned, truncated = pcall(function()
        return visitVisible(TOOL_CONTAINERS, 22000, function(candidate)
            if candidate:IsA("Tool") and not toolInSomeoneCharacter(candidate) then
                local key = toolKey(candidate.Name)
                if key ~= "" then visibleToolIndex[key] = candidate.Name end
                local didCopy, reason = false, "limit"
                if copied < 60 then didCopy, reason = copyToolOnce(candidate, owned) end
                if didCopy then copied = copied + 1
                elseif reason == "duplicate" then duplicates = duplicates + 1
                elseif reason == "failed" then failed = failed + 1 end
                return false -- no need to traverse the internals of a Tool
            end
            return true
        end)
    end)
    toolScanRunning = false
    if not alive then return end
    local unique = 0
    for _ in pairs(visibleToolIndex) do unique = unique + 1 end
    local total, locally = currentInventoryCounts()
    refreshToolUI()
    if toolsInfo then
        toolsInfo.Text = "الحقيبة: " .. total .. " اسم (منها " .. locally .. " نسخ محلية)"
            .. " | مرئية: " .. unique .. " | نسخ جديدة: " .. copied
            .. " | مكررة: " .. duplicates .. " | تعذّر: " .. failed
            .. (truncated and " | الفحص محدود لخفة الأداء" or "")
            .. (copied >= 60 and " | حد النسخ: 60 أداة للجلسة" or "")
        toolsInfo.Size = UDim2.new(1, 0, 0, 75)
    end
    if not ok then
        warn("NOVA Tool Scan: " .. safeText(scanned))
        if not silent then say("تعذّر فحص بعض أدوات الماب؛ بقية القوائم مستمرة", false) end
    elseif not silent then
        say("اكتمل فحص الأدوات الظاهرة: " .. copied .. " نسخ جديدة محليًا"
            .. (truncated and "، ووصلنا لحدّ الأداء" or ""), copied > 0)
    end
end

-- Auto-collect is opt-in. Scan only the newly replicated Tool, not the entire map.
local function newVisibleTool(obj)
    if not alive or not obj:IsA("Tool") or toolInSomeoneCharacter(obj) then return end
    local key = toolKey(obj.Name)
    if key == "" then return end
    visibleToolIndex[key] = obj.Name
    if state.AutoTools then
        task.defer(function()
            if not alive or not state.AutoTools or not obj.Parent then return end
            local owned = ownedToolNames()
            local didCopy = copyToolOnce(obj, owned)
            if didCopy then refreshToolUI() end
        end)
    end
end
for _, container in ipairs(TOOL_CONTAINERS) do
    listen(container.DescendantAdded, function(obj)
        if obj:IsA("Tool") then newVisibleTool(obj) end
    end)
end

local adminToolTokens = {
    "admin", "moderator", "mod panel", "ban hammer", "banhammer",
    "kick tool", "kicktool", "owner tool", "admin wand",
    "ادمن", "أدمن", "مشرف"
}
local function visibleAdminTool(player)
    local char = player.Character
    if not char then return nil end
    -- Other players' Backpacks are normally not visible on the client.
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local lower = tool.Name:lower()
            for _, token in ipairs(adminToolTokens) do
                if lower:find(token, 1, true) then
                    return tool.Name
                end
            end
        end
    end
    return nil
end
local rankCache = {}
local rankQueued = {}
local rankQueue = {}
local rankWorkerRunning = false
local function queueGroupRank(player)
    if rankCache[player.UserId] ~= nil or rankQueued[player.UserId] then return end
    rankQueued[player.UserId] = true
    table.insert(rankQueue, player)
    if rankWorkerRunning then return end
    rankWorkerRunning = true
    task.spawn(function()
        while alive and #rankQueue > 0 do
            local candidate = table.remove(rankQueue, 1)
            if candidate and candidate.Parent == Players then
                local ok, rank = pcall(function()
                    return candidate:GetRankInGroup(game.CreatorId)
                end)
                rankCache[candidate.UserId] = (ok and type(rank) == "number") and rank or false
                if alive and state.AdminESP and refreshAdminVision then
                    local success, err = pcall(refreshAdminVision)
                    if not success then warn("NOVA rank visuals: " .. safeText(err)) end
                end
            end
            if candidate then rankQueued[candidate.UserId] = nil end
            task.wait(.35) -- avoid many concurrent rank requests
        end
        rankWorkerRunning = false
    end)
end
local function getRole(player, allowRankCheck)
    if game.CreatorType == Enum.CreatorType.User then
        if player.UserId == game.CreatorId then
            return "مالك التجربة (هوية مؤكدة)", "owner"
        end
    elseif game.CreatorType == Enum.CreatorType.Group then
        local rank = rankCache[player.UserId]
        if rank == nil and allowRankCheck then queueGroupRank(player) end
        if type(rank) == "number" then
            if rank == 255 then
                return "مالك المجموعة (رتبة 255)", "owner"
            elseif rank >= 200 then
                return "رتبة قروب " .. tostring(rank) .. " (ليست إثبات أدمن)", "possible"
            end
        end
    end
    local candidate = visibleAdminTool(player)
    if candidate then
        return "أداة ظاهرة: " .. safeText(candidate) .. " (اشتباه فقط)", "tool"
    end
    if game.CreatorType == Enum.CreatorType.Group and rankCache[player.UserId] == nil then
        return allowRankCheck and "الرتبة قيد التحقق" or "الرتبة لم تُفحص", allowRankCheck and "pending" or "unknown"
    end
    return "صلاحيات الأدمن غير معروفة", "unknown"
end
-- Unified player visualization: one outline + one readable nametag per player.
-- Both modes show visible players. "Admin" status stays UNKNOWN unless public evidence exists.
-- Limit highlights to avoid the Roblox renderer's simultaneous-highlight cap.
local visionStatusText = nil
local VISION_HIGHLIGHT_CAP = 26
local VISION_LABEL_CAP = 72
local function clearPlayerMarker(player)
    local d = highlighted[player]
    if not d then return end
    if d.highlight then pcall(function() d.highlight:Destroy() end) end
    if d.billboard then pcall(function() d.billboard:Destroy() end) end
    highlighted[player] = nil
end
local function clearHighlights()
    for player in pairs(highlighted) do clearPlayerMarker(player) end
end
local function refreshHighlights()
    if not alive then return end
    if not state.ESP and not state.AdminESP then
        clearHighlights()
        if visionStatusText then visionStatusText.Text = "الرؤية متوقفة؛ شغّل زر كشف اللاعبين أو مؤشرات الأدمن" end
        return
    end
    local own = localRoot()
    local candidates = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if char and head and (not hum or hum.Health > 0) then
                local dist = own and (head.Position - own.Position).Magnitude or math.huge
                table.insert(candidates, {player=player, char=char, head=head, distance=dist})
            end
        end
    end
    table.sort(candidates, function(a,b) return a.distance < b.distance end)
    local marked = {}
    local indications, pending = 0, 0
    for index, item in ipairs(candidates) do
        if index > VISION_LABEL_CAP then break end
        local player, char, head = item.player, item.char, item.head
        marked[player] = true
        local role, kind = "", "unknown"
        if state.AdminESP then
            role, kind = getRole(player, true)
            if kind == "owner" or kind == "possible" or kind == "tool" then indications = indications + 1 end
            if kind == "pending" then pending = pending + 1 end
        end
        local tint = COLORS.cyan
        if state.AdminESP then
            if kind == "owner" then tint = COLORS.green
            elseif kind == "possible" then tint = COLORS.orange
            elseif kind == "tool" then tint = Color3.fromRGB(255, 217, 95)
            else tint = COLORS.cyan end
        end
        local d = highlighted[player]
        if d and (d.char ~= char or not d.billboard or not d.billboard.Parent) then
            clearPlayerMarker(player)
            d = nil
        end
        if not d then
            local bill = make("BillboardGui", {
                Name = "NovaPlayerLabel", Adornee = head,
                AlwaysOnTop = true, Size = UDim2.fromOffset(244, 56),
                StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0),
                MaxDistance = 3000, LightInfluence = 0,
            }, gui)
            local card = make("Frame", {
                Name = "InfoCard", BackgroundColor3 = Color3.fromRGB(9, 15, 29),
                BackgroundTransparency = .13, BorderSizePixel = 0,
                Size = UDim2.fromScale(1, 1),
            }, bill)
            round(card, 8)
            make("UIStroke", {Color = tint, Transparency = .08, Thickness = 1.15}, card)
            local label = make("TextLabel", {
                Name = "PlayerText", BackgroundTransparency = 1,
                Position = UDim2.fromOffset(6, 2), Size = UDim2.new(1, -12, 1, -4),
                Font = Enum.Font.GothamBold, TextColor3 = COLORS.white,
                TextSize = 12, TextWrapped = true, TextStrokeTransparency = .64,
            }, card)
            d = {char=char, billboard=bill, label=label, frame=card, highlight=nil}
            highlighted[player] = d
        end
        d.billboard.Adornee = head
        local shortName = safeText(player.DisplayName, player.Name)
        local top = shortName .. "  (@" .. safeText(player.Name) .. ")"
        local distance = item.distance == math.huge and "?" or tostring(math.floor(item.distance + .5))
        if state.AdminESP then
            -- Never label an unknown player as confirmed staff.
            d.label.Text = top .. "  •  " .. distance .. " st\n" .. safeText(role, "غير معروف")
        else
            d.label.Text = top .. "\n" .. distance .. " studs"
        end
        d.label.TextColor3 = tint
        local border = d.frame:FindFirstChildOfClass("UIStroke")
        if border then border.Color = tint end
        if index <= VISION_HIGHLIGHT_CAP then
            if not d.highlight or not d.highlight.Parent then
                -- Parent to the character so 3D highlights render reliably.
                local ok, hl = pcall(function()
                    return make("Highlight", {
                        Name = "NOVA_LocalVisual_Only", Adornee = char,
                        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                        FillTransparency = .78, OutlineTransparency = .04,
                        FillColor = tint, OutlineColor = tint,
                    }, char)
                end)
                if ok then d.highlight = hl end
            end
            if d.highlight then
                d.highlight.Adornee = char
                d.highlight.FillColor = tint
                d.highlight.OutlineColor = tint
            end
        elseif d.highlight then
            pcall(function() d.highlight:Destroy() end)
            d.highlight = nil
        end
    end
    for player in pairs(highlighted) do
        if not marked[player] then clearPlayerMarker(player) end
    end
    if visionStatusText then
        local visible = math.min(#candidates, VISION_LABEL_CAP)
        visionStatusText.Text = "ظاهرين: " .. visible .. " | مؤشرات عامة: " .. indications
            .. " | رتب تنتظر القراءة: " .. pending
            .. (state.AdminESP and " | المجهول لا يعني أنه أدمن" or " | وضع رؤية اللاعبين")
    end
end

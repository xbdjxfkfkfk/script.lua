        Position = UDim2.fromOffset(8, 8),
        BackgroundTransparency = 1,
        Text = icon,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = C.white
    }, btn)
    
    inst("TextLabel", {
        Size = UDim2.new(1, -35, 1, 0),
        Position = UDim2.fromOffset(32, 0),
        BackgroundTransparency = 1,
        Text = name,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = C.white,
        TextXAlignment = Enum.TextXAlignment.Left
    }, btn)
    
    local page = inst("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = C.accent,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        Visible = false
    }, area)
    
    inst("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder}, page)
    inst("UIPadding", {PaddingRight = UDim.new(0, 5)}, page)
    
    table.insert(tabs, page)
    table.insert(tabBtns, btn)
    
    conn(btn.MouseButton1Click, function()
        for i, t in ipairs(tabs) do
            t.Visible = (t == page)
            tabBtns[i].BackgroundColor3 = (t == page) and C.accent or C.card
        end
    end)
    
    if #tabs == 1 then
        page.Visible = true
        btn.BackgroundColor3 = C.accent
    end
    
    return page
end


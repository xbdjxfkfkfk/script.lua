local invisible = {}
local frozen = {}
local flying = {}
local lastRequest = {}
local original = setmetatable({}, {__mode = "k"})

local function note(player, message)
    if player and player.Parent == Players then
        Signal:FireClient(player, "Notice", tostring(message))
    end
end
local function targetById(value)
    if type(value) ~= "number" or value ~= math.floor(value) then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if player.UserId == value then return player end
    end
    return nil
end
local function getCharacterRoot(player)
    if not player or not player.Character then return nil end
    local char = player.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return nil end
    return char, root, hum
end
local function storeOriginal(obj)
    if original[obj] then return end
    if obj:IsA("BasePart") then
        original[obj] = { kind = "part", transparency = obj.Transparency, shadow = obj.CastShadow }
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        original[obj] = { kind = "decal", transparency = obj.Transparency }
    elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("Highlight") then
        original[obj] = { kind = "effect", enabled = obj.Enabled }
    elseif obj:IsA("Humanoid") then
        original[obj] = { kind = "humanoid", display = obj.DisplayDistanceType }
    end
end
local function changeVisual(obj, hidden)
    if hidden then
        storeOriginal(obj)
        if obj:IsA("BasePart") then
            obj.Transparency = 1
            obj.CastShadow = false
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("Highlight") then
            obj.Enabled = false
        elseif obj:IsA("Humanoid") then
            obj.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        end
    else
        local prev = original[obj]
        if not prev then return end
        if prev.kind == "part" and obj:IsA("BasePart") then
            obj.Transparency = prev.transparency
            obj.CastShadow = prev.shadow
        elseif prev.kind == "decal" and (obj:IsA("Decal") or obj:IsA("Texture")) then
            obj.Transparency = prev.transparency
        elseif prev.kind == "effect" then
            obj.Enabled = prev.enabled
        elseif prev.kind == "humanoid" and obj:IsA("Humanoid") then
            obj.DisplayDistanceType = prev.display
        end
        original[obj] = nil
    end
end
local function applyInvisible(player)
    local char = player.Character
    if not char then return end
    local hidden = invisible[player.UserId] == true
    for _, obj in ipairs(char:GetDescendants()) do
        changeVisual(obj, hidden)
    end
end
local function applyFrozen(player)
    local _, root = getCharacterRoot(player)
    if not root then return end
    if frozen[player.UserId] then
        root.Anchored = true
    else
        root.Anchored = false
    end
end
local function publishHello(player)
    local names = {}
    if isAdmin(player) then
        for _, obj in ipairs(inventory:GetChildren()) do
            if obj:IsA("Tool") then table.insert(names, obj.Name) end
        end
        table.sort(names)
    end
    Signal:FireClient(player, "Welcome", {admin = isAdmin(player), tools = names})
end

local function onCharacter(player, char)
    local conn
    conn = char.DescendantAdded:Connect(function(obj)
        if invisible[player.UserId] then
            task.defer(function()
                if obj.Parent and invisible[player.UserId] then changeVisual(obj, true) end
            end)
        end
    end)
    char.Destroying:Once(function()
        if conn then conn:Disconnect() end
    end)
    task.spawn(function()
        if char:WaitForChild("HumanoidRootPart", 12) then
            task.wait(0.15)
            if player.Character ~= char then return end
            applyInvisible(player)
            applyFrozen(player)
            if flying[player.UserId] then
                Signal:FireClient(player, "Flight", true)
            end
        end
    end)
end
local function register(player)
    player.CharacterAdded:Connect(function(char) onCharacter(player, char) end)
    if player.Character then onCharacter(player, player.Character) end
end
Players.PlayerAdded:Connect(register)
for _, player in ipairs(Players:GetPlayers()) do register(player) end
Players.PlayerRemoving:Connect(function(player)
    invisible[player.UserId] = nil
    frozen[player.UserId] = nil
    flying[player.UserId] = nil
    lastRequest[player] = nil
end)

Request.OnServerEvent:Connect(function(actor, action, id, payload)
    if type(action) ~= "string" then return end
    if action == "Hello" then
        publishHello(actor)
        return
    end
    local t = os.clock()
    if t - (lastRequest[actor] or 0) < 0.12 then return end
    lastRequest[actor] = t
    if not isAdmin(actor) then
        note(actor, "الأمر يحتاج صلاحيات مالك الماب")
        return
    end

    if action == "Speed" then
        local _, _, hum = getCharacterRoot(actor)
        local value = tonumber(payload)
        if hum and value and value == value then
            hum.WalkSpeed = math.clamp(value, 8, 100)
            note(actor, "تم تغيير السرعة")
        else
            note(actor, "الشخصية غير جاهزة أو القيمة غير صحيحة")
        end
        return
    end
    if action == "Respawn" then
        actor:LoadCharacter()
        return
    end
    if action == "GiveTool" then
        if type(payload) ~= "string" or #payload > 80 then return end
        local item = inventory:FindFirstChild(payload)
        if not item or not item:IsA("Tool") then
            note(actor, "الأداة غير مصرح بها في مخزن اللعبة")
            return
        end
        local recipient = targetById(id) or actor
        local backpack = recipient:FindFirstChildOfClass("Backpack")
        if not backpack then note(actor, "حقيبة اللاعب غير جاهزة") return end
        local cloned = item:Clone()
        if cloned.Name == "NOVA Tag Wand" or cloned.Name == "NOVA Freeze Wand" then
            local handle = cloned:FindFirstChild("Handle")
            local lastHit = {}
            if handle and handle:IsA("BasePart") then
                handle.Touched:Connect(function(hit)
                    -- Only an authorized owner who has equipped the tool can activate it.
                    if cloned.Parent ~= recipient.Character or not isAdmin(recipient) then return end
                    local hitCharacter = hit:FindFirstAncestorOfClass("Model")
                    local victim = hitCharacter and Players:GetPlayerFromCharacter(hitCharacter)
                    if not victim or victim == recipient then return end
                    local t = os.clock()
                    if t - (lastHit[victim.UserId] or 0) < 2.5 then return end
                    local _, victimRoot, victimHum = getCharacterRoot(victim)
                    local _, ownerRoot = getCharacterRoot(recipient)
                    if not victimRoot or not ownerRoot then return end
                    lastHit[victim.UserId] = t
                    if cloned.Name == "NOVA Freeze Wand" then
                        victimRoot.Anchored = true
                        task.delay(3, function()
                            if victimRoot.Parent and not frozen[victim.UserId] then
                                victimRoot.Anchored = false
                            end
                        end)
                    else
                        local delta = victimRoot.Position - ownerRoot.Position
                        if delta.Magnitude > .01 then
                            victimRoot.AssemblyLinearVelocity = delta.Unit * 48 + Vector3.new(0, 25, 0)
                        end
                        victimHum:TakeDamage(5)
                    end
                end)
            end
        end
        cloned.Parent = backpack
        note(actor, "تم تسليم الأداة إلى " .. recipient.DisplayName)
        return
    end

    local target = targetById(id)
    if not target then note(actor, "اختر لاعبًا موجودًا") return end

    if action == "Invisible" then
        invisible[target.UserId] = not invisible[target.UserId]
        applyInvisible(target)
        note(actor, invisible[target.UserId] and "تم الإخفاء على الخادم" or "تم إظهار اللاعب")
    elseif action == "Freeze" then
        frozen[target.UserId] = not frozen[target.UserId]
        applyFrozen(target)
        note(actor, frozen[target.UserId] and "تم تجميد اللاعب" or "تم فك التجميد")
    elseif action == "Fly" then
        flying[target.UserId] = not flying[target.UserId]
        Signal:FireClient(target, "Flight", flying[target.UserId])
        note(actor, flying[target.UserId] and "تم تفعيل الطيران" or "تم إيقاف الطيران")
    elseif action == "Bring" then
        local myChar, myRoot = getCharacterRoot(actor)
        local otherChar = getCharacterRoot(target)
        if not myChar or not myRoot or not otherChar then note(actor, "الشخصية غير جاهزة") return end
        otherChar:PivotTo(myRoot.CFrame * CFrame.new(0, 0, -5))
        note(actor, "تم سحب اللاعب عندك")
    elseif action == "Teleport" then
        local myChar = getCharacterRoot(actor)
        local _, otherRoot = getCharacterRoot(target)
        if not myChar or not otherRoot then note(actor, "الشخصية غير جاهزة") return end
        myChar:PivotTo(otherRoot.CFrame * CFrame.new(4, 0, 0))
        note(actor, "تم الانتقال للاعب")
    else
        note(actor, "أمر غير معروف")
    end
end)
print("[NOVA PRO v7] Server ready. Admin permission enforced on server.")

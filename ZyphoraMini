local selectedUserId, spectatedUserId
local function currentSelected()
    return selectedUserId and Players:GetPlayerByUserId(selectedUserId)
end
local function endSpectate()
    spectatedUserId = nil
    local camera = workspace.CurrentCamera
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if camera and humanoid then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = humanoid
    end
    note("تم إيقاف المشاهدة")
end
local function beginSpectate()
    local target = currentSelected()
    if not target or target == player then note("اختر لاعبًا من القائمة أولًا") return end
    local humanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
    local camera = workspace.CurrentCamera
    if not humanoid or not camera then note("شخصية اللاعب غير جاهزة") return end
    spectatedUserId = target.UserId
    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = humanoid
    note("تشاهد " .. target.DisplayName .. "؛ المشاهدة لا تنقل الصوت")
end
local function localTeleport()
    local target = currentSelected()
    if not target or target == player then note("اختر لاعبًا أولًا") return end
    local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    local mine = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root or not mine then note("موقع إحدى الشخصيتين غير جاهز") return end
    local ok = pcall(function() mine.CFrame = root.CFrame * CFrame.new(3, 0, 3) end)
    note(ok and "تمت محاولة انتقال محلي، وقد يعيدك السيرفر لمكانك" or "تعذّر الانتقال المحلي")
end


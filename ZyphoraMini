-- Vehicle speed controls

label(tab4, "مضاعف سرعة السيارة: 1 إلى 10")

local carInput = make("TextBox", {
    Size = UDim2.new(1, -4, 0, 40),
    BackgroundColor3 = C.panel2,
    Text = tostring(CarMultiplier),
    TextColor3 = C.text,
    Font = Enum.Font.GothamBold,
    TextSize = 13,
    ClearTextOnFocus = false
}, tab4)
corner(carInput, 8)

addonBind(carInput.FocusLost, function()
    local number = tonumber(carInput.Text)

    if number and number >= 1 and number <= 10 then
        CarMultiplier = number
        notify("CAR MULTIPLIER: " .. number)
    else
        notify("ENTER CAR MULTIPLIER 1-10")
    end

    carInput.Text = tostring(CarMultiplier)
end)

button(tab4, "زيادة سرعة السيارة أثناء القيادة", function()
    CarSpeedEnabled = not CarSpeedEnabled

    notify(
        CarSpeedEnabled
        and "CAR SPEED ON"
        or "CAR SPEED OFF"
    )
end)

-- Runtime updates

local aimTimer = 0

addonBind(RunService.Heartbeat, function(dt)
    if not alive then return end

    aimTimer += dt

    -- Camera target, throttled to reduce scanning
    if AutoAimLizard and aimTimer >= 0.15 then
        aimTimer = 0

        local target = nearestLizard(LizardTargetName)
        local camera = Workspace.CurrentCamera

        if target and camera then
            local position = camera.CFrame.Position
            local destination = target.Root.Position

            camera.CFrame = CFrame.lookAt(
                position,
                destination
            )
        end
    end

    -- Vehicle speed boost
    if CarSpeedEnabled and not S.CarFly then
        local root = seatedVehicleRoot()

        if root then
            local velocity = root.AssemblyLinearVelocity
            local horizontal = Vector3.new(
                velocity.X, 0, velocity.Z
            )

            if horizontal.Magnitude > 1 then
                local targetSpeed = math.min(
                    horizontal.Magnitude
                    * (1 + dt * CarMultiplier),
                    35 * CarMultiplier
                )

                local boosted =
                    horizontal.Unit * targetSpeed

                root.AssemblyLinearVelocity = Vector3.new(
                    boosted.X,
                    velocity.Y,
                    boosted.Z
                )
            end
        end
    end
end)


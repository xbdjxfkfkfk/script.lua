local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LP = Players.LocalPlayer
local PG = LP:WaitForChild("PlayerGui", 12)

if not PG then return end

-- تنظيف
for _, name in ipairs({"سكربت_الإخفاء"}) do
    local old = PG:FindFirstChild(name)
    if old then old:Destroy() end
end

-- الحالة
local alive = true
local invisible = false

-- واجهة
local gui = Instance.new("ScreenGui")
gui.Name = "سكربت_الإخفاء"
gui.ResetOnSpawn = false
gui.DisplayOrder = 90
gui.Parent = PG

-- زر عائم
local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.fromOffset(50, 50)
toggleBtn.Position = UDim2.new(0, 20, 0.5, -25)
toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
toggleBtn.Text = "👻"
toggleBtn.TextColor3 = Color3.new(1, 1, 1)
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.TextSize = 24
toggleBtn.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = toggleBtn

-- حالة الإخفاء
local function setInvisible(state)
    invisible = state
    local char = LP.Character
    if not char then return end
    
    if invisible then
        -- إخفاء كل شي
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.LocalTransparencyModifier = 1
                v.CastShadow = false
            end
            if v:IsA("Decal") or v:IsA("Texture") then
                v.LocalTransparencyModifier = 1
            end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
                v.Enabled = false
            end
        end
        toggleBtn.BackgroundColor3 = Color3.fromRGB(100, 0, 150)
        toggleBtn.Text = "👻✓"
    else
        -- إظهار كل شي
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.LocalTransparencyModifier = 0
                v.CastShadow = true
            end
            if v:IsA("Decal") or v:IsA("Texture") then
                v.LocalTransparencyModifier = 0
            end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
                v.Enabled = true
            end
        end
        toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        toggleBtn.Text = "👻"
    end
end

-- زر التبديل
toggleBtn.MouseButton1Click:Connect(function()
    setInvisible(not invisible)
end)

-- إعادة عند موت الشخصية
LP.CharacterAdded:Connect(function(char)
    task.wait(1)
    if invisible then
        setInvisible(true)
    end
end)

-- تحديث مستمر
RunService.Heartbeat:Connect(function()
    if not alive then return end
    if invisible then
        local char = LP.Character
        if char then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.LocalTransparencyModifier ~= 1 then
                    v.LocalTransparencyModifier = 1
                    v.CastShadow = false
                end
            end
        end
    end
end)

print("✅ سكربت الإخفاء (محلي)")
print("⚠️ أنت ما تشوف نفسك — الناس تشوفك")
print("👻 اضغط الزر للإخفاء/الإظهار")

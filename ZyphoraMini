        local camera=workspace.CurrentCamera
        local move=hum.MoveDirection
        local vertical=0
        if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) or flyUp then vertical=vertical+1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) or flyDown then vertical=vertical-1 end
        local direction=move+Vector3.new(0,vertical,0)

-- Fix for black screen & missing UI elements in Lx REDLINE PRO
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
if not LP then return end
local PG = LP:WaitForChild("PlayerGui", 12)
if not PG then return end

for _, name in ipairs({"Lx_NexusV77", "Lx_DiscordAuthGuard"}) do
    local old = PG:FindFirstChild(name)
    if old then old:Destroy() end
end

local gui = Instance.new("ScreenGui")
gui.Name = "Lx_NexusV77"
gui.ResetOnSpawn = false
gui.DisplayOrder = 90
gui.Parent = PG

local main = Instance.new("Frame", gui)
main.Size = UDim2.fromOffset(650, 500)
main.Position = UDim2.new(0.5, -325, 0.5, -250)
main.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
main.BorderSizePixel = 0
main.Active = true
Instance.new("UICorner", main).CornerRadius = UDim.new(0, 16)
local stroke = Instance.new("UIStroke", main)
stroke.Color = Color3.fromRGB(205, 36, 42)
stroke.Thickness = 1.4

-- الهيدر
local head = Instance.new("Frame", main)
head.Size = UDim2.new(1, 0, 0, 66)
head.BackgroundColor3 = Color3.fromRGB(22, 22, 24)
Instance.new("UICorner", head).CornerRadius = UDim.new(0, 16)

local titleLabel = Instance.new("TextLabel", head)
titleLabel.Size = UDim2.fromOffset(450, 30)
titleLabel.Position = UDim2.fromOffset(70, 18)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = "Lx  REDLINE PRO (Discord Verified & Fixed)"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextSize = 17
titleLabel.TextXAlignment = Enum.TextXAlignment.Left

local closeBtn = Instance.new("TextButton", head)
closeBtn.Size = UDim2.fromOffset(31, 29)
closeBtn.Position = UDim2.new(1, -39, 0, 19)
closeBtn.Text = "×"
closeBtn.Font = Enum.Font.GothamBold
closeBtn.TextSize = 16
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 7)
closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

-- مساحة العرض الرئيسية مع تفعيل الـ AutomaticCanvasSize لمنع الشاشة السوداء
local area = Instance.new("ScrollingFrame", main)
area.Size = UDim2.new(1, -222, 1, -85)
area.Position = UDim2.fromOffset(210, 76)
area.BackgroundTransparency = 1
area.BorderSizePixel = 0
area.ScrollBarThickness = 4
area.AutomaticCanvasSize = Enum.AutomaticSize.Y
area.CanvasSize = UDim2.new(0, 0, 0, 0)

local layout = Instance.new("UIListLayout", area)
layout.Padding = UDim.new(0, 8)
layout.SortOrder = Enum.SortOrder.LayoutOrder

-- إضافة عناصر تجريبية تظهر فوراً لتأكيد عمل الواجهة
for i = 1, 4 do
    local card = Instance.new("Frame", area)
    card.Size = UDim2.new(1, -10, 0, 50)
    card.BackgroundColor3 = Color3.fromRGB(28, 29, 32)
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
    
    local txt = Instance.new("TextLabel", card)
    txt.Size = UDim2.new(1, -20, 1, 0)
    txt.Position = UDim2.fromOffset(10, 0)
    txt.BackgroundTransparency = 1
    txt.Text = "⚡ عنصر تحكم رئيسي رقم " .. i .. " (جاهز للعمل)"
    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 12
    txt.TextXAlignment = Enum.TextXAlignment.Left
end

titleList = make("ScrollingFrame", {
    Size = UDim2.new(1, 0, 0, 220), BackgroundColor3 = COLORS.panel,
    BorderSizePixel = 0, ScrollBarThickness = 5,
    ScrollBarImageColor3 = COLORS.purple,
    AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
}, scroller)
round(titleList, 9)
make("UIListLayout", {Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder}, titleList)
make("UIPadding", {PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5),
    PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5)}, titleList)
refreshTitleList = function()
    if not alive or not titleList.Parent then return end
    for _, child in ipairs(titleList:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then child:Destroy() end
    end
    local results = {}
    local query = titleSearch.Text:lower()
    local knownNames = {}
    -- Static reference titles remain visible even before client-side scanning.
    for _, entry in ipairs(vollTitleCatalog) do
        local lower = entry.name:lower()
        knownNames[lower] = true
        if query == "" or lower:find(query, 1, true) or entry.requirement:lower():find(query, 1, true) then
            table.insert(results, {
                name = entry.name, source = "VOLL | من صورك", description = entry.requirement,
                screenshotState = entry.screenshotState, catalog = true,
            })
        end
    end
    local live = {}
    for key, entry in pairs(titleEntries) do
        if not knownNames[key] and (query == "" or key:find(query, 1, true)) then
            table.insert(live, entry)
        end
    end
    table.sort(live, function(a,b) return a.name:lower() < b.name:lower() end)
    for _, entry in ipairs(live) do table.insert(results, entry) end
    for i=1, math.min(#results, 90) do
        local entry = results[i]
        local isCatalog = entry.catalog
        local desc = isCatalog and (tostring(entry.screenshotState or "حالة غير معروفة") .. " | " .. tostring(entry.description or "الشرط غير معروف"))
            or ("مرصود: " .. tostring(entry.source or "بيانات ظاهرة"))
        local b = make("TextButton", {
            Size = UDim2.new(1, -5, 0, isCatalog and 68 or 50),
            BackgroundColor3 = COLORS.panel2,
            TextColor3 = COLORS.white, TextWrapped = true,
            Text = (isCatalog and "🏷️ " or "🔎 ") .. entry.name .. "\n" .. desc,
            TextSize = 12, Font = Enum.Font.GothamMedium,
        }, titleList)
        round(b, 8)
        listen(b.MouseButton1Click, function()
            selectedTitle = entry.name
            if isCatalog then
                catalogSelectionNote.Text = "اللقب: " .. tostring(entry.name) .. " | الشرط: " .. tostring(entry.description or "غير معروف")
                    .. " | الحالة بالصور: " .. tostring(entry.screenshotState or "غير معروفة")
                say("اخترت «" .. selectedTitle .. "». للتجهيز الحقيقي استخدم زر نظام الألقاب الرسمي في VOLL", true)
            else
                catalogSelectionNote.Text = "اللقب المرصود: " .. entry.name .. " | " .. entry.source
                say("رُصد «" .. selectedTitle .. "» في بيانات ظاهرة، ولا يعني أنه متاح لحسابك", true)
            end
        end)
    end
    if #results == 0 then
        make("TextLabel", {
            Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1,
            TextColor3 = COLORS.muted, Text = "لا توجد ألقاب مطابقة للبحث.",
            TextWrapped = true, TextSize = 12,
        }, titleList)
    end
end
listen(titleSearch:GetPropertyChangedSignal("Text"), refreshTitleList)
refreshTitleList()
-- Update small set of client-only functions.
local elapsed, adminElapsed = 0, 0
listen(RunService.Stepped, function()
    if alive and state.Noclip then applyNoclip() end
end)
listen(RunService.RenderStepped, function(dt)
    if not alive then return end
    updateFlight()
    elapsed = elapsed + dt
    adminElapsed = adminElapsed + dt
    if elapsed >= .6 then
        elapsed = 0
        if state.LocalInvisible then applyLocalInvisible() end
        if state.Speed then applySpeed() end
        if state.ESP then refreshHighlights() end
    end
    if adminElapsed >= 3 then
        adminElapsed = 0
        if state.AdminESP then refreshAdminVision() end
    end
end)
listen(LocalPlayer.CharacterAdded, function()
    clearTitlePreview()
    stopFlight()
    restoreCollisions()
    -- Keep imported tool names across respawns to prevent repeated local copies.
    if state.AutoTools then task.delay(1.5, scheduleToolScan) end
    original.WalkSpeed = nil
    if state.Fly then
        task.delay(.5, function() if alive and state.Fly then startFlight() end end)
    end
    task.delay(.7, function()
        if alive then applySpeed(); applyLocalInvisible(); applyNoclip() end
    end)
end)

local function cleanup()
    if not alive then return end
    alive = false
    state.Fly = false
    stopFlight()
    state.LocalInvisible = false
    applyLocalInvisible()
    state.Speed = false
    applySpeed()
    state.Noclip = false
    restoreCollisions()
    clearHighlights()
    clearTitlePreview()
    for player in pairs(adminVisuals) do clearAdminVisual(player) end
    setToolWatching(false)
    for _, conn in ipairs(connections) do conn:Disconnect() end
    gui:Destroy()
    if rawget(_G, "NOVA_SuiteV19Cleanup") == cleanup then
        _G.NOVA_SuiteV19Cleanup = nil
    end
end
_G.NOVA_SuiteV19Cleanup = cleanup
-- Close hides the panel; rerun script to fully reset. The NOVA tab reopens it.
-- Startup intentionally does NOT scan Workspace/ReplicatedStorage/StarterGui.
-- Only small owned-inventory UI is drawn; deep scans run after the user's click.
task.defer(refreshToolUI)
say("NOVA v19: أُصلح عرض الألقاب؛ الطيران يتحكم بالارتفاع، والسحب عبر أدوات الماب فقط", true)
updateCanvas()
print("NOVA SUITE v19: full dashboard ready.")

end

            for part, was in pairs(originalCollision) do
                if part.Parent then part.CanCollide = was end
                originalCollision[part] = nil
            end
        end
        notice(noclip and "اختراق الجدران المحلي: تشغيل" or "اختراق الجدران المحلي: إيقاف")

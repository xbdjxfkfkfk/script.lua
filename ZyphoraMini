 local names,seen={},{}
 local function add(name)
  name=tostring(name)
  if name~='' and not seen[name] then seen[name]=true;names[#names+1]=name end
 end
 local containers={'OwnedCars','PurchasedCars','Garage','Vehicles','CarInventory','Cars'}
 for _,containerName in ipairs(containers) do
  local container=LP:FindFirstChild(containerName,true)
  if container then
   if container:IsA('Folder') or container:IsA('Configuration') then
    for _,item in ipairs(container:GetChildren()) do
     if item:IsA('BoolValue') then if item.Value then add(item.Name) end
     elseif item:IsA('StringValue') then add(item.Value~='' and item.Value or item.Name)
     elseif item:IsA('NumberValue') or item:IsA('IntValue') then if item.Value>0 then add(item.Name) end
     elseif item:IsA('Folder') or item:IsA('Model') or item:IsA('Configuration') then add(item.Name) end
    end
   elseif container:IsA('StringValue') then add(container.Value) end
  end
 end
 table.sort(names)
 if #names==0 then names={'لا توجد قائمة ملكية مكشوفة للعميل في هذا الماب'} end
 for _,name in ipairs(names) do
  local t=new('TextLabel',{Size=UDim2.new(1,-4,0,30),BackgroundColor3=C.panel2,Text='  🚘 '..name,TextColor3=C.white,TextSize=12,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},ownedList);corner(t,6)
 end
 status('سجلات السيارات المقروءة: '..(#names==1 and names[1]:find('لا توجد') and 0 or #names))
end
btn(carPage,'تحديث قائمة سياراتي المشتراة',refreshOwned)

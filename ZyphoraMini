-- بدء تشغيل السكريبت الأساسي (Lx REDLINE PRO v77)
-- ==========================================
local function launchRedline()
    local alive = true
    local conns = {}
    local markers = {}
    local S = {
        Radar = false,
        RadarRange = 3000,
        Aim = false,
        AimRange = 3000,
        AimSmooth = 0.14,
        FOV = 25,
        Speed = false,
        Walk = 32,
        CarSpeed = false,
        CarTarget = 200,
        Filter = "الكل"
    }

    local function conn(signal, fn)
        local c = signal:Connect(fn)
        conns[#conns + 1] = c
        return c
    end

    local function inst(typ, props, parent)
        local x = Instance.new(typ)
        for k, v in pairs(props or {}) do x[k] = v end
        x.Parent = parent
        return x
    end

    local function roundBox(x, r)
        inst("UICorner", {CornerRadius = UDim.new(0, r or 9)}, x)
    end

    local function root()
        return LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    end

    local C = {
        bg = Color3.fromRGB(10, 10, 12),
        card = Color3.fromRGB(28, 29, 32),
        muted = Color3.fromRGB(184, 186, 190),
        white = Color3.fromRGB(255, 255, 255),
        purple = Color3.fromRGB(239, 28, 37),
        green = Color3.fromRGB(80, 215, 135)
    }

    local gui = inst("ScreenGui", {
        Name = "Lx_NexusV77",
        ResetOnSpawn = false,
        DisplayOrder = 90,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, PG)

    local main = inst("Frame", {
        Size = UDim2.fromOffset(650, 500),
        Position = UDim2.new(0.5, -325, 0.5, -250),
        BackgroundColor3 = C.bg,
        BorderSizePixel = 0,
        Active = true
    }, gui)
    roundBox(main, 16)
    inst("UIStroke", {Color = Color3.fromRGB(205, 36, 42), Thickness = 1.4, Transparency = 0.12}, main)

    local head = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 66),
        BackgroundColor3 = Color3.fromRGB(22, 22, 24),
        BorderSizePixel = 0,
        Active = true
    }, main)
    roundBox(head, 16)
    inst("Frame", {
        Size = UDim2.new(1, -30, 0, 2),
        Position = UDim2.new(0, 15, 1, -2),
        BackgroundColor3 = C.purple,
        BorderSizePixel = 0
    }, head)

    inst("TextLabel", {
        Size = UDim2.fromOffset(330, 30),
        Position = UDim2.fromOffset(70, 9),
        BackgroundTransparency = 1,
        Text = "Lx  REDLINE PRO (Discord Secured)",
        TextColor3 = C.white,
        Font = Enum.Font.GothamBold,
        TextSize = 19,
        TextXAlignment = Enum.TextXAlignment.Left
    }, head)

    local close = inst("TextButton", {
        Size = UDim2.fromOffset(31, 29),
        Position = UDim2.new(1, -39, 0, 19),
        Text = "×",
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        TextColor3 = C.white,
        BackgroundColor3 = C.bg
    }, head)
    roundBox(close, 7)

    -- مراقبة مستمرة لوجود ديسكورد أثناء عمل السكريبت (إذا أغلق المستخدم ديسكورد تقفل الأداة تلقائياً)
    task.spawn(function()
        while alive do
            task.wait(5)
            if not checkDiscordConnection() then
                -- إغلاق الأداة فورا عند خروج ديسكورد
                pcall(function() gui:Destroy() end)
                alive = false
                break
            end
        end
    end)

    conn(close.MouseButton1Click, function()
        alive = false
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        pcall(function() gui:Destroy() end)
    end)
end

launchRedline()

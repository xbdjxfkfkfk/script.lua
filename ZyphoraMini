-- Preserve the user's original visual state instead of resetting arbitrary effects.
local function applyInvisible()
    local character=LP.Character
    if not character then return end
    if S.invisible then
        for _,obj in ipairs(character:GetDescendants()) do
            if obj:IsA('BasePart') and hiddenParts[obj]==nil then
                hiddenParts[obj]=obj.LocalTransparencyModifier
                obj.LocalTransparencyModifier=1
            elseif (obj:IsA('Decal') or obj:IsA('Texture')) and hiddenParts[obj]==nil then
                hiddenParts[obj]=obj.Transparency
                obj.Transparency=1
            end
        end
    else
        for obj,val in pairs(hiddenParts) do
            if obj and obj.Parent then
                if obj:IsA('BasePart') then obj.LocalTransparencyModifier=val
                elseif obj:IsA('Decal') or obj:IsA('Texture') then obj.Transparency=val end
            end
            hiddenParts[obj]=nil
        end
    end
end
local function stopFly()
    if flyVelocity then flyVelocity:Destroy();flyVelocity=nil end
    if flyFacing then flyFacing:Destroy();flyFacing=nil end
    if flyAttachment then flyAttachment:Destroy();flyAttachment=nil end
    local humanoid=LP.Character and LP.Character:FindFirstChildOfClass('Humanoid')
    if humanoid then humanoid.AutoRotate=true end
end
local function moveFly()
    local root=partOf(LP)
    local hum=LP.Character and LP.Character:FindFirstChildOfClass('Humanoid')
    if not S.fly or not root or not hum then stopFly();return end
    if not flyVelocity or flyVelocity.Parent~=root then
        stopFly()
        flyAttachment=make('Attachment',{},root)
        flyVelocity=make('LinearVelocity',{Attachment0=flyAttachment,RelativeTo=Enum.ActuatorRelativeTo.World,
            MaxForce=math.huge,VectorVelocity=Vector3.zero},root)
        flyFacing=make('AlignOrientation',{Attachment0=flyAttachment,
            Mode=Enum.OrientationAlignmentMode.OneAttachment,MaxTorque=math.huge,Responsiveness=20},root)
    end
    local cam=Workspace.CurrentCamera
    if not cam then return end
    local flatLook=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
    local flatRight=Vector3.new(cam.CFrame.RightVector.X,0,cam.CFrame.RightVector.Z)
    if flatLook.Magnitude<.001 then flatLook=Vector3.new(0,0,-1) end
    if flatRight.Magnitude<.001 then flatRight=Vector3.new(1,0,0) end
    flatLook=flatLook.Unit;flatRight=flatRight.Unit
    local dir=Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then dir+=flatLook end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir-=flatLook end
    if UIS:IsKeyDown(Enum.KeyCode.D) then dir+=flatRight end
    if UIS:IsKeyDown(Enum.KeyCode.A) then dir-=flatRight end
    if mobile then dir+=hum.MoveDirection end
    if S.up or UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then dir+=Vector3.yAxis end
    if S.down or UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) then dir-=Vector3.yAxis end
    flyVelocity.VectorVelocity=(dir.Magnitude>0 and dir.Unit or Vector3.zero)*S.flyValue
    flyFacing.CFrame=CFrame.lookAt(Vector3.zero,flatLook)
    hum.AutoRotate=false
end
local function clearPlayerVisuals()
    for p,insta in pairs(highlights) do if insta then insta:Destroy() end;highlights[p]=nil end
    for p,insta in pairs(nameTags) do if insta then insta:Destroy() end;nameTags[p]=nil end
end
local function refreshVisuals()
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP then
            local char=p.Character
            local head=char and char:FindFirstChild('Head')
            if S.esp and char then
                if not highlights[p] or highlights[p].Adornee~=char then
                    if highlights[p] then highlights[p]:Destroy() end
                    highlights[p]=make('Highlight',{Adornee=char,FillColor=C.purple,
                        OutlineColor=C.white,FillTransparency=.65,DepthMode=Enum.HighlightDepthMode.AlwaysOnTop},gui)
                end
            elseif highlights[p] then highlights[p]:Destroy();highlights[p]=nil end
            if S.names and head then
                if not nameTags[p] or nameTags[p].Adornee~=head then
                    if nameTags[p] then nameTags[p]:Destroy() end
                    local bill=make('BillboardGui',{Adornee=head,Size=UDim2.fromOffset(180,36),
                        StudsOffsetWorldSpace=Vector3.new(0,2.5,0),AlwaysOnTop=true,MaxDistance=300},gui)
                    make('TextLabel',{Size=UDim2.fromScale(1,1),BackgroundColor3=C.pane,
                        BackgroundTransparency=.25,Text=p.DisplayName..' (@'..p.Name..')',
                        TextColor3=C.white,TextScaled=true,Font=Enum.Font.GothamBold},bill)
                    nameTags[p]=bill
                end
                nameTags[p].Size=S.markers and UDim2.fromOffset(245,55) or UDim2.fromOffset(180,36)
            elseif nameTags[p] then nameTags[p]:Destroy();nameTags[p]=nil end
        end
    end
    for p,insta in pairs(highlights) do
        if not p.Parent or not p.Character or not S.esp then insta:Destroy();highlights[p]=nil end
    end
    for p,insta in pairs(nameTags) do
        if not p.Parent or not p.Character or not S.names then insta:Destroy();nameTags[p]=nil end
    end
end
local timer=0
watch(RunService.Heartbeat,function(dt)
    if not live then return end
    local hum=LP.Character and LP.Character:FindFirstChildOfClass('Humanoid')
    if hum then
        if S.speed then
            if savedHumanoidSpeed==nil then savedHumanoidSpeed=hum.WalkSpeed end
            hum.WalkSpeed=S.speedValue
        elseif savedHumanoidSpeed~=nil then
            hum.WalkSpeed=savedHumanoidSpeed;savedHumanoidSpeed=nil
        end
    end
    moveFly()
    timer+=dt
    if timer>.3 then timer=0;applyInvisible();refreshVisuals() end
end)

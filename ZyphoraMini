-- Drag works with mouse and touchscreen; the title bar is the drag handle.
local dragging, origin, initialPosition, touchInput = false, nil, nil, nil
bind(head.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        origin = input.Position
        initialPosition = main.Position
        touchInput = input.UserInputType == Enum.UserInputType.Touch and input or nil
    end
end)
bind(UserInputService.InputChanged, function(input)
    if not dragging or not origin or not initialPosition then return end
    local mouse = input.UserInputType == Enum.UserInputType.MouseMovement and touchInput == nil
    local touch = touchInput ~= nil and input == touchInput
    if not mouse and not touch then return end
    local diff = input.Position - origin
    main.Position = UDim2.new(initialPosition.X.Scale, initialPosition.X.Offset + diff.X,
        initialPosition.Y.Scale, initialPosition.Y.Offset + diff.Y)
end)
bind(UserInputService.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input == touchInput then
        dragging = false
        touchInput = nil
    end
end)


local function rarity(m)
    local raw = tostring(m:GetAttribute("Rarity") or m:GetAttribute("Tier") or ""):lower()
    return rarities[raw] or "غير محدد"
end

local function speciesName(model)
    return model:GetAttribute("Species") or model.Name
end

local function animalWeight(model)
    local v = model:GetAttribute("Weight") or model:GetAttribute("WeightKG") or model:GetAttribute("الوزن")
    if v then
        local n = tonumber(v)
        if n then return string.format("%.1f", n) .. " كجم" end
        return tostring(v)
    end
    for _, folderName in ipairs({"Stats", "Data", "Info", "بيانات"}) do
        local folder = model:FindFirstChild(folderName, true)
        if folder then
            local val = folder:GetAttribute("Weight") or folder:GetAttribute("WeightKG")
            if val then return tostring(val) .. " كجم" end
        end
    end
    return "غير معروف"
end

local function animalSize(model)
    local v = model:GetAttribute("Size") or model:GetAttribute("الحجم")
    if v then return tostring(v) end
    return "غير معروف"
end

-- Cache
local indexed = setmetatable({}, {__mode = "k"})
local cache = {}

local function refreshCache()
    table.clear(cache)
    for m in pairs(indexed) do
        if m.Parent and living(m) and lizard(m) then
            local p = part(m)
            if p and p.Parent then
                table.insert(cache, {model = m, part = p})
            end
        else
            indexed[m] = nil
        end
    end
end

-- Index
task.spawn(function()
    local pending = {WS}
    local index = 1
    while alive and index <= #pending do
        local obj = pending[index]
        index = index + 1
        if obj:IsA("Model") and not isVehicleModel(obj) and lizard(obj) and living(obj) then
            indexed[obj] = true
        end
        for _, child in ipairs(obj:GetChildren()) do
            table.insert(pending, child)
        end
        if index % 35 == 0 then task.wait(0.04) end
    end
end)


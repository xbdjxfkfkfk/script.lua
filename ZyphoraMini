-- Lx REDLINE PRO - Admin Kick Add-on
-- Install this Script in ServerScriptService of an experience you own/manage.
-- Only trusted UserIds (and the individual experience creator) can use it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- IMPORTANT: Replace 123456789 with your Roblox numeric UserId.
-- For a user-owned experience, the creator is automatically trusted.
-- For a group-owned experience, add your account's UserId below.
local ADMIN_USER_IDS = {
    [123456789] = true,
}

local REMOTE_NAME = "LxAdminKickRemote"
local LIST_COOLDOWN = 0.75
local KICK_COOLDOWN = 3
local MAX_REASON_BYTES = 180

local remote = ReplicatedStorage:FindFirstChild(REMOTE_NAME)
if remote and not remote:IsA("RemoteFunction") then
    remote:Destroy()
    remote = nil
end

if not remote then
    remote = Instance.new("RemoteFunction")
    remote.Name = REMOTE_NAME
    remote.Parent = ReplicatedStorage
end

local lastListRequest = {}
local lastKickRequest = {}

local function isTrustedAdmin(player)
    if not player or not player:IsA("Player") then
        return false
    end

    if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
        return true
    end

    return ADMIN_USER_IDS[player.UserId] == true
end

local function cleanReason(value)
    if typeof(value) ~= "string" then
        return "مخالفة قواعد التجربة"
    end

    local reason = value:gsub("[%c]", " "):gsub("%s+", " ")
    reason = reason:match("^%s*(.-)%s*$") or ""

    if reason == "" then
        reason = "مخالفة قواعد التجربة"
    end

    -- Keep valid UTF-8 and stay comfortably below Roblox's 500-byte Kick message limit.
    local nextByte = utf8.offset(reason, MAX_REASON_BYTES + 1)
    if nextByte then
        reason = string.sub(reason, 1, nextByte - 1)
    end

    return reason
end

local function getPlayerList(requester)
    local result = {}

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= requester then
            table.insert(result, {
                userId = target.UserId,
                name = target.Name,
                displayName = target.DisplayName,
                protected = isTrustedAdmin(target),
            })
        end
    end

    table.sort(result, function(a, b)
        return string.lower(a.displayName) < string.lower(b.displayName)
    end)

    return result
end

local function handleRequest(requester, action, targetUserId, reasonText)
    if not isTrustedAdmin(requester) then
        return { ok = false, code = "NO_PERMISSION", message = "ليس لديك صلاحية استخدام لوحة الإدارة." }
    end

    if action == "list" then
        local now = os.clock()
        local previous = lastListRequest[requester.UserId] or 0
        if now - previous < LIST_COOLDOWN then
            return { ok = false, code = "RATE_LIMIT", message = "انتظر قليلًا قبل تحديث القائمة." }
        end
        lastListRequest[requester.UserId] = now

        return {
            ok = true,
            players = getPlayerList(requester),
            serverCount = #Players:GetPlayers(),
        }
    end

    if action == "kick" then
        local now = os.clock()
        local previous = lastKickRequest[requester.UserId] or 0
        if now - previous < KICK_COOLDOWN then
            return { ok = false, code = "RATE_LIMIT", message = "انتظر ثلاث ثوانٍ قبل تنفيذ طرد آخر." }
        end

        if typeof(targetUserId) ~= "number" or targetUserId <= 0 or targetUserId % 1 ~= 0 then
            return { ok = false, code = "INVALID_TARGET", message = "معرّف اللاعب غير صالح." }
        end

        if targetUserId == requester.UserId then
            return { ok = false, code = "SELF_KICK_BLOCKED", message = "لا يمكنك طرد نفسك من هذه اللوحة." }
        end

        local target = Players:GetPlayerByUserId(targetUserId)
        if not target then
            return { ok = false, code = "TARGET_LEFT", message = "اللاعب غادر السيرفر بالفعل." }
        end

        if isTrustedAdmin(target) then
            return { ok = false, code = "PROTECTED_TARGET", message = "لا يمكن طرد حساب إداري محمي." }
        end

        lastKickRequest[requester.UserId] = now
        local reason = cleanReason(reasonText)
        local kickMessage = "تم إخراجك من التجربة بواسطة الإدارة. السبب: " .. reason

        local success, err = pcall(function()
            target:Kick(kickMessage)
        end)

        if not success then
            warn(string.format("[LxAdminKick] Failed to kick %s (%d): %s", target.Name, target.UserId, tostring(err)))
            return { ok = false, code = "KICK_FAILED", message = "تعذر تنفيذ الطرد. راجع سجل الخادم." }
        end

        print(string.format(
            "[LxAdminKick] %s (%d) kicked %s (%d). Reason: %s",
            requester.Name,
            requester.UserId,
            target.Name,
            target.UserId,
            reason
        ))

        return { ok = true, code = "KICK_SENT", message = "تم إرسال أمر الطرد إلى الخادم.", targetUserId = targetUserId }
    end

    return { ok = false, code = "UNKNOWN_ACTION", message = "طلب غير معروف." }
end

remote.OnServerInvoke = function(requester, action, targetUserId, reasonText)
    local success, response = pcall(handleRequest, requester, action, targetUserId, reasonText)
    if not success then
        warn("[LxAdminKick] Request error: " .. tostring(response))
        return { ok = false, code = "SERVER_ERROR", message = "حدث خطأ داخلي في لوحة الإدارة." }
    end
    return response
end

Players.PlayerRemoving:Connect(function(player)
    lastListRequest[player.UserId] = nil
    lastKickRequest[player.UserId] = nil
end)

print("[LxAdminKick] Server add-on ready. Trusted admin checks are enforced server-side.")

-- ============================================
-- Discord Auth Guard
-- Requires real Discord client to be running
-- If Discord closes, script locks itself
-- ============================================

local Players = game:GetService("Players")
local LP = Players.LocalPlayer
if not LP then
    warn("No LocalPlayer")
    return
end

local PG = LP:WaitForChild("PlayerGui", 12)
if not PG then
    warn("PlayerGui unavailable")
    return
end

local DISCORD_INVITE = "https://discord.gg/7HyFER45Y"
local DISCORD_PORTS = {6463, 6464}

local function discordIsAlive()
    for _, port in ipairs(DISCORD_PORTS) do
        local ok, res = pcall(function()
            if syn and syn.request then
                return syn.request({
                    Url = "http://127.0.0.1:" .. port .. "/",
                    Method = "GET",
                    Headers = {["Content-Type"] = "application/json"}
                })
            end

            if http and http.request then
                return http.request({
                    Url = "http://127.0.0.1:" .. port .. "/",
                    Method = "GET",
                    Headers = {["Content-Type"] = "application/json"}
                })
            end

            if request then
                return request({
                    Url = "http://127.0.0.1:" .. port .. "/",
                    Method = "GET",
                    Headers = {["Content-Type"] = "application/json"}
                })
            end

            return nil
        end)

        if ok and res then
            if type(res) == "table" then
                if res.Success ~= false and (res.StatusCode == nil or res.StatusCode >= 200) then
                    return true
                end
            elseif type(res) == "string" then
                if res ~= "" then
                    return true
                end
            end
        end
    end

    return false
end

local function createLockGui()
    local gui = Instance.new("ScreenGui")
    gui.Name = "Lx_DiscordGuard"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 999999
    gui.Parent = PG

    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromOffset(430, 220)
    bg.Position = UDim2.new(0.5, -215, 0.5, -110)
    bg.BackgroundColor3 = Color3.fromRGB(15,15,18)
    bg.BorderSizePixel = 0
    bg.Parent = gui
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 16)
    c.Parent = bg

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(239, 28, 37)
    stroke.Thickness = 1.5
    stroke.Parent = bg

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -30, 0, 42)
    title.Position = UDim2.fromOffset(15, 18)
    title.BackgroundTransparency = 1
    title.Text = "🔒 Discord مطلوب"
    title.TextColor3 = Color3.fromRGB(255,255,255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 18
    title.Parent = bg

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -30, 0, 82)
    status.Position = UDim2.fromOffset(15, 62)
    status.BackgroundTransparency = 1
    status.Text = "يجب أن يكون Discord مفتوحًا ومسجلًا داخل الحساب الحقيقي.\nالسكربت مقفل حتى يتم التحقق."
    status.TextColor3 = Color3.fromRGB(188, 191, 198)
    status.Font = Enum.Font.Gotham
    status.TextSize = 13
    status.TextWrapped = true
    status.Parent = bg

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -30, 0, 42)
    btn.Position = UDim2.new(0, 15, 1, -54)
    btn.Text = "فتح رابط Discord"
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.BackgroundColor3 = Color3.fromRGB(239, 28, 37)
    btn.Parent = bg
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        pcall(function()
            if setclipboard then
                setclipboard(DISCORD_INVITE)
            end
        end)
    end)

    return gui, status
end

local function lockScript()
    local guardGui, status = createLockGui()

    while true do
        if discordIsAlive() then
            status.Text = "✅ تم التحقق من Discord\nجارٍ فتح السكربت..."
            task.wait(1)
            guardGui:Destroy()
            return true
        else
            status.Text = "❌ Discord غير مفتوح أو غير متصل\nيجب الدخول للحساب الحقيقي أولاً."
            task.wait(2)
        end
    end
end

local function monitorDiscord()
    task.spawn(function()
        while true do
            task.wait(2)

            if not discordIsAlive() then
                local guardGui, status = createLockGui()
                status.Text = "❌ تم اكتشاف خروجك من Discord\nتم قفل السكربت مؤقتًا."

                while not discordIsAlive() do
                    status.Text = "❌ Discord خارج الخدمة\nانتظر حتى تعود إليه."
                    task.wait(2)
                end

                guardGui:Destroy()
            end
        end
    end)
end

-- Start guard
local passed = lockScript()
if not passed then
    warn("Discord guard failed")
    return
end


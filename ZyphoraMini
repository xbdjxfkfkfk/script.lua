        TextColor3 = C.muted,
        TextXAlignment = Enum.TextXAlignment.Left
    }, f)
    
    local switch = inst("TextButton", {
        Size = UDim2.fromOffset(45, 25),
        Position = UDim2.new(1, -55, 0.5, -12),
        BackgroundColor3 = Color3.fromRGB(50, 50, 60),
        Text = "",
        BorderSizePixel = 0
    }, f)
    round(switch, 12)
    
    local circle = inst("Frame", {
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(0, 2, 0.5, -10),
        BackgroundColor3 = C.white,
        BorderSizePixel = 0
    }, switch)
    round(circle, 10)
    
    local on = false
    
    local function update()
        if on then
            game:GetService("TweenService"):Create(circle, TweenInfo.new(0.2), {
                Position = UDim2.new(1, -22, 0.5, -10)
            }):Play()
            game:GetService("TweenService"):Create(switch, TweenInfo.new(0.2), {
                BackgroundColor3 = C.accent
            }):Play()
        else
            game:GetService("TweenService"):Create(circle, TweenInfo.new(0.2), {
                Position = UDim2.new(0, 2, 0.5, -10)
            }):Play()
            game:GetService("TweenService"):Create(switch, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            }):Play()
        end
    end
    
    conn(switch.MouseButton1Click, function()
        on = not on
        S[key] = on
        update()
    end)
    
    return f
end

-- Slider component
local function slider(p, title, desc, key, min, max, default, order)
    local f = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 65),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0,
        LayoutOrder = order or 1
    }, p)
    round(f, 8)
    
    inst("TextLabel", {
        Size = UDim2.new(0.7, 0, 0, 20),
        Position = UDim2.fromOffset(10, 5),
        BackgroundTransparency = 1,
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = C.white,
        TextXAlignment = Enum.TextXAlignment.Left
    }, f)
    
    local valLabel = inst("TextLabel", {
        Size = UDim2.new(0.25, 0, 0, 20),
        Position = UDim2.new(0.75, -5, 0, 5),
        BackgroundTransparency = 1,
        Text = tostring(default),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = C.accent,
        TextXAlignment = Enum.TextXAlignment.Right
    }, f)
    
    inst("TextLabel", {
        Size = UDim2.new(1, -20, 0, 18),
        Position = UDim2.fromOffset(10, 25),
        BackgroundTransparency = 1,
        Text = desc or "",
        Font = Enum.Font.Gotham,
        TextSize = 10,
        TextColor3 = C.muted,
        TextXAlignment = Enum.TextXAlignment.Left
    }, f)
    
    local sliderBg = inst("Frame", {
        Size = UDim2.new(1, -20, 0, 6),
        Position = UDim2.fromOffset(10, 48),
        BackgroundColor3 = Color3.fromRGB(40, 40, 50),
        BorderSizePixel = 0
    }, f)
    round(sliderBg, 3)
    
    local fill = inst("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0
    }, sliderBg)
    round(fill, 3)
    
    local handle = inst("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new((default - min) / (max - min), -8, 0.5, -8),
        BackgroundColor3 = C.white,
        BorderSizePixel = 0
    }, sliderBg)
    round(handle, 8)
    
    S[key] = default
    
    local dragging = false
    
    local function update(input)
        local rel = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * rel)
        S[key] = val
        valLabel.Text = tostring(val)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        handle.Position = UDim2.new(rel, -8, 0.5, -8)
    end
    
    conn(handle.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)
    
    conn(sliderBg.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input)
        end
    end)
    
    conn(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    conn(UIS.InputChanged, function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input)
        end
    end)
    
    return f
end


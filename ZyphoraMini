label.Position = UDim2.new(0.5, 0, 0.05, 0)
label.Size = UDim2.new(0.85, 0, 0, 54)
label.BackgroundColor3 = Color3.fromRGB(12, 22, 38)
label.BackgroundTransparency = 0.12
label.TextColor3 = Color3.fromRGB(235, 246, 255)
label.TextScaled = true
label.TextWrapped = true
label.Font = Enum.Font.GothamSemibold
label.Text = "NOVA Admin Cuffs | صوب على لاعب قريب واضغط لتقييده أو فكّه"

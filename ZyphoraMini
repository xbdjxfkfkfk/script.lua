-- ESP
local function clearESP()
    for _, obj in pairs(espObjects) do
        if obj and obj.Parent then
            obj:Destroy()
        end
    end
    table.clear(espObjects)
end

local function updateESP()
    if not S.ESP then
        clearESP()
        return
    end
    
    local r = root()
    if not r then return end
    
    for _, v in pairs(WS:GetDescendants()) do
        if v:IsA("Model") and not espObjects[v] then
            local name = v.Name:lower()
            if name:find("dhab") or name:find("lizard") or name:find("ضب") then
                local p = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                if p then
                    local d = (p.Position - r.Position).Magnitude
                    if d < 2000 then
                        local bb = inst("BillboardGui", {
                            Adornee = p,
                            Size = UDim2.fromOffset(150, 40),
                            StudsOffset = Vector3.new(0, 3, 0),
                            AlwaysOnTop = true,
                            Parent = gui
                        }, gui)
                        
                        inst("TextLabel", {
                            Size = UDim2.fromScale(1, 1),
                            BackgroundTransparency = 1,
                            Text = v.Name .. "\n" .. math.floor(d) .. "m",
                            TextColor3 = C.accent,
                            Font = Enum.Font.GothamBold,
                            TextSize = 11,
                            TextStrokeTransparency = 0.5
                        }, bb)
                        
                        espObjects[v] = bb
                    end
                end
            end
        end
    end
    
    -- Clean far objects
    for m, obj in pairs(espObjects) do
        if not m.Parent then
            obj:Destroy()
            espObjects[m] = nil
        end
    end
end

-- Aimbot
local aimConn = nil

local function startAim()
    if aimConn then aimConn:Disconnect() end
    
    aimConn = RunService.RenderStepped:Connect(function(dt)
        if not S.Aim then return end
        
        local cam = WS.CurrentCamera
        local r = root()
        if not cam or not r then return end
        
        local vp = cam.ViewportSize
        local center = Vector2.new(vp.X / 2, vp.Y / 2)
        local radius = S.FOV / 2
        
        local closest, dist = nil, math.huge
        
        for _, v in pairs(WS:GetDescendants()) do
            if v:IsA("Model") then
                local name = v.Name:lower()
                if name:find("dhab") or name:find("lizard") or name:find("ضب") then
                    local head = v:FindFirstChild("Head") or v:FindFirstChildWhichIsA("BasePart")
                    if head then
                        local d = (head.Position - r.Position).Magnitude
                        if d <= S.AimRange then
                            local pos, onScreen = cam:WorldToViewportPoint(head.Position)
                            if onScreen then
                                local pd = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                                if pd <= radius and pd < dist then
                                    closest = head
                                    dist = pd
                                end
                            end
                        end
                    end
                end
            end
        end
        
        if closest then
            local target = CFrame.lookAt(cam.CFrame.Position, closest.Position)
            local alpha = 1 - math.exp(-(S.AimSmooth / 10) * 30 * dt)
            cam.CFrame = cam.CFrame:Lerp(target, math.clamp(alpha, 0, 1))
        end
    end)
end

local function stopAim()
    if aimConn then
        aimConn:Disconnect()
        aimConn = nil
    end
end

-- Car Fly
local flyVel = nil

local function updateCarFly()
    if not S.CarFly then
        if flyVel then
            flyVel:Destroy()
            flyVel = nil
        end
        return
    end
    
    local h = hum()
    if not h or not h.SeatPart then return end
    
    local seat = h.SeatPart
    local body = seat.AssemblyRootPart or seat
    
    if not flyVel or not flyVel.Parent then
        flyVel = Instance.new("LinearVelocity")
        flyVel.MaxForce = math.huge
        flyVel.Parent = body
    end
    
    local cam = WS.CurrentCamera
    if not cam then return end
    
    local dir = Vector3.new()
    if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.E) then dir = dir + Vector3.new(0, 1, 0) end
    if UIS:IsKeyDown(Enum.KeyCode.Q) then dir = dir - Vector3.new(0, 1, 0) end
    
    flyVel.VectorVelocity = dir * S.CarFlySpeed
end

-- Visuals
local savedLight = {}

local function updateVisuals()
    if S.Fullbright then
        if not savedLight.Brightness then
            savedLight.Brightness = Lighting.Brightness
            savedLight.Ambient = Lighting.Ambient
        end
        Lighting.Brightness = 3
        Lighting.Ambient = Color3.fromRGB(200, 200, 200)
        Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
    elseif savedLight.Brightness then
        Lighting.Brightness = savedLight.Brightness
        Lighting.Ambient = savedLight.Ambient
    end
    
    if S.FogRemove then
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0
    end
end

--====================================
-- MAIN LOOP
--====================================

conn(RunService.Heartbeat, function(dt)
    if not alive then return end
    
    -- ESP
    updateESP()
    
    -- Aim
    if S.Aim and not aimConn then
        startAim()
    elseif not S.Aim and aimConn then
        stopAim()
    end
    
    -- Car Fly
    updateCarFly()
    
    -- Visuals
    updateVisuals()
    
    -- Walk Speed
    if S.WalkSpeed then
        local h = hum()
        if h then
            h.WalkSpeed = S.SpeedValue
        end
    end
    
    -- Anti-AFK
    if S.AntiAFK then
        pcall(function()
            local h = hum()
            if h then
                h:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end)


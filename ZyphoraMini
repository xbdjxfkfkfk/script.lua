    if obj:IsA("Model") and not isVehicleModel(obj) then
        task.defer(function()
            if alive and obj.Parent and lizard(obj) and living(obj) then
                indexed[obj] = true
            end
        end)
    end
end)

conn(WS.DescendantRemoving, function(obj)

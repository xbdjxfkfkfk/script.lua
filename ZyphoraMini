local flyAllowed = false
local flightConnection, velocity, attachment, flyHumanoid
local verticalTouch = 0
local upDownFrame = obj("Frame", gui, {
    Size = UDim2.fromOffset(78, 144), Position = UDim2.new(1, -88, .5, -70),
    BackgroundTransparency = 1, Visible = false
})
local up = button(upDownFrame, "▲", 2, 0, 74, 62, function() end, C.itemHi)
local down = button(upDownFrame, "▼", 2, 75, 74, 62, function() end, C.itemHi)
local function hold(btn, val)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            verticalTouch = val
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            if verticalTouch == val then verticalTouch = 0 end
        end
    end)
end
hold(up, 1)
hold(down, -1)
local function stopFlight()
    if flightConnection then flightConnection:Disconnect() flightConnection = nil end
    if velocity then velocity:Destroy() velocity = nil end
    if attachment then attachment:Destroy() attachment = nil end
    if flyHumanoid and flyHumanoid.Parent then
        flyHumanoid.PlatformStand = false
        flyHumanoid.AutoRotate = true
    end
    flyHumanoid = nil
    verticalTouch = 0
    upDownFrame.Visible = false
end
local function startFlight()
    stopFlight()
    if not flyAllowed then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end
    flyHumanoid = hum
    attachment = obj("Attachment", root, {Name = "NOVA_FlyAttachment"})
    velocity = obj("LinearVelocity", root, {
        Name = "NOVA_FlyVelocity", Attachment0 = attachment,
        MaxForce = 1e9, ForceLimitsEnabled = false,
        RelativeTo = Enum.ActuatorRelativeTo.World,
        VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
        VectorVelocity = Vector3.zero
    })
    hum.PlatformStand = true
    hum.AutoRotate = false
    upDownFrame.Visible = UIS.TouchEnabled
    flightConnection = RunService.RenderStepped:Connect(function()
        if not flyAllowed or not root.Parent or not hum.Parent or player.Character ~= char then
            stopFlight()
            return
        end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        local forward = Vector3.new(look.X, 0, look.Z)
        local side = Vector3.new(right.X, 0, right.Z)
        if forward.Magnitude > 0 then forward = forward.Unit end
        if side.Magnitude > 0 then side = side.Unit end
        local motion = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then motion += forward end
        if UIS:IsKeyDown(Enum.KeyCode.S) then motion -= forward end
        if UIS:IsKeyDown(Enum.KeyCode.D) then motion += side end
        if UIS:IsKeyDown(Enum.KeyCode.A) then motion -= side end
        if motion.Magnitude < 0.01 and UIS.TouchEnabled then
            motion = hum.MoveDirection
        end
        if motion.Magnitude > 1 then motion = motion.Unit end
        local upValue = verticalTouch
        if UIS:IsKeyDown(Enum.KeyCode.Space) then upValue = 1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl) then upValue = -1 end
        velocity.VectorVelocity = (motion + Vector3.new(0, upValue, 0)) * flySpeed
    end)
end
player.CharacterAdded:Connect(function()
    stopFlight()
    if flyAllowed then
        task.delay(1, function() if flyAllowed then startFlight() end end)
    end
end)

-- Helpers
local function conn(signal, fn)
    local c = signal:Connect(fn)
    table.insert(conns, c)
    return c
end

local function inst(typ, props, parent)
    local x = Instance.new(typ)
    for k, v in pairs(props or {}) do pcall(function() x[k] = v end) end
    x.Parent = parent
    return x
end

local function round(x, r) inst("UICorner", {CornerRadius = UDim.new(0, r or 8)}, x) end

local function root()

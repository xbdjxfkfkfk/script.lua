    local minus = create("TextButton", {Position = UDim2.fromOffset(8, 32), Size = UDim2.fromOffset(34, 33),
        Text = "−", TextSize = 20, TextColor3 = COLORS.white,
        BackgroundColor3 = COLORS.dark}, f)
    corner(minus, 6)
    local plus = create("TextButton", {Position = UDim2.new(1, -43, 0, 32), Size = UDim2.fromOffset(34, 33),
        Text = "+", TextSize = 20, TextColor3 = COLORS.white,
        BackgroundColor3 = COLORS.dark}, f)
    corner(plus, 6)
    local function commit(raw)
        local parsed = convertNumber(raw)
        if not parsed then log("اكتب رقمًا صحيحًا: " .. title) field.Text = tostring(current) return end
        local proposed = math.clamp(parsed, minValue, maxValue)
        local ok, reason = setter(proposed)
        if ok == true then current = proposed else log(reason or "فشل تحديث الرقم", true) end
        field.Text = tostring(current)
    end
    connect(field.FocusLost, function() commit(field.Text) end)
    connect(minus.MouseButton1Click, function() commit(current - increment) end)
    connect(plus.MouseButton1Click, function() commit(current + increment) end)
    return field
end


    if not (root and hum) then say("الشخصية غير جاهزة",false); return end
    stopFly()
    flyOn=true
    hum.PlatformStand=true
    hum.AutoRotate=false
    local attach=new("Attachment",root,{Name="NOVA12_FlightAttachment"})
    local linear=new("LinearVelocity",root,{Name="NOVA12_FlightForce",Attachment0=attach,

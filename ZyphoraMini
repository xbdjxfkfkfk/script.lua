local connections = {}
local function bind(signal, callback)
    local conn = signal:Connect(callback)
    table.insert(connections, conn)
    return conn
end
local function make(className, parent, properties)
    local obj = Instance.new(className)
    for k, v in pairs(properties or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end
local function round(obj, radius)
    make("UICorner", obj, {CornerRadius = UDim.new(0, radius or 9)})
end
local function text(parent, value, position, size, fontSize, color, bold)
    return make("TextLabel", parent, {
        BackgroundTransparency = 1,
        Position = position,
        Size = size,
        Text = value,
        TextColor3 = color or C.white,
        Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextSize = fontSize or 14,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
end
local function button(parent, value, position, size, callback, background)
    local b = make("TextButton", parent, {
        BackgroundColor3 = background or C.button,
        BorderSizePixel = 0,
        Position = position,
        Size = size,
        Text = value,
        Font = Enum.Font.GothamBold,
        TextColor3 = C.white,
        TextSize = 14,
        TextWrapped = true,
        AutoButtonColor = true,
    })
    round(b, 8)
    bind(b.Activated, callback)
    return b
end
local function inputBox(parent, defaultText, position, size)
    local b = make("TextBox", parent, {
        Position = position,
        Size = size,
        BackgroundColor3 = C.button,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Text = defaultText,
        TextColor3 = C.white,
        PlaceholderColor3 = C.muted,
        Font = Enum.Font.Gotham,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    round(b, 8)
    return b
end


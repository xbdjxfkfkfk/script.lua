-- Independent lightweight updates: only movement is per frame.
local elapsed, noclipElapsed, lastVisualError = 0, 0, 0
listen(RunService.Heartbeat, function(dt)
    if not alive then return end
    noclipElapsed = noclipElapsed + dt
    if noclipElapsed >= .15 then
        noclipElapsed = 0
        if state.Noclip then applyNoclip() end
    end
end)
listen(RunService.RenderStepped, function(dt)
    if not alive then return end
    if state.Fly then updateFlight() end
    elapsed = elapsed + dt
    if elapsed >= .75 then
        elapsed = 0
        if state.LocalInvisible then applyLocalInvisible() end
        if state.Speed then applySpeed() end
        if state.ESP or state.AdminESP then
            local ok, err = pcall(refreshHighlights)
            if not ok and os.clock() - lastVisualError > 10 then
                lastVisualError = os.clock()
                warn("NOVA player vision: " .. safeText(err))
                say("مشكلة مؤقتة في كشف اللاعبين؛ افتح وحدة التحكم لقراءة التفاصيل", false)
            end
        end
    end
end)

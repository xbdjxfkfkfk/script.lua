-- Lx REDLINE PRO | Movement Monitor
-- Client-side movement diagnostics. Does not bypass server protections.
local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local UIS = game:GetService('UserInputService')
local player = Players.LocalPlayer
local guiParent = player:WaitForChild('PlayerGui')
local previous = guiParent:FindFirstChild('LxMovementMonitor')
if previous then previous:Destroy() end
local gui = Instance.new('ScreenGui')
gui.Name = 'LxMovementMonitor'
gui.ResetOnSpawn = false
gui.Parent = guiParent
local frame = Instance.new('Frame')
frame.Size = UDim2.fromOffset(320, 285)
frame.Position = UDim2.new(0, 35, 0.5, -140)
frame.BackgroundColor3 = Color3.fromRGB(19,19,23)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui
Instance.new('UICorner', frame).CornerRadius = UDim.new(0,12)
local stroke = Instance.new('UIStroke', frame)
stroke.Color = Color3.fromRGB(220,40,52)
stroke.Thickness = 2
local function label(text, y, size, color)
 local l = Instance.new('TextLabel')
 l.BackgroundTransparency = 1
 l.Size = UDim2.new(1,-24,0,32)
 l.Position = UDim2.fromOffset(12,y)
 l.Text = text
 l.TextColor3 = color or Color3.new(1,1,1)
 l.Font = Enum.Font.GothamBold
 l.TextSize = size or 14
 l.TextXAlignment = Enum.TextXAlignment.Left
 l.Parent = frame
 return l
end
label('Lx REDLINE PRO  |  Movement Monitor', 12, 16, Color3.fromRGB(255,76,86))
local status = label('الحالة: المراقبة مفعّلة', 53)
local speed = label('السرعة: --', 90)
local position = label('الإحداثيات: --', 124, 12)
local jumps = label('انتقالات مفاجئة: 0', 158)
local note = label('تنبيه: الانتقال المفاجئ لا يثبت وجود حماية', 190, 11, Color3.fromRGB(188,188,188))
local function button(txt,x,callback)
 local b=Instance.new('TextButton')
 b.Size=UDim2.fromOffset(140,35)
 b.Position=UDim2.fromOffset(x,233)
 b.BackgroundColor3=Color3.fromRGB(165,28,40)
 b.TextColor3=Color3.new(1,1,1)
 b.Font=Enum.Font.GothamBold
 b.TextSize=13
 b.Text=txt
 b.Parent=frame
 Instance.new('UICorner',b).CornerRadius=UDim.new(0,7)
 b.MouseButton1Click:Connect(callback)
 return b
end
local enabled=true
local count=0
local lastPosition=nil
local lastTime=nil
local toggle
local function reset()
 count=0
 jumps.Text='انتقالات مفاجئة: 0'
 lastPosition=nil
 lastTime=nil
end
toggle=button('إيقاف المراقبة',12,function()
 enabled=not enabled
 toggle.Text=enabled and 'إيقاف المراقبة' or 'تشغيل المراقبة'
 status.Text=enabled and 'الحالة: المراقبة مفعّلة' or 'الحالة: المراقبة متوقفة'
 lastPosition=nil
 lastTime=nil
end)
button('تصفير العداد',168,reset)
local elapsed=0
local conn
conn=RunService.Heartbeat:Connect(function(dt)
 if not gui.Parent then conn:Disconnect() return end
 if not enabled then return end
 elapsed=elapsed+dt
 if elapsed<0.15 then return end
 elapsed=0
 local char=player.Character
 local root=char and char:FindFirstChild('HumanoidRootPart')
 if not root then speed.Text='السرعة: بانتظار الشخصية';return end
 local now=os.clock()
 local p=root.Position
 speed.Text=string.format('السرعة: %.1f studs/s',root.AssemblyLinearVelocity.Magnitude)
 position.Text=string.format('الإحداثيات: X %.0f | Y %.0f | Z %.0f',p.X,p.Y,p.Z)
 if lastPosition and lastTime then
  local duration=now-lastTime
  local displacement=(p-lastPosition).Magnitude
  if duration>0 and displacement>80 and displacement/duration>140 then
   count=count+1
   jumps.Text='انتقالات مفاجئة: '..count
  end
 end
 lastPosition=p
 lastTime=now
end)
player.CharacterAdded:Connect(reset)

mkSection("Visuals")

local EspConn
local function stripEsp(char)
    if char then
        local h = char:FindFirstChild("ZyHighlight")
        if h then h:Destroy() end
    end
end
local function applyEsp(char)
    if not char or not S.ESP or char:FindFirstChild("ZyHighlight") then return end
    local h = Instance.new("Highlight")
    h.Name = "ZyHighlight"
    h.FillColor = C.accent
    h.FillTransparency = 0.5
    h.OutlineColor = Color3.fromRGB(255, 255, 255)
    h.Adornee = char
    h.Parent = char
end
local function wireEsp(p)
    if p == LP then return end
    applyEsp(p.Character)
    p.CharacterAdded:Connect(function(c) task.wait(0.2); applyEsp(c) end)
end

mkBtn("👁  ESP", function(b, bar)
    toggle(b, bar, "👁  ESP", "ESP",
        function()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then applyEsp(p.Character) end
            end
            for _, p in ipairs(Players:GetPlayers()) do wireEsp(p) end
            EspConn = Players.PlayerAdded:Connect(wireEsp)
        end,
        function()
            if EspConn then EspConn:Disconnect(); EspConn = nil end
            for _, p in ipairs(Players:GetPlayers()) do stripEsp(p.Character) end
        end)
end)

local origBright, origAmb
mkBtn("💡  Fullbright", function(b, bar)

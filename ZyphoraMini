end

-- Server visibility affects other clients. Local-only replicas retain your view of yourself.
local function clearLocalCopy()
    if cloneFolder then cloneFolder:Destroy();cloneFolder=nil end
end
local function takeSnapshot()
    local snapshot={}
    local char=me.Character
    if not char then return snapshot end
    for _,obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name~="HumanoidRootPart" and obj.Transparency<1 then
            snapshot[obj]=obj.Transparency
        end
    end
    return snapshot
end
local function localCopy(snapshot)
    clearLocalCopy()
    local folder=make("Folder",workspace,{Name="NOVA_v13_LocalAppearance"})
    cloneFolder=folder
    for part,alpha in pairs(snapshot) do
        if part and part.Parent then
            local ok,copy=pcall(function() return part:Clone() end)
            if ok and copy and copy:IsA("BasePart") then
                for _,item in ipairs(copy:GetDescendants()) do
                    local keep=item:IsA("SpecialMesh") or item:IsA("SurfaceAppearance")
                        or item:IsA("Decal") or item:IsA("Texture")
                    if not keep then item:Destroy() end
                end
                copy.Transparency=alpha
                copy.CanCollide=false
                copy.CanTouch=false
                copy.CanQuery=false
                copy.Anchored=false
                copy.Massless=true
                copy.CFrame=part.CFrame
                copy.Parent=folder
                make("WeldConstraint",copy,{Part0=part,Part1=copy})
            end
        end
    end
end
local function toggleHide()
    if not isAdmin then
        message("الإخفاء عن الآخرين يحتاج صلاحية سيرفر في مابك",false)
        return
    end
    local wanted=not selfHidden
    local snapshot=wanted and takeSnapshot() or nil
    serverCall("hide",wanted,function(result)
        if not result.ok then return end
        selfHidden=wanted
        if wanted then localCopy(snapshot) else clearLocalCopy() end
    end)
end

local function stopFlight()
    flight=false; upPressed=false; downPressed=false
    if flightConn then flightConn:Disconnect();flightConn=nil end
    for _,o in ipairs(flightInstances) do
        if o and o.Parent then o:Destroy() end
    end
    table.clear(flightInstances)
    local hum=getHum(me)
    if hum then hum.PlatformStand=false;hum.AutoRotate=true end
    if flyControls then flyControls.Visible=false end
end
local function toggleFlight()
    if flight then stopFlight();message("الطيران متوقف",true);return end
    local root=getRoot(me)
    local hum=getHum(me)
    if not (root and hum) then message("انتظر تحميل شخصيتك",false);return end
    stopFlight()
    flight=true
    hum.PlatformStand=true
    hum.AutoRotate=false
    local a=make("Attachment",root,{Name="NOVAFlightAttachment"})
    local lv=make("LinearVelocity",root,{
        Name="NOVAFlightVelocity",Attachment0=a,
        VelocityConstraintMode=Enum.VelocityConstraintMode.Vector,
        RelativeTo=Enum.ActuatorRelativeTo.World,
        MaxForce=100000000, VectorVelocity=Vector3.zero,
    })
    local ao=make("AlignOrientation",root,{
        Name="NOVAFlightRotation",Attachment0=a,Mode=Enum.OrientationAlignmentMode.OneAttachment,
        MaxTorque=100000000,Responsiveness=15,
    })
    flightInstances={a,lv,ao}
    flightConn=RunService.Heartbeat:Connect(function()
        if not root.Parent or not hum.Parent then stopFlight();return end
        local y=0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or upPressed then y+=1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or downPressed then y-=1 end
        local dir=hum.MoveDirection+Vector3.new(0,y,0)
        if dir.Magnitude>1 then dir=dir.Unit end
        lv.VectorVelocity=dir*55
        local cam=workspace.CurrentCamera
        if cam then
            local forward=cam.CFrame.LookVector
            local flat=Vector3.new(forward.X,0,forward.Z)
            if flat.Magnitude>0.02 then ao.CFrame=CFrame.lookAt(Vector3.zero,flat.Unit) end
        end
    end)
    if flyControls then flyControls.Visible=true end
    message("الطيران المحلي شغال | WASD + Space/Ctrl أو أزرار الجوال",true)
end

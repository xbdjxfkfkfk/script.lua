local flying=false
local flyConnection,flyAttachment,flyVelocity,flyAlign
local upHeld,downHeld=false,false
local function stopFly()
    flying=false
    if flyConnection then flyConnection:Disconnect(); flyConnection=nil end
    if flyVelocity then flyVelocity:Destroy(); flyVelocity=nil end
    if flyAlign then flyAlign:Destroy(); flyAlign=nil end
    if flyAttachment then flyAttachment:Destroy(); flyAttachment=nil end
    local h=me.Character and me.Character:FindFirstChildOfClass("Humanoid")
    if h then h.PlatformStand=false; h.AutoRotate=true end
end
local flyBtn
local function startFly()
    local c=me.Character
    local h=c and c:FindFirstChildOfClass("Humanoid")
    local root=c and c:FindFirstChild("HumanoidRootPart")
    if not h or not root then note("الشخصية غير جاهزة للطيران") return end
    if flying then return end
    flying=true
    flyAttachment=new("Attachment",root,{Name="NOVA_FlyPoint"})
    flyVelocity=new("LinearVelocity",root,{
        Attachment0=flyAttachment,RelativeTo=Enum.ActuatorRelativeTo.World,
        MaxForce=math.huge,ForceLimitsEnabled=false,VectorVelocity=Vector3.zero
    })
    flyAlign=new("AlignOrientation",root,{
        Attachment0=flyAttachment,Mode=Enum.OrientationAlignmentMode.OneAttachment,
        MaxTorque=math.huge,Responsiveness=15
    })
    h.PlatformStand=true
    flyConnection=RunService.Heartbeat:Connect(function()
        if not root.Parent or not h.Parent then stopFly(); return end
        local camera=workspace.CurrentCamera
        if not camera then return end
        local motion=h.MoveDirection
        local vertical=0
        if UIS:IsKeyDown(Enum.KeyCode.Space) or upHeld then vertical+=1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or downHeld then vertical-=1 end
        local direction=motion+Vector3.new(0,vertical,0)
        if direction.Magnitude>1 then direction=direction.Unit end
        flyVelocity.VectorVelocity=direction*65
        local flat=Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z)
        if flat.Magnitude>.02 then
            flyAlign.CFrame=CFrame.lookAt(Vector3.zero,flat)
        end
    end)
end

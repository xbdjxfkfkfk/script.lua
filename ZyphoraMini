localScript.Source = [=[-- NOVA Admin Cuffs | LocalScript inside the Tool stored in ServerStorage.
-- Client only selects a player; the server makes all permission/action decisions.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

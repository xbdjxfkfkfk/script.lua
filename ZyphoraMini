local aimBinding='Lx_NexusAimV45'
RunService:BindToRenderStep(aimBinding,Enum.RenderPriority.Camera.Value+1,function(dt)
 if not alive then return end
 local cam=WS.CurrentCamera
 updateCircle(cam)
 if not S.Aim or not cam then return end
 local r=root();if not r then return end
 local vp=cam.ViewportSize
 local center=Vector2.new(vp.X*.5,vp.Y*.5)
 local best,bestPixelDistance=nil,math.huge
 for _,e in ipairs(cache) do
  if e.model.Parent and e.part.Parent and lizard(e.model) and living(e.model) then
   local worldDistance=(e.part.Position-r.Position).Magnitude
   if worldDistance<=S.AimRange then
    local point,onScreen=cam:WorldToViewportPoint(e.part.Position)
    if onScreen and point.Z>0 then
     local pixelDistance=(Vector2.new(point.X,point.Y)-center).Magnitude
     if pixelDistance<=S.FOV and pixelDistance<bestPixelDistance then
      best=e
      bestPixelDistance=pixelDistance
     end
    end
   end
  end
 end
 if best then
  local desired=CFrame.lookAt(cam.CFrame.Position,best.part.Position)
  local alpha=1-math.exp(-math.clamp(S.AimSmooth,.02,1)*30*math.min(dt,.1))
  cam.CFrame=cam.CFrame:Lerp(desired,math.clamp(alpha,0,1))
 end
end)

serverScript.Source = [=[-- NOVA Admin Cuffs | ServerScriptService
-- For Roblox experiences you own or are authorized to develop.
-- Uses server-side permission checks. Does not bypass other games' admin systems.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local CONFIG = {
    MAX_DISTANCE = 12,             -- studs
    MAX_RESTRAINT_SECONDS = 60,    -- automatic release; change for your game
    ACTION_COOLDOWN = 0.4,
    ADMIN_USER_IDS = {
        -- [123456789] = true,      -- add trusted Roblox UserIds here
    },
}

local function isAdmin(player)
    if not player or player.Parent ~= Players then return false end
    if CONFIG.ADMIN_USER_IDS[player.UserId] == true then return true end
    return game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId
end

local toolTemplate = ServerStorage:WaitForChild("NOVA_AdminCuffs", 15)
if not toolTemplate or not toolTemplate:IsA("Tool") then
    warn("[NOVA Cuffs] ServerStorage.NOVA_AdminCuffs Tool was not found. Run the installer in Studio.")
    return
end

local remoteFolder = ReplicatedStorage:FindFirstChild("NOVA_AdminCuffs_Remotes")
if not remoteFolder then
    remoteFolder = Instance.new("Folder")
    remoteFolder.Name = "NOVA_AdminCuffs_Remotes"
    remoteFolder.Parent = ReplicatedStorage
end

local actionRemote = remoteFolder:FindFirstChild("Action")
if not actionRemote then
    actionRemote = Instance.new("RemoteEvent")
    actionRemote.Name = "Action"
    actionRemote.Parent = remoteFolder
end

local feedbackRemote = remoteFolder:FindFirstChild("Feedback")
if not feedbackRemote then
    feedbackRemote = Instance.new("RemoteEvent")
    feedbackRemote.Name = "Feedback"
    feedbackRemote.Parent = remoteFolder
end

local restraints = {}  -- [UserId] = {humanoid, root, saved, officerId, deathConnection}
local lastAction = {}  -- [UserId] = os.clock()

local function notify(player, succeeded, message)
    if player and player.Parent == Players then
        feedbackRemote:FireClient(player, succeeded, message)
    end
end

local function releasePlayer(target, reason)
    if not target then return false end
    local entry = restraints[target.UserId]
    if not entry then return false end
    restraints[target.UserId] = nil

    if entry.deathConnection then
        entry.deathConnection:Disconnect()
        entry.deathConnection = nil
    end
    if entry.humanoid and entry.humanoid.Parent then
        entry.humanoid.WalkSpeed = entry.walkSpeed
        entry.humanoid.JumpPower = entry.jumpPower
        entry.humanoid.JumpHeight = entry.jumpHeight
        entry.humanoid.AutoRotate = entry.autoRotate
    end
    if entry.root and entry.root.Parent then
        entry.root.Anchored = entry.wasAnchored
    end
    if target.Parent == Players then
        target:SetAttribute("NOVA_IsCuffed", false)
        notify(target, true, reason or "تم فك التقييد.")
    end
    return true
end

local function equippedValidTool(player)
    local character = player.Character
    if not character then return false end
    local tool = character:FindFirstChild(toolTemplate.Name)
    return tool ~= nil and tool:IsA("Tool")
end

local function getLivingCharacter(player)
    local character = player.Character
    if not character then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
        return nil
    end
    return humanoid, root
end

local function grantTool(player)
    if not isAdmin(player) then return end
    local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 10)
    if not backpack then return end
    if backpack:FindFirstChild(toolTemplate.Name) then return end
    if player.Character and player.Character:FindFirstChild(toolTemplate.Name) then return end
    local tool = toolTemplate:Clone()
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.Parent = backpack
end

actionRemote.OnServerEvent:Connect(function(officer, targetId)
    if not isAdmin(officer) then return end
    if type(targetId) ~= "number" or targetId % 1 ~= 0 then
        notify(officer, false, "هدف غير صالح.")
        return
    end
    local now = os.clock()
    if lastAction[officer.UserId] and now - lastAction[officer.UserId] < CONFIG.ACTION_COOLDOWN then
        return
    end
    lastAction[officer.UserId] = now

    if not equippedValidTool(officer) then
        notify(officer, false, "جهّز أداة NOVA Admin Cuffs الأصلية أولًا.")
        return
    end
    local target = Players:GetPlayerByUserId(targetId)
    if not target or target == officer then
        notify(officer, false, "اختر لاعبًا آخر داخل السيرفر.")
        return
    end

    -- Admins may release a cuffed player remotely in an emergency.
    if restraints[target.UserId] then
        releasePlayer(target, "تم فك تقييدك بواسطة الأدمن.")
        notify(officer, true, "تم فك تقييد " .. target.DisplayName)
        return
    end

    if isAdmin(target) then
        notify(officer, false, "لا يمكن تقييد أدمن آخر بهذه الأداة.")
        return
    end
    local officerHum, officerRoot = getLivingCharacter(officer)
    local targetHum, targetRoot = getLivingCharacter(target)
    if not officerHum or not officerRoot or not targetHum or not targetRoot then
        notify(officer, false, "يجب أن تكون الشخصيتان موجودتين وعلى قيد الحياة.")
        return
    end
    if (officerRoot.Position - targetRoot.Position).Magnitude > CONFIG.MAX_DISTANCE then
        notify(officer, false, "اقترب من اللاعب: الحد الأقصى " .. CONFIG.MAX_DISTANCE .. " studs.")
        return
    end

    local entry = {
        humanoid = targetHum,
        root = targetRoot,
        walkSpeed = targetHum.WalkSpeed,
        jumpPower = targetHum.JumpPower,
        jumpHeight = targetHum.JumpHeight,
        autoRotate = targetHum.AutoRotate,
        wasAnchored = targetRoot.Anchored,
        officerId = officer.UserId,
    }
    restraints[target.UserId] = entry
    target:SetAttribute("NOVA_IsCuffed", true)

    -- Anchor on the server, not only locally: a real server-authoritative restraint.
    targetHum.Sit = false
    targetHum.WalkSpeed = 0
    targetHum.JumpPower = 0
    targetHum.JumpHeight = 0
    targetHum.AutoRotate = false
    targetRoot.Anchored = true

    entry.deathConnection = targetHum.Died:Connect(function()
        releasePlayer(target, "انتهى التقييد عند إعادة الظهور.")
    end)
    notify(officer, true, "تم تقييد " .. target.DisplayName .. " من السيرفر.")
    notify(target, true, "تم تقييدك بواسطة أدمن؛ سيُفك التقييد تلقائيًا.")

    task.delay(CONFIG.MAX_RESTRAINT_SECONDS, function()
        if restraints[target.UserId] == entry then
            releasePlayer(target, "انتهت مدة التقييد تلقائيًا.")
            notify(officer, true, "انتهت مدة تقييد " .. target.DisplayName)
        end
    end)
end)

local function setupPlayer(player)
    player:SetAttribute("NOVA_IsCuffed", false)
    player.CharacterAdded:Connect(function()
        releasePlayer(player, "انتهى التقييد عند تغيير الشخصية.")
        task.defer(function() grantTool(player) end)
    end)
    task.defer(function() grantTool(player) end)
end

Players.PlayerAdded:Connect(setupPlayer)
for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

Players.PlayerRemoving:Connect(function(leaver)
    releasePlayer(leaver)
    lastAction[leaver.UserId] = nil
    for userId, entry in pairs(restraints) do
        if entry.officerId == leaver.UserId then
            local target = Players:GetPlayerByUserId(userId)
            if target then releasePlayer(target, "فُك التقييد بسبب خروج الأدمن.") end
        end
    end
end)

print("[NOVA Cuffs] Server-authoritative cuffs loaded. Admins only.")

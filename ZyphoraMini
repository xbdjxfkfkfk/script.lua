-- 3) Speed — restores on disable and respawn
-- ═══════════════════════════════════════════════════════════
local function applySpeed()
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = S.Speed and 80 or 16
    end
end

local SpeedBtn = mkBtn("⚡ سرعة اللاعب: OFF", function(self)
    S.Speed = not S.Speed
    self.Text = S.Speed and "⚡ سرعة اللاعب: ON" or "⚡ سرعة اللاعب: OFF"
    applySpeed()
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    applySpeed()
    if S.ESP then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then applyESP(p.Character) end
        end
    end
end)


-- Dragging the header with mouse or touch.
local dragStart, dragPosition, dragInput
local moving = false
top.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        moving = true
        dragStart = input.Position
        dragPosition = main.Position
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if not moving or not dragStart or not dragPosition then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= dragInput then return end
    local d = input.Position - dragStart
    local size = screenSize()
    local x = math.clamp(dragPosition.X.Offset+d.X,0,math.max(0,size.X-main.AbsoluteSize.X))
    local y = math.clamp(dragPosition.Y.Offset+d.Y,0,math.max(0,size.Y-main.AbsoluteSize.Y))
    main.Position = UDim2.fromOffset(x,y)
end)
UserInputService.InputEnded:Connect(function(input)
    if input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1 then moving = false end
end)


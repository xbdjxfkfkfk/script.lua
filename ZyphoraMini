local function waitForDiscord()
    local guardGui, status = createGuardGui()

    local ticks = 0
    while true do
        if discordIsAlive() then
            status.Text = "✅ تم التحقق: Discord مفتوح\nجاري فتح السكربت..."
            task.wait(1)
            guardGui:Destroy()
            return true
        end

        ticks += 1
        if ticks % 2 == 0 then
            status.Text = "❌ لازم تدخل Discord الحقيقي أولاً\nالسكربت مقفل حتى تفتح التطبيق."
        else
            status.Text = "🔒 تم منع التشغيل\nDiscord مطلوب ليبدأ السكربت."
        end

        task.wait(2)
    end
end

-- Startup gate
local ok = waitForDiscord()
if not ok then
    warn("Lx: Discord check failed")
    return
end

-- =========================================================
-- AFTER THIS POINT: keep monitoring Discord while script runs
-- =========================================================
task.spawn(function()
    while true do
        task.wait(2)

        if not discordIsAlive() then
            local lockGui, lockStatus = createGuardGui()
            lockStatus.Text = "❌ تم اكتشاف خروجك من Discord\nتم قفل السكربت مؤقتًا."

            while not discordIsAlive() do
                lockStatus.Text = "❌ Discord غير متصل\nانتظر حتى تعود إلى التطبيق."
                task.wait(2)
            end

            lockGui:Destroy()
            -- If you want to truly stop the script after disconnect:
            -- return
            -- But for most executor scripts the safer pattern is:
            -- keep waiting until Discord returns then continue.
        end
    end
end)


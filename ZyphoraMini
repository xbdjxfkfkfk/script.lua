-- Functions
local function freezePlayer(p)
    frozenPlayers[p] = true
    local char = p.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = true end
    end
end

local function unfreezePlayer(p)
    frozenPlayers[p] = nil
    local char = p.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
    end
end

local function giveFly(p)
    flyingPlayers[p] = true
    local char = p.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(0, math.huge, 0)
            bv.Velocity = Vector3.new(0, 50, 0)
            bv.Parent = hrp
            flyingPlayers[p] = bv
        end
    end
end

local function removeFly(p)
    if flyingPlayers[p] and typeof(flyingPlayers[p]) == "Instance" then
        flyingPlayers[p]:Destroy()
    end
    flyingPlayers[p] = nil
end


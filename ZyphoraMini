local function refreshTags()
 if not state.Radar then destroyMap(markers) else
  local seen={}
  for _,a in ipairs(animals) do
   local m,p=a.model,a.part;local r=root();local d=r and (p.Position-r.Position).Magnitude or math.huge
   local label,color,rank=rarity(m)
   local passes=state.Rarity=='الكل' or label==state.Rarity or (state.Rarity=='نادر' and rank==3)
   if d<=state.Range and passes then
    seen[m]=true
    if not markers[m] then
     local power=info(m,{'Power','Strength','Damage','قوة'})
     local size=info(m,{'Size','Scale','حجم'})
     local s='الندرة: '..label..' | القوة: '..(power and tostring(power) or 'غير مكشوفة')
     if size~=nil then local num=tonumber(size);s=s..' | الحجم: '..(num and string.format('%.2f',num) or tostring(size)) end
     markers[m]=tag(gui,p,'🦎 '..m.Name,s,color,state.Range)
    else markers[m].MaxDistance=state.Range end
   end
  end
  for m,v in pairs(markers) do if not seen[m] then v:Destroy();markers[m]=nil end end
 end
 if not state.PlayerESP then destroyMap(playerMarkers) else
  local seen={};for _,p in ipairs(Players:GetPlayers()) do if p~=LP and p.Character then local r=p.Character:FindFirstChild('Head') or p.Character:FindFirstChild('HumanoidRootPart');if r then seen[p]=true;if not playerMarkers[p] or playerMarkers[p].Adornee~=r then if playerMarkers[p] then playerMarkers[p]:Destroy() end;playerMarkers[p]=tag(gui,r,p.DisplayName,'لاعب',Color3.fromRGB(80,180,255),state.Range) end end end end
  for p,v in pairs(playerMarkers) do if not seen[p] then v:Destroy();playerMarkers[p]=nil end end
 end
 if not state.CarESP then destroyMap(carMarkers) else
  local seen={};for _,v in ipairs(vehicles) do local seat=v:FindFirstChildWhichIsA('VehicleSeat',true);if seat then seen[v]=true;if not carMarkers[v] then carMarkers[v]=tag(gui,seat,'🚗 '..v.Name,'سيارة محمّلة',Color3.fromRGB(255,190,85),state.Range) end end end
  for v,bb in pairs(carMarkers) do if not seen[v] then bb:Destroy();carMarkers[v]=nil end end
 end
end

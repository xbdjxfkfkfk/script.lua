-- DISCORD AUTH GUARD (حماية التحقق عبر ديسكورد)
-- ==========================================
-- يتأكد من اتصال المستخدم بسيرفر ديسكورد الخاص بك عبر ميزة الربط أو خادم المصادقة المحلي.
-- إذا لم يكن متصلاً، تقفل الواجهة فوراً وتظهر نافذة مطالبة بالدخول للديسكورد.
local DISCORD_SERVER_INVITE = "https://discord.gg/yourserver" -- ضع رابط ديسكورد الخاص بك هنا
local DISCORD_API_PORT = 6463 -- منفذ ديسكورد المحلي للتحقق من الاتصال المفتوح على جهاز العميل

local function checkDiscordConnection()
    -- محاولة فحص الاتصال بتطبيق ديسكورد المحلي أو عبر ملفات الارتباط المعتمدة
    local success, result = pcall(function()
        -- فحص وجود جلسة ديسكورد نشطة عبر المتصفح المحلّي أو الـ IPC الخاص بديسكورد
        if syn and syn.request then
            local req = syn.request({
                Url = "http://127.0.0.1:" .. DISCORD_API_PORT .. "/",
                Method = "GET"
            })
            if req and (req.StatusCode == 200 or req.StatusCode == 404 or req.StatusCode == 400) then
                return true
            end
        end
        -- فحص بديل عبر طلبات HTTP المعتمدة للبيئة
        if request then
            local req = request({
                Url = "http://127.0.0.1:" .. DISCORD_API_PORT .. "/",
                Method = "GET"
            })
            if req then return true end
        end
        return false
    end)
    return success and result
end


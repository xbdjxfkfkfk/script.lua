local function clearESP()
    for _, h in pairs(espHighlights) do
        if h then h:Destroy() end
    end
    table.clear(espHighlights)
end

local function createESP(model, color)
    if espHighlights[model] then return end
    local highlight = inst("Highlight", {
        FillColor = color or C.accent,
        OutlineColor = C.white,
        FillTransparency = 0.5,
        Adornee = model,
        Parent = gui
    })
    espHighlights[model] = highlight
end

-- Animal ESP with info
local animalNames = {"dhab", "lizard", "ضب", "ضبان", "reptile"}

local function isAnimal(model)
    local name = model.Name:lower()
    for _, word in pairs(animalNames) do
        if name:find(word) then return true end
    end
    return false
end

local function updateAnimalESP()
    if not S.ESPAnimals then return end
    
    local r = root()
    if not r then return end
    
    for _, v in pairs(WS:GetDescendants()) do
        if v:IsA("Model") and isAnimal(v) and not espHighlights[v] then
            local p = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
            if p then
                local d = (p.Position - r.Position).Magnitude
                if d <= S.RadarRange then
                    -- Determine rarity
                    local rarity = v:GetAttribute("Rarity") or "عادي"
                    local color = C.accent
                    
                    -- Create billboard with info
                    local bb = inst("BillboardGui", {
                        Adornee = p,
                        Size = UDim2.fromOffset(180, 60),
                        StudsOffset = Vector3.new(0, 3, 0),
                        AlwaysOnTop = true,
                        Parent = gui
                    })
                    
                    local nameLabel = inst("TextLabel", {
                        Size = UDim2.new(1, 0, 0, 20),
                        BackgroundTransparency = 1,
                        Text = v.Name,
                        TextColor3 = color,
                        Font = Enum.Font.GothamBold,
                        TextSize = 12,
                        TextStrokeTransparency = 0.5
                    }, bb)
                    
                    local infoLabel = inst("TextLabel", {
                        Size = UDim2.new(1, 0, 0, 35),
                        Position = UDim2.new(0, 0, 0, 22),
                        BackgroundTransparency = 1,
                        Text = "[" .. rarity .. "]\n📏 " .. math.floor(d) .. "m | ⚖️ " .. (v:GetAttribute("Weight") or "؟"),
                        TextColor3 = C.white,
                        Font = Enum.Font.Gotham,
                        TextSize = 10,
                        TextStrokeTransparency = 0.5,
                        TextWrapped = true
                    }, bb)
                    
                    espHighlights[v] = bb
                end
            end
        end
    end
end


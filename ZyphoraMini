        b.BackgroundColor3=S[key] and Color3.fromRGB(78,126,95) or C.panel
        b.Text=title..(S[key] and "  [ON]" or "  [OFF]")
    end
    paint()
    hook(b.MouseButton1Click,function()
        S[key]=not S[key]
        if key=="light" then setLight(S.light) end
        if key=="fly" and not S.fly then stopFly() end
        if key=="ghost" and not S.ghost then restoreTransparency() end
        if key=="noclip" and not S.noclip then restoreCollision() end
        if key=="esp" and not S.esp then clearHighlights() end
        paint()
        syncLocal()
    end)
end

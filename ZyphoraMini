local dragInitialPosition, dragInitialInput, draggingInput
connect(titlebar.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        draggingInput = input
        dragInitialPosition = main.Position
        dragInitialInput = input.Position
    end
end)
connect(UserInputService.InputChanged, function(input)
    if not dragging then return end
    if draggingInput and (input == draggingInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
        local delta = input.Position - dragInitialInput
        main.Position = UDim2.new(dragInitialPosition.X.Scale, dragInitialPosition.X.Offset + delta.X / screenScale.Scale,
            dragInitialPosition.Y.Scale, dragInitialPosition.Y.Offset + delta.Y / screenScale.Scale)
    end
end)
connect(UserInputService.InputEnded, function(input)
    if input == draggingInput or input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
connect(UserInputService.InputBegan, function(input, processed)
    if processed then return end
    inputHeld[input.KeyCode] = true
end)
connect(UserInputService.InputEnded, function(input)
    inputHeld[input.KeyCode] = nil
end)

local function flightDirection()
    local camera = Workspace.CurrentCamera
    if not camera then return Vector3.zero, Vector3.new(0, 0, -1) end
    local forward = camera.CFrame.LookVector
    local horizontal = Vector3.new(forward.X, 0, forward.Z)
    if horizontal.Magnitude < 0.01 then horizontal = Vector3.new(0, 0, -1) end
    horizontal = horizontal.Unit
    local right = Vector3.new(-horizontal.Z, 0, horizontal.X)
    local function held(name, keycode)
        return touchHeld[name] or inputHeld[keycode]
    end
    local move = Vector3.zero
    if held("W", Enum.KeyCode.W) then move = move + horizontal end
    if held("S", Enum.KeyCode.S) then move = move - horizontal end
    if held("D", Enum.KeyCode.D) then move = move + right end
    if held("A", Enum.KeyCode.A) then move = move - right end
    if held("E", Enum.KeyCode.E) or inputHeld[Enum.KeyCode.Space] then move = move + Vector3.yAxis end
    if held("Q", Enum.KeyCode.Q) or inputHeld[Enum.KeyCode.LeftControl] then move = move - Vector3.yAxis end
    -- Mobile analog stick controls use Humanoid.MoveDirection for horizontal travel.
    if move.Magnitude < 0.01 and UserInputService.TouchEnabled then
        local h = human()
        if h then move = h.MoveDirection end
    end
    if move.Magnitude > 1 then move = move.Unit end
    return move, horizontal
end
local function nearestAimPart()
    local camera = Workspace.CurrentCamera
    if not camera then return nil end
    local midpoint = camera.ViewportSize * 0.5
    local best, bestPx = nil, aimRadius
    for model in pairs(radarModels) do
        if isLiveLizard(model) then
            local hit = model:FindFirstChild("Head", true) or basePart(model)
            if hit and hit:IsA("BasePart") then
                local screenPoint, visible = camera:WorldToViewportPoint(hit.Position)
                if visible then
                    local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - midpoint).Magnitude
                    if distance < bestPx then best, bestPx = hit, distance end
                end
            end
        end
    end
    return best
end
local reportTimer, radarTimer, resourceTimer, flightTimer, authTimer, monitorTimer = 0, 0, 0, 0, 0, 0
connect(RunService.Heartbeat, function(dt)
    if not alive then return end
    reportTimer = reportTimer + dt
    radarTimer = radarTimer + dt
    resourceTimer = resourceTimer + dt
    flightTimer = flightTimer + dt
    authTimer = authTimer + dt
    monitorTimer = monitorTimer + dt
    touchFrame.Visible = isAuthed and flyMode ~= nil and UserInputService.TouchEnabled
    if reportTimer >= 0.35 then
        reportTimer = 0
        local seat = getDriverSeat()
        if seat then
            local speed = seat.AssemblyLinearVelocity.Magnitude
            carDiagText.Text = string.format("السرعة الفعلية: %.1f / المطلوبة: %.1f studs/s", speed, speedWanted)
        else carDiagText.Text = "السرعة الفعلية: ليست داخل مقعد قيادة" end
    end
    if radarTimer >= 2 then
        radarTimer = 0
        if isAuthed and (radarEnabled or activePage == animalsPage) then
            local ok, e = pcall(fillAnimals)
            if not ok then log("Radar refresh: " .. tostring(e), true) end
        end
    end
    if resourceTimer >= 3 then
        resourceTimer = 0
        if isAuthed and (resourceEnabled or activePage == resourcesPage) then
            local ok, e = pcall(refreshResources)
            if not ok then log("Resource refresh: " .. tostring(e), true) end
        end
    end
    if flightTimer >= 0.10 then
        flightTimer = 0
        if isAuthed and remoteEvent then
            if flyMode then
                local direction, facing = flightDirection()
                remoteEvent:FireServer("FlightInput", {direction = direction, facing = facing, mode = flyMode})
            elseif carSpeedControl:get() then
                local seat = getDriverSeat()
                if seat then
                    local throttle, steer = seat.ThrottleFloat, seat.SteerFloat
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then throttle = 1 end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then throttle = -1 end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then steer = -1 end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then steer = 1 end
                    remoteEvent:FireServer("DriveInput", {throttle = throttle, steer = steer})
                end
            end
        end
    end
    if monitorTimer >= 0.25 then
        monitorTimer = 0
        if monitorEnabled and isAuthed then
            local r = playerRoot()
            if r then
                if lastPosition and (r.Position - lastPosition).Magnitude > 70 then
                    lastLargeMove = "تغيّر الموقع بأكثر من 70 studs (قد يكون انتقالًا مشروعًا)"
                end
                lastPosition = r.Position
                monitorText.Text = lastLargeMove
            end
        end
    end
    if authTimer >= 20 then
        authTimer = 0
        if remoteFunction then task.spawn(refreshAuth) end
    end
end)
connect(RunService.RenderStepped, function()
    local camera = Workspace.CurrentCamera
    if not camera then return end
    fovRing.Visible = isAuthed and aimEnabled
    aimTouchButton.Visible = isAuthed and aimEnabled and UserInputService.TouchEnabled
    fovRing.Size = UDim2.fromOffset(aimRadius * 2, aimRadius * 2)
    fovRing.Position = UDim2.fromOffset(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    if isAuthed and aimEnabled and (aimTouchHeld or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) then
        local target = nearestAimPart()
        if target then
            camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, target.Position), 0.12)
        end
    end
end)

-- =========================================================
-- Discord Guard - exact style like the image
-- Blocks script until Discord is active
-- If Discord closes while running, script locks again
-- =========================================================

local Players = game:GetService("Players")
local LP = Players.LocalPlayer

if not LP then
    warn("Lx: no LocalPlayer")
    return
end

local PG = LP:WaitForChild("PlayerGui", 12)
if not PG then
    warn("Lx: PlayerGui unavailable")
    return
end

local DISCORD_LINK = "https://discord.gg/7HyFER45Y"
local DISCORD_PORTS = {6463, 6464}

local function discordIsAlive()
    for _, port in ipairs(DISCORD_PORTS) do
        local ok, res = pcall(function()
            if syn and syn.request then
                return syn.request({
                    Url = "http://127.0.0.1:" .. port .. "/",
                    Method = "GET",
                    Headers = {["Content-Type"] = "application/json"}
                })
            end

            if http and http.request then
                return http.request({
                    Url = "http://127.0.0.1:" .. port .. "/",
                    Method = "GET",
                    Headers = {["Content-Type"] = "application/json"}
                })
            end

            if request then
                return request({
                    Url = "http://127.0.0.1:" .. port .. "/",
                    Method = "GET",
                    Headers = {["Content-Type"] = "application/json"}
                })
            end

            return nil
        end)

        if ok and res then
            if type(res) == "table" then
                if res.Success ~= false and (res.StatusCode == nil or res.StatusCode >= 200) then
                    return true
                end
            elseif type(res) == "string" then
                if res ~= "" then
                    return true
                end
            end
        end
    end

    return false
end

local function openDiscord()
    pcall(function()
        if setclipboard then
            setclipboard(DISCOED_LINK)
        end
    end)

    pcall(function()
        if isfolder and syn then
            -- some executors can open browser URL
            -- but usually setclipboard is enough
        end
    end)
end


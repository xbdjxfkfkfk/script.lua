local function restoreSeat()
 if savedSeat and savedSeat.Parent then
  pcall(function() if savedMaxSpeed~=nil then savedSeat.MaxSpeed=savedMaxSpeed end end)
  pcall(function() if savedTorque~=nil then savedSeat.Torque=savedTorque end end)

local function ClearTraderESP()
    if traderESP then
        for _, obj in pairs(traderESP) do
            if obj then obj:Destroy() end
        end
        traderESP = nil
    end
end

local function CreateTraderESP()
    ClearTraderESP()
    if not Config.ESPTrader then return end
    
    for _, v in pairs(workspace:GetDescendants()) do
        local name = v.Name:lower()
        if name:find("trader") or name:find("تاجر") or name:find("seller") or name:find("shop") or name:find("بقالة") then
            local root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head") or (v:IsA("BasePart") and v) or v:FindFirstChildWhichIsA("BasePart")
            
            if root then
                traderESP = {}
                
                -- Highlight
                local h = Instance.new("Highlight")
                h.FillColor = Color3.fromRGB(0, 255, 255)
                h.OutlineColor = Color3.new(1, 1, 1)
                h.FillTransparency = 0.3
                h.Adornee = v:IsA("Model") and v or nil
                if not v:IsA("Model") then h.Adornee = v.Parent end
                h.Parent = ScreenGui
                table.insert(traderESP, h)
                
                -- Billboard
                local bb = Instance.new("BillboardGui")
                bb.Size = UDim2.new(0, 120, 0, 40)
                bb.StudsOffset = Vector3.new(0, 3, 0)
                bb.Adornee = root
                bb.AlwaysOnTop = true
                bb.Parent = ScreenGui
                
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, 0, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = "🏪 " .. v.Name
                lbl.TextColor3 = Color3.fromRGB(0, 255, 255)
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 14
                lbl.TextStrokeTransparency = 0.3
                lbl.Parent = bb
                
                table.insert(traderESP, bb)
                
                -- زر فتح البقالة من بعيد
                local openBtn = Instance.new("TextButton")
                openBtn.Size = UDim2.new(0, 100, 0, 30)
                openBtn.Position = UDim2.new(0.5, -50, 0, 50)
                openBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
                openBtn.Text = "🛒 فتح البقالة"
                openBtn.TextColor3 = Color3.new(1, 1, 1)
                openBtn.Font = Enum.Font.GothamBold
                openBtn.TextSize = 12
                openBtn.Parent = bb
                Instance.new("UICorner", openBtn).CornerRadius = UDim.new(0, 6)
                
                openBtn.MouseButton1Click:Connect(function()
                    -- محاولة فتح البقالة (عدّل حسب نظام اللعبة)
                    local char = LocalPlayer.Character
                    if char then
                        local myRoot = char:FindFirstChild("HumanoidRootPart")
                        if myRoot then
                            -- نقل للتاجر مؤقتاً
                            local oldPos = myRoot.CFrame
                            myRoot.CFrame = root.CFrame * CFrame.new(0, 0, -3)
                            task.wait(0.5)
                            -- هنا تضغط زر البقالة في اللعبة
                            -- مثال: fireclickdetector(root.Parent:FindFirstChild("ClickDetector"))
                            task.wait(0.5)
                            -- رجوع للمكان
                            myRoot.CFrame = oldPos
                        end
                    end
                end)
                
                table.insert(traderESP, openBtn)
                
                break -- أول تاجر فقط
            end
        end
    end
end

--====================================
-- نظام Aimbot المحسّن (يتوقف تماماً)
--====================================
local function StopAimbot()
    Config.Aimbot = false
    
    if aimbotConnection then
        aimbotConnection:Disconnect()
        aimbotConnection = nil
    end
    
    -- إعادة الكاميرا للوضع الطبيعي
    Camera.CameraType = Enum.CameraType.Custom
    
    print("✅ Aimbot متوقف تماماً")
end

local function StartAimbot()
    -- إيقاف أي اتصال سابق
    StopAimbot()
    
    Config.Aimbot = true
    
    aimbotConnection = RunService.RenderStepped:Connect(function()
        -- التحقق مرة أخرى داخل الحلقة
        if not Config.Aimbot then
            StopAimbot()
            return
        end
        
        -- التحقق من زر الضغط
        if not UserInputService:IsKeyDown(Config.AimbotKey) then
            return -- لا يأثر على الكاميرا إذا ما ضاغط
        end
        
        -- البحث عن أقرب ضبان للماوس
        local closest = nil
        local closestDist = 200
        
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                local name = v.Name:lower()
                if name:find("lizard") or name:find("ضبان") then
                    local head = v:FindFirstChild("Head") or v:FindFirstChild("HumanoidRootPart")
                    if head then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closest = head
                            end
                        end
                    end
                end
            end
        end
        
        -- توجيه الكاميرا فقط إذا وجد هدف
        if closest and Config.Aimbot then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closest.Position)
        end
    end)
    
    print("🎯 Aimbot شغال - اضغط " .. Config.AimbotKey.Name .. " للتصويب")
end


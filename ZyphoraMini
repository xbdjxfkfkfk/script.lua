    end
    -- Do not synthesize a click or send arbitrary remotes: title activation
    -- must be handled by the game's official, server-authorized flow.
end
local titleScanRunning = false
local function scanVisibleTitles()
    if titleScanRunning or not alive then return end
    titleScanRunning = true
    titleEntries = {}
    local ok, scanned, truncated = pcall(function()
        return visitVisible({ReplicatedStorage, Workspace, game:GetService("StarterGui"), PlayerGui},
            2500, function(obj)
                if obj == gui or obj:IsDescendantOf(gui) then return false end
                if obj:IsA("StringValue") then
                    if titleField(obj.Name) then
                        addTitleCandidate(obj.Value, "قيمة ظاهرة")
                    elseif titleContainer(obj.Parent) then
                        addTitleCandidate(obj.Name, "قائمة ظاهرة")
                        addTitleCandidate(obj.Value, "قيمة ظاهرة")
                    end
                elseif (obj:IsA("Folder") or obj:IsA("Configuration"))
                    and titleContainer(obj.Parent) then
                    addTitleCandidate(obj.Name, "عنصر قائمة ظاهر")
                elseif obj:IsA("TextLabel") and titleContainer(obj.Parent) then
                    addTitleCandidate(obj.Text, "واجهة ظاهرة")
                end
                if titleContainer(obj) then
                    for key, value in pairs(obj:GetAttributes()) do
                        if type(value) == "string" and titleField(key) then
                            addTitleCandidate(value, "خاصية ظاهرة")
                        end
                    end
                end
                return true
            end)
    end)
    if not alive then return end
    -- Use already-replicated BillboardGuis, never create false titles.
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character then
            for _, obj in ipairs(character:GetDescendants()) do
                if obj:IsA("TextLabel") then
                    local billboard = obj:FindFirstAncestorWhichIsA("BillboardGui")
                    if billboard and billboard.Name ~= "NovaTitleLocalPreview" then
                        local value = usableTitle(obj.Text)
                        if value and value ~= player.Name and value ~= player.DisplayName then
                            if titleField(obj.Name) or titleField(billboard.Name) or value:match("^%[.+%]") then
                                addTitleCandidate(value, "لقب ظاهر فوق " .. player.DisplayName)
                            end
                        end
                    end
                end
            end
        end
    end
    local active = currentTitleFromReplicatedData()
    if active then addTitleCandidate(active, "لقبي في البيانات الظاهرة") end
    local total = 0
    for _ in pairs(titleEntries) do total = total + 1 end
    if titleStatus then
        titleStatus.Text = "رُصد " .. total .. " لقبًا | العناصر المفحوصة: "
            .. tostring(type(scanned) == "number" and scanned or 0)
            .. (truncated and " | فحص محدود" or "")
            .. (not ok and " | تعذّر فحص بعض العناصر" or "")
    end
    if refreshTitleList then refreshTitleList() end
    titleScanRunning = false
    if not ok then warn("NOVA title scan: " .. safeText(scanned)) end
    say("انتهى فحص الألقاب الظاهرة. التفعيل الحقيقي يتم من نظام الماب", ok)
end


local function slider(parent,title,min,max,initial,changed)
 local frame=make('Frame',{BackgroundColor3=C.panel,Size=UDim2.new(1,-8,0,68)},parent)
 corner(frame,9)
 local n=make('TextLabel',{Text=title,Font=Enum.Font.Gotham,TextSize=13,TextColor3=C.text,
 BackgroundTransparency=1,Position=UDim2.fromOffset(12,5),Size=UDim2.new(1,-100,0,25),TextXAlignment=Enum.TextXAlignment.Left},frame)
 local v=make('TextLabel',{Text=tostring(initial),Font=Enum.Font.GothamBold,TextSize=14,TextColor3=C.good,
 BackgroundTransparency=1,Position=UDim2.new(1,-80,0,5),Size=UDim2.fromOffset(68,25),TextXAlignment=Enum.TextXAlignment.Right},frame)
 local rail=make('Frame',{BackgroundColor3=C.raised,Size=UDim2.new(1,-24,0,12),Position=UDim2.fromOffset(12,41),Active=true},frame)
 corner(rail,6)
 local fill=make('Frame',{BackgroundColor3=C.accent,Size=UDim2.fromScale((initial-min)/(max-min),1)},rail); corner(fill,6)
 local dragging=false
 local function set(x)
  if rail.AbsoluteSize.X<1 then return end
  local a=math.clamp((x-rail.AbsolutePosition.X)/rail.AbsoluteSize.X,0,1)
  local value=math.floor(min+(max-min)*a+0.5)
  v.Text=tostring(value);fill.Size=UDim2.fromScale(a,1); changed(value)
 end
 on(rail.InputBegan,function(input)
  if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=true;set(input.Position.X) end
 end)
 on(UIS.InputChanged,function(input)
  if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then set(input.Position.X) end
 end)
 on(UIS.InputEnded,function(input)
  if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end
 end)
 return frame
end
local function charParts(p)
 local character=p and p.Character
 return character,character and character:FindFirstChildOfClass('Humanoid'),character and character:FindFirstChild('HumanoidRootPart')
end
local function clearFly()
 for _,v in ipairs({flyVelocity,flyOrientation,flyAttachment}) do if v then v:Destroy() end end
 flyVelocity,flyOrientation,flyAttachment,flyRoot=nil,nil,nil,nil
 local _,hum=charParts(LP)
 if hum and hum.Health>0 then hum.AutoRotate=true end
end
local function setFly(value)
 flyOn=value
 if not value then clearFly();notify('تم إيقاف الطيران');return end
 local _,hum,root=charParts(LP)
 if not hum or not root or hum.Health<=0 then flyOn=false;notify('الشخصية غير جاهزة للطيران',false);return end
 clearFly();hum.AutoRotate=false
 flyAttachment=make('Attachment',{},root)
 flyVelocity=make('LinearVelocity',{Attachment0=flyAttachment,RelativeTo=Enum.ActuatorRelativeTo.World,MaxForce=1e9,VectorVelocity=Vector3.zero},root)
 flyOrientation=make('AlignOrientation',{Attachment0=flyAttachment,Mode=Enum.OrientationAlignmentMode.OneAttachment,MaxTorque=1e9,Responsiveness=16},root)
 flyRoot=root
 notify('الطيران المحلي مفعل — W A S D، Space للصعود، Ctrl للنزول')
end

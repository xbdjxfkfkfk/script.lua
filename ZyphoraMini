newSection("4. البيئة والحماية وتنظيف النظام (World & Core)", false)
toggle("إضاءة نهارية كاملة وإزالة الظلال (FullBright)", "FullBright", applyFullBright)
toggle("منع الطرد بسبب الخمول (Anti-AFK)", "AntiAFK")

action("إعادة ضبط الشخصية فوراً (Instant Reset)", function()
    local hum = localHumanoid()
    if hum then hum.Health = 0 end
end)

local function fullCleanup()
    alive = false
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    stopFlight()
    restoreCollisions()
    clearESP()
    state.Speed, state.JumpPower, state.FullBright, state.LocalInvisible = false, false, false, false
    applyStats()
    applyFullBright()
    applyLocalInvisible()
    if Workspace.CurrentCamera and localHumanoid() then
        Workspace.CurrentCamera.CameraSubject = localHumanoid()
    end
    pcall(function() gui:Destroy() end)
end
_G.NOVA_SuiteV18Cleanup = fullCleanup

action("إغلاق وتدمير NOVA V18 بالكامل (Clean Unload)", fullCleanup)

-- ==========================================
-- الحلقات المستمرة (RenderStepped & Events)
-- ==========================================
listen(RunService.RenderStepped, function()
    if not alive then return end
    if state.Fly then updateFlight() end
    if state.Noclip then applyNoclip() end
end)

task.spawn(function()
    while alive do
        if state.PlayerESP or state.AdminESP then pcall(updateESP) end
        if state.Speed or state.JumpPower then pcall(applyStats) end
        task.wait(0.35)
    end
end)

listen(UserInputService.JumpRequest, function()
    if not alive or not state.InfiniteJump then return end
    local hum = localHumanoid()
    if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end) end
end)

listen(LocalPlayer.Idled, function()
    if not alive or not state.AntiAFK then return end
    local vu = game:GetService("VirtualUser")
    pcall(function()
        vu:Button2Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
        task.wait(0.1)
        vu:Button2Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
    end)
end)

listen(Players.PlayerRemoving, function(plr)
    if playerESPObjects[plr] then
        pcall(function()
            playerESPObjects[plr].Highlight:Destroy()
            playerESPObjects[plr].Billboard:Destroy()
        end)
        playerESPObjects[plr] = nil
    end
    if selectedTargetPlayer == plr then
        selectedTargetPlayer = nil
        targetLabel.Text = "اللاعب المحدد للتنقل: غادر الماب"
    end
end)

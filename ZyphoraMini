-- Slider Component (Mobile Friendly)
local function mobSlider(title, key, min, max, default, order)
    local f = inst("Frame", {Size = UDim2.new(1, 0, 0, 55), BackgroundColor3 = C.card, BorderSizePixel = 0, LayoutOrder = order}, content)
    round(f, 10)
    
    inst("TextLabel", {Size = UDim2.new(0.6, 0, 0, 18), Position = UDim2.fromOffset(10, 5), BackgroundTransparency = 1, Text = title, TextColor3 = C.white, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left}, f)
    
    local val = inst("TextLabel", {Size = UDim2.new(0.3, 0, 0, 18), Position = UDim2.new(0.7, -5, 0, 5), BackgroundTransparency = 1, Text = tostring(default), TextColor3 = C.accent, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right}, f)
    
    local bg = inst("Frame", {Size = UDim2.new(1, -20, 0, 8), Position = UDim2.fromOffset(10, 32), BackgroundColor3 = Color3.fromRGB(40, 40, 50), BorderSizePixel = 0}, f)
    round(bg, 4)
    
    local fill = inst("Frame", {Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BackgroundColor3 = C.accent, BorderSizePixel = 0}, bg)
    round(fill, 4)
    
    local handle = inst("Frame", {Size = UDim2.fromOffset(20, 20), Position = UDim2.new((default - min) / (max - min), -10, 0.5, -10), BackgroundColor3 = C.white, BorderSizePixel = 0}, bg)
    round(handle, 10)
    
    S[key] = default
    local dragging = false
    
    local function update(input)
        local rel = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * rel)
        S[key] = v
        val.Text = tostring(v)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        handle.Position = UDim2.new(rel, -10, 0.5, -10)
    end
    
    conn(handle.InputBegan, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end end)
    conn(bg.InputBegan, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true update(input) end end)
    conn(UIS.InputEnded, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
    conn(UIS.InputChanged, function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end end)
    
    return f
end


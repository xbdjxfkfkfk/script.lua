connect(UIS.InputBegan,function(input, processed)
    if processed and UIS:GetFocusedTextBox() then return end
    if input.KeyCode==Enum.KeyCode.W then keyboard.w=true
    elseif input.KeyCode==Enum.KeyCode.S then keyboard.s=true
    elseif input.KeyCode==Enum.KeyCode.A then keyboard.a=true
    elseif input.KeyCode==Enum.KeyCode.D then keyboard.d=true
    elseif input.KeyCode==Enum.KeyCode.Space then keyboard.up=true
    elseif input.KeyCode==Enum.KeyCode.LeftControl or input.KeyCode==Enum.KeyCode.RightControl then keyboard.down=true end
end)
connect(UIS.InputEnded,function(input)
    if input.KeyCode==Enum.KeyCode.W then keyboard.w=false
    elseif input.KeyCode==Enum.KeyCode.S then keyboard.s=false
    elseif input.KeyCode==Enum.KeyCode.A then keyboard.a=false
    elseif input.KeyCode==Enum.KeyCode.D then keyboard.d=false
    elseif input.KeyCode==Enum.KeyCode.Space then keyboard.up=false
    elseif input.KeyCode==Enum.KeyCode.LeftControl or input.KeyCode==Enum.KeyCode.RightControl then keyboard.down=false end
end)
local elapsed=0
connect(RunService.Heartbeat,function(dt)
    if stopped then return end
    controls.Visible=flyEnabled
    if flyEnabled then
        local _,root,hum=characterParts()
        if not root or root~=flyingRoot or not flyVelocity or not flyGyro or flyVelocity.Parent~=root then
            stopFly();flyBtn.Text="الطيران: إيقاف";notify("توقف الطيران بعد تغيير الشخصية",false)
        else
            local cam=Workspace.CurrentCamera
            if cam then
                local cf=cam.CFrame
                local forward=cf.LookVector -- Includes Y: looking downward means descending.
                local flatForward=Vector3.new(forward.X,0,forward.Z)
                local right=Vector3.new(cf.RightVector.X,0,cf.RightVector.Z)
                if flatForward.Magnitude>0.001 then
                    flatForward=flatForward.Unit
                else
                    flatForward=Vector3.new(0,0,-1)
                end
                if right.Magnitude>0.001 then
                    right=right.Unit
                else
                    right=Vector3.new(1,0,0)
                end
                local fb=(keyboard.w and 1 or 0)-(keyboard.s and 1 or 0)
                    +(held.f and 1 or 0)-(held.b and 1 or 0)
                local lr=(keyboard.d and 1 or 0)-(keyboard.a and 1 or 0)
                    +(held.r and 1 or 0)-(held.l and 1 or 0)
                local ud=(keyboard.up and 1 or 0)-(keyboard.down and 1 or 0)
                -- Mobile joystick gives planar input; apply pitch through forward.
                if math.abs(fb)<0.01 and math.abs(lr)<0.01 and UIS.TouchEnabled then
                    local md=hum.MoveDirection
                    fb=md:Dot(flatForward)
                    lr=md:Dot(right)
                end
                local vector=forward*fb+right*lr+Vector3.new(0,ud,0)
                flyVelocity.VectorVelocity=vector.Magnitude>0.01
                    and vector.Unit*flySpeed or Vector3.zero
                flyGyro.CFrame=CFrame.lookAt(Vector3.zero,flatForward)
            end
        end
    end
    elapsed=elapsed+dt
    if elapsed>=1.5 then
        elapsed=0
        if espEnabled then
            for _,p in ipairs(Players:GetPlayers()) do
                if p~=player and p.Character then
                    local h=highlights[p]
                    if not h or not h.Parent or h.Adornee~=p.Character then
                        if h then h:Destroy() end
                        h=new("Highlight",{
                            Name="NOVA_LocalHighlight",Adornee=p.Character,FillColor=COLORS.accent,
                            OutlineColor=Color3.fromRGB(255,255,255),FillTransparency=0.78,
                            DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                        },Workspace)
                        highlights[p]=h
                    end
                end
            end
        end
    end
end)
connect(player.CharacterAdded,function()
    stopFly();flyBtn.Text="الطيران: إيقاف"
    savedSpeed=nil
    if speedEnabled then
        task.defer(function()
            if stopped then return end
            local char=player.Character
            if char then char:WaitForChild("Humanoid",7);applySpeed() end
        end)
    end
    task.defer(function()
        if not stopped then refreshTools() end
    end)
end)
local backpack=player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack",5)
if backpack then
    connect(backpack.ChildAdded,function() task.defer(refreshTools) end)
    connect(backpack.ChildRemoved,function() task.defer(refreshTools) end)
end
local function setWindow(visible)
    window.Visible=visible
    mini.Visible=not visible
end
connect(collapse.MouseButton1Click,function() setWindow(false) end)
connect(mini.MouseButton1Click,function() setWindow(true) end)
local function close()
    if stopped then return end
    stopFly()
    if speedEnabled then speedEnabled=false;applySpeed() end
    if lightEnabled then
        for property,value in pairs(oldLight) do pcall(function() Lighting[property]=value end) end
    end
    for _,h in pairs(highlights) do pcall(function() h:Destroy() end) end
    stopped=true
    for _,c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    pcall(function() gui:Destroy() end)
    if global.NOVA_V16 and global.NOVA_V16.Close==close then global.NOVA_V16=nil end
end
connect(exit.MouseButton1Click,close)
global.NOVA_V16={Close=close}

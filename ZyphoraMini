toggle("كشف جميع اللاعبين والمسافات (Player ESP)", "PlayerESP", updateESP)
toggle("رصد الأدمن والمشرفين فقط (Admin Radar)", "AdminESP", updateESP)

local targetLabel = note("اللاعب المحدد للتنقل: لا يوجد")
action("تحديد أقرب لاعب إليك الآن", function()
    local myRoot = localRoot()
    if not myRoot then return end
    local closest, minDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local d = (myRoot.Position - plr.Character.HumanoidRootPart.Position).Magnitude
            if d < minDist then minDist = d; closest = plr end
        end
    end
    if closest then
        selectedTargetPlayer = closest
        targetLabel.Text = "اللاعب المحدد: " .. closest.Name .. " (" .. math.floor(minDist) .. "m)"
        say("تم تحديد اللاعب: " .. closest.Name, true)
    else
        say("لا يوجد لاعبون قريبون في الماب", false)
    end
end)

action("انتقال فوري إلى اللاعب المحدد (Teleport)", function()
    local myRoot = localRoot()
    if not myRoot or not selectedTargetPlayer or not selectedTargetPlayer.Character then
        say("حدد لاعباً أولاً أو تأكد من وجوده في الماب", false)
        return
    end
    local targetRoot = selectedTargetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if targetRoot then
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
        say("تم الانتقال إلى " .. selectedTargetPlayer.Name, true)
    end
end)

action("مراقبة اللاعب المحدد بالكاميرا (Spectate Toggle)", function()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    if cam.CameraSubject ~= localHumanoid() then
        cam.CameraSubject = localHumanoid()
        say("تمت إعادة الكاميرا لشخصيتك", true)
    elseif selectedTargetPlayer and selectedTargetPlayer.Character then
        local hum = selectedTargetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            cam.CameraSubject = hum
            say("تتم الآن مراقبة: " .. selectedTargetPlayer.Name, true)
        end
    else
        say("حدد لاعباً أولاً للمراقبة", false)
    end
end)

-- 3. الأدوات والحقيبة
newSection("3. استخراج الأدوات والحقيبة (Tools Scanner)", false)
local toolsStatus = note("اضغط لفحص الماب واستنساخ الأدوات المتاحة محلياً")
action("فحص ونسخ جميع الأدوات الظاهرة في الماب", function()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return end
    local count = 0
    local containers = {Workspace, ReplicatedStorage, game:GetService("StarterPack"), Lighting}
    for _, cont in ipairs(containers) do
        for _, obj in ipairs(cont:GetDescendants()) do
            if obj:IsA("Tool") and not backpack:FindFirstChild(obj.Name) then
                local ok, clone = pcall(function() return obj:Clone() end)
                if ok and clone then
                    clone.Parent = backpack
                    count = count + 1
                end
            end
        end
    end
    toolsStatus.Text = "تم استنساخ " .. count .. " أداة جديدة إلى حقيبتك"
    say("اكتمل الفحص: تمت إضافة " .. count .. " أداة", count > 0)
end)


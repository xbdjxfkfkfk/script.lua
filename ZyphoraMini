local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local Window = Fluent:CreateWindow({Title="cCraft Space | Pro Script", SubTitle="by Nova", TabWidth=160, Size=UDim2.fromOffset(580, 460), Acrylic=true, Theme="Dark", MinimizeKey=Enum.KeyCode.LeftControl})
local Tabs = {Main = Window:AddTab({Title="التحكم", Icon=""}), Players = Window:AddTab({Title="اللاعبين", Icon=""})}

-- Flight Logic
local FlightSpeed = 50
local Flying = false
local FlyConnection

local function ToggleFlight(state)
    Flying = state
    if Flying then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local bv = Instance.new("BodyVelocity", hrp)
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        FlyConnection = RunService.RenderStepped:Connect(function()
            local cam = workspace.CurrentCamera
            bv.Velocity = cam.CFrame.LookVector * FlightSpeed
        end)
    else
        if FlyConnection then FlyConnection:Disconnect() end
        if LocalPlayer.Character:FindFirstChild("HumanoidRootPart"):FindFirstChild("BodyVelocity") then
            LocalPlayer.Character.HumanoidRootPart.BodyVelocity:Destroy()
        end
    end
end

-- UI Elements
Tabs.Main:AddToggle("FlyToggle", {Title="طيران (Flight)", Default=false}):OnChanged(ToggleFlight)
Tabs.Main:AddSlider("SpeedSlider", {Title="السرعة", Default=16, Min=16, Max=200, Rounding=0, Callback=function(v) LocalPlayer.Character.Humanoid.WalkSpeed = v end})

Tabs.Main:AddToggle("InvisToggle", {Title="إخفاء الشخصية", Default=false}):OnChanged(function(state)
    for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
        if part:IsA("BasePart") then part.Transparency = state and 1 or 0 end
    end
end)

-- Player Interaction
local SelectedPlayer = nil
Tabs.Players:AddDropdown("PlayerDrop", {Title="اختر لاعب", Values={}, Multi=false, Callback=function(v) SelectedPlayer = v end})

Tabs.Players:AddButton({Title="سحب اللاعب", Callback=function()
    if SelectedPlayer and Players[SelectedPlayer] then
        Players[SelectedPlayer].Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
    end
end})

Tabs.Players:AddButton({Title="تجميد اللاعب", Callback=function()
    if SelectedPlayer and Players[SelectedPlayer] then
        Players[SelectedPlayer].Character.HumanoidRootPart.Anchored = true
    end
end})

-- Refresh Player List
task.spawn(function()
    while true do
        local names = {}
        for _, p in pairs(Players:GetPlayers()) do if p ~= LocalPlayer then table.insert(names, p.Name) end end
        Fluent.Options.PlayerDrop:SetValues(names)
        task.wait(5)
    end
end)

Fluent:Notify({Title="cCraft Space", Content="تم تحميل السكريبت بنجاح!", Duration=5})
Window:SelectTab(1)

local function getTools()
    local tools={}
    local backpack=player:FindFirstChildOfClass("Backpack")
    for _,parent in ipairs({backpack,player.Character}) do
        if parent then
            for _,child in ipairs(parent:GetChildren()) do
                if child:IsA("Tool") then table.insert(tools,child) end
            end
        end
    end
    return tools
end
refreshTools = function()
    if stopped then return end
    for _,child in ipairs(toolHolder:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    local tools=getTools()
    if #tools==0 then
        local b=textButton(toolHolder,"None","لا توجد أدوات متاحة لك الآن",UDim2.new(1,-7,0,36),nil)
        b.AutoButtonColor=false
        b.TextColor3=COLORS.muted
    else
        for i,tool in ipairs(tools) do
            local b=textButton(toolHolder,"Tool_"..i,"استخدم: "..tool.Name,UDim2.new(1,-7,0,36),nil)
            connect(b.MouseButton1Click,function()
                local _,_,hum=characterParts()
                local backpack=player:FindFirstChildOfClass("Backpack")
                if not hum or not tool.Parent then return notify("الأداة غير متاحة الآن",false) end
                if backpack and tool.Parent==backpack then
                    local success=pcall(function() hum:EquipTool(tool) end)
                    notify(success and "تم تجهيز الأداة: "..tool.Name or "تعذر تجهيز الأداة",success)
                elseif tool.Parent==player.Character then
                    pcall(function() tool:Activate() end)
                    notify("تم إرسال طلب استخدام الأداة: "..tool.Name,true)
                else
                    notify("الأداة ليست في حقيبتك",false)
                end
            end)
        end
    end
    toolHolder.Size=UDim2.new(1,-8,0,math.max(#tools,1)*42)
end


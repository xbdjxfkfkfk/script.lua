local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ضع UserId الخاص بك هنا
local ADMIN_USER_IDS = {
    [123456789] = true,
}

local FOLDER_NAME = "LxAdminRemotes"

local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)

if folder and not folder:IsA("Folder") then
    folder:Destroy()
    folder = nil
end

if not folder then
    folder = Instance.new("Folder")
    folder.Name = FOLDER_NAME
    folder.Parent = ReplicatedStorage
end

local function getRemote(name, className)
    local remote = folder:FindFirstChild(name)

    if remote and not remote:IsA(className) then
        remote:Destroy()
        remote = nil
    end

    if not remote then
        remote = Instance.new(className)
        remote.Name = name
        remote.Parent = folder
    end

    return remote
end

local GetPlayers = getRemote("GetPlayers", "RemoteFunction")
local KickRequest = getRemote("KickRequest", "RemoteEvent")
local KickResult = getRemote("KickResult", "RemoteEvent")

local lastRequest = {}
local REQUEST_COOLDOWN = 2

local function isAdmin(player)
    return ADMIN_USER_IDS[player.UserId] == true
end

GetPlayers.OnServerInvoke = function(requester)
    if not isAdmin(requester) then
        return {
            ok = false,
            message = "ليس لديك صلاحية الإدارة."
        }
    end

    local list = {}

    for _, player in ipairs(Players:GetPlayers()) do
        table.insert(list, {
            userId = player.UserId,
            name = player.Name,
            displayName = player.DisplayName,
            isAdmin = isAdmin(player),
            isSelf = player == requester
        })
    end

    table.sort(list, function(a, b)
        return string.lower(a.name) < string.lower(b.name)
    end)

    return {
        ok = true,
        players = list
    }
end

KickRequest.OnServerEvent:Connect(function(requester, targetUserId, rawReason)
    if not isAdmin(requester) then
        KickResult:FireClient(requester, {
            ok = false,
            message = "رفض الطلب: ليس لديك صلاحية."
        })
        return
    end

    local now = os.clock()
    local previous = lastRequest[requester.UserId] or 0

    if now - previous < REQUEST_COOLDOWN then
        KickResult:FireClient(requester, {
            ok = false,
            message = "انتظر قليلًا قبل تنفيذ طلب آخر."
        })
        return
    end

    lastRequest[requester.UserId] = now

    if typeof(targetUserId) ~= "number"
        or targetUserId % 1 ~= 0 then

        KickResult:FireClient(requester, {
            ok = false,
            message = "رقم اللاعب غير صحيح."
        })
        return
    end

    local target = Players:GetPlayerByUserId(targetUserId)

    if not target or target.Parent ~= Players then
        KickResult:FireClient(requester, {
            ok = false,
            message = "اللاعب لم يعد موجودًا في السيرفر."
        })
        return
    end

    if target == requester then
        KickResult:FireClient(requester, {
            ok = false,
            message = "لا يمكنك طرد نفسك."
        })
        return
    end

    if isAdmin(target) then
        KickResult:FireClient(requester, {
            ok = false,
            message = "لا يمكنك طرد حساب إداري."
        })
        return
    end

    local reason = "إجراء إداري"

    if typeof(rawReason) == "string" then
        reason = rawReason:gsub("[%c]", " ")
        reason = reason:match("^%s*(.-)%s*$") or ""
        reason = string.sub(reason, 1, 100)

        if reason == "" then
            reason = "إجراء إداري"
        end
    end

    local targetName = target.Name
    local kickMessage = "تم إخراجك من السيرفر. السبب: " .. reason

    local success, err = pcall(function()
        target:Kick(kickMessage)
    end)

    if not success then
        warn("[Lx Kick] Failed:", err)

        KickResult:FireClient(requester, {
            ok = false,
            message = "فشل تنفيذ الطرد. راجع سجل الخادم."
        })

        return
    end

    print("[Lx Kick] " .. requester.Name .. " kicked " .. targetName)

    KickResult:FireClient(requester, {
        ok = true,
        message = "تم طرد اللاعب " .. targetName .. " بنجاح."
    })
end)

Players.PlayerRemoving:Connect(function(player)
    lastRequest[player.UserId] = nil
end)


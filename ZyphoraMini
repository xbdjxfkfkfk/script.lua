local function updatePlayerList()
    for _,child in ipairs(playerHolder:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local query=string.lower(search.Text)
    local n=0
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=player and (query=="" or string.find(string.lower(p.Name),query,1,true) or string.find(string.lower(p.DisplayName),query,1,true)) then
            n=n+1
            local b=textButton(playerHolder,"User_"..p.Name,p.DisplayName.."  (@"..p.Name..")",UDim2.new(1,-7,0,36),nil,
                p==selectedPlayer and COLORS.accent or COLORS.button)
            b.TextSize=12
            connect(b.MouseButton1Click,function()
                selectedPlayer=p
                selectedLabel.Text="المحدد: "..p.DisplayName.." (@"..p.Name..")"
                updatePlayerList()
            end)
        end
    end
    playerHolder.Size=UDim2.new(1,-8,0,math.max(n*42,10))
end
connect(search:GetPropertyChangedSignal("Text"),updatePlayerList)
connect(Players.PlayerAdded,updatePlayerList)
connect(Players.PlayerRemoving,function(p)
    if selectedPlayer==p then selectedPlayer=nil;selectedLabel.Text="لم يتم تحديد لاعب" end
    if highlights[p] then highlights[p]:Destroy();highlights[p]=nil end
    updatePlayerList()
end)
itemButton(pages["اللاعبون"],"انتقال إلى اللاعب (محلي)",function()
    if not selectedPlayer or not selectedPlayer.Parent then return notify("حدد لاعبًا أولاً",false) end
    local _,root=characterParts()
    local other=selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root or not other then return notify("موقع اللاعب غير متاح",false) end
    local success=pcall(function()
        player.Character:PivotTo(other.CFrame*CFrame.new(3,0,0))
    end)
    if success then notify("تم إرسال حركة الانتقال محليًا (قد يلغيها السيرفر)",true)
    else notify("تعذر الانتقال",false) end
end)

    inst("TextLabel", {Size = UDim2.new(1, -50, 0, 22), Position = UDim2.fromOffset(50, 6), BackgroundTransparency = 1, Text = title, TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left}, b)
    
    local state = inst("TextLabel", {Size = UDim2.new(1, -50, 0, 16), Position = UDim2.fromOffset(50, 28), BackgroundTransparency = 1, Text = "مطفأ", TextColor3 = Color3.fromRGB(170, 170, 170), Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left}, b)
    
    local on = false
    conn(b.MouseButton1Click, function()
        on = not on
        S[key] = on
        state.Text = on and "مشغّل ✓" or "مطفأ"
        state.TextColor3 = on and Color3.fromRGB(140, 255, 180) or Color3.fromRGB(170, 170, 170)
        b.BackgroundColor3 = on and (color or Color3.fromRGB(100, 50, 150)) or Color3.fromRGB(30, 25, 45)
    end)
    
    return b
end


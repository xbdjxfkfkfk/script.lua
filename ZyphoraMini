local function createErrorGui(errMsg)
    local plr = Players.LocalPlayer
    if not plr then return end
    local pg = plr:FindFirstChildOfClass("PlayerGui")
    if not pg then return end

    -- remove old panel if any
    local old = pg:FindFirstChild("LxErrorGuard")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "LxErrorGuard"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 9999
    gui.Parent = pg

    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromOffset(560,210)
    bg.Position = UDim2.new(0.5,-280,0.32,0)
    bg.BackgroundColor3 = Color3.fromRGB(30,16,17)   -- dark‑red
    bg.BorderSizePixel = 0
    bg.Parent = gui

    Instance.new("UICorner", bg).CornerRadius = UDim.new(0,8)

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1,-24,1,-68)
    txt.Position = UDim2.fromOffset(12,12)
    txt.BackgroundTransparency = 1
    txt.TextWrapped = true
    txt.Font = Enum.Font.Code
    txt.TextSize = 14
    txt.TextColor3 = Color3.new(1,1,1)
    txt.Text = "⚠️ STARTUP ERROR\n\n"..tostring(errMsg):sub(1,500)
    txt.Parent = bg

    local copyBtn = Instance.new("TextButton")
    copyBtn.Size = UDim2.new(0,130,0,32)
    copyBtn.Position = UDim2.new(0,12,1,-44)
    copyBtn.BackgroundColor3 = Color3.fromRGB(200,30,40)

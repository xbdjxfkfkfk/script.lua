local function GetLizardType(model)
    local name = model.Name:lower()
    
    -- أسطوري (Legendary)
    if name:find("legendary") or name:find("اسطوري") or name:find("mythic") or name:find("ancient") then
        return "Legendary", Color3.fromRGB(255, 50, 255)
    end
    
    -- فاخر (Fancy/Premium)
    if name:find("fancy") or name:find("فاخر") or name:find("premium") or name:find("golden") or name:find("gold") then
        return "Fancy", Color3.fromRGB(255, 200, 50)
    end
    
    -- عادي (Normal)
    return "Normal", Color3.fromRGB(100, 255, 100)
end

local function ShouldShow(lizardType)
    if lizardType == "Legendary" then return Config.ShowLegendary end
    if lizardType == "Fancy" then return Config.ShowFancy end
    return Config.ShowNormal
end


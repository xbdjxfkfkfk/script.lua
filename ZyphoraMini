bestDistance = distance
                    closest = target
                end
            end
        end
    end

    if closest then
        r.CFrame = closest.CFrame * CFrame.new(0, 0, 4)
        notify("TELEPORTED")
    else
        notify("NO TARGET FOUND")
    end
end)


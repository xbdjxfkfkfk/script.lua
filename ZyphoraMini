-- Strict model classification: never attach animal markers to players or vehicles.
local function blockedAncestor(obj)
 local cursor=obj
 while cursor and cursor~=WS do
  if cursor:IsA('Model') then
   if Players:GetPlayerFromCharacter(cursor) then return true end
   local n=cursor.Name:lower()
   if n:find('car',1,true) or n:find('truck',1,true) or n:find('vehicle',1,true) or n:find('سيار',1,true) then return true end
   if cursor:FindFirstChildWhichIsA('VehicleSeat',true) then return true end
  end
  if cursor:IsA('VehicleSeat') or cursor:IsA('Seat') then return true end
  cursor=cursor.Parent
 end
 return false
end
local function playerAncestor(obj)
 local cursor=obj
 while cursor and cursor~=WS do
  if cursor:IsA('Model') and Players:GetPlayerFromCharacter(cursor) then return true end
  cursor=cursor.Parent
 end
 return false
end
local function hasVehicle(model)

local togglePaints = {}

local function toggle(p, title, key, fn)
    local b = inst("TextButton", {
        Size = UDim2.new(1, -2, 0, 41),
        Text = "",
        TextColor3 = C.white,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        BackgroundColor3 = C.card
    }, p)
    round(b, 11)
    inst("UIStroke", {Color = Color3.fromRGB(110, 44, 49), Thickness = 1, Transparency = 0.5}, b)
    
    local function paint()
        local enabled = S[key] == true
        b.Text = title .. (enabled and "  |  ON ✓" or "  |  OFF ✕")
        b.BackgroundColor3 = enabled and Color3.fromRGB(105, 30, 35) or C.card
    end
    paint()
    togglePaints[key] = paint
    
    conn(b.MouseButton1Click, function()
        local previous = S[key] == true
        local desired = not previous
        S[key] = desired
        
        local ok, err = true, nil
        if fn then ok, err = pcall(fn, desired) end
        
        if not ok then
            S[key] = previous
            warn("[Lx] toggle failed:", err)
            msg("تعذر تغيير الخيار: " .. tostring(err):sub(1, 55))
        else
            msg(title .. (desired and " : تم التشغيل ON" or " : تم الإيقاف OFF"))
        end
        paint()
    end)
    
    return b
end


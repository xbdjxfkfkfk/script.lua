-- Animal detection
local animalNames = {"dhab", "dhub", "lizard", "reptile", "ضب", "ضبان", "dhabb", "uromastyx", "spiny"}
local vehicleNames = {"car", "truck", "vehicle", "pickup", "chassis", "wheel", "tire", "seat", "سيار", "مركب", "شاص", "كفر", "عجل"}

local function matchesAny(value, words)
    local name = tostring(value):lower()
    for _, word in ipairs(words) do
        if name:find(word, 1, true) then return true end
    end
    return false
end

local function playerAncestor(obj)
    local cursor = obj
    while cursor and cursor ~= WS do
        if cursor:IsA("Model") and Players:GetPlayerFromCharacter(cursor) then return true end
        cursor = cursor.Parent
    end
    return false
end

local function isVehicleModel(model)
    if not model or not model:IsA("Model") then return false end
    if model:FindFirstChildWhichIsA("VehicleSeat", true) then return true end
    if model:FindFirstChild("Chassis") then return true end
    if model:FindFirstChild("Wheels") then return true end
    if matchesAny(model.Name, vehicleNames) then
        if model:FindFirstChildWhichIsA("BasePart", true) then
            return true
        end
    end
    return false
end

local function blockedAncestor(obj)
    local cursor = obj
    while cursor and cursor ~= WS do
        if cursor:IsA("VehicleSeat") or cursor:IsA("Seat") then return true end
        if cursor:IsA("Model") then
            if Players:GetPlayerFromCharacter(cursor) then return true end
            if isVehicleModel(cursor) then return true end
        end
        cursor = cursor.Parent
    end
    return false
end

local function lizard(model)
    if not model or not model:IsA("Model") or not model.Parent then return false end
    if blockedAncestor(model) then return false end
    if isVehicleModel(model) then return false end
    
    local tagged = CollectionService:HasTag(model, "Lizard") or 
                   CollectionService:HasTag(model, "Dhab") or 
                   CollectionService:HasTag(model, "ضب")
    
    local named = matchesAny(model.Name, animalNames)
    if not (tagged or named) then return false end
    
    local hasPart = model:FindFirstChildWhichIsA("BasePart", true) ~= nil
    if not hasPart then return false end
    
    local ok, _, size = pcall(function() return model:GetBoundingBox() end)
    if ok and size then
        local maxDim = math.max(size.X, size.Y, size.Z)
        if maxDim > 15 then return false end
    end
    
    return true
end

local function part(model)
    return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

local function living(model)
    local h = model:FindFirstChildOfClass("Humanoid")
    if h and h.Health <= 0 then return false end
    return model.Parent ~= nil
end

-- Rarity system
local rarities = {
    ["t1"] = "عادي", ["t2"] = "مميز", ["t3"] = "نادر", ["t4"] = "فاخر", ["t5"] = "أسطوري", ["t6"] = "خرافي",
    common = "عادي", uncommon = "مميز", rare = "نادر", epic = "فاخر", legendary = "أسطوري", mythic = "خرافي"
}

local function rarity(m)
    local raw = tostring(m:GetAttribute("Rarity") or m:GetAttribute("Tier") or ""):lower()
    return rarities[raw] or "غير محدد"
end

local function speciesName(model)
    return model:GetAttribute("Species") or model.Name
end

local function animalWeight(model)
    local v = model:GetAttribute("Weight") or model:GetAttribute("WeightKG") or model:GetAttribute("الوزن")
    if v then
        local n = tonumber(v)
        if n then return string.format("%.1f", n) .. " كجم" end
        return tostring(v)
    end
    for _, folderName in ipairs({"Stats", "Data", "Info", "بيانات"}) do
        local folder = model:FindFirstChild(folderName, true)
        if folder then
            local val = folder:GetAttribute("Weight") or folder:GetAttribute("WeightKG")
            if val then return tostring(val) .. " كجم" end
        end
    end
    return "غير معروف"
end

-- Cache
local indexed = setmetatable({}, {__mode = "k"})
local cache = {}

local function refreshCache()
    table.clear(cache)
    for m in pairs(indexed) do
        if m.Parent and living(m) and lizard(m) then
            local p = part(m)
            if p and p.Parent then
                table.insert(cache, {model = m, part = p})
            end
        else
            indexed[m] = nil
        end
    end
end


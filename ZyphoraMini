-- Gamepad thumbstick readings directly to work even if Humanoid is in PlatformStand.
local thumb = Vector2.zero
local function currentThumb()
    -- Poll prevents stale stick values when input focus changes.
    local success, inputs = pcall(UserInputService.GetGamepadState, UserInputService, Enum.UserInputType.Gamepad1)
    if success then
        local found = false
        for _, input in ipairs(inputs) do
            if input.KeyCode == Enum.KeyCode.Thumbstick1 then
                thumb = Vector2.new(input.Position.X, input.Position.Y)
                found = true
                break
            end
        end
        if not found then thumb = Vector2.zero end
    else
        thumb = Vector2.zero
    end
    if thumb.Magnitude < 0.14 then return Vector2.zero end
    return thumb
end
local function keyDown(key)
    return UserInputService:IsKeyDown(key)
end
local function updateFlight()
    if not state.Fly then return end
    local root = localRoot()
    if not root or not fly.velocity or fly.velocity.Parent ~= root then
        startFlight()
        return
    end
    local cam = Workspace.CurrentCamera
    if not cam then return end

    -- FULL camera LookVector, including pitch: up/down naturally follows your aim.
    local look = cam.CFrame.LookVector
    local right = cam.CFrame.RightVector
    local stick = currentThumb()
    local forwardInput = stick.Y
    local sidewaysInput = stick.X

    if keyDown(Enum.KeyCode.W) then forwardInput = forwardInput + 1 end
    if keyDown(Enum.KeyCode.S) then forwardInput = forwardInput - 1 end
    if keyDown(Enum.KeyCode.D) then sidewaysInput = sidewaysInput + 1 end
    if keyDown(Enum.KeyCode.A) then sidewaysInput = sidewaysInput - 1 end

    -- Strafe remains horizontal to avoid accidental climbing while turning.
    local horizontalRight = Vector3.new(right.X, 0, right.Z)
    if horizontalRight.Magnitude > 0.01 then
        horizontalRight = horizontalRight.Unit
    else
        horizontalRight = Vector3.xAxis
    end
    local movement = (look * forwardInput) + (horizontalRight * sidewaysInput)
    if movement.Magnitude > 1 then movement = movement.Unit end
    if movement.Magnitude < 0.03 then movement = Vector3.zero end
    fly.velocity.VectorVelocity = movement * state.FlySpeed

    -- The character faces where you aim, including looking up/down.
    fly.orient.CFrame = cam.CFrame.Rotation
end

local function applySpeed()
    local hum = localHumanoid()
    if hum and not state.Fly then
        if not original.WalkSpeed then original.WalkSpeed = hum.WalkSpeed end
        hum.WalkSpeed = state.Speed and state.WalkSpeed or original.WalkSpeed
    end
end
local function applyLocalInvisible()
    local character = localCharacter()
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = state.LocalInvisible and 1 or 0
        end
    end
end

-- Local noclip: keep each part's original collision state for an honest reset.
local function applyNoclip()
    if not state.Noclip then return end
    local char = localCharacter()
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            if collisionOriginal[obj] == nil then
                collisionOriginal[obj] = obj.CanCollide
            end
            obj.CanCollide = false
        end
    end
end
local function restoreCollisions()
    for part, originalState in pairs(collisionOriginal) do
        if part and part.Parent then
            pcall(function() part.CanCollide = originalState end)
        end
        collisionOriginal[part] = nil
    end
end

-- Incremental BFS: unlike GetDescendants(), this yields instead of locking the UI.
-- Capped to avoid traversing huge maps indefinitely; the result discloses truncation.
local function visitVisible(roots, limit, onObject)
    local queue, front, last = {}, 1, 0
    for _, root in ipairs(roots) do
        if root then last = last + 1; queue[last] = root end
    end
    local scanned = 0
    while front <= last and scanned < limit and alive do
        local current = queue[front]
        queue[front] = nil
        front = front + 1
        if current and current.Parent then
            scanned = scanned + 1
            local descend = onObject(current) ~= false
            if descend then
                for _, child in ipairs(current:GetChildren()) do
                    if last < limit * 2 then
                        last = last + 1
                        queue[last] = child
                    end
                end
            end
        end
        -- Yield more frequently, so a large map does not hog a whole frame.
        if scanned % 55 == 0 then task.wait() end
    end
    return scanned, front <= last
end


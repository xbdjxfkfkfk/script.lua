local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "STRQ_ESP"
ESPFolder.Parent = Screen

local function makeESP(plr)
	if plr == LocalPlayer then return end
	local esp = Instance.new("BillboardGui")
	esp.Name = "ESP_" .. plr.Name
	esp.Size = UDim2.new(8, 0, 1.6, 0) -- إطار كبير — تشوف الاسم من بعيد
	esp.StudsOffset = Vector3.new(0, 3.4, 0)
	esp.AlwaysOnTop = true
	esp.MaxDistance = 2000
	local nm = Instance.new("TextLabel")
	nm.BackgroundTransparency = 1
	nm.Text = plr.Name
	nm.TextSize = 20
	nm.Font = Enum.Font.GothamBold
	nm.Size = UDim2.new(1, 0, 0.55, 0)
	nm.Parent = esp
	local dist = Instance.new("TextLabel")
	dist.BackgroundTransparency = 1
	dist.Text = ""
	dist.TextColor3 = Color3.fromRGB(255, 235, 110)
	dist.TextSize = 15
	dist.Font = Enum.Font.Gotham
	dist.Size = UDim2.new(1, 0, 0.45, 0)
	dist.Position = UDim2.new(0, 0, 0.55, 0)
	dist.Parent = esp
	esp.Parent = ESPFolder

	local bnd
	bnd = RunService.RenderStepped:Connect(function()
		if not plr.Parent then
			esp:Destroy()
			bnd:Disconnect()
			return
		end
		if State.ESP and plr.Character then
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local _, vis = Camera:WorldToViewportPoint(hrp.Position)
				if vis then
					esp.Adornee = hrp
					esp.Enabled = true
					if plr.Team and plr.Team ~= LocalPlayer.Team then
						nm.TextColor3 = Color3.fromRGB(255, 75, 75) -- عدو أحمر
					else
						nm.TextColor3 = Color3.fromRGB(80, 185, 255) -- تيم أزرق
					end
					dist.Text = tostring(math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)) .. " m"
					return
				end
			end
		end
		esp.Enabled = false
	end)
end

for _, plr in ipairs(Players:GetPlayers()) do makeESP(plr) end
Players.PlayerAdded:Connect(makeESP)
Players.PlayerRemoving:Connect(function(plr)
	local e = ESPFolder:FindFirstChild("ESP_" .. plr.Name)
	if e then e:Destroy() end
end)


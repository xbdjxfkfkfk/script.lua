local Flight = {}
do
    Flight.Enabled = false
    Flight.BodyForce = nil
    Flight.BodyGyro = nil
    Flight.Settings = {
        Speed = 80,   -- meters per second
        PitchRate = 60,   -- deg/s
        YawRate   = 60,
        RollRate  = 60,
    }

    function Flight:Enable()
        if self.Enabled then return end
        self.Enabled = true

        local plr = Players.LocalPlayer
        local char = plr.Character or plr.CharacterAdded:Wait()
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then error("HumanoidRootPart missing (flight)") end

        -- Neutralise gravity while preserving existing forces
        self.BodyForce = Instance.new("BodyForce")
        self.BodyForce.Force = Vector3.new(0, workspace.Gravity * root:GetMass(), 0)
        self.BodyForce.Parent = root

        -- Orientation control
        self.BodyGyro = Instance.new("BodyGyro")
        self.BodyGyro.MaxTorque = Vector3.new(1e5,1e5,1e5)
        self.BodyGyro.P = 1500
        self.BodyGyro.CFrame = root.CFrame
        self.BodyGyro.Parent = root

        self._FlightConn = RunService.Heartbeat:Connect(function(dt)
            -- WASD for movement, Q/E for ascend/descend, mouse for direction
            local move = Vector3.new()
            if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + Vector3.new(0,0,-1) end
            if UIS:IsKeyDown(Enum.KeyCode.S) then move = move + Vector3.new(0,0,1)  end
            if UIS:IsKeyDown(Enum.KeyCode.A) then move = move + Vector3.new(-1,0,0) end
            if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + Vector3.new(1,0,0)  end
            if UIS:IsKeyDown(Enum.KeyCode.E) then move = move + Vector3.new(0,1,0)  end
            if UIS:IsKeyDown(Enum.KeyCode.Q) then move = move + Vector3.new(0,-1,0) end

            if move.Magnitude > 0 then
                move = move.Unit * self.Settings.Speed * dt
                root.CFrame = root.CFrame + (root.CFrame:VectorToWorldSpace(move))
            end

            -- Simple mouse look (optional)
            local mouse = UIS:GetMouseLocation()
            local cam = WS.CurrentCamera
            if cam then
                local delta = (mouse - Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2))
                local yaw   = -delta.X * self.Settings.YawRate   * dt * 0.001
                local pitch =  delta.Y * self.Settings.PitchRate * dt * 0.001
                self.BodyGyro.CFrame = self.BodyGyro.CFrame * CFrame.Angles(pitch, yaw, 0)
            end
        end)
    end

    function Flight:Disable()
        if not self.Enabled then return end
        self.Enabled = false
        if self._FlightConn then self._FlightConn:Disconnect() end
        if self.BodyForce then self.BodyForce:Destroy() end
        if self.BodyGyro then self.BodyGyro:Destroy() end
        -- Restore default gravity
        local char = Players.LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root and root:FindFirstChild("BodyForce") then
                root.BodyForce:Destroy()
            end
        end
    end
end


        Position = UDim2.fromOffset(13, 9),
        Size = UDim2.new(1, -225, 0, 29),
        TextXAlignment = Enum.TextXAlignment.Left,
    }, panel)
    local number = create("TextLabel", {
        Text = tostring(STATE[stateKey]),
        TextSize = 16, Font = Enum.Font.GothamBold,
        TextColor3 = PURPLE, BackgroundTransparency = 1,
        Position = UDim2.new(1, -160, 0, 10),
        Size = UDim2.fromOffset(52, 28),
    }, panel)
    for _, spec in ipairs({
        {text = "−", delta = -step, x = -101},
        {text = "+", delta = step, x = -51},
    }) do
        local b = create("TextButton", {
            Text = spec.text, TextSize = 20,
            Font = Enum.Font.GothamBold,
            TextColor3 = TEXT,
            BackgroundColor3 = Color3.fromRGB(70, 52, 103),
            Size = UDim2.fromOffset(43, 33),
            Position = UDim2.new(1, spec.x, 0, 8),
        }, panel)
        corner(b, 8)
        b.MouseButton1Click:Connect(function()
            STATE[stateKey] = math.clamp(STATE[stateKey] + spec.delta, lowest, highest)
            number.Text = tostring(STATE[stateKey])
            if stateKey == "SpeedValue" then updateSpeed() end
        end)
    end
end


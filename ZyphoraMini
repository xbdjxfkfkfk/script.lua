local function new(className, parent, properties)
    local item = Instance.new(className)
    for key, value in pairs(properties or {}) do item[key] = value end
    item.Parent = parent
    return item
end
local function corner(obj, px)
    new("UICorner", obj, {CornerRadius = UDim.new(0, px)})
end
local function label(parent, value, size, bold)
    return new("TextLabel", parent, {
        BackgroundTransparency = 1, Text = value, TextColor3 = C.text,
        TextSize = size or 14, Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
    })
end
local function button(parent, value)
    local b = new("TextButton", parent, {
        Text = value, Font = Enum.Font.GothamBold, TextSize = 13,
        TextColor3 = C.text, BackgroundColor3 = C.raised,
        BorderSizePixel = 0, AutoButtonColor = true, TextWrapped = true,
    })
    corner(b, 9)
    return b
end


    inst("TextLabel", {Size = UDim2.new(1, -45, 0, 18), Position = UDim2.fromOffset(42, 4), BackgroundTransparency = 1, Text = title, TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left}, b)
    
    local state = inst("TextLabel", {Size = UDim2.new(1, -45, 0, 14), Position = UDim2.fromOffset(42, 24), BackgroundTransparency = 1, Text = "OFF", TextColor3 = Color3.fromRGB(150, 150, 150), Font = Enum.Font.Gotham, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left}, b)
    
    local on = false
    conn(b.MouseButton1Click, function()
        on = not on
        S[key] = on
        state.Text = on and "ON ✓" or "OFF"
        state.TextColor3 = on and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(150, 150, 150)
        b.BackgroundColor3 = on and (color or Color3.fromRGB(100, 50, 150)) or Color3.fromRGB(20, 20, 28)
    end)
    
    return b
end


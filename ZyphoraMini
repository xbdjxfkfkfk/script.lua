local function updateSelection()
    if selectedInfo then
        selectedLabel.Text =
            selectedInfo.displayName ..
            "\n@" .. selectedInfo.name ..
            "\nUserId: " .. tostring(selectedInfo.userId)

        kickButton.BackgroundColor3 = RED
        kickButton.Active = true
        kickButton.AutoButtonColor = true
    else
        selectedLabel.Text = "لم يتم اختيار لاعب"
        kickButton.BackgroundColor3 = Color3.fromRGB(95, 35, 39)
        kickButton.Active = false
        kickButton.AutoButtonColor = false
    end
end

renderPlayerList = function()
    for _, child in ipairs(playerList:GetChildren()) do
        if child:IsA("TextButton") or child.Name == "EmptyLabel" then
            child:Destroy()
        end
    end

    local query = string.lower(searchBox.Text or "")
    local visibleCount = 0

    for _, info in ipairs(currentPlayers) do
        local combined = string.lower(
            info.name .. " " .. info.displayName
        )

        if query == "" or string.find(combined, query, 1, true) then
            visibleCount += 1

            local suffix = ""

            if info.isSelf then
                suffix = "  [أنت]"
            elseif info.isAdmin then
                suffix = "  [إدارة]"
            end

            local row = create("TextButton", playerList, {
                Size = UDim2.new(1, -4, 0, 42),
                BackgroundColor3 =
                    selectedInfo and selectedInfo.userId == info.userId
                    and Color3.fromRGB(90, 30, 37)
                    or DARK,
                Text = "  " .. info.displayName ..
                    "  |  @" .. info.name .. suffix,
                TextColor3 = WHITE,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                LayoutOrder = visibleCount
            })

            create("UICorner", row, {
                CornerRadius = UDim.new(0, 6)
            })

            row.Activated:Connect(function()
                selectedInfo = info
                updateSelection()
                renderPlayerList()
            end)
        end
    end

    if visibleCount == 0 then
        create("TextLabel", playerList, {
            Name = "EmptyLabel",
            Size = UDim2.new(1, -4, 0, 45),
            BackgroundTransparency = 1,
            Text = "لا يوجد لاعب مطابق للبحث",
            TextColor3 = GREY,
            Font = Enum.Font.Gotham,
            TextSize = 12
        })
    end
end

refreshPlayers = function()
    statusLabel.Text = "جاري تحديث القائمة..."

    local success, result = pcall(function()
        return GetPlayers:InvokeServer()
    end)

    if not success then
        statusLabel.Text = "تعذر الاتصال بالخادم."
        warn("[Lx] GetPlayers error:", result)
        return
    end

    if not result or not result.ok then
        statusLabel.Text =
            result and result.message or "تعذر تحميل القائمة."
        currentPlayers = {}
        selectedInfo = nil
        updateSelection()
        renderPlayerList()
        return
    end

    currentPlayers = result.players or {}

    if selectedInfo then
        local found = nil

        for _, info in ipairs(currentPlayers) do
            if info.userId == selectedInfo.userId then
                found = info
                break
            end
        end

        selectedInfo = found
    end

    updateSelection()
    renderPlayerList()

    statusLabel.Text =
        "عدد اللاعبين في السيرفر: " .. #currentPlayers
end


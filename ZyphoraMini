refreshPlayers=function()
    if closed or not playerList.Parent then return end
    for _,ch in ipairs(playerList:GetChildren()) do
        if ch:IsA("TextButton") then ch:Destroy() end
    end
    local term=string.lower(search.Text or "")
    local group={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=Me then table.insert(group,p) end
    end
    table.sort(group,function(a,b) return string.lower(a.DisplayName)<string.lower(b.DisplayName) end)
    local found=0
    for _,p in ipairs(group) do
        local name=string.lower(p.Name)
        local display=string.lower(p.DisplayName)
        if term=="" or string.find(name,term,1,true) or string.find(display,term,1,true) then
            found+=1
            local entry=make("TextButton",{
                Size=UDim2.new(1,-1,0,39),BackgroundColor3=p==state.selected and K.accent2 or K.card,
                BorderSizePixel=0,AutoButtonColor=false,
                Text=(p==state.selected and "●  " or "○  ")..p.DisplayName.."  (@"..p.Name..")",
                TextColor3=K.white,Font=Enum.Font.GothamMedium,TextSize=13,
                TextXAlignment=Enum.TextXAlignment.Left,
                LayoutOrder=found,
            },playerList)
            round(entry,8)
            make("UIPadding",{PaddingLeft=UDim.new(0,10)},entry)
            entry.MouseButton1Click:Connect(function()
                state.selected=p
                refreshPlayers()
                notify("تم تحديد "..p.Name)
            end)
        end
    end
    if found==0 then
        local empty=make("TextButton",{
            Text="لا توجد نتائج",TextColor3=K.muted,
            BackgroundTransparency=1,AutoButtonColor=false,
            Font=Enum.Font.Gotham,TextSize=13,
            Size=UDim2.new(1,0,0,35),
        },playerList)
        empty.Active=false
    end
end

local function createToggle(parent, title, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -4, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(26, 27, 33)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Text = title .. " | OFF ✕"
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = btn

    local enabled = false
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        btn.Text = title .. (enabled and " | ON ✓" or " | OFF ✕")
        btn.BackgroundColor3 = enabled and Color3.fromRGB(120, 25, 30) or Color3.fromRGB(26, 27, 33)
        pcall(callback, enabled)
    end)
end


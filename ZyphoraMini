-- Panels Creator
local panels = {}
local function createPanel(name)
    local p = Instance.new("ScrollingFrame")
    p.Name = name
    p.Size = UDim2.new(1, -16, 1, -16)
    p.Position = UDim2.fromOffset(8, 8)
    p.BackgroundTransparency = 1
    p.BorderSizePixel = 0
    p.ScrollBarThickness = 4
    p.AutomaticCanvasSize = Enum.AutomaticSize.Y
    p.CanvasSize = UDim2.new()
    p.Visible = false
    p.Parent = contentContainer

    local pLayout = Instance.new("UIListLayout")
    pLayout.Padding = UDim.new(0, 8)
    pLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pLayout.Parent = p

    panels[name] = p
    return p
end

local function showPanel(name)
    for k, p in pairs(panels) do
        p.Visible = (k == name)
    end
end

local function addNavButton(name, targetPanel)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -4, 0, 42)
    btn.BackgroundColor3 = Color3.fromRGB(28, 29, 35)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Text = name
    btn.Parent = navContainer

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 8)
    bc.Parent = btn

    btn.MouseButton1Click:Connect(function()
        showPanel(targetPanel)
    end)
end


-- Roblox Player Local Panel (client-side). No server admin powers.
-- Run only in a client environment that supports LocalScripts.
local Players = game:GetService('Players')
local UIS = game:GetService('UserInputService')
local RunService = game:GetService('RunService')
local LP = Players.LocalPlayer
local PG = LP:WaitForChild('PlayerGui')
local old = PG:FindFirstChild('LocalPanelV4')
if old then old:Destroy() end
local gui = Instance.new('ScreenGui')
gui.Name='LocalPanelV4'; gui.ResetOnSpawn=false; gui.Parent=PG
local function make(class, props, parent)
 local x=Instance.new(class)
 for k,v in pairs(props) do x[k]=v end
 x.Parent=parent
 return x
end
local panel=make('Frame',{Size=UDim2.fromOffset(540,480),Position=UDim2.new(.5,-270,.5,-240),BackgroundColor3=Color3.fromRGB(20,24,34),BorderSizePixel=0,Active=true,Draggable=true},gui)
make('UICorner',{CornerRadius=UDim.new(0,14)},panel)
local header=make('TextLabel',{Size=UDim2.new(1,-55,0,54),Position=UDim2.fromOffset(16,0),BackgroundTransparency=1,Text='PLAYER PANEL  |  LOCAL',TextColor3=Color3.new(1,1,1),TextSize=23,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},panel)
local toggle=make('TextButton',{Size=UDim2.fromOffset(42,40),Position=UDim2.new(1,-47,0,7),Text='—',TextSize=24,BackgroundColor3=Color3.fromRGB(53,65,88),TextColor3=Color3.new(1,1,1)},panel)
local reopen=make('TextButton',{Size=UDim2.fromOffset(110,38),Position=UDim2.fromOffset(15,90),Text='OPEN PANEL',Visible=false,BackgroundColor3=Color3.fromRGB(39,80,138),TextColor3=Color3.new(1,1,1)},gui)
local body=make('Frame',{Size=UDim2.new(1,-28,1,-70),Position=UDim2.fromOffset(14,60),BackgroundTransparency=1},panel)
local left=make('Frame',{Size=UDim2.new(.48,-5,1,0),BackgroundColor3=Color3.fromRGB(28,35,48),BorderSizePixel=0},body)
local right=make('Frame',{Size=UDim2.new(.52,-5,1,0),Position=UDim2.new(.48,10,0,0),BackgroundColor3=Color3.fromRGB(28,35,48),BorderSizePixel=0},body)
make('UICorner',{CornerRadius=UDim.new(0,9)},left);make('UICorner',{CornerRadius=UDim.new(0,9)},right)
local search=make('TextBox',{Size=UDim2.new(1,-16,0,38),Position=UDim2.fromOffset(8,8),PlaceholderText='Search players...',Text='',TextSize=16,TextColor3=Color3.new(1,1,1),BackgroundColor3=Color3.fromRGB(47,55,70),ClearTextOnFocus=false},left)
local list=make('ScrollingFrame',{Size=UDim2.new(1,-16,1,-60),Position=UDim2.fromOffset(8,52),BackgroundTransparency=1,ScrollBarThickness=5,CanvasSize=UDim2.new()},left)
local layout=make('UIListLayout',{Padding=UDim.new(0,5)},list)
local selected=nil
local status=make('TextLabel',{Size=UDim2.new(1,-16,0,44),Position=UDim2.fromOffset(8,8),BackgroundTransparency=1,Text='Select a player',TextWrapped=true,TextColor3=Color3.fromRGB(200,216,240),TextSize=14},right)
local actions=make('ScrollingFrame',{Size=UDim2.new(1,-16,1,-60),Position=UDim2.fromOffset(8,52),BackgroundTransparency=1,ScrollBarThickness=5,CanvasSize=UDim2.new()},right)
local al=make('UIListLayout',{Padding=UDim.new(0,7)},actions)
local function char() return LP.Character, LP.Character and LP.Character:FindFirstChildOfClass('Humanoid'), LP.Character and LP.Character:FindFirstChild('HumanoidRootPart') end
local speed=false;local flying=false;local esp=false;local invisible=false
local highlights={};local flightConn=nil
local function notify(s) status.Text=s end
local function button(title,callback)
 local b=make('TextButton',{Size=UDim2.new(1,-7,0,39),Text=title,TextColor3=Color3.new(1,1,1),TextSize=15,Font=Enum.Font.GothamMedium,BackgroundColor3=Color3.fromRGB(46,66,96),BorderSizePixel=0},actions)
 make('UICorner',{CornerRadius=UDim.new(0,7)},b)
 b.MouseButton1Click:Connect(function() local ok,err=pcall(callback);if not ok then notify('Error: '..tostring(err)) end end)
 return b
end
local function refresh()
 for _,c in ipairs(list:GetChildren()) do if c:IsA('TextButton') then c:Destroy() end end
 local q=string.lower(search.Text)
 for _,p in ipairs(Players:GetPlayers()) do
  if string.find(string.lower(p.Name),q,1,true) or string.find(string.lower(p.DisplayName),q,1,true) then
   local b=make('TextButton',{Size=UDim2.new(1,-6,0,38),Text=p.DisplayName..'  (@'..p.Name..')',TextSize=13,TextColor3=Color3.new(1,1,1),BackgroundColor3=Color3.fromRGB(48,56,73)},list)
   b.MouseButton1Click:Connect(function() selected=p;notify('Selected: '..p.Name) end)
  end
 end
 list.CanvasSize=UDim2.fromOffset(0,layout.AbsoluteContentSize.Y+8)
end
search:GetPropertyChangedSignal('Text'):Connect(refresh)
Players.PlayerAdded:Connect(refresh);Players.PlayerRemoving:Connect(function(p) if selected==p then selected=nil end;refresh() end)
layout:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(function()list.CanvasSize=UDim2.fromOffset(0,layout.AbsoluteContentSize.Y+8)end)
al:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(function()actions.CanvasSize=UDim2.fromOffset(0,al.AbsoluteContentSize.Y+8)end)
button('Teleport near selected (local)',function()
 local _,_,root=char();local target=selected and selected.Character and selected.Character:FindFirstChild('HumanoidRootPart')
 if not root or not target then notify('Choose a spawned player');return end
 root.CFrame=target.CFrame*CFrame.new(3,0,0);notify('Local teleport attempted')
end)
button('Toggle speed (local)',function()
 speed=not speed;local _,h=char();if h then h.WalkSpeed=speed and 42 or 16 end
 notify('Speed: '..(speed and 'ON' or 'OFF'))
end)
button('Toggle flight (WASD / Space / Ctrl)',function()
 flying=not flying
 if flightConn then flightConn:Disconnect();flightConn=nil end
 local _,h,root=char()
 if not h or not root then flying=false;notify('Spawn first');return end
 if flying then
  h.PlatformStand=true
  flightConn=RunService.RenderStepped:Connect(function(dt)
   local _,hum,r=char();if not hum or not r then return end
   local cam=workspace.CurrentCamera;local d=Vector3.zero
   if UIS:IsKeyDown(Enum.KeyCode.W) then d=d+cam.CFrame.LookVector end
   if UIS:IsKeyDown(Enum.KeyCode.S) then d=d-cam.CFrame.LookVector end
   if UIS:IsKeyDown(Enum.KeyCode.A) then d=d-cam.CFrame.RightVector end
   if UIS:IsKeyDown(Enum.KeyCode.D) then d=d+cam.CFrame.RightVector end
   if UIS:IsKeyDown(Enum.KeyCode.Space) then d=d+Vector3.yAxis end
   if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then d=d-Vector3.yAxis end
   r.AssemblyLinearVelocity=Vector3.zero
   if d.Magnitude>0 then r.CFrame=r.CFrame+CFrame.new(d.Unit*math.min(dt,.05)*55) end
  end)
 else h.PlatformStand=false;root.AssemblyLinearVelocity=Vector3.zero end
 notify('Flight: '..(flying and 'ON' or 'OFF'))
end)
local function clearESP() for _,h in pairs(highlights) do if h then h:Destroy() end end;table.clear(highlights) end
local function updateESP()
 clearESP();if not esp then return end
 for _,p in ipairs(Players:GetPlayers()) do
  if p~=LP and p.Character then
   local hi=Instance.new('Highlight');hi.Name='LocalESP';hi.FillTransparency=.7;hi.OutlineTransparency=0;hi.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop;hi.Adornee=p.Character;hi.Parent=gui;highlights[p]=hi
  end
 end
end
button('Toggle ESP highlights (local)',function()esp=not esp;updateESP();notify('ESP: '..(esp and 'ON' or 'OFF')) end)
Players.PlayerAdded:Connect(function(p)p.CharacterAdded:Connect(function()task.wait(.5);updateESP()end)end)
Players.PlayerRemoving:Connect(function()task.defer(updateESP)end)
for _,p in ipairs(Players:GetPlayers()) do p.CharacterAdded:Connect(function()task.wait(.5);updateESP()end) end
button('Toggle local invisibility',function()
 invisible=not invisible
 local c=LP.Character;if c then for _,x in ipairs(c:GetDescendants()) do if x:IsA('BasePart') then x.LocalTransparencyModifier=invisible and 1 or 0 end end end
 notify('Local-only invisibility: '..(invisible and 'ON' or 'OFF'))
end)
button('Camera zoom out',function()LP.CameraMaxZoomDistance=300;notify('Camera zoom range increased')end)
button('Reset camera zoom',function()LP.CameraMaxZoomDistance=128;notify('Camera zoom range reset')end)
button('Reset character movement',function()
 speed=false;flying=false;if flightConn then flightConn:Disconnect();flightConn=nil end
 local _,h,r=char();if h then h.PlatformStand=false;h.WalkSpeed=16 end;if r then r.AssemblyLinearVelocity=Vector3.zero end
 notify('Movement reset')
end)
button('Server-only actions info',function()notify('Kick, freeze, carry, pull, give flight require server permissions / cooperation')end)
toggle.MouseButton1Click:Connect(function()panel.Visible=false;reopen.Visible=true end)
reopen.MouseButton1Click:Connect(function()panel.Visible=true;reopen.Visible=false end)
UIS.InputBegan:Connect(function(key,processed)if not processed and key.KeyCode==Enum.KeyCode.RightShift then panel.Visible=not panel.Visible;reopen.Visible=not panel.Visible end end)
LP.CharacterAdded:Connect(function()flying=false;if flightConn then flightConn:Disconnect();flightConn=nil end end)
refresh()

local function vehicleModels()
 local results,seen={},{}
 local names={'car','vehicle','truck','bike','sedan','suv','سيارة','مركبة'}
 for _,o in ipairs(WS:GetDescendants()) do
  if o:IsA('VehicleSeat') then
   local m=o:FindFirstAncestorOfClass('Model')
   if m and not seen[m] then seen[m]=true;results[#results+1]=m end
  end
 end
 for _,o in ipairs(WS:GetDescendants()) do
  if o:IsA('Model') and not seen[o] and part(o) then
   local name=string.lower(o.Name)
   for _,word in ipairs(names) do
    if name:find(word,1,true) then
     seen[o]=true;results[#results+1]=o;break
    end
   end
  end
 end
 table.sort(results,function(a,b)return a.Name<b.Name end)
 return results
end

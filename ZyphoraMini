local function rarity(m)
 local raw=stat(m,{'Rarity','Tier','Grade','Quality','ندرة'})
 if raw==nil then return 'غير محدد',col.muted end
 local s=tostring(raw); local normalized=rarityNames[s:upper()] or s
 local low=normalized:lower()
 if low:find('common',1,true) then normalized='عادي' elseif low:find('uncommon',1,true) then normalized='أخضر' elseif low:find('legendary',1,true) then normalized='ذهبي' elseif low:find('mythic',1,true) then normalized='خرافي' elseif low:find('epic',1,true) then normalized='بنفسجي' elseif low:find('rare',1,true) then normalized='أزرق' end
 return normalized,rarityColors[normalized] or col.muted
end
local function isAnimal(m)

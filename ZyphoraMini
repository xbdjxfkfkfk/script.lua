-- Lx REDLINE v78 navigation extension
-- Insert inside initializeFeatures(), after goToPointWithCar and nearestNamed are assigned.
-- Uses existing: tab, action, label, inst, round, conn, msg, root, WS, S,
-- goToPointWithCar, nearestNamed, findMerchant, moveTo, C.
local nav = tab('وجهات v78')
label(nav,'انتقال بالسيارة أو اللاعب','الوجهات تُكتشف من العناصر المحمّلة؛ زر الإلغاء يمنع أي انتقال مؤجل')
local destinations = {
 {title='تاجر الخلا', words={'تاجر الخلا','merchant','trader','dealer'}},
 {title='نفرة الفيروز', words={'نفرة الفيروز','فيروز','turquoise','turqoise'}},
 {title='القولد', words={'قولد','gold','golden'}},
 {title='الألماسي', words={'الماسي','ألماسي','diamond'}},
 {title='العالم الثاني', words={'العالم الثاني','world 2','world2','second world','portal2'}},
 {title='الديرة', words={'ديرة','home','base','spawnlocation'}},
}
local selected = 1
local pendingToken = 0
local destinationButton = action(nav,'الوجهة: '..destinations[selected].title,function()
 selected = selected % #destinations + 1
 destinationButton.Text = 'الوجهة: '..destinations[selected].title
 msg('تم اختيار '..destinations[selected].title)
end)
local delaySeconds = 1.5
local delayButton = action(nav,'مهلة التأكيد: 1.5 ثانية',function()
 delaySeconds = delaySeconds == 1.5 and 3 or (delaySeconds == 3 and 5 or 1.5)
 delayButton.Text = 'مهلة التأكيد: '..delaySeconds..' ثانية'
end)
action(nav,'الانتقال للوجهة المختارة',function()
 pendingToken += 1
 local token = pendingToken
 local dest = destinations[selected]
 msg('سيتم الانتقال إلى '..dest.title..' بعد '..delaySeconds..' ثانية؛ اضغط إلغاء للتراجع')
 task.delay(delaySeconds,function()
  if not alive or token ~= pendingToken then return end
  local target
  if selected == 1 then target = findMerchant() else target = nearestNamed(dest.words) end
  if not target or not target.Parent then
   msg('لم تُكتشف وجهة '..dest.title..' ضمن عناصر الماب المحمّلة')
   return
  end
  goToPointWithCar(target)
 end)
end)
action(nav,'إلغاء الانتقال المعلّق ✕',function()
 pendingToken += 1
 msg('تم إلغاء الانتقال المعلّق')
end)
label(nav,'حدود الانتقال','الإلغاء يوقف العملية قبل تنفيذها، ولا يعكس انتقالًا تم بالفعل. قد يعيد السيرفر موقع اللاعب أو السيارة.')

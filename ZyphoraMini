-- Continuous movement
bind(RunService.Stepped, function()
    if not alive or not S.Noclip then return end

    local char = LP.Character
    if not char then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if originalCollisions[part] == nil then
                originalCollisions[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end
end)

bind(RunService.Heartbeat, function()
    if not alive or not S.Fly then return end

    if not flyVelocity or not flyVelocity.Parent then
        stopFly()
        return
    end

    local hum = getHum()
    if not hum then return end

    local vertical = 0

    if UIS:IsKeyDown(Enum.KeyCode.Space)
        or UIS:IsKeyDown(Enum.KeyCode.E) then
        vertical += 1
    end

    if UIS:IsKeyDown(Enum.KeyCode.LeftControl)
        or UIS:IsKeyDown(Enum.KeyCode.Q) then
        vertical -= 1
    end

    flyVelocity.VectorVelocity =
        hum.MoveDirection * 65
        + Vector3.new(0, vertical * 65, 0)
end)

-- Respawn handling
bind(LP.CharacterAdded, function(char)
    stopFly()
    restoreCollision()
    speedOriginal = nil

    if S.Speed then
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 10)
            if hum and alive and S.Speed then
                speedOriginal = hum.WalkSpeed
                hum.WalkSpeed = 80
            end
        end)
    end
end)

-- Drag window (mouse and touch)
local dragging = false
local dragStart
local originalPosition
local dragInput

bind(Header.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        originalPosition = Main.Position
        dragInput = input
    end
end)

bind(UIS.InputChanged, function(input)
    if not dragging then return end

    if input == dragInput
        or (dragInput
            and dragInput.UserInputType ==
                Enum.UserInputType.MouseButton1
            and input.UserInputType ==
                Enum.UserInputType.MouseMovement) then

        local delta = input.Position - dragStart

        Main.Position = UDim2.new(
            originalPosition.X.Scale,
            originalPosition.X.Offset + delta.X,
            originalPosition.Y.Scale,
            originalPosition.Y.Offset + delta.Y
        )
    end
end)

bind(UIS.InputEnded, function(input)
    if input == dragInput
        or (dragInput
            and dragInput.UserInputType ==
                Enum.UserInputType.MouseButton1
            and input.UserInputType ==
                Enum.UserInputType.MouseButton1) then
        dragging = false
        dragInput = nil
    end
end)

-- Minimize
local minimized = false

bind(Min.MouseButton1Click, function()
    minimized = not minimized

    Scroll.Visible = not minimized
    Footer.Visible = not minimized
    Min.Text = minimized and "+" or "−"

    TweenService:Create(
        Main,
        TweenInfo.new(0.2, Enum.EasingStyle.Quad),
        {
            Size = minimized
                and UDim2.fromOffset(280, 46)
                or UDim2.fromOffset(280, 430)
        }
    ):Play()
end)

-- Cleanup
local function cleanup()
    if not alive then return end
    alive = false

    stopFly()
    restoreCollision()
    setESP(false)

    if S.Speed then
        setSpeed(false)
    end

    if S.Fullbright then
        setFullbright(false)
    end

    for _, con in ipairs(connections) do
        con:Disconnect()
    end
    table.clear(connections)

    if _G.ZyphoraCleanup == cleanup then
        _G.ZyphoraCleanup = nil
    end

    if GUI.Parent then
        GUI:Destroy()
    end
end

_G.ZyphoraCleanup = cleanup

bind(Close.MouseButton1Click, cleanup)
bind(GUI.Destroying, cleanup)


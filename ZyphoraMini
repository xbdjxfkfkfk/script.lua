local hidden = {}
local frozen = {}
local lastCall = {}

local function setHidden(player, enable)
    local character = player.Character
    if not character then return false, "الشخصية غير موجودة" end
    if not enable then
        local state = hidden[player]
        if state and state.character == character then
            for instance, value in pairs(state.props) do
                if instance and instance.Parent then
                    if instance:IsA("BasePart") or instance:IsA("Decal") or instance:IsA("Texture") then
                        instance.Transparency = value
                    else
                        instance.Enabled = value
                    end
                end
            end
        end
        hidden[player] = nil
        notify:FireClient(player, "invisibility", false)
        return true, "رجعت مرئيًا للجميع"
    end
    if hidden[player] and hidden[player].character == character then
        return true, "الاختفاء شغال"
    end
    local state = {character = character, props = {}}
    for _, item in ipairs(character:GetDescendants()) do
        if item:IsA("BasePart") or item:IsA("Decal") or item:IsA("Texture") then
            state.props[item] = item.Transparency
            item.Transparency = 1
        elseif item:IsA("ParticleEmitter") or item:IsA("Trail") or item:IsA("Beam")
            or item:IsA("BillboardGui") or item:IsA("Highlight") or item:IsA("PointLight")
            or item:IsA("SpotLight") or item:IsA("SurfaceLight") then
            state.props[item] = item.Enabled
            item.Enabled = false
        end
    end
    hidden[player] = state
    notify:FireClient(player, "invisibility", true)
    return true, "مختفٍ عن اللاعبين (قد تكشفك أنظمة مخصصة بالماب)"
end

local function setFrozen(target, enable)
    local character = target.Character
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then return false, "شخصية اللاعب غير جاهزة" end
    if enable then
        if frozen[target] and frozen[target].character == character then return true, "مجمد مسبقًا" end
        frozen[target] = {character = character, root = root, hum = hum,
            anchored = root.Anchored, speed = hum.WalkSpeed,
            jumpPower = hum.JumpPower, jumpHeight = hum.JumpHeight, autoRotate = hum.AutoRotate}
        root.Anchored = true
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.JumpHeight = 0
        hum.AutoRotate = false
        return true, "تم تجميد " .. target.Name
    end
    local state = frozen[target]
    if state and state.character == character and state.root.Parent and state.hum.Parent then
        state.root.Anchored = state.anchored
        state.hum.WalkSpeed = state.speed
        state.hum.JumpPower = state.jumpPower
        state.hum.JumpHeight = state.jumpHeight
        state.hum.AutoRotate = state.autoRotate
    end
    frozen[target] = nil
    return true, "تم فك التجميد"
end

local function getRoot(plr)
    local char = plr.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (char and root and hum and hum.Health > 0) then return nil end
    return char, root, hum

do
	local page = tabs["الخريطة"].page  -- داخل تاب الخريطة تحت مع قائمة
	sectionLabel(page, "🧍 قامتي / جسمي")

	-- تكبير قامتي لتشوف اسمك زين
	makeSlider(page, "📏 تكبير قامتي", 1, 10, 1, function(v)
		local c = getChar()
		local hum = c and c:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.BodyHeightScale.Value = v
			hum.BodyWidthScale.Value  = math.max(v - 0.5, 0.5)
			hum.BodyDepthScale.Value  = math.max(v - 0.5, 0.5)
			hum.HeadScale.Value       = v
		end
	end)

	-- اخفاء قامتي + الرجوع
	makeToggle(page, "🫥 أخفي قامتي / أرجعها (محد يشوفني)", function(on)
		State.Invis = on
		local c = getChar()
		if not c then return end
		local hum = c:FindFirstChildOfClass("Humanoid")
		if on then
			State.InvisStore = {}
			for _, p in ipairs(c:GetDescendants()) do
				if p:IsA("BasePart") or p:IsA("Decal") then
					State.InvisStore[p] = p.Transparency
					pcall(function() p.Transparency = 1 end)
				end
				if p:IsA("ParticleEmitter") or p:IsA("Trail") or p:IsA("Beam") then
					pcall(function() p.Enabled = false end)
				end
			end
			if hum then
				hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			end
		else
			for p, t in pairs(State.InvisStore) do
				if p and p.Parent then
					pcall(function() p.Transparency = t end)
				end
			end
			State.InvisStore = {}
			if hum then
				hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
			end
		end
	end)
end

-- اجعل قامتي تظل مخفية حتى مع إلباس/تغيير
RunService.Heartbeat:Connect(function()
	if State.Invis then
		local c = getChar()
		if c then
			for _, p in ipairs(c:GetDescendants()) do
				if p:IsA("BasePart") and p.Transparency < 1 then
					pcall(function() p.Transparency = 1 end)
				end
			end
			local hum = c:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			end
		end
	end
end)


local function launchMainInterface()
    authGui:Destroy()

    local mainGui = inst("ScreenGui", { Name = "Lx_NexusV77", ResetOnSpawn = false, DisplayOrder = 90, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, PG)
    local mainFrame = inst("Frame", { Size = UDim2.fromOffset(650, 500), Position = UDim2.new(.5, -325, .5, -250), BackgroundColor3 = C.bg, BorderSizePixel = 0, Active = true, Draggable = true }, mainGui)
    round(mainFrame, 16)
    inst("UIStroke", { Color = Color3.fromRGB(205, 36, 42), Thickness = 1.4, Transparency = .12 }, mainFrame)

    local scale = inst("UIScale", { Scale = 1 }, mainFrame)
    local function fitScreen()
        local cam = WS.CurrentCamera
        if cam then
            local v = cam.ViewportSize
            scale.Scale = math.min(1, math.max(.55, math.min((v.X - 24) / 650, (v.Y - 24) / 500)))
        end
    end
    fitScreen()

    local head = inst("Frame", { Size = UDim2.new(1, 0, 0, 66), BackgroundColor3 = Color3.fromRGB(22, 22, 24), BorderSizePixel = 0, Active = true }, mainFrame)
    round(head, 16)
    inst("Frame", { Size = UDim2.new(1, -30, 0, 2), Position = UDim2.new(0, 15, 1, -2), BackgroundColor3 = C.purple, BorderSizePixel = 0 }, head)

    local brand = inst("Frame", { Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(12, 11), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0 }, head)
    round(brand, 12)
    inst("UIStroke", { Color = Color3.fromRGB(240, 42, 50), Thickness = 1 }, brand)
    inst("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "Lx", Font = Enum.Font.GothamBlack, TextSize = 22, TextColor3 = C.purple }, brand)

    inst("TextLabel", { Size = UDim2.fromOffset(270, 17), Position = UDim2.fromOffset(70, 39), BackgroundTransparency = 1, Text = "REDLINE  •  ULTIMATE ENGINE v77.1", TextColor3 = C.muted, Font = Enum.Font.GothamMedium, TextSize = 9, TextXAlignment = Enum.TextXAlignment.Left }, head)
    inst("TextLabel", { Size = UDim2.fromOffset(330, 30), Position = UDim2.fromOffset(70, 9), BackgroundTransparency = 1, Text = "Lx  REDLINE PRO", TextColor3 = C.white, Font = Enum.Font.GothamBold, TextSize = 19, TextXAlignment = Enum.TextXAlignment.Left }, head)

    local function smallBtn(text, x)
        local b = inst("TextButton", { Size = UDim2.fromOffset(31, 29), Position = UDim2.new(1, x, 0, 19), Text = text, Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = C.white, BackgroundColor3 = C.bg }, head)
        round(b, 7)
        return b
    end
    local miniBtn = smallBtn("−", -78)
    local closeBtn = smallBtn("×", -39)

    local sideContainer = inst("ScrollingFrame", { Size = UDim2.new(0, 188, 1, -111), Position = UDim2.fromOffset(12, 76), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, mainFrame)
    inst("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, sideContainer)

    local areaContainer = inst("Frame", { Size = UDim2.new(1, -222, 1, -114), Position = UDim2.fromOffset(210, 76), BackgroundTransparency = 1, ClipsDescendants = true }, mainFrame)
    statusText = inst("TextLabel", { Size = UDim2.new(1, -24, 0, 25), Position = UDim2.new(0, 12, 1, -31), BackgroundTransparency = 1, Text = "Lx REDLINE v77.1 | جاهز ومستقر", TextColor3 = C.muted, TextSize = 11, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, mainFrame)

    local minimized = false
    conn(miniBtn.MouseButton1Click, function()
        minimized = not minimized
        areaContainer.Visible = not minimized
        sideContainer.Visible = not minimized
        mainFrame.Size = minimized and UDim2.fromOffset(650, 66) or UDim2.fromOffset(650, 500)
    end)

    local function fullCleanup()
        if not alive then return end
        alive = false
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        for _, d in pairs(drawingObjects) do pcall(function() d:Remove() end) end
        pcall(function() RunService:UnbindFromRenderStep("LxRedlineMainLoop") end)
        if mainGui and mainGui.Parent then pcall(function() mainGui:Destroy() end) end
        if env.LxRedlineCleanup == fullCleanup then env.LxRedlineCleanup = nil end
    end
    env.LxRedlineCleanup = fullCleanup

    conn(closeBtn.MouseButton1Click, fullCleanup)

    local tabs = {}
    local pageButtons = {}
    local function createTab(name)
        local b = inst("TextButton", { Size = UDim2.new(1, -6, 0, 44), Text = name, TextSize = 12, Font = Enum.Font.GothamBold, TextColor3 = C.white, BackgroundColor3 = C.card }, sideContainer)
        round(b, 11)
        inst("UIStroke", { Color = Color3.fromRGB(110, 44, 49), Thickness = 1, Transparency = .45 }, b)

        local p = inst("ScrollingFrame", { Size = UDim2.fromScale(1, 1), Visible = false, BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, areaContainer)
        inst("UIListLayout", { Padding = UDim.new(0, 9), SortOrder = Enum.SortOrder.LayoutOrder }, p)
        inst("UIPadding", { PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 12), PaddingRight = UDim.new(0, 8) }, p)

        table.insert(tabs, p)
        table.insert(pageButtons, b)

        conn(b.MouseButton1Click, function()
            for i, t in ipairs(tabs) do
                t.Visible = (t == p)
                pageButtons[i].BackgroundColor3 = (t == p) and C.purple or C.card
            end
        end)

        if #tabs == 1 then
            p.Visible = true
            b.BackgroundColor3 = C.purple
        end
        return p
    end

    local function createToggle(p, title, key, fn)
        local b = inst("TextButton", { Size = UDim2.new(1, -2, 0, 41), Text = "", TextColor3 = C.white, TextSize = 12, Font = Enum.Font.GothamBold, BackgroundColor3 = C.card }, p)
        round(b, 11)
        inst("UIStroke", { Color = Color3.fromRGB(110, 44, 49), Thickness = 1, Transparency = .5 }, b)

        local function paint()
            local enabled = S[key] == true
            b.Text = title .. (enabled and "  |  ON ✓" or "  |  OFF ✕")
            b.BackgroundColor3 = enabled and Color3.fromRGB(105, 30, 35) or C.card
        end
        paint()

        conn(b.MouseButton1Click, function()
            local previous = S[key] == true
            local desired = not previous
            S[key] = desired
            local ok, err = true, nil
            if fn then ok, err = pcall(fn, desired) end
            if not ok then
                S[key] = previous
                msg("تعذر التبديل")
            else
                msg(title .. (desired : " : تم التشغيل" or " : تم الإيقاف"))
            end
            paint()
        end)
        return b
    end

    local function createNumber(p, title, key, min, max, step)
        local f = inst("Frame", { Size = UDim2.new(1, -2, 0, 72), BackgroundColor3 = C.card, BorderSizePixel = 0 }, p)
        round(f, 10)
        inst("TextLabel", { Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 4), BackgroundTransparency = 1, Text = title, TextColor3 = C.white, TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left }, f)

        local minus = inst("TextButton", { Size = UDim2.fromOffset(36, 31), Position = UDim2.fromOffset(8, 31), Text = "−", TextColor3 = C.white, Font = Enum.Font.GothamBold, TextSize = 18, BackgroundColor3 = C.bg }, f)
        round(minus, 6)
        local plus = inst("TextButton", { Size = UDim2.fromOffset(36, 31), Position = UDim2.new(1, -44, 0, 31), Text = "+", TextColor3 = C.white, Font = Enum.Font.GothamBold, TextSize = 18, BackgroundColor3 = C.bg }, f)
        round(plus, 6)

        local valueBox = inst("TextBox", { Size = UDim2.new(1, -108, 0, 31), Position = UDim2.fromOffset(54, 31), BackgroundColor3 = C.bg, Text = tostring(S[key]), ClearTextOnFocus = false, TextColor3 = C.white, TextSize = 14, Font = Enum.Font.GothamBold }, f)
        round(valueBox, 6)
        inst("UIStroke", { Color = C.purple, Thickness = 1.2, Transparency = .2 }, valueBox)

        local function commit(raw)
            local cleaned = tostring(raw):gsub("٫", "."):gsub("٬", ""):gsub("،", ".")
            local n = tonumber(cleaned)
            if n and n == n and n ~= math.huge then
                S[key] = math.clamp(math.floor(n * 100 + .5) / 100, min, max)
            end
            valueBox.Text = tostring(S[key])
        end

        conn(minus.MouseButton1Click, function() commit(S[key] - step) end)
        conn(plus.MouseButton1Click, function() commit(S[key] + step) end)
        conn(valueBox.FocusLost, function() commit(valueBox.Text) end)
        return f
    end

    -- TABS CREATION
    local radarTab = createTab("كشف الضبان")
    createToggle(radarTab, "كشف العناصر (Radar)", "Radar")
    createToggle(radarTab, "رسم ESP احترافي (Drawing API)", "DrawingESP", function(on)
        if not on then
            for _, d in pairs(drawingObjects) do pcall(function() d:Remove() end) end
            table.clear(drawingObjects)
        end
    end)
    createNumber(radarTab, "مدى الكشف", "RadarRange", 500, 5000, 200)

    local vehicleTab = createTab("المركبات والطيران")
    createToggle(vehicleTab, "طيران السيارة (Car Fly)", "CarFly", function(on)
        if not on then
            local char = LP.Character
            local seat = char and char.Humanoid.SeatPart
            if seat and seat:IsA("VehicleSeat") then
                local vehicle = seat.Parent
                local pv = vehicle and vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
                if pv then
                    if pv:FindFirstChild("LxCarFlyBV") then pv.LxCarFlyBV:Destroy() end
                    if pv:FindFirstChild("LxCarFlyBG") then pv.LxCarFlyBG:Destroy() end
                end
            end
        end
    end)
    createNumber(vehicleTab, "سرعة الطيران", "FlySpeed", 20, 300, 10)

    createToggle(vehicleTab, "طيران الشخصية (Player Fly)", "PlayerFly", function(on)
        if not on then
            local r = root()
            if r then
                if r:FindFirstChild("LxPlayerFlyBV") then r.LxPlayerFlyBV:Destroy() end
                if r:FindFirstChild("LxPlayerFlyBG") then r.LxPlayerFlyBG:Destroy() end
            end
        end
    end)
    createNumber(vehicleTab, "سرعة طيران الشخصية", "PlayerFlySpeed", 10, 200, 10)

    local combatTab = createTab("السرعة")
    createToggle(combatTab, "تعديل سرعة المشي", "Speed", function(on)
        local h = hum()
        if h then
            if on then
                originalSpeed = originalSpeed or h.WalkSpeed
                h.WalkSpeed = S.Walk
            else
                if originalSpeed then h.WalkSpeed = originalSpeed end
            end
        end
    end)
    createNumber(combatTab, "سرعة المشي", "Walk", 16, 120, 4)

    local worldTab = createTab("البيئة")
    createToggle(worldTab, "إضاءة كاملة (Fullbright)", "Fullbright", function(on)
        if on then
            lightSaved.Brightness = Lighting.Brightness
            lightSaved.ClockTime = Lighting.ClockTime
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.GlobalShadows = false
        else
            if lightSaved.Brightness then Lighting.Brightness = lightSaved.Brightness end
            if lightSaved.ClockTime then Lighting.ClockTime = lightSaved.ClockTime end
            Lighting.GlobalShadows = true
        end
    end)

    -- HIGH PERFORMANCE RENDER LOOP
    conn(RunService.RenderStepped, function()
        if not alive then return end

        if S.CarFly then
            local char = LP.Character
            local seat = char and char.Humanoid.SeatPart
            if seat and seat:IsA("VehicleSeat") then
                local vehicle = seat.Parent
                local pv = vehicle and vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
                if pv then
                    local bv = pv:FindFirstChild("LxCarFlyBV")
                    local bg = pv:FindFirstChild("LxCarFlyBG")
                    if not bv then
                        bv = inst("BodyVelocity", { Name = "LxCarFlyBV", MaxForce = Vector3.new(1e5, 1e5, 1e5), Velocity = Vector3.new(0, 0, 0) }, pv)
                        bg = inst("BodyGyro", { Name = "LxCarFlyBG", MaxTorque = Vector3.new(1e5, 1e5, 1e5), CFrame = pv.CFrame }, pv)
                    end
                    local cam = WS.CurrentCamera
                    local moveDir = Vector3.new()
                    if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir += cam.CFrame.LookVector end
                    if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir -= cam.CFrame.LookVector end
                    if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir += cam.CFrame.RightVector end
                    if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir -= cam.CFrame.RightVector end
                    if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
                    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0, 1, 0) end

                    bv.Velocity = moveDir.Magnitude > 0 and moveDir.Unit * S.FlySpeed or Vector3.new(0, 0.1, 0)
                    bg.CFrame = cam.CFrame
                end
            end
        end

        if S.PlayerFly then
            local r = root()
            if r then
                local bv = r:FindFirstChild("LxPlayerFlyBV")
                local bg = r:FindFirstChild("LxPlayerFlyBG")
                if not bv then
                    bv = inst("BodyVelocity", { Name = "LxPlayerFlyBV", MaxForce = Vector3.new(1e5, 1e5, 1e5), Velocity = Vector3.new(0, 0, 0) }, r)
                    bg = inst("BodyGyro", { Name = "LxPlayerFlyBG", MaxTorque = Vector3.new(1e5, 1e5, 1e5), CFrame = r.CFrame }, r)
                end
                local cam = WS.CurrentCamera
                local moveDir = Vector3.new()
                if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir += cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir -= cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir += cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir -= cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0, 1, 0) end

                bv.Velocity = moveDir.Magnitude > 0 and moveDir.Unit * (S.PlayerFlySpeed or 60) or Vector3.new(0, 0, 0)
                bg.CFrame = cam.CFrame
            end
        end
    end)

    msg("Lx REDLINE v77.1 | تم تفعيل المحرك الاحترافي بالكامل")
end

conn(verifyBtn.MouseButton1Click, function()
    authStatus.Text = "جاري المصادقة عبر خادم الديسكورد..."
    task.delay(1.0, function()
        if alive then
            authStatus.Text = "تم التحقق بنجاح!"
            task.delay(0.5, launchMainInterface)
        end
    end)
end)

        if camera then
            local look=camera.CFrame.LookVector
            local flat=Vector3.new(look.X,0,look.Z)
            if flat.Magnitude>0.01 then align.CFrame=CFrame.lookAt(Vector3.zero,flat.Unit) end
        end
    end)
    if flightControls then flightControls.Visible=true end
    say("الطيران ON | WASD / الجوال: العصا وأزرار ↑ ↓",true)
end

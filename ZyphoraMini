local function updateVehicleBoost(dt)
 if S.CarFly then
  vehicleState='الطيران مفعّل: مساعد السرعة الأرضي معلّق';clearVehicleBoost();return
 end
 if not S.CarSpeed then
  vehicleState='مساعد السرعة متوقف';clearVehicleBoost();return
 end
 local h=hum()
 local seat=h and h.SeatPart
 if not seat then
  vehicleState='اجلس في مقعد السائق';clearVehicleBoost();return
 end
 if not seat:IsA('VehicleSeat') then
  vehicleState='مقعد مخصص ('..seat.ClassName..'): لا توجد طريقة عامة لضبط سرعته';clearVehicleBoost();return
 end
 if seat.Occupant~=h then
  vehicleState='لا يوجد تحكم في مقعد السائق';clearVehicleBoost();return
 end
 local body=seat.AssemblyRootPart or seat
 if not body or body.Anchored then
  vehicleState='جسم السيارة ثابت أو غير متاح';clearVehicleBoost();return
 end
 if savedSeat~=seat then
  restoreSeat()
  savedSeat=seat;savedMaxSpeed=seat.MaxSpeed;savedTorque=seat.Torque
 end
 local target=math.clamp(S.CarTarget,20,400)
 pcall(function() seat.MaxSpeed=math.max(savedMaxSpeed or 0,target) end)
 pcall(function() seat.Torque=math.max(savedTorque or 0,math.min(20000,target*45)) end)
 local pressingW=UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up)
 local throttle=seat.ThrottleFloat
 if not pressingW and throttle<=0.05 then
  vehicleState='انتظار W | السرعة الحالية '..string.format('%.1f',body.AssemblyLinearVelocity.Magnitude)
  vehicleSpeedStuckFor=0;return
 end
 local forward=seat.CFrame.LookVector*S.CarDirection
 local flat=Vector3.new(forward.X,0,forward.Z)
 if flat.Magnitude<0.01 then vehicleState='اتجاه السيارة غير صالح';return end
 flat=flat.Unit
 local velocity=body.AssemblyLinearVelocity
 local horizontal=Vector3.new(velocity.X,0,velocity.Z)
 local current=horizontal.Magnitude
 -- Preserve actual movement direction to avoid sideways impulses on steering.
 local direction=current>1 and horizontal.Unit or flat

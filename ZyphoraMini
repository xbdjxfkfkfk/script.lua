local function scanVisibleTitles()
    titleEntries = {}
    local scanned, maxObjects = 0, 15000
    for _, root in ipairs({ReplicatedStorage, Workspace, game:GetService("StarterGui"), PlayerGui}) do
        for _, obj in ipairs(root:GetDescendants()) do
            scanned = scanned + 1
            if scanned > maxObjects then break end
            if scanned % 160 == 0 then task.wait() end
            if not obj:IsDescendantOf(gui) then
                if obj:IsA("StringValue") then
                    if titleField(obj.Name) then
                        addTitleCandidate(obj.Value, "قيمة ظاهرة")
                    elseif titleContainer(obj.Parent) then
                        addTitleCandidate(obj.Name, "قائمة ظاهرة")
                        addTitleCandidate(obj.Value, "قيمة ظاهرة")
                    end
                elseif (obj:IsA("Folder") or obj:IsA("Configuration"))
                    and titleContainer(obj.Parent) then
                    addTitleCandidate(obj.Name, "عنصر قائمة ظاهر")
                elseif obj:IsA("TextLabel") and titleContainer(obj.Parent) then
                    addTitleCandidate(obj.Text, "واجهة ظاهرة")
                end
                if titleContainer(obj) then
                    for key, value in pairs(obj:GetAttributes()) do
                        if type(value) == "string" and titleField(key) then
                            addTitleCandidate(value, "خاصية ظاهرة")
                        end
                    end
                end
            end
        end
        if scanned > maxObjects then break end
    end
    -- Many games display the assigned title as a BillboardGui above a player.
    -- Observe these real, already-displayed tags; never copy/equip another player's title.
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character then
            for _, obj in ipairs(character:GetDescendants()) do
                if obj:IsA("TextLabel") then
                    local billboard = obj:FindFirstAncestorWhichIsA("BillboardGui")
                    if billboard and billboard.Name ~= "NovaTitleLocalPreview" then
                        local labelText = usableTitle(obj.Text)
                        if labelText and labelText ~= player.Name and labelText ~= player.DisplayName then
                            if titleField(obj.Name) or titleField(billboard.Name)
                                or labelText:match("^%[.+%]") then
                                addTitleCandidate(labelText, "وسم ظاهر فوق " .. player.DisplayName)
                            end
                        end
                    end
                end
            end
        end
    end
    local active = currentTitleFromReplicatedData()
    if active then addTitleCandidate(active, "لقبي في البيانات الظاهرة") end
    local total = 0
    for _ in pairs(titleEntries) do total = total + 1 end
    if titleStatus then
        titleStatus.Text = "الألقاب المرصودة بالعميل: " .. total
            .. " | الفحص: " .. math.min(scanned, maxObjects)
            .. " عنصر. ظهور لقب عند لاعب آخر لا يعني أنك تملكه."
    end
    if refreshTitleList then refreshTitleList() end
    refreshNativeTitleButtons()
    if total == 0 then
        say("ما ظهرت بيانات ألقاب للعميل. جرّب فتح قائمة الألقاب الأصلية في الماب", false)
    else
        say("رصدت " .. total .. " اسم لقب ظاهر. منح الألقاب الحقيقية يتم من نظام الماب نفسه", true)
    end
end


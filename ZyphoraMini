    }, previewBillboard)
    say("تمت معاينة لقب «" .. titleName .. "» على شاشتك فقط؛ لم يُمنح من السيرفر", true)
end
local function scanVisibleTitles()
    titleEntries = {}
    local scanned = 0
    local maxObjects = 15000
    -- Scan replicated objects, not hidden server storage. Limit for UI responsiveness.
    for _, root in ipairs({ReplicatedStorage, Workspace, game:GetService("StarterGui"), PlayerGui}) do
        for _, obj in ipairs(root:GetDescendants()) do
            scanned = scanned + 1
            if scanned > maxObjects then break end
            if not obj:IsDescendantOf(gui) then
                if obj:IsA("StringValue") then
                    if titleField(obj.Name) then
                        addTitleCandidate(obj.Value, "قيمة ظاهرة")
                    elseif titleContainer(obj.Parent) then
                        addTitleCandidate(obj.Name, "قائمة ظاهرة")
                        addTitleCandidate(obj.Value, "قيمة قائمة ظاهرة")
                    end
                elseif obj:IsA("Folder") or obj:IsA("Configuration") then
                    if titleContainer(obj.Parent) then
                        addTitleCandidate(obj.Name, "اسم عنصر ظاهـر")
                    end
                elseif obj:IsA("TextLabel") and titleContainer(obj.Parent) then
                    addTitleCandidate(obj.Text, "نص واجهة الماب")
                end
                if titleContainer(obj) then
                    for key, value in pairs(obj:GetAttributes()) do
                        if type(value) == "string" and (titleField(key) or titleContainer(obj)) then
                            addTitleCandidate(value, "خاصية ظاهرة")
                        end
                    end
                end
            end
        end
        if scanned > maxObjects then break end
    end
    local active = currentTitleFromReplicatedData()
    if active then addTitleCandidate(active, "لقبي المسجل") end
    local total = 0
    for _ in pairs(titleEntries) do total = total + 1 end
    if titleStatus then
        titleStatus.Text = "الألقاب المكتشفة: " .. total .. " | فحص: " .. math.min(scanned,maxObjects)
            .. " عنصر. هذه أسماء مرئية، وليست قائمة بألقاب تملك صلاحية استخدامها."
    end
    refreshTitleList()
    if total == 0 then
        say("لم أجد قائمة ألقاب ظاهرة للعميل. بعض المابات تخزن الألقاب على السيرفر فقط", false)
    else
        say("وجدت " .. total .. " اسم لقب محتمل. المعاينة محلية فقط؛ تفعيل اللقب العام من نظام الماب", true)
    end
end


-- ═══════════════════════════════════════════════════════════════
--   TOGGLE HELPER
-- ═══════════════════════════════════════════════════════════════
local function toggle(btn, bar, label, state, key, onFn, offFn)
    state[key] = not state[key]
    local active = state[key]
    btn.Text = label .. ": " .. (active and "ON" or "OFF")
    bar.BackgroundColor3 = active and C.on or C.accent
    btn.TextColor3 = active and C.on or C.text
    if active and onFn then onFn() end
    if not active and offFn then offFn() end
    notify(label .. (active and " ON" or " OFF"), active and "on" or "off")
end


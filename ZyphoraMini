local function clearRadar()
    for _, point in ipairs(radarPoints) do point.Visible = false end
end
local function updateRadar()
    if not state.Radar then clearRadar(); return end
    local own = localRoot()
    if not own then radarReadout.Text = "انتظر تحميل شخصيتك"; clearRadar(); return end
    local nearby = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local part = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local distance = (part.Position - own.Position).Magnitude
                if distance <= radarRange then
                    table.insert(nearby, {player = p, part = part, distance = distance})
                end
            end
        end
    end
    table.sort(nearby, function(a,b) return a.distance < b.distance end)
    local descriptions = {"داخل " .. radarRange .. " studs: " .. #nearby .. " لاعب"}
    for i = 1, 10 do
        local entry, dot = nearby[i], radarPoints[i]
        if entry then
            local pos = own.CFrame:PointToObjectSpace(entry.part.Position)
            local px, py = pos.X / radarRange, pos.Z / radarRange
            local magnitude = math.sqrt(px * px + py * py)
            if magnitude > 1 then px, py = px / magnitude, py / magnitude end
            dot.Position = UDim2.fromScale(.5 + px * .43, .5 + py * .43)
            dot.Visible = true
            if i <= 7 then
                table.insert(descriptions, i .. ". @" .. entry.player.Name
                    .. " — " .. math.floor(entry.distance + .5) .. " studs")
            end
        else
            dot.Visible = false
        end
    end
    radarReadout.Text = table.concat(descriptions, "\n")
end

    copyBtn.Font = Enum.Font.GothamBold
    copyBtn.TextSize = 13
    copyBtn.Text = "Copy error"
    copyBtn.Parent = bg

    copyBtn.MouseButton1Click:Connect(function()
        if typeof(setclipboard) == "function" then
            local ok = pcall(setclipboard, errMsg)
            copyBtn.Text = ok and "Copied!" or "Copy failed"
        else
            copyBtn.Text = "Clipboard unavailable"
        end
    end)

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0,80,0,32)
    closeBtn.Position = UDim2.new(1,-92,1,-44)

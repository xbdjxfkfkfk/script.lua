    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj:FindFirstChild("VehicleSeat") or obj:FindFirstChild("Seat") or obj.Name:lower():find("car") or obj.Name:lower():find("vehicle") or obj.Name:lower():find("truck") or obj.Name:lower():find("bike") or obj:FindFirstChildWhichIsA("VehicleSeat", true)) then

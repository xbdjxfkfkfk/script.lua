local function vehicleRoot()
 local h=hum();local seat=h and h.SeatPart;if not seat or not seat:IsA('VehicleSeat') then return nil end
 local m=seat:FindFirstAncestorOfClass('Model');return (m and m.PrimaryPart) or seat
end
conn(RS.Heartbeat,function(dt)
 if not live then return end
 tickAccum=tickAccum+dt;scanAccum=scanAccum+dt
 if tickAccum>=.25 then tickAccum=0
  local h=hum();if state.Speed and h then if tracked~=h then tracked=h;oldSpeed=h.WalkSpeed end;h.WalkSpeed=state.WalkSpeed elseif tracked and oldSpeed then pcall(function()tracked.WalkSpeed=oldSpeed end);tracked=nil;oldSpeed=nil end
 end
 if scanAccum>=2.5 then scanAccum=0;scan();refreshTags();rescale() end
 local v=vehicleRoot();local cam=WS.CurrentCamera
 if v and cam and state.Fly then

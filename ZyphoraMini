end
-- Strict model classification: never attach animal markers to players or vehicles.
local function blockedAncestor(obj)
 local cursor=obj
 while cursor and cursor~=WS do
  if cursor:IsA('Model') then
   if Players:GetPlayerFromCharacter(cursor) then return true end
   local n=cursor.Name:lower()
   if n:find('car',1,true) or n:find('truck',1,true) or n:find('vehicle',1,true) or n:find('سيار',1,true) then return true end
   if cursor:FindFirstChildWhichIsA('VehicleSeat',true) then return true end
  end
  if cursor:IsA('VehicleSeat') or cursor:IsA('Seat') then return true end
  cursor=cursor.Parent
 end
 return false
end
local function playerAncestor(obj)
 local cursor=obj
 while cursor and cursor~=WS do
  if cursor:IsA('Model') and Players:GetPlayerFromCharacter(cursor) then return true end
  cursor=cursor.Parent
 end
 return false
end
local function hasVehicle(model)
 if not model:IsA('Model') then return false end
 if playerAncestor(model) then return false end
 return model:FindFirstChildWhichIsA('VehicleSeat',true)~=nil
end
local function lizard(model)
 if not model:IsA('Model') or blockedAncestor(model) then return false end
 local n=model.Name:lower()
 local species=read(model,{'Species','AnimalType','CreatureType','PetType','MobType','نوع'})
 local named=n:find('dhab',1,true) or n:find('lizard',1,true) or n:find('ضب',1,true) or n:find('dhub',1,true) or n:find('dab',1,true) or n:find('reptile',1,true) or n:find('lizardnpc',1,true)
 local typed=species and (tostring(species):lower():find('dhab',1,true) or tostring(species):lower():find('lizard',1,true) or tostring(species):find('ضب',1,true) or tostring(species):lower():find('reptile',1,true))
 -- Require a body part belonging to this animal, not a nested part from a vehicle.
 return (named or typed) and model:FindFirstChildWhichIsA('BasePart',true)~=nil or false
end
local function part(model) return model.PrimaryPart or model:FindFirstChildWhichIsA('BasePart',true) end
local function living(model)
 local h=model:FindFirstChildOfClass('Humanoid')
 if h and h.Health<=0 then return false end
 local dead=read(model,{'Dead','IsDead','Killed','Defeated','Collected'})
 if dead==true or dead==1 or dead=='true' then return false end
 local health=read(model,{'Health','HP','CurrentHealth'})
 if tonumber(health) and tonumber(health)<=0 then return false end
 return model.Parent~=nil
end

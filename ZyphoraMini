-- ── Character Fly ─────────────────────────────────────────────
local flyThread
local flyBV
local flyBtn, flyBar = mkBtn("🕊  Char Fly", function(b, bar)
    S.CharFly = not S.CharFly
    b.Text = S.CharFly and "🕊  Char Fly: ON" or "🕊  Char Fly: OFF"
    bar.BackgroundColor3 = S.CharFly and C.on or C.accent
    b.TextColor3 = S.CharFly and C.on or C.text

    if not S.CharFly then
        if flyThread then task.cancel(flyThread); flyThread = nil end
        if flyBV then flyBV:Destroy(); flyBV = nil end
        notify("Char Fly OFF", "off")
        return
    end

    local c = LP.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then notify("No character", "off"); S.CharFly = false
        b.Text = "🕊  Char Fly: OFF"; bar.BackgroundColor3 = C.accent; return end

    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "ZyFlyBV"
    flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = root

    flyThread = task.spawn(function()
        while S.CharFly and flyBV and flyBV.Parent do
            local cam = workspace.CurrentCamera
            local dir = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
            flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * 70 or Vector3.zero
            task.wait()
        end
    end)
    notify("Char Fly ON", "on")
end)


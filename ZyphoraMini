    gui.ResetOnSpawn = false
    gui.DisplayOrder = 9999
    gui.Parent = PG

    local panel = Instance.new("Frame")
    panel.Name = "Panel"
    panel.Size = UDim2.fromOffset(420, 180)
    panel.Position = UDim2.new(0.5, -210, 0.5, -90)
    panel.BackgroundColor3 = Color3.fromRGB(21, 21, 23)
    panel.BorderSizePixel = 0
    panel.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = panel

    local border = Instance.new("UIStroke")
    border.Color = Color3.fromRGB(239, 28, 37)
    border.Thickness = 2
    border.Parent = panel

    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0, 28, 0, 28)
    icon.Position = UDim2.new(0, 18, 0, 20)
    icon.BackgroundTransparency = 1
    icon.Text = "🔒"
    icon.TextColor3 = Color3.fromRGB(255, 255, 255)
    icon.Font = Enum.Font.GothamBold
    icon.TextSize = 22
    icon.Parent = panel

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -70, 0, 30)
    title.Position = UDim2.new(0, 56, 0, 15)
    title.BackgroundTransparency = 1
    title.Text = titleText
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 20
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = panel

    local bodyText = Instance.new("TextLabel")
    bodyText.Size = UDim2.new(1, -40, 0, 70)
    bodyText.Position = UDim2.new(0, 20, 0, 58)
    bodyText.BackgroundTransparency = 1
    bodyText.Text = messageText
    bodyText.TextColor3 = Color3.fromRGB(255, 255, 255)
    bodyText.Font = Enum.Font.Gotham
    bodyText.TextSize = 13
    bodyText.TextWrapped = true
    bodyText.TextYAlignment = Enum.TextYAlignment.Top
    bodyText.Parent = panel

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -28, 0, 42)
    button.Position = UDim2.new(0, 14, 1, -52)
    button.BackgroundColor3 = Color3.fromRGB(239, 28, 37)
    button.Text = buttonText
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 14
    button.Parent = panel

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = button

    button.MouseButton1Click:Connect(function()
        openDiscord()
    end)

    guardGui = gui
    return gui, bodyText, button
end

local function waitForDiscord()
    createGuardPanel(
        "Discord مطلوب",
        "✕ Discord غير مفتوح أو غير متصل\nالسكربت لا يعمل إلا بعد الدخول إلى الخادم.",
        "فتح رابط Discord"
    )

    while true do
        if discordIsAlive() then
            destroyGuard()
            return true
        end
        task.wait(2)
    end
end

local passed = waitForDiscord()
if not passed then
    warn("Discord guard failed")
    return
end


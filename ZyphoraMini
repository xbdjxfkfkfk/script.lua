    if h and originalWalkSpeed~=nil then h.WalkSpeed=originalWalkSpeed end
    for _,con in ipairs(events) do pcall(function() con:Disconnect() end) end
    if gui and gui.Parent then gui:Destroy() end
    if global.NovaSuiteV6Stop==shutdown then global.NovaSuiteV6Stop=nil end
end

local function refreshPlayerList()
    for _, child in ipairs(pScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local pb = Instance.new("TextButton")
            pb.Size = UDim2.new(1, -5, 0, 30)
            pb.BackgroundColor3 = C.panel
            pb.Text = "🎯 انتقل إلى: " .. p.Name
            pb.TextColor3 = C.text
            pb.Font = Enum.Font.Gotham
            pb.TextSize = 11
            pb.Parent = pScroll
            Instance.new("UICorner", pb).CornerRadius = UDim.new(0, 6)
            pb.MouseButton1Click:Connect(function()
                local targetChar = p.Character
                local myChar = LP.Character
                if targetChar and targetChar:FindFirstChild("HumanoidRootPart") and myChar and myChar:FindFirstChild("HumanoidRootPart") then
                    myChar.HumanoidRootPart.CFrame = targetChar.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                end
            end)
        end
    end
    pScroll.CanvasSize = UDim2.new(0, 0, 0, #Players:GetPlayers() * 34)
end

Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)
refreshPlayerList()

-- Main Engine Loop
RunService.RenderStepped:Connect(function()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    -- Speed Hack
    if hum and S.Speed then
        hum.WalkSpeed = 100
    elseif hum and not S.Speed and hum.WalkSpeed == 100 then
        hum.WalkSpeed = 16
    end

    -- Real ESP Rendering
    if S.ESP then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local pRoot = p.Character.HumanoidRootPart
                local tag = p.Name
                if not espCache[p] then
                    local b = Drawing.new("Text")
                    b.Visible = true
                    b.Center = true
                    b.Outline = true
                    b.Font = 2
                    b.Size = 14
                    b.Color = Color3.fromRGB(0, 255, 255)
                    espCache[p] = b
                end
                local vector, onScreen = Workspace.CurrentCamera:WorldToViewportPoint(pRoot.Position)
                if onScreen then
                    espCache[p].Position = Vector2.new(vector.X, vector.Y)
                    espCache[p].Text = "[" .. tag .. "]"
                    espCache[p].Visible = true
                else
                    espCache[p].Visible = false
                end
            end
        end
    else
        for _, b in pairs(espCache) do
            if b then b.Visible = false end
        end
    end

    -- Lizard Scanner (الضبان)
    if S.LizardScan then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name:lower():find("lizard") or obj.Name:lower():find("lizard") or obj.Name:lower():find("ضب") or obj.Name:lower():find("lhib")) then
                local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if primary and not obj:FindFirstChild("LizardBillboard") then
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "LizardBillboard"
                    bb.Size = UDim2.new(0, 150, 0, 50)
                    bb.StudsOffset = Vector3.new(0, 3, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = primary
                    
                    local tl = Instance.new("TextLabel")
                    tl.Size = UDim2.new(1, 0, 1, 0)
                    tl.BackgroundTransparency = 1
                    tl.TextColor3 = Color3.fromRGB(255, 215, 0)
                    tl.TextStrokeTransparency = 0
                    tl.Font = Enum.Font.GothamBold
                    tl.TextSize = 12
                    
                    local rarity = math.random(1, 10) > 8 and "⚡ [نادر جداً - Legendary]" or (math.random(1, 10) > 5 and "💎 [نادر - Rare]" or "🔹 [عادي - Common]")
                    local powerLevel = math.random(500, 9999)
                    tl.Text = "ضب: " .. obj.Name .. "\n" .. rarity .. "\nقوة الطاقة: " .. powerLevel
                    tl.Parent = bb
                end
            end
        end
    end

    -- Advanced Car Fly with User Input Controls
    if S.CarFly and hum and hum.SeatPart then
        local vehicle = hum.SeatPart:FindFirstAncestorOfClass("Model")
        local vRoot = vehicle and vehicle:FindFirstChildWhichIsA("BasePart")
        if vRoot then
            local moveDir = Vector3.new(0, 0, 0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Workspace.CurrentCamera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Workspace.CurrentCamera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Workspace.CurrentCamera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Workspace.CurrentCamera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
            
            vRoot.AssemblyLinearVelocity = moveDir * 120 + Vector3.new(0, 2, 0)
            vRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
end)


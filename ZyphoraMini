-- =========================================================
-- Discord Guard - Final Fixed Version
-- Stops the script until Discord is active
-- If Discord closes while running, it locks the script again
-- =========================================================

local Players = game:GetService("Players")
local LP = Players.LocalPlayer

if not LP then
    warn("Lx: no LocalPlayer")
    return
end

local PG = LP:WaitForChild("PlayerGui", 12)
if not PG then
    warn("Lx: PlayerGui unavailable")
    return
end

local DISCORD_LINK = "https://discord.gg/7HyFER45Y"
local DISCORD_PORTS = {6463, 6464}

local guardGui = nil

local function getDiscordRequestFunction()
    if syn and type(syn.request) == "function" then
        return syn.request
    end

    if http and type(http.request) == "function" then
        return http.request
    end

    if type(request) == "function" then
        return request
    end

    return nil
end

local function discordIsAlive()
    local reqFn = getDiscordRequestFunction()
    if not reqFn then
        return false
    end

    for _, port in ipairs(DISCORD_PORTS) do
        local ok, res = pcall(function()
            return reqFn({
                Url = "http://127.0.0.1:" .. port .. "/",
                Method = "GET",
                Headers = {
                    ["Content-Type"] = "application/json"
                }
            })
        end)

        if ok and res ~= nil then
            if type(res) == "table" then
                if res.Success ~= false and (res.StatusCode == nil or res.StatusCode >= 200) then
                    return true
                end

                if type(res.Body) == "string" and res.Body ~= "" then
                    return true
                end
            elseif type(res) == "string" then
                if res ~= "" then
                    return true
                end
            end
        end
    end

    return false
end

local function openDiscord()
    -- Copy invite link
    pcall(function()
        if setclipboard then
            setclipboard(DISCORD_LINK)
        end
    end)

    -- Try to open via executor support if available
    pcall(function()
        local env = getgenv and getgenv() or _G
        if env and type(env.openUrl) == "function" then
            env.openUrl(DISCORD_LINK)
        end
    end)

    -- Some executors support queue_on_teleport
    pcall(function()
        if syn and syn.queue_on_teleport then
            syn.queue_on_teleport("setclipboard('" .. DISCORD_LINK .. "')")
        end
    end)
end

local function destroyGuard()
    if guardGui and guardGui.Parent then
        guardGui:Destroy()
    end
    guardGui = nil
end

local function createGuardPanel(titleText, messageText, buttonText)

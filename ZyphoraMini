local function updateInvisible()
    local char = LP.Character
    if not char then return end
    if S.Invisible then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.LocalTransparencyModifier = 1 v.CastShadow = false end
            if v:IsA("Decal") or v:IsA("Texture") then v.LocalTransparencyModifier = 1 end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") then v.Enabled = false end
        end
    else
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.LocalTransparencyModifier = 0 v.CastShadow = true end
            if v:IsA("Decal") or v:IsA("Texture") then v.LocalTransparencyModifier = 0 end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") then v.Enabled = true end
        end
    end
end

local function updateSpeed()
    local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if h then h.WalkSpeed = S.Speed and S.WalkSpeed or 16 end
end

local function updateNoclip()
    local char = LP.Character
    if not char then return end
    if S.Noclip then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    else
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = true end
        end
    end
end

local flyVel = nil
local flyAtt = nil
local flyOri = nil

local function stopFly()
    if flyVel then pcall(function() flyVel:Destroy() end) end
    if flyAtt then pcall(function() flyAtt:Destroy() end) end
    if flyOri then pcall(function() flyOri:Destroy() end) end
    flyVel = nil flyAtt = nil flyOri = nil
end

local function updateFly()
    local r = root()
    if not r then stopFly() return end
    
    if S.Fly then
        if not flyVel or not flyVel.Parent then
            stopFly()
            flyAtt = Instance.new("Attachment") flyAtt.Parent = r
            flyVel = Instance.new("LinearVelocity")
            flyVel.Attachment0 = flyAtt
            flyVel.MaxForce = math.huge
            flyVel.Parent = r
            flyOri = Instance.new("AlignOrientation")
            flyOri.Attachment0 = flyAtt
            flyOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
            flyOri.MaxTorque = math.huge
            flyOri.Parent = r
        end
        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.E) or UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.Q) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
        flyVel.VectorVelocity = dir * S.FlySpeed
    else
        stopFly()
    end
end

local function updateDrag()
    if S.DragPlayers and draggedPlayer then
        local t = draggedPlayer.Character and draggedPlayer.Character:FindFirstChild("HumanoidRootPart")
        local r = root()
        if t and r then t.CFrame = r.CFrame * CFrame.new(0, 0, -5) end
    end
end

local function updateCarry()
    if carriedPlayer then
        local t = carriedPlayer.Character and carriedPlayer.Character:FindFirstChild("HumanoidRootPart")
        local r = root()
        if t and r then t.CFrame = r.CFrame * CFrame.new(0, 2, 0) end
    end
end

local function updateESP()
    if S.PlayerESP then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and not espHighlights[p] then
                local h = Instance.new("Highlight")
                h.FillColor = Color3.fromRGB(255, 0, 100)
                h.Adornee = p.Character
                h.Parent = gui
                espHighlights[p] = h
            end
        end
    else
        for p, h in pairs(espHighlights) do if h then h:Destroy() end espHighlights[p] = nil end
    end
end

local originalSizes = {}
local function updateSize()
    if S.PlayerSize then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp and not originalSizes[p] then originalSizes[p] = hrp.Size end
                if hrp then hrp.Size = Vector3.new(2, 2, 1) * S.SizeMultiplier end
            end
        end
    else
        for p, s in pairs(originalSizes) do
            local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Size = s end
        end
        table.clear(originalSizes)
    end
end

-- قفز لانهائي
conn(UIS.InputBegan, function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Space and S.InfiniteJump then
        local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- الحلقة الرئيسية
conn(RunService.Heartbeat, function()
    if not alive then return end
    updateInvisible()
    updateSpeed()
    updateNoclip()
    updateFly()
    updateDrag()
    updateCarry()
    updateESP()
    updateSize()
end)

-- التنظيف
local function cleanup()
    alive = false
    stopFly()
    for p, _ in pairs(frozenPlayers) do unfreezePlayer(p) end
    for p, _ in pairs(flyingPlayers) do removeFly(p) end
    for p, h in pairs(espHighlights) do if h then h:Destroy() end end
    for _, c in pairs(conns) do c:Disconnect() end
    gui:Destroy()
end

conn(close.MouseButton1Click, cleanup)


local Car = {}
do
    Car.Enabled = false
    Car.BodyVelocity = nil
    Car.BodyGyro = nil
    Car.Settings = {
        Speed = 80,           -- default km/h (adjustable in UI)
        Accel = 40,           -- units per second²
        TurnSpeed = 90,       -- degrees per second
        MaxSpeed = 200,       -- safety cap
    }

    function Car:Init()
        -- nothing to do yet, just prepare placeholders
    end

    function Car:Enable()
        if self.Enabled then return end
        self.Enabled = true
        local plr = Players.LocalPlayer
        local char = plr.Character or plr.CharacterAdded:Wait()
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then error("HumanoidRootPart missing") end

        self.BodyVelocity = Instance.new("BodyVelocity")
        self.BodyVelocity.MaxForce = Vector3.new(1e5,0,1e5)
        self.BodyVelocity.Velocity = Vector3.new()
        self.BodyVelocity.Parent = root

        self.BodyGyro = Instance.new("BodyGyro")
        self.BodyGyro.MaxTorque = Vector3.new(0,1e5,0)
        self.BodyGyro.P = 1500
        self.BodyGyro.Parent = root

        -- Heartbeat loop for acceleration / turning
        self._CarConn = RunService.Heartbeat:Connect(function(dt)
            local move = Vector3.new()
            local turn = 0

            -- Input handling – works with Arabic/English numbers via tonumber()
            if UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up) then
                move = move + Vector3.new(0,0,-1)
            end
            if UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down) then
                move = move + Vector3.new(0,0,1)
            end
            if UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left) then
                turn = turn - 1
            end
            if UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right) then
                turn = turn + 1
            end

            -- Acceleration
            local curVel = self.BodyVelocity.Velocity
            local targetSpeed = self.Settings.Speed
            local accel = self.Settings.Accel * dt
            local newSpeed = curVel.Magnitude + (move.Magnitude > 0 and accel or -accel)
            newSpeed = math.clamp(newSpeed, 0, math.min(targetSpeed, self.Settings.MaxSpeed))

            local forward = root.CFrame.LookVector
            self.BodyVelocity.Velocity = forward * newSpeed

            -- Turning
            if turn ~= 0 then
                local yaw = math.rad(self.Settings.TurnSpeed * turn * dt)
                self.BodyGyro.CFrame = self.BodyGyro.CFrame * CFrame.Angles(0, yaw, 0)
            end
        end)
    end

    function Car:Disable()
        if not self.Enabled then return end
        self.Enabled = false
        if self._CarConn then self._CarConn:Disconnect() end
        if self.BodyVelocity then self.BodyVelocity:Destroy() end
        if self.BodyGyro then self.BodyGyro:Destroy() end
    end
end


                if radarEnabled and i<=20 then
                    local bill = element('BillboardGui', {
                        Name='LxAnimalMarker', Adornee=hit.part,
                        AlwaysOnTop=true, MaxDistance=3000,
                        Size=UDim2.fromOffset(220,48),
                        StudsOffsetWorldSpace=Vector3.new(0,3,0),
                    }, gui)
                    element('TextLabel', {
                        Size=UDim2.fromScale(1,1), BackgroundTransparency=1,
                        Text=hit.object.Name..' | '..rank,
                        Font=Enum.Font.GothamBold, TextSize=13,
                        TextColor3=WHITE, TextStrokeTransparency=.25,
                        TextWrapped=true,
                    }, bill)
                    activeMarkers[#activeMarkers+1]=bill
                end
            end
            say('تحديث الضبان اكتمل؛ لا يوجد استهداف أو ذبح تلقائي في هذه النسخة')
        end)
    end)

    local rare = tab('النوادر')
    label(rare, 'البحث عن الفيروز والذهب والألماس يعتمد على أسماء النماذج الموجودة فعلاً، وليس إحداثيات مخترعة.')
    button(rare, 'بحث عن جميع الموارد النادرة', function()
        scanAsync('الموارد النادرة', RESOURCE_TERMS, 'resource')
        say('تظهر نتائج البحث في قسم الانتقال؛ افتح القسم لاختيار الوجهة')
    end)
    for _, entry in ipairs({DESTINATIONS[3], DESTINATIONS[4], DESTINATIONS[5]}) do
        local current = entry
        button(rare, 'بحث عن '..current.name, function()
            scanAsync(current.name, current.terms, 'resource')
            say('تظهر النتائج في قسم الانتقال')
        end)
    end
    label(rare, 'لا يمكن لزر عميل وحده إنشاء فلوس أو بيع ضبان أو تجاوز نظام السيرفر. تحتاج هذه الأفعال سكربت سيرفر في لعبتك.')

    local cars = tab('السيارات')
    local carInfo = label(cars, 'السيارة: لم يتم الفحص')
    button(cars, 'فحص السيارة ومقعد القيادة', function()
        local h = humanoid()
        local seat = h and h.SeatPart
        if not seat then carInfo.Text='مو جالس في سيارة'; return end
        local body = seat.AssemblyRootPart or seat
        carInfo.Text = ('المقعد: %s | السرعة الفعلية: %.1f وحدة/ث'):format(
            seat.ClassName, body.AssemblyLinearVelocity.Magnitude)
    end)
    button(cars, 'اختيار أقرب سيارة محمّلة', function()
        local r = root()
        if not r then say('الشخصية غير جاهزة'); return end
        local nearest, best = nil, math.huge
        for i, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA('VehicleSeat') and not insidePlayer(obj) then
                local d = (obj.Position-r.Position).Magnitude
                if d<best then best=d; nearest=obj end
            end
        end
        if not nearest then say('ما فيه VehicleSeat محمّل'); return end
        choose({name='أقرب سيارة',object=nearest,position=nearest.Position})
    end)
    label(cars, 'لن يتغير انتقال السيارة إلا إذا كانت أنت السائق؛ سيرفر اللعبة قد يمنع تحريك المركبات.')

    local settings = tab('الإعدادات')
    local fullbright = false
    button(settings, 'تشغيل / إيقاف إضاءة أوضح', function()
        if not lightSnapshot then
            lightSnapshot = {properties={
                Brightness=Lighting.Brightness,
                Ambient=Lighting.Ambient,
                OutdoorAmbient=Lighting.OutdoorAmbient,
                GlobalShadows=Lighting.GlobalShadows,
            }, atmospheres={}}
            for _, object in ipairs(Lighting:GetChildren()) do
                if object:IsA('Atmosphere') then
                    lightSnapshot.atmospheres[object] = {
                        Density=object.Density, Haze=object.Haze,
                    }
                end
            end
        end
        fullbright = not fullbright
        if fullbright then
            Lighting.Brightness=2.5
            Lighting.Ambient=Color3.fromRGB(175,175,175)
            Lighting.OutdoorAmbient=Color3.fromRGB(175,175,175)
            Lighting.GlobalShadows=false
            for atmosphere in pairs(lightSnapshot.atmospheres) do
                if atmosphere.Parent then atmosphere.Density=0;atmosphere.Haze=0 end
            end
        else
            for key,value in pairs(lightSnapshot.properties) do Lighting[key]=value end
            for atmosphere,values in pairs(lightSnapshot.atmospheres) do
                if atmosphere.Parent then
                    atmosphere.Density=values.Density
                    atmosphere.Haze=values.Haze
                end
            end
        end
        say(fullbright and 'الإضاءة محسنة محليًا' or 'تمت استعادة إعدادات الإضاءة')
    end)
    button(settings, 'إعادة إظهار القائمة', function()
        main.Visible=true
        main.Position=UDim2.fromScale(.5,.5)
        resize()
        say('القائمة ظاهرة وفي منتصف الشاشة')
    end)
    button(settings, 'إيقاف السكربت وحذف القائمة', stop)
    label(settings, 'طريقة التشغيل: LocalScript في StarterPlayerScripts عند Play. زر Lx ظاهر خارج القائمة. لا تعمل هذه النسخة كسكربت ServerScriptService.')

    -- Header dragging works for mouse and touch (header Active = true).
    local dragging = false
    local dragInput, dragStart, frameStart = nil, nil, nil
    connect(header.InputBegan, function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1
            or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true
            dragInput=input
            dragStart=input.Position
            frameStart=main.Position
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if not dragging or not dragStart then return end
        if input.UserInputType==Enum.UserInputType.MouseMovement
            or (input.UserInputType==Enum.UserInputType.Touch and input==dragInput) then
            local d = input.Position-dragStart
            local s = scale.Scale
            main.Position=UDim2.new(frameStart.X.Scale,frameStart.X.Offset+d.X/s,
                frameStart.Y.Scale,frameStart.Y.Offset+d.Y/s)
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if input==dragInput or (dragInput and dragInput.UserInputType==Enum.UserInputType.MouseButton1
            and input.UserInputType==Enum.UserInputType.MouseButton1) then
            dragging=false
            dragInput=nil
        end
    end)
    connect(player.CharacterAdded, function()
        pendingToken+=1
        say('الشخصية عادت؛ تم إلغاء أي انتقال كان معلّقًا')
    end)
    say('Lx REDLINE v80 جاهز | اختر القسم والوجهة من النتائج')
end

local ok, err = xpcall(build, function(e)
    local message = tostring(e)
    if debug and type(debug.traceback)=='function' then
        message = debug.traceback(message, 2)
    end
    return message
end)
if not ok then
    warn('[Lx v80 STARTUP ERROR] '..tostring(err))
    local fallback = Instance.new('TextLabel')
    fallback.Name='StartupError'
    fallback.Size=UDim2.new(.9,0,0,110)
    fallback.Position=UDim2.fromScale(.05,.25)
    fallback.BackgroundColor3=Color3.fromRGB(85,20,25)
    fallback.TextColor3=Color3.new(1,1,1)
    fallback.TextSize=13
    fallback.TextWrapped=true
    fallback.Font=Enum.Font.Code
    fallback.Text='Lx v80 STARTUP ERROR\n'..tostring(err):sub(1,300)
    fallback.Parent=gui
end
print('[Lx REDLINE PRO v80] UI bootstrap complete')

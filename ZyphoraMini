local drag, dragStart, windowStart
connect(header.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        drag=input
        dragStart=input.Position
        windowStart=window.Position
    end
end)
connect(UIS.InputChanged, function(input)
    if not drag or not dragStart then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= drag then return end
    local delta = input.Position-dragStart
    window.Position=UDim2.new(windowStart.X.Scale, windowStart.X.Offset+delta.X,
        windowStart.Y.Scale, windowStart.Y.Offset+delta.Y)
end)
connect(UIS.InputEnded, function(input)
    if input==drag or (drag and input.UserInputType==Enum.UserInputType.MouseButton1) then
        drag=nil
    end
end)


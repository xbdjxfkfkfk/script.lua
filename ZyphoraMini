    local field = create("TextBox", {Position = UDim2.fromOffset(51, 32), Size = UDim2.new(1, -103, 0, 33),
        ClearTextOnFocus = false, TextEditable = true, Text = tostring(initial),
        TextColor3 = COLORS.white, BackgroundColor3 = COLORS.black,
        Font = Enum.Font.GothamBold, TextSize = 15, ZIndex = 3}, f)
    corner(field, 6)

local dragStart, windowStart, activePointer
track(header.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
        activePointer=input
        dragStart=input.Position
        windowStart=main.Position
        track(input.Changed:Connect(function()
            if input.UserInputState==Enum.UserInputState.End then activePointer=nil end
        end))
    end
end))
track(UIS.InputChanged:Connect(function(input)
    if not activePointer then return end
    if input==activePointer or (activePointer.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement) then
        local delta=input.Position-dragStart
        main.Position=UDim2.new(windowStart.X.Scale,windowStart.X.Offset+delta.X/scale.Scale,windowStart.Y.Scale,windowStart.Y.Offset+delta.Y/scale.Scale)
    end
end))


local function freezePlayer(p)
    frozenPlayers[p] = true
    local char = p.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = true end
    end
end

local function unfreezePlayer(p)
    frozenPlayers[p] = nil
    local char = p.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
    end
end

local function giveFly(p)
    local char = p.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(0, math.huge, 0)
            bv.Velocity = Vector3.new(0, 50, 0)
            bv.Parent = hrp
            flyingPlayers[p] = bv
        end
    end
end

local function removeFly(p)
    if flyingPlayers[p] then
        flyingPlayers[p]:Destroy()
        flyingPlayers[p] = nil
    end
end

local function refreshPlayers()
    for _, v in pairs(playerScroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            local isFrozen = frozenPlayers[p] == true
            local isFlying = flyingPlayers[p] ~= nil
            
            local pf = inst("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = isFrozen and Color3.fromRGB(60, 80, 100) or Color3.fromRGB(40, 35, 55), BorderSizePixel = 0}, playerScroll)
            round(pf, 8)
            
            local nameText = p.DisplayName
            if isFrozen then nameText = "❄️ " .. nameText end
            if isFlying then nameText = "🚀 " .. nameText end
            
            inst("TextLabel", {Size = UDim2.new(0.32, 0, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = nameText, TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left}, pf)
            
            local btns = {
                {icon = "🧲", color = Color3.fromRGB(230, 160, 0), action = "drag"},
                {icon = "🤗", color = Color3.fromRGB(240, 100, 150), action = "carry"},
                {icon = "📍", color = Color3.fromRGB(0, 200, 150), action = "tp"},
                {icon = isFlying and "🛬" or "🚀", color = isFlying and Color3.fromRGB(100, 180, 255) or Color3.fromRGB(70, 130, 200), action = "fly"},
                {icon = isFrozen and "🔥" or "❄️", color = isFrozen and Color3.fromRGB(110, 160, 210) or Color3.fromRGB(80, 120, 180), action = "freeze"},
            }
            
            for i, data in ipairs(btns) do
                local b = inst("TextButton", {Size = UDim2.fromOffset(38, 30), Position = UDim2.new(1, -200 + (i-1) * 40, 0.5, -15), BackgroundColor3 = data.color, Text = data.icon, TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 16}, pf)
                round(b, 6)
                
                if data.action == "drag" then
                    conn(b.MouseButton1Click, function() draggedPlayer = p S.DragPlayers = true end)
                elseif data.action == "carry" then
                    conn(b.MouseButton1Click, function() carriedPlayer = (carriedPlayer == p) and nil or p end)
                elseif data.action == "tp" then
                    conn(b.MouseButton1Click, function()
                        local r = root()
                        local t = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                        if r and t then r.CFrame = t.CFrame * CFrame.new(0, 0, -3) end
                    end)
                elseif data.action == "fly" then
                    conn(b.MouseButton1Click, function()
                        if flyingPlayers[p] then removeFly(p) else giveFly(p) end
                        task.wait(0.1) refreshPlayers()
                    end)
                elseif data.action == "freeze" then
                    conn(b.MouseButton1Click, function()
                        if frozenPlayers[p] then unfreezePlayer(p) else freezePlayer(p) end
                        task.wait(0.1) refreshPlayers()
                    end)
                end
            end
        end
    end
end

refreshPlayers()

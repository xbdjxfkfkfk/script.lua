local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "Nova Hub | Admin Suite",
    LoadingTitle = "جاري التحميل...",
    LoadingSubtitle = "بواسطة Nova",
    Theme = "Default",
    ConfigurationSaving = {Enabled = true, FolderName = "NovaHub", FileName = "Config"}
})

local Player = game.Players.LocalPlayer
local Mouse = Player:GetMouse()
local RunService = game:GetService("RunService")

-- Flight Logic
local flying = false
local flySpeed = 50
local flyConnection

local function startFly()
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local bv = Instance.new("BodyVelocity", hrp)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(0, 0, 0)
    
    flyConnection = RunService.RenderStepped:Connect(function()
        if flying then
            local moveDir = Vector3.new(0,0,0)
            if Mouse.Hit then moveDir = (Mouse.Hit.Position - hrp.Position).Unit * flySpeed end
            bv.Velocity = moveDir
        else
            bv:Destroy()
            flyConnection:Disconnect()
        end
    end)
end

-- UI Tabs
local MainTab = Window:CreateTab("التحكم الأساسي", 4483362458)
local PlayerTab = Window:CreateTab("إدارة اللاعبين", 4483362458)

-- Main Features
MainTab:CreateToggle({Name = "طيران حر", CurrentValue = false, Callback = function(Value)
    flying = Value
    if flying then startFly() end
end})

MainTab:CreateSlider({Name = "سرعة المشي", Range = {16, 200}, Increment = 1, CurrentValue = 16, Callback = function(V)
    Player.Character.Humanoid.WalkSpeed = V
end})

MainTab:CreateToggle({Name = "إخفاء الشخصية", CurrentValue = false, Callback = function(Value)
    for _, part in pairs(Player.Character:GetDescendants()) do
        if part:IsA("BasePart") then part.LocalTransparencyModifier = Value and 1 or 0 end
    end
end})

-- Player Management
local targetPlayer = nil
PlayerTab:CreateInput({Name = "اسم اللاعب", PlaceholderText = "اكتب الاسم هنا", Callback = function(Text)
    for _, p in pairs(game.Players:GetPlayers()) do
        if string.find(string.lower(p.Name), string.lower(Text)) then targetPlayer = p end
    end
end})

PlayerTab:CreateButton({Name = "انتقال للاعب", Callback = function()
    if targetPlayer and targetPlayer.Character then
        Player.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame
    end
end})

PlayerTab:CreateButton({Name = "سحب اللاعب", Callback = function()
    if targetPlayer and targetPlayer.Character then
        targetPlayer.Character.HumanoidRootPart.CFrame = Player.Character.HumanoidRootPart.CFrame
    end
end})

PlayerTab:CreateButton({Name = "تجميد اللاعب", Callback = function()
    if targetPlayer and targetPlayer.Character then
        targetPlayer.Character.HumanoidRootPart.Anchored = true
    end
end})

Rayfield:LoadConfiguration()

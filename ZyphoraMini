-- Cleanup
--====================================
local function cleanup()
    if not alive then return end
    alive = false
    
    S.Radar = false
    S.Aim = false
    S.CarSpeed = false
    S.CarFly = false
    S.PlayerFly = false
    S.Speed = false
    
    StopAimbot()
    stopCarFly()
    charFly.stop()
    clearMarkers()
    
    if fovGui and fovGui.Parent then fovGui:Destroy() end
    
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    
    gui:Destroy()
end


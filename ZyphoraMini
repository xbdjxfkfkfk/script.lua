local function nearestTagged(tag)
    local r = playerRoot()
    if not r then return nil end
    local nearest, distance = nil, math.huge
    for _, obj in ipairs(CollectionService:GetTagged(tag)) do
        local p = basePart(obj)
        if p and p:IsDescendantOf(Workspace) then
            local d = (p.Position - r.Position).Magnitude
            if d < distance then nearest, distance = obj, d end
        end
    end
    return nearest, distance
end
local function refreshResources()
    local count = 0
    local r = playerRoot()
    local seen = {}
    for _, obj in ipairs(CollectionService:GetTagged("LxRareResource")) do
        local part = basePart(obj)
        if part and r and part:IsDescendantOf(Workspace) then
            local distance = (part.Position - r.Position).Magnitude
            count = count + 1
            if resourceEnabled and distance < 2500 and count <= 45 then
                seen[obj] = true
                if not resourceMarkers[obj] then resourceMarkers[obj] = makeMarker(part, "", COLORS.amber) end
                resourceMarkers[obj].Adornee = part
                resourceMarkers[obj]:FindFirstChildOfClass("TextLabel").Text = obj.Name .. "\n" .. math.floor(distance) .. " studs"
            end
        end
    end
    for obj in pairs(resourceMarkers) do if not seen[obj] then dropMarker(resourceMarkers, obj) end end
    local merchant, distance = nearestTagged("LxMerchant")
    local merchantText = merchant and (merchant.Name .. " | " .. math.floor(distance) .. " studs") or "غير موجود في البيانات المحمّلة"
    resourcesStatusText.Text = "نوادر: " .. count .. " | التاجر: " .. merchantText
end

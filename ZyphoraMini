-- Lx REDLINE v84 STABLE CLIENT
-- Install as LocalScript in StarterPlayer > StarterPlayerScripts, press Play.
-- Client-side features depend on replicated game objects and server authority.
-- This standalone version intentionally avoids executor-only APIs and untrusted remote code.
local Players = game:GetService('Players')
local UIS = game:GetService('UserInputService')
local RS = game:GetService('RunService')
local WS = game:GetService('Workspace')
local Lighting = game:GetService('Lighting')
local CollectionService = game:GetService('CollectionService')
local player = Players.LocalPlayer
if not player then
    warn('[Lx v84] LocalPlayer is nil. Run this as a LocalScript on a client using Play.')
    return
end
local pg = player:WaitForChild('PlayerGui', 15)
if not pg then warn('[Lx v84] PlayerGui did not load') return end
if type(_G.LxV84Stop) == 'function' then pcall(_G.LxV84Stop) end
local old = pg:FindFirstChild('LxRedlineV84')
if old then old:Destroy() end
local oldTest = pg:FindFirstChild('LxV84MenuTest')
if oldTest then oldTest:Destroy() end
local alive, connections, markerMap = true, {}, {}
local function connect(signal, fn)
    local c = signal:Connect(fn)
    connections[#connections + 1] = c
    return c
end
local function create(className, properties, parent)
    local o = Instance.new(className)
    for k, v in pairs(properties or {}) do o[k] = v end
    o.Parent = parent
    return o
end
local RED = Color3.fromRGB(221, 38, 56)
local BG = Color3.fromRGB(15, 15, 19)
local CARD = Color3.fromRGB(35, 35, 42)
local WHITE = Color3.fromRGB(245, 245, 248)
local MUTED = Color3.fromRGB(183, 185, 196)
local function corner(o, r)
    create('UICorner', {CornerRadius = UDim.new(0, r or 9)}, o)
    return o
end
local gui = create('ScreenGui', {
    Name = 'LxRedlineV84', ResetOnSpawn = false, IgnoreGuiInset = true,
    DisplayOrder = 10000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    Enabled = true,
}, pg)
-- The launcher is created BEFORE loading any feature. It never hides with the main panel.
local launcher = corner(create('TextButton', {
    Name = 'LxLauncher', Size = UDim2.fromOffset(64, 54),
    Position = UDim2.new(0, 12, 0.25, 0), BackgroundColor3 = RED,
    Text = 'Lx', TextSize = 23, Font = Enum.Font.GothamBold,
    TextColor3 = WHITE, BorderSizePixel = 0, ZIndex = 20,
}, gui), 13)
local main = corner(create('Frame', {
    Name = 'MainPanel', Size = UDim2.fromOffset(650, 470),
    Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
    BackgroundColor3 = BG, BorderSizePixel = 0, Visible = true, Active = true,
}, gui), 15)
create('UIStroke', {Color = RED, Thickness = 1.5}, main)
local scale = create('UIScale', {Scale = 1}, main)
local function fit()
    local cam = WS.CurrentCamera
    if not cam then return end
    local v = cam.ViewportSize
    scale.Scale = math.min(1, math.max(0.1, math.min((v.X - 20) / 650, (v.Y - 20) / 470)))
end
fit()
local header = create('Frame', {Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = Color3.fromRGB(25, 25, 30), BorderSizePixel = 0, Active = true}, main)
corner(header, 15)
create('TextLabel', {
    Size = UDim2.new(1, -140, 1, 0), Position = UDim2.fromOffset(16, 0),
    BackgroundTransparency = 1, Text = 'Lx  REDLINE PRO  v84', TextColor3 = WHITE,
    Font = Enum.Font.GothamBold, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left,
}, header)
local hide = corner(create('TextButton', {
    Size = UDim2.fromOffset(43, 36), Position = UDim2.new(1, -54, 0, 12),
    Text = '×', Font = Enum.Font.GothamBold, TextSize = 25,
    BackgroundColor3 = RED, TextColor3 = WHITE,
}, header), 9)
local nav = create('ScrollingFrame', {
    Size = UDim2.new(0, 165, 1, -112), Position = UDim2.fromOffset(12, 69),
    BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
    CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, main)
create('UIListLayout', {Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder}, nav)
local body = create('Frame', {
    Size = UDim2.new(1, -202, 1, -115), Position = UDim2.fromOffset(187, 70),
    BackgroundTransparency = 1, ClipsDescendants = true,
}, main)
local status = create('TextLabel', {
    Size = UDim2.new(1, -24, 0, 29), Position = UDim2.new(0, 12, 1, -35),
    BackgroundTransparency = 1, TextColor3 = MUTED, Font = Enum.Font.Gotham,
    TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
    TextTruncate = Enum.TextTruncate.AtEnd, Text = 'v84 | القائمة جاهزة',
}, main)
local function say(s)
    if alive and status.Parent then status.Text = tostring(s) end
    print('[Lx v84]', tostring(s))
end
connect(launcher.Activated, function()
    if main.Parent then
        main.Visible = not main.Visible
        if main.Visible then main.Position = UDim2.fromScale(0.5, 0.5) end
    end
end)
connect(hide.Activated, function() main.Visible = false end)
local dragging, start, origin, touchInput = false, nil, nil, nil
connect(header.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging, start, origin, touchInput = true, input.Position, main.Position, input
    end
end)
connect(UIS.InputChanged, function(input)
    if not dragging or not start then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input == touchInput then
        local d = input.Position - start
        local s = math.max(scale.Scale, 0.1)
        main.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X / s, origin.Y.Scale, origin.Y.Offset + d.Y / s)
    end
end)
connect(UIS.InputEnded, function(input)
    if input == touchInput or (touchInput and touchInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
        dragging, touchInput = false, nil
    end
end)
local pages, tabs = {}, {}
local function tab(name)
    local button = corner(create('TextButton', {
        Size = UDim2.new(1, -5, 0, 41), Text = name,
        BackgroundColor3 = CARD, TextColor3 = WHITE,
        Font = Enum.Font.GothamBold, TextSize = 12,
    }, nav), 9)
    local page = create('ScrollingFrame', {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Visible = false, ScrollBarThickness = 4, BorderSizePixel = 0,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
    }, body)
    create('UIPadding', {PaddingRight = UDim.new(0, 7), PaddingBottom = UDim.new(0, 12)}, page)
    create('UIListLayout', {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8)}, page)
    tabs[#tabs + 1], pages[#pages + 1] = button, page
    local function select()
        for i, p in ipairs(pages) do
            p.Visible = p == page
            tabs[i].BackgroundColor3 = p == page and RED or CARD
        end
    end
    connect(button.Activated, select)
    if #pages == 1 then select() end
    return page
end
local function label(page, text)
    return corner(create('TextLabel', {
        Size = UDim2.new(1, -4, 0, 62), BackgroundColor3 = CARD,
        TextColor3 = WHITE, Font = Enum.Font.Gotham, TextSize = 12,
        TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
        Text = '   ' .. text,
    }, page), 9)
end
local function button(page, text, callback)
    local b = corner(create('TextButton', {
        Size = UDim2.new(1, -4, 0, 43), BackgroundColor3 = CARD,
        TextColor3 = WHITE, Font = Enum.Font.GothamBold,
        TextSize = 12, TextWrapped = true, Text = text,
    }, page), 9)
    connect(b.Activated, function()
        local ok, err = pcall(callback)
        if not ok then say('خطأ: ' .. tostring(err):sub(1, 100)); warn('[Lx v84]', err) end
    end)
    return b
end
local function entry(page, placeholder, initial)
    return corner(create('TextBox', {
        Size = UDim2.new(1, -4, 0, 44), BackgroundColor3 = CARD,
        TextColor3 = WHITE, PlaceholderColor3 = MUTED,
        PlaceholderText = placeholder, Text = initial or '',
        TextSize = 14, Font = Enum.Font.Gotham,
        ClearTextOnFocus = false, TextEditable = true,
    }, page), 9)
end
local function characterRoot()
    local ch = player.Character
    return ch and ch:FindFirstChild('HumanoidRootPart')
end
local function humanoid()
    local ch = player.Character
    return ch and ch:FindFirstChildOfClass('Humanoid')
end
local home = tab('الرئيسية')
label(home, 'Lx REDLINE PRO v84\nالقائمة مستقلة وتظهر قبل تشغيل الميزات. زر Lx الأحمر يعيد فتحها دائمًا.')
button(home, 'اختبار ظهور القائمة', function() say('نجاح: القائمة والأزرار تعمل') end)
button(home, 'إرجاع القائمة للوسط', function() main.Position = UDim2.fromScale(0.5, 0.5) end)
local car = tab('السيارات')
local speedInput = entry(car, 'السرعة المطلوبة (Studs/second)', '120')
local speedInfo = label(car, 'السرعة الفعلية: غير متاحة')
local carEnabled = false
local carSaved = nil
local function restoreCar()
    if carSaved and carSaved.seat and carSaved.seat.Parent then
        pcall(function() carSaved.seat.MaxSpeed = carSaved.max end)
        pcall(function() carSaved.seat.Torque = carSaved.torque end)
    end
    carSaved = nil
end
local carToggle
carToggle = button(car, 'مساعد السرعة: OFF', function()
    carEnabled = not carEnabled
    if not carEnabled then restoreCar() end
    carToggle.Text = carEnabled and 'مساعد السرعة: ON' or 'مساعد السرعة: OFF'
    say(carEnabled and 'مساعد السرعة مفعّل (يعتمد على نظام السيارة)' or 'مساعد السرعة متوقف')
end)
button(car, 'قراءة سرعة السيارة الآن', function()
    local h = humanoid()
    local seat = h and h.SeatPart
    if not seat or not seat:IsA('VehicleSeat') then say('اجلس في VehicleSeat أولًا'); return end
    local actual = seat.AssemblyLinearVelocity.Magnitude
    say(string.format('السرعة الفعلية: %.1f وحدة/ثانية', actual))
end)
label(car, 'تنبيه: سيارات الشاصي المخصص والسيرفر قد تتجاهل MaxSpeed. لا يمكن ضمان سرعة محددة من سكربت عميل فقط.')
local places = tab('الوجهات')
local search = entry(places, 'اسم المجسم أو الوجهة داخل الماب', '')
local resultInfo = label(places, 'اكتب اسم وجهة، ثم اضغط بحث. البحث في العناصر المحمّلة فقط.')
local found = {}
local resultButtons = create('Frame', {Size = UDim2.new(1, -4, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1}, places)
create('UIListLayout', {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5)}, resultButtons)
local selected = nil
local function getPosition(item)
    if item:IsA('BasePart') then return item.Position end
    if item:IsA('Model') then
        local p = item.PrimaryPart or item:FindFirstChildWhichIsA('BasePart', true)
        return p and p.Position
    end
    return nil
end
local function clearResults()
    for _, child in ipairs(resultButtons:GetChildren()) do
        if child:IsA('GuiObject') then child:Destroy() end
    end
end
button(places, 'بحث عن الوجهة', function()
    clearResults()
    selected = nil
    local term = string.lower(search.Text)
    if #term < 2 then say('اكتب حرفين على الأقل'); return end
    found = {}
    local seen = {}
    for _, obj in ipairs(WS:GetDescendants()) do
        if #found >= 12 then break end
        if (obj:IsA('Model') or obj:IsA('BasePart')) and string.find(string.lower(obj.Name), term, 1, true) then
            local pos = getPosition(obj)
            if pos and not seen[obj] then
                seen[obj] = true
                found[#found + 1] = obj
            end
        end
    end
    resultInfo.Text = '   النتائج: ' .. tostring(#found) .. ' (اختر نتيجة حقيقية)'
    for i, obj in ipairs(found) do
        local candidate = obj
        button(resultButtons, candidate.Name .. '  [' .. candidate.ClassName .. ']', function()
            selected = candidate
            say('تم اختيار: ' .. candidate:GetFullName())
        end)
    end
end)
button(places, 'الانتقال إلى الوجهة المختارة', function()
    if not selected or not selected.Parent then say('اختر نتيجة أولًا'); return end
    local r = characterRoot()
    local pos = getPosition(selected)
    if not r or not pos then say('الشخصية أو الوجهة غير متاحة'); return end
    r.CFrame = CFrame.new(pos + Vector3.new(0, 6, 0))
    say('تمت محاولة الانتقال؛ قد يعيدك السيرفر لمكانك')
end)
local animals = tab('كشف الضبان')
local radarOn = false
local animalLabel = label(animals, 'الكشف متوقف')
local radarButton
local function clearMarkers()
    for model, mark in pairs(markerMap) do
        pcall(function() mark:Destroy() end)
        markerMap[model] = nil
    end
end
radarButton = button(animals, 'الرادار: OFF', function()
    radarOn = not radarOn
    radarButton.Text = radarOn and 'الرادار: ON' or 'الرادار: OFF'
    if not radarOn then clearMarkers() end
    say(radarOn and 'بدأ كشف العناصر المحمّلة' or 'تم إيقاف الرادار')
end)
label(animals, 'يبحث عن موديلات Lizard / Dhab / ضب أو العناصر التي تحمل CollectionService Tag. لن تظهر عناصر غير محمّلة عند العميل.')
local function isLizard(obj)
    if not obj:IsA('Model') or not obj.Parent then return false end
    local n = string.lower(obj.Name)
    return string.find(n, 'lizard', 1, true) ~= nil
        or string.find(n, 'dhab', 1, true) ~= nil
        or string.find(n, 'ضب', 1, true) ~= nil
        or CollectionService:HasTag(obj, 'Lizard')
        or CollectionService:HasTag(obj, 'Dhab')
end
local visual = tab('المظهر')
local oldBrightness = Lighting.Brightness
local brightOn = false
local brightButton
brightButton = button(visual, 'إضاءة إضافية: OFF', function()
    brightOn = not brightOn
    Lighting.Brightness = brightOn and 4 or oldBrightness
    brightButton.Text = brightOn and 'إضاءة إضافية: ON' or 'إضاءة إضافية: OFF'
end)
local diagnostics = tab('التشخيص')
local diag = label(diagnostics, 'تشخيص التشغيل: جاهز')
button(diagnostics, 'فحص بيئة التشغيل', function()
    local h = humanoid()
    local r = characterRoot()
    local cam = WS.CurrentCamera
    local info = 'LocalPlayer: OK | PlayerGui: OK\n'
    info = info .. 'Character: ' .. (h and 'OK' or 'NOT READY') .. '\n'
    info = info .. 'Root: ' .. (r and 'OK' or 'NOT READY') .. '\n'
    info = info .. 'Camera: ' .. (cam and 'OK' or 'NOT READY')
    diag.Text = '   ' .. info
    say('تم فحص بيئة التشغيل')
end)
local function stop()
    if not alive then return end
    alive = false
    carEnabled = false
    restoreCar()
    clearMarkers()
    if brightOn then Lighting.Brightness = oldBrightness end
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    if gui.Parent then gui:Destroy() end
    if _G.LxV84Stop == stop then _G.LxV84Stop = nil end
end
_G.LxV84Stop = stop
button(diagnostics, 'إيقاف السكربت وتنظيف الواجهة', stop)
local elapsed = 0
connect(RS.Heartbeat, function(dt)
    if not alive then return end
    elapsed = elapsed + dt
    if elapsed < 0.5 then return end
    elapsed = 0
    fit()
    local h = humanoid()
    local seat = h and h.SeatPart
    if seat and seat:IsA('VehicleSeat') then
        local actual = seat.AssemblyLinearVelocity.Magnitude
        speedInfo.Text = string.format('   السرعة الفعلية: %.1f وحدة/ثانية | المطلوبة: %s', actual, speedInput.Text)
        if carEnabled then
            local target = tonumber(speedInput.Text)
            if target and target > 0 and target <= 400 then
                if not carSaved or carSaved.seat ~= seat then
                    restoreCar()
                    carSaved = {seat = seat, max = seat.MaxSpeed, torque = seat.Torque}
                end
                pcall(function()
                    seat.MaxSpeed = target
                    seat.Torque = math.max(seat.Torque, 10000)
                end)
            else
                speedInfo.Text = '   أدخل سرعة بين 1 و400'
            end
        end
    else
        speedInfo.Text = '   اجلس في VehicleSeat لقراءة السرعة'
        if carSaved then restoreCar() end
    end
    if radarOn then
        local r = characterRoot()
        local count = 0
        if r then
            for _, obj in ipairs(WS:GetDescendants()) do
                if count >= 30 then break end
                if isLizard(obj) then
                    local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA('BasePart', true)
                    if p and (p.Position - r.Position).Magnitude < 800 then
                        count = count + 1
                        if not markerMap[obj] then
                            local mark = create('BillboardGui', {
                                Name = 'LxV84Radar', Adornee = p,
                                Size = UDim2.fromOffset(150, 30), StudsOffset = Vector3.new(0, 3, 0),
                                AlwaysOnTop = true, MaxDistance = 800,
                            }, gui)
                            create('TextLabel', {
                                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                                Text = obj.Name, TextColor3 = RED,
                                TextStrokeTransparency = 0.2, TextSize = 14,
                                Font = Enum.Font.GothamBold,
                            }, mark)
                            markerMap[obj] = mark
                        end
                    end
                end
            end
        end
        for obj, mark in pairs(markerMap) do
            if not obj.Parent or not isLizard(obj) then
                mark:Destroy()
                markerMap[obj] = nil
            end
        end
        animalLabel.Text = '   تم العثور على ' .. tostring(count) .. ' عنصر ضمن 800 وحدة'
    end
end)
say('Lx REDLINE v84 | القائمة جاهزة — اضغط Lx لإخفائها أو فتحها')

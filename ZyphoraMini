                cb.Font = Enum.Font.Gotham
                cb.TextSize = 11
                cb.Parent = carContainer
                Instance.new("UICorner", cb).CornerRadius = UDim.new(0, 6)
                cb.MouseButton1Click:Connect(function()
                    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        obj:PivotTo(root.CFrame + Vector3.new(7, 3, 0))
                    end
                end)
            end
        end
    end
    carContainer.CanvasSize = UDim2.new(0, 0, 0, math.max(160, #carContainer:GetChildren() * 34))
end


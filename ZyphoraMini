local function titleField(text)
    local lower = tostring(text or ""):lower()
    return lower:find("title", 1, true) ~= nil
        or lower:find("nametag", 1, true) ~= nil
        or lower:find("name tag", 1, true) ~= nil
        or lower:find("لقب", 1, true) ~= nil
        or lower:find("ألقاب", 1, true) ~= nil
        or lower:find("القاب", 1, true) ~= nil
end
local function titleContainer(object)
    local current = object
    for _ = 1, 4 do
        if not current then break end
        if titleField(current.Name) then return true end
        current = current.Parent
    end
    return false
end
local function usableTitle(txt)
    if type(txt) ~= "string" then return nil end
    local trimmed = txt:gsub("^%s+", ""):gsub("%s+$", "")
    if #trimmed < 2 or #trimmed > 100 or trimmed:find("\n", 1, true) then return nil end
    local lower = trimmed:lower()
    if lower == "title" or lower == "titles" or lower == "none"
        or lower == "default" or lower == "false" or lower == "true" then
        return nil
    end
    return trimmed
end
local function addTitleCandidate(label, source)
    label = usableTitle(label)
    if not label then return end
    local key = label:lower()
    if not titleEntries[key] then
        titleEntries[key] = {name = label, source = source}
    end
end
local function currentTitleFromReplicatedData()
    for _, host in ipairs({LocalPlayer, localCharacter()}) do
        if host then
            for key, value in pairs(host:GetAttributes()) do
                if titleField(key) and type(value) == "string" and usableTitle(value) then
                    return value, "خاصية " .. key
                end
            end
            for _, child in ipairs(host:GetDescendants()) do
                if child:IsA("StringValue") and titleField(child.Name)
                    and usableTitle(child.Value) then
                    return child.Value, "قيمة " .. child.Name
                end
            end
        end
    end
    return nil, nil
end

-- Model metadata is game-specific. Never invent rarity/power.
local keywords={'ضب','lizard','dhab','reptile','lhib'}
local function isLizard(m)
 if not m:IsA('Model') or Players:GetPlayerFromCharacter(m) then return false end
 local n=string.lower(m.Name)
 for _,word in ipairs(keywords) do if n:find(word,1,true) then return true end end
 return m:GetAttribute('Rarity')~=nil and (n:find('pet',1,true)~=nil or n:find('animal',1,true)~=nil)
end
local function part(m) return m.PrimaryPart or m:FindFirstChildWhichIsA('BasePart',true) end
local function stat(m,names)
 for _,n in ipairs(names) do
  local a=m:GetAttribute(n);if a~=nil then return a end
  local v=m:FindFirstChild(n,true)
  if v and (v:IsA('StringValue') or v:IsA('NumberValue') or v:IsA('IntValue')) then return v.Value end
 end
 return nil
end
local function info(m)
 return {rarity=stat(m,{'Rarity','Tier','Grade','الندرة'}),power=stat(m,{'Power','Strength','قوة'}),size=stat(m,{'Size','Scale','حجم'}),kind=stat(m,{'Type','Species','نوع'})}
end
local function rarityColor(value)
 local s=string.lower(tostring(value or ''))
 if s:find('mythic',1,true) or s:find('خرافي',1,true) then return Color3.fromRGB(255,58,221) end
 if s:find('legendary',1,true) or s:find('gold',1,true) or s:find('ذهبي',1,true) then return Color3.fromRGB(255,199,43) end
 if s:find('epic',1,true) or s:find('بنفسجي',1,true) then return Color3.fromRGB(169,100,255) end
 if s:find('uncommon',1,true) or s:find('أخضر',1,true) then return Color3.fromRGB(54,224,120) end
 if s:find('rare',1,true) or s:find('أزرق',1,true) then return Color3.fromRGB(48,161,255) end
 return Color3.fromRGB(221,224,230)
end
local lizards={}
local function scanLizards()
 table.clear(lizards)
 for _,obj in ipairs(WS:GetDescendants()) do if isLizard(obj) then local p=part(obj);if p then lizards[#lizards+1]={model=obj,root=p} end end end
end
local function targetLizard(query)
 local me=root();if not me then return nil end
 local chosen,best=nil,math.huge;query=string.lower(query or '')
 for _,e in ipairs(lizards) do if e.model.Parent and e.root.Parent and (query=='' or string.lower(e.model.Name):find(query,1,true)) then
  local d=(e.root.Position-me.Position).Magnitude;if d<best then best=d;chosen=e end
 end end
 return chosen
end

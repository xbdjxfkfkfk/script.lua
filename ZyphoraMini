-- Lx REDLINE v78 | standalone LocalScript for Roblox Studio
-- Client-only: uses replicated objects; server controls money, kills, sales, and teleports.
local Players=game:GetService('Players')
local UIS=game:GetService('UserInputService')
local WS=game:GetService('Workspace')
local player=Players.LocalPlayer
if not player then warn('Lx v78 requires a LocalScript'); return end
local pg=player:WaitForChild('PlayerGui',15)
if not pg then warn('Lx v78: PlayerGui unavailable');return end
local prior=pg:FindFirstChild('Lx_REDLINE_v78')
if prior then prior:Destroy() end
local gui=Instance.new('ScreenGui');gui.Name='Lx_REDLINE_v78';gui.ResetOnSpawn=false;gui.DisplayOrder=100;gui.Parent=pg
local alive=true
local pending=0
local connections={}
local function listen(sig,cb) local c=sig:Connect(cb);table.insert(connections,c);return c end
local function make(class,props,parent)
 local o=Instance.new(class)
 for k,v in pairs(props) do o[k]=v end
 o.Parent=parent;return o
end
local bg=Color3.fromRGB(15,15,18)
local card=Color3.fromRGB(34,34,39)
local red=Color3.fromRGB(210,34,47)
local white=Color3.fromRGB(245,245,245)
local main=make('Frame',{Size=UDim2.fromOffset(410,475),Position=UDim2.new(.5,-205,.5,-237),BackgroundColor3=bg,BorderSizePixel=0,Active=true},gui)
make('UICorner',{CornerRadius=UDim.new(0,14)},main)
make('UIStroke',{Color=red,Thickness=2},main)
local scale=make('UIScale',{Scale=1},main)
local function resize()
 local cam=WS.CurrentCamera
 if cam then local v=cam.ViewportSize;scale.Scale=math.clamp(math.min((v.X-20)/410,(v.Y-20)/475),.48,1) end
end
resize()
local title=make('TextLabel',{Size=UDim2.new(1,-100,0,48),Position=UDim2.fromOffset(15,5),BackgroundTransparency=1,Text='Lx REDLINE PRO v78',TextColor3=white,Font=Enum.Font.GothamBold,TextSize=19,TextXAlignment=Enum.TextXAlignment.Left},main)
local close=make('TextButton',{Size=UDim2.fromOffset(34,32),Position=UDim2.new(1,-42,0,12),Text='×',Font=Enum.Font.GothamBold,TextSize=24,TextColor3=white,BackgroundColor3=red},main)
make('UICorner',{CornerRadius=UDim.new(0,8)},close)
local status=make('TextLabel',{Size=UDim2.new(1,-24,0,55),Position=UDim2.new(0,12,1,-62),BackgroundColor3=card,Text='جاهز | الكشف يعتمد على المجسمات المحمّلة',TextColor3=white,TextSize=12,Font=Enum.Font.Gotham,TextWrapped=true},main)
make('UICorner',{CornerRadius=UDim.new(0,8)},status)
local scroll=make('ScrollingFrame',{Size=UDim2.new(1,-24,1,-125),Position=UDim2.fromOffset(12,57),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=4,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.fromOffset(0,0)},main)
make('UIListLayout',{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder},scroll)
local function say(s)if alive then status.Text=s end end
local function button(text,callback)
 local b=make('TextButton',{Size=UDim2.new(1,-7,0,39),BackgroundColor3=card,Text=text,TextColor3=white,TextSize=13,Font=Enum.Font.GothamBold},scroll)
 make('UICorner',{CornerRadius=UDim.new(0,8)},b)
 listen(b.MouseButton1Click,function()
  local ok,err=pcall(callback)
  if not ok then warn('[Lx v78]',err);say('خطأ: '..tostring(err):sub(1,110)) end
 end)
 return b
end
local function characterRoot()
 local char=player.Character
 return char and char:FindFirstChild('HumanoidRootPart')
end
local function vehicle()
 local h=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
 local seat=h and h.SeatPart
 if not seat or not seat:IsA('VehicleSeat') or seat.Occupant~=h then return nil end
 local model=seat:FindFirstAncestorOfClass('Model')
 return model,seat
end
local function pos(obj)
 if obj:IsA('BasePart') then return obj.Position end
 if obj:IsA('Model') then
  local ok,p=pcall(function()return obj:GetPivot().Position end)
  if ok then return p end
 end
 return nil
end
local function hasAny(n,terms)
 n=string.lower(n)
 for _,word in ipairs(terms) do if string.find(n,string.lower(word),1,true) then return true end end
 return false
end
local destinations={
 {'تاجر الخلا',{'تاجر الخلا','merchant','trader','dealer'}},
 {'الديرة / البيع',{'الديرة','ديرة','sellpoint','sell zone','buyer','نقطة البيع'}},
 {'الفيروز',{'فيروز','turquoise'}},
 {'القولد / الذهب',{'قولد','gold','ذهب'}},
 {'الألماسي',{'ألماسي','الماسي','diamond'}},
 {'العالم الثاني',{'العالم الثاني','world2','world 2','second world'}},
 {'الضبان',{'ضب','ضبان','lizard','dhab','dhub'}},
}
local selected=nil
local chosen=nil
local savedHome=nil
local function scan(terms)
 local root=characterRoot()
 if not root then return {} end
 local result={}
 for _,obj in ipairs(WS:GetDescendants()) do
  if (obj:IsA('BasePart') or obj:IsA('Model')) and hasAny(obj.Name,terms) then
   local p=pos(obj)
   if p then
    local ancestor=obj:FindFirstAncestorOfClass('Model')
    local char=ancestor and Players:GetPlayerFromCharacter(ancestor)
    if not char then
     table.insert(result,{object=obj,position=p,distance=(p-root.Position).Magnitude})
    end
   end
  end
 end
 table.sort(result,function(a,b)return a.distance<b.distance end)
 return result
end
local selectedLabel=button('الوجهة: لم يتم الاختيار',function()
 if selected then say('الوجهة المحددة: '..selected.object:GetFullName()) else say('اختر وجهة من الأزرار') end
end)
for _,entry in ipairs(destinations) do
 local label,terms=entry[1],entry[2]
 button('تحديد: '..label,function()
  local matches=scan(terms)
  if #matches==0 then say(label..': لا توجد وجهة محمّلة بهذا الاسم');return end
  selected=matches[1];chosen=label
  selectedLabel.Text='الوجهة: '..label..' | '..math.floor(selected.distance)..' وحدة'
  say('تم اختيار '..label..' | '..selected.object.Name..' | الاسم تقريبي، تحقق من المكان')
 end)
end
button('حفظ مكاني الحالي كديرة',function()
 local r=characterRoot()
 if not r then say('الشخصية غير جاهزة');return end
 savedHome=r.Position;say('تم حفظ موقع الديرة لهذه الجلسة')
end)
button('تحديد الديرة المحفوظة',function()
 if not savedHome then say('احفظ موقع الديرة أولاً');return end
 selected={position=savedHome,distance=0,object=WS};chosen='الديرة المحفوظة'
 selectedLabel.Text='الوجهة: الديرة المحفوظة'
 say('تم تحديد الديرة المحفوظة')
end)
local mode='player'
local modeBtn=button('طريقة الانتقال: اللاعب',function()
 mode=mode=='player' and 'car' or 'player'
 modeBtn.Text='طريقة الانتقال: '..(mode=='car' and 'السيارة' or 'اللاعب')
end)
button('انتقال إلى الوجهة (بعد 3 ثوانٍ)',function()
 if not selected then say('حدد وجهة أولاً');return end
 if selected.object~=WS and not selected.object:IsDescendantOf(WS) then say('الوجهة اختفت؛ أعد البحث');return end
 local target=selected.position
 local label=chosen or 'الوجهة'
 pending+=1
 local request=pending
 say('الانتقال إلى '..label..' بعد 3 ثوانٍ | اضغط إلغاء للتراجع')
 task.delay(3,function()
  if not alive or request~=pending then return end
  local cf=CFrame.new(target+Vector3.new(0,6,0))
  if mode=='car' then
   local car=vehicle()
   if not car then say('أنت لست في مقعد سائق VehicleSeat');return end
   local ok,err=pcall(function()car:PivotTo(cf*car:GetPivot().Rotation)end)
   if not ok then say('فشل تحريك السيارة: '..tostring(err):sub(1,65));return end
  else
   local r=characterRoot()
   if not r then say('الشخصية غير جاهزة');return end
   r.CFrame=cf
  end
  say('تمت محاولة الانتقال محلياً؛ السيرفر قد يعيد موقعك')
  task.delay(1,function()
   if not alive or request~=pending then return end
   local r=characterRoot()
   if r and (r.Position-target).Magnitude>40 then say('الانتقال لم يثبت؛ قد يكون السيرفر رفضه') end
  end)
 end)
end)
button('إلغاء الانتقال المعلّق',function()
 pending+=1;say('تم إلغاء الانتقال المعلّق')
end)
button('فحص عدد الضبان المحمّلة',function()
 local matches=scan({'ضب','ضبان','lizard','dhab','dhub'})
 say('مطابقات الأسماء المحمّلة: '..#matches..' | ليست تأكيدًا أنها ضبان حية')
end)
button('تحديث حجم القائمة',function()resize();say('تم تحديث مقياس القائمة')end)
local dragging,startMouse,startPos=false,nil,nil
listen(title.InputBegan,function(input)
 if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
  dragging=true;startMouse=input.Position;startPos=main.Position
 end
end)
listen(UIS.InputChanged,function(input)
 if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
  local delta=input.Position-startMouse
  main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
 end
end)
listen(UIS.InputEnded,function(input)
 if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dragging=false end
end)
listen(close.MouseButton1Click,function()
 alive=false;pending+=1
 for _,c in ipairs(connections) do c:Disconnect() end
 gui:Destroy()
end)
print('[Lx REDLINE v78] standalone navigation UI loaded')

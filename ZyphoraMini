refreshToolUI = function()
    if not alive or not itemsList.Parent then return end
    for _, existing in ipairs(itemsList:GetChildren()) do
        if existing:IsA("Frame") then existing:Destroy() end
    end
    local owned = ownedToolNames()
    local found = {}
    for key, name in pairs(visibleToolIndex) do found[key] = name end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({backpack, LocalPlayer.Character}) do
        if holder then
            for _, obj in ipairs(holder:GetChildren()) do
                if obj:IsA("Tool") then found[toolKey(obj.Name)] = obj.Name end
            end
        end
    end
    for key, name in pairs(favorites) do
        if not found[key] then found[key] = name end
    end
    local keys, phrase = {}, toolKey(toolSearch.Text)
    for key, name in pairs(found) do
        if (phrase == "" or key:find(phrase, 1, true)) and (not favoritesOnly or favorites[key]) and (not toolOwnedOnly or owned[key]) then
            table.insert(keys, key)
        end
    end
    table.sort(keys, function(a,b)
        if toolSortMode == "owned" then
            local aOwned, bOwned = owned[a] == true, owned[b] == true
            if aOwned ~= bOwned then return aOwned end
        end
        return a < b
    end)
    local pageCount = math.max(1, math.ceil(#keys / toolPageSize))
    toolPage = math.clamp(toolPage, 1, pageCount)
    toolPageStatus.Text = "أدوات: " .. #keys .. " | " .. (toolOwnedOnly and "الحقيبة" or "الكل") .. " | صفحة " .. toolPage .. " / " .. pageCount
    toolPrevious.Active = toolPage > 1
    toolNext.Active = toolPage < pageCount
    toolPrevious.TextTransparency = toolPage > 1 and 0 or .55
    toolNext.TextTransparency = toolPage < pageCount and 0 or .55
    local first = (toolPage - 1) * toolPageSize + 1
    for i = first, math.min(#keys, first + toolPageSize - 1) do
        local key = keys[i]
        local name = safeText(found[key], key)
        local ownedNow = owned[key] == true
        local row = make("Frame", {
            Size = UDim2.new(1, -5, 0, 44), BackgroundColor3 = COLORS.panel2,
            BorderSizePixel = 0,

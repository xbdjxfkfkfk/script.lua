local function updateSpeed()
    local hum = humanoid()

    if not hum then return end

    if S.Speed then
        if trackedHumanoid ~= hum then
            trackedHumanoid = hum
            originalWalkSpeed = hum.WalkSpeed
        end

        hum.WalkSpeed = 16 * S.Multiplier
    end
end

local function disableSpeed()
    if trackedHumanoid
        and trackedHumanoid.Parent
        and originalWalkSpeed then

        trackedHumanoid.WalkSpeed = originalWalkSpeed
    end

    trackedHumanoid = nil
    originalWalkSpeed = nil
end

local function restoreVisibility()
    for obj, value in pairs(visibilityCache) do
        if obj and obj.Parent then
            if obj:IsA("BasePart") then
                obj.LocalTransparencyModifier = value
            elseif obj:IsA("Decal") then
                obj.Transparency = value
            end
        end
    end

    table.clear(visibilityCache)
end

local function updateVisibility()
    if not S.Invis then return end

    local char = character()
    if not char then return end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            if visibilityCache[obj] == nil then
                visibilityCache[obj] =
                    obj.LocalTransparencyModifier
            end

            obj.LocalTransparencyModifier = 1

        elseif obj:IsA("Decal") then
            if visibilityCache[obj] == nil then
                visibilityCache[obj] = obj.Transparency
            end

            obj.Transparency = 1
        end
    end
end

-- =====================================
-- LIZARD DETECTION
-- =====================================

local lizardKeywords = {
    "lizard",
    "dhab",
    "reptile",
    "lhib",
    "ضب"
}

local function isLizard(model)
    if not model:IsA("Model") then
        return false
    end

    if Players:GetPlayerFromCharacter(model) then
        return false
    end

    local name = string.lower(model.Name)

    for _, keyword in ipairs(lizardKeywords) do
        if string.find(name, keyword, 1, true) then
            return true
        end
    end

    return false
end

local function lizardRoot(model)
    return model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function readStat(model, names)
    for _, name in ipairs(names) do
        local attribute = model:GetAttribute(name)

        if attribute ~= nil then
            return attribute
        end

        local child = model:FindFirstChild(name, true)

        if child and child:IsA("ValueBase") then
            return child.Value
        end
    end

    return nil
end

local function lizardStats(model)
    return {
        Rarity = readStat(model, {
            "Rarity", "Tier", "ندرة"
        }) or "غير معروف",

        Power = readStat(model, {
            "Power", "Strength", "قوة"
        }) or "غير متاح",

        Size = readStat(model, {
            "Size", "Scale", "حجم"
        }) or "غير متاح"
    }
end

local function rarityColor(value)
    local text = string.lower(tostring(value))

    if text:find("mythic", 1, true)
        or text:find("خرافي", 1, true) then

        return Color3.fromRGB(255, 50, 225)

    elseif text:find("legendary", 1, true)
        or text:find("ذهبي", 1, true) then

        return Color3.fromRGB(255, 200, 45)

    elseif text:find("epic", 1, true)
        or text:find("بنفسجي", 1, true) then

        return Color3.fromRGB(165, 90, 255)

    elseif text:find("rare", 1, true)
        or text:find("أزرق", 1, true) then

        return Color3.fromRGB(45, 160, 255)

    elseif text:find("uncommon", 1, true)
        or text:find("أخضر", 1, true) then

        return Color3.fromRGB(45, 225, 130)
    end

    return Color3.fromRGB(220, 225, 235)
end

local lizardCache = {}
local lizardSnapshot = {}
local scanIndex = 1

local function rebuildLizardSnapshot()
    table.clear(lizardCache)

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isLizard(obj) then
            local part = lizardRoot(obj)

            if part then
                table.insert(lizardCache, {
                    Model = obj,
                    Root = part
                })
            end
        end
    end
end

local function nearestLizard(filter)
    local root = rootPart()
    if not root then return nil end

    local closest
    local shortest = math.huge
    local query = string.lower(filter or "")

    for _, entry in ipairs(lizardCache) do
        local model = entry.Model
        local part = entry.Root

        if model.Parent and part.Parent then
            local matches = query == ""
                or string.find(
                    string.lower(model.Name),
                    query,
                    1,
                    true
                ) ~= nil

            if matches then
                local distance =
                    (part.Position - root.Position).Magnitude

                if distance < shortest then
                    shortest = distance
                    closest = entry
                end
            end
        end
    end

    return closest
end

local function clearLizardRadar()
    for _, gui in pairs(wildlifeObjects) do
        if gui then
            gui:Destroy()
        end
    end

    table.clear(wildlifeObjects)
end

local function createLizardMarker(entry)
    local model = entry.Model
    local part = entry.Root

    if wildlifeObjects[model] or not part.Parent then
        return
    end

    local stats = lizardStats(model)
    local color = rarityColor(stats.Rarity)

    local bb = create("BillboardGui", {
        Name = "ZyphoraLizardMarker",
        Adornee = part,
        Size = UDim2.fromOffset(250, 112),
        StudsOffsetWorldSpace = Vector3.new(0, 4, 0),
        AlwaysOnTop = true,
        MaxDistance = 350
    }, GUI)

    local frame = create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = C.bg,
        BackgroundTransparency = 0.12,
        BorderSizePixel = 0
    }, bb)
    round(frame, 8)

    create("UIStroke", {
        Color = color,
        Thickness = 1.5
    }, frame)

    local lines = {
        "🦎 " .. model.Name,
        "الندرة: " .. tostring(stats.Rarity),
        "القوة: " .. tostring(stats.Power),
        "الحجم: " .. tostring(stats.Size)
    }

    local layout = create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2)
    }, frame)

    create("UIPadding", {
        PaddingTop = UDim.new(0, 5),
        PaddingLeft = UDim.new(0, 5),
        PaddingRight = UDim.new(0, 5)
    }, frame)

    for i, text in ipairs(lines) do
        create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 23),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = i == 1 and color or C.text,
            Font = Enum.Font.GothamBold,
            TextSize = 11,
            TextTruncate = Enum.TextTruncate.AtEnd,
            LayoutOrder = i
        }, frame)
    end

    wildlifeObjects[model] = bb
end

local function refreshLizardRadar()
    if not S.LizardScan then
        clearLizardRadar()
        return
    end

    for _, entry in ipairs(lizardCache) do
        createLizardMarker(entry)
    end

    for model, marker in pairs(wildlifeObjects) do
        if not model.Parent then
            marker:Destroy()
            wildlifeObjects[model] = nil
        end
    end
end


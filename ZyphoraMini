    panel.Position = UDim2.new(0.5, -230, 0.5, -h/2)
    panel.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
    panel.BorderSizePixel = 0
    panel.Parent = gui

    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 10); c.Parent = panel
    local st = Instance.new("UIStroke"); st.Color = Color3.fromRGB(239, 28, 37); st.Thickness = 2; st.Parent = panel

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -40, 0, 30)
    title.Position = UDim2.new(0, 20, 0, 15)
    title.BackgroundTransparency = 1
    title.Text = cfg.title or "Discord مطلوب"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 18
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = panel

    local body = Instance.new("TextLabel")
    body.Size = UDim2.new(1, -40, 0, 65)
    body.Position = UDim2.new(0, 20, 0, 50)
    body.BackgroundTransparency = 1
    body.Text = cfg.message or ""
    body.TextColor3 = Color3.fromRGB(220, 220, 220)
    body.Font = Enum.Font.Gotham
    body.TextSize = 13
    body.TextWrapped = true
    body.TextYAlignment = Enum.TextYAlignment.Top
    body.Parent = panel

    local input
    if cfg.showInput then
        input = Instance.new("TextBox")
        input.Size = UDim2.new(1, -40, 0, 36)
        input.Position = UDim2.new(0, 20, 0, 118)
        input.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
        input.TextColor3 = Color3.fromRGB(255, 255, 255)
        input.PlaceholderText = "الصق المفتاح هنا"
        input.PlaceholderColor3 = Color3.fromRGB(120, 120, 125)
        input.Font = Enum.Font.Code
        input.TextSize = 13
        input.ClearTextOnFocus = false
        input.Parent = panel
        local ic = Instance.new("UICorner"); ic.CornerRadius = UDim.new(0, 6); ic.Parent = input
    end

    local function makeBtn(text, x, w, color, cb)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, w, 0, 40)
        b.Position = UDim2.new(0, x, 1, -52)
        b.BackgroundColor3 = color
        b.Text = text
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 13
        b.Parent = panel
        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 8); bc.Parent = b
        b.MouseButton1Click:Connect(cb)
        return b
    end

    if cfg.showInput then
        makeBtn("تحقق", 20, 130, Color3.fromRGB(239, 28, 37), function()
            if not input then return end
            local k = input.Text:gsub("%s+", "")
            if k == "" then body.Text = "أدخل المفتاح أولاً." return end
            body.Text = "جاري التحقق..."
            local ok, reason, msg = checkMembership(k)
            if ok then
                currentKey = k; saveKey(k); netFails = 0
                destroyGuard(); isLocked = false
                if cfg.onVerified then cfg.onVerified() end
            else
                body.Text = "✕ فشل: " .. tostring(msg or reason)
            end
        end)
        makeBtn("احصل على مفتاح", 170, 200, Color3.fromRGB(88, 101, 242), function()
            copyAuthLink(); openAuthLink()
            body.Text = "تم فتح الرابط. سجّل الدخول ثم الصق المفتاح."
        end)
    else
        -- زر "إعادة المحاولة" — يستخدم المفتاح المحفوظ
        makeBtn(cfg.buttonText or "إعادة المحاولة", 20, 220, Color3.fromRGB(239, 28, 37), function()
            body.Text = "جاري التحقق..."
            local ok, reason, msg = checkMembership(currentKey)
            if ok then
                netFails = 0
                destroyGuard(); isLocked = false
                if cfg.onVerified then cfg.onVerified() end
            else
                body.Text = "✕ " .. tostring(msg or reason) .. "\nتأكد إنك داخل السيرفر ثم اضغط إعادة المحاولة."
            end
        end)
        makeBtn("رابط السيرفر", 260, 180, Color3.fromRGB(88, 101, 242), function()
            copyAuthLink(); openAuthLink()
            body.Text = "تم فتح الرابط. ادخل السيرفر ثم اضغط إعادة المحاولة."
        end)
    end

    guardGui = gui
    return body
end

local function showKeyPanel(msg)
    isLocked = true
    buildPanel({
        title = "Discord مطلوب",
        message = msg or "لازم تدخل سيرفر Discord حقنا أول.\nاضغط \"احصل على مفتاح\"، سجّل دخول بحسابك، ثم الصق المفتاح.",
        showInput = true,
        height = 265,
    })
end

local function showReLockPanel(msg)
    isLocked = true
    buildPanel({
        title = "Discord مطلوب",
        message = msg or "✕ طلعت من سيرفر Discord.\nادخل السيرفر مرة ثانية ثم اضغط إعادة المحاولة.",
        showInput = false,
        buttonText = "إعادة المحاولة",
        height = 210,
    })
end

-- ---------- main ----------
local started = false
local function runMain()
    -- =========================================================
    -- السكربت الحقيقي يبدأ هنا
    -- =========================================================
    -- launchRedline()
end

local function onVerified()
    if not started then
        started = true
        runMain()
    end
end

local function lockOnLeave(message)
    if not isLocked then
        showReLockPanel(message)
    end
end

local function startWatchdog()
    task.spawn(function()
        while true do
            task.wait(POLL_INTERVAL)
            local ok, reason, msg = checkMembership(currentKey)

            if ok then
                netFails = 0
                if isLocked then
                    destroyGuard()
                    isLocked = false
                    if onVerified then onVerified() end
                end
            else
                if reason == "left_guild" then
                    -- طلع من السيرفر → قفل فورًا
                    lockOnLeave("✕ طلعت من سيرفر Discord.\nادخل السيرفر مرة ثانية ثم اضغط إعادة المحاولة.")
                elseif reason == "bad_key" then
                    -- المفتاح انتهى/غير صالح → يطلب مفتاح جديد
                    currentKey = nil; clearKey(); started = false
                    showKeyPanel("✕ مفتاحك غير صالح. احصل على مفتاح جديد.")
                    return
                else
                    -- مشكلة شبكة → تحمّل كم محاولة
                    netFails = netFails + 1
                    if netFails >= NET_TOLERANCE then
                        lockOnLeave("✕ تعذر التحقق من العضوية.\nتأكد إنك داخل السيرفر ثم اضغط إعادة المحاولة.")
                    end
                end
            end
        end
    end)
end

local function boot()
    local saved = loadKey()
    if saved then
        local ok, reason, msg = checkMembership(saved)
        if ok then
            currentKey = saved
            destroyGuard(); isLocked = false
            onVerified()
            startWatchdog()
            return
        elseif reason == "left_guild" then
            currentKey = saved
            showReLockPanel("✕ أنت مو داخل سيرفر Discord.\nادخل السيرفر ثم اضغط إعادة المحاولة.")
            startWatchdog()
            return
        else
            clearKey()
        end
    end
    showKeyPanel()
end

local ok, err = pcall(boot)
if not ok then
    warn("Guard startup error:", err)
    showReLockPanel("خطأ: " .. tostring(err):sub(1, 300))
end
// npm install express
const express = require("express");
const crypto  = require("crypto");

const {
  DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, DISCORD_BOT_TOKEN,
  DISCORD_GUILD_ID, REDIRECT_URI, HMAC_SECRET, PORT = 3000,
} = process.env;

for (const [k, v] of Object.entries({
  DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, DISCORD_BOT_TOKEN,
  DISCORD_GUILD_ID, REDIRECT_URI, HMAC_SECRET,
})) {
  if (!v) { console.error(`FILL: missing env ${k}`); process.exit(1); }
}

const app = express();

// ---------- signing ----------
function signKey(userId) {
  const payload = Buffer.from(String(userId)).toString("base64url");
  const sig = crypto.createHmac("sha256", HMAC_SECRET).update(payload).digest("base64url");
  return `${payload}.${sig}`;
}
function verifyKey(key) {
  if (typeof key !== "string" || !key.includes(".")) return null;
  const [payload, sig] = key.split(".");
  const expect = crypto.createHmac("sha256", HMAC_SECRET).update(payload).digest("base64url");
  const a = Buffer.from(sig), b = Buffer.from(expect);
  if (a.length !== b.length || !crypto.timingSafeEqual(a, b)) return null;
  try { return Buffer.from(payload, "base64url").toString("utf8"); } catch { return null; }
}

// ---------- member cache ----------
const cache = new Map(); // userId -> { member: bool, expires: number }
const CACHE_TTL = 8000;  // ٨ ثواني

async function isGuildMember(userId) {
  const now = Date.now();
  const hit = cache.get(userId);
  if (hit && hit.expires > now) return hit.member;

  const r = await fetch(
    `https://discord.com/api/guilds/${DISCORD_GUILD_ID}/members/${userId}`,
    { headers: { Authorization: `Bot ${DISCORD_BOT_TOKEN}` } }
  );
  if (r.status === 404) {
    cache.set(userId, { member: false, expires: now + CACHE_TTL });
    return false;
  }
  if (!r.ok) throw new Error(`guild check ${r.status}`);
  cache.set(userId, { member: true, expires: now + CACHE_TTL });
  return true;
}

// ---------- OAuth ----------
async function exchangeCode(code) {
  const body = new URLSearchParams({
    client_id: DISCORD_CLIENT_ID,
    client_secret: DISCORD_CLIENT_SECRET,
    grant_type: "authorization_code",
    code,
    redirect_uri: REDIRECT_URI,
  });
  const r = await fetch("https://discord.com/api/oauth2/token", {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body,
  });
  if (!r.ok) throw new Error(`token ${r.status}`);
  return r.json();
}
async function fetchUserId(token) {
  const r = await fetch("https://discord.com/api/users/@me", {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (!r.ok) throw new Error(`user ${r.status}`);
  return r.json();
}

// ---------- routes ----------
app.get("/auth", (_req, res) => {
  const p = new URLSearchParams({
    client_id: DISCORD_CLIENT_ID,
    redirect_uri: REDIRECT_URI,
    response_type: "code",
    scope: "identify guilds",
  });
  res.redirect(`https://discord.com/oauth2/authorize?${p}`);
});

app.get("/auth/callback", async (req, res) => {
  const code = req.query.code;
  if (!code) return res.status(400).send("no code");
  try {
    const token = await exchangeCode(code);
    const user = await fetchUserId(token.access_token);

    // تجاوز الكاش هنا — نبي نعرف الحالة الحقيقية الآن
    const r = await fetch(
      `https://discord.com/api/guilds/${DISCORD_GUILD_ID}/members/${user.id}`,
      { headers: { Authorization: `Bot ${DISCORD_BOT_TOKEN}` } }
    );
    const isMember = r.ok;
    cache.set(user.id, { member: isMember, expires: Date.now() + CACHE_TTL });

    if (!isMember) {
      return res.status(403).send(`
        <body style="font-family:sans-serif;background:#121214;color:#fff;text-align:center;padding:80px">
          <h2 style="color:#ef1c25">✕ أنت لست عضوًا في السيرفر</h2>
          <p>ادخل السيرفر أولاً ثم أعد المحاولة.</p>
        </body>`);
    }

    const key = signKey(user.id);
    res.send(`
      <body style="font-family:sans-serif;background:#121214;color:#fff;text-align:center;padding:80px">
        <h2>✓ تم التحقق</h2>
        <p>انسخ المفتاح والصقه في السكربت:</p>
        <pre style="display:inline-block;background:#1e1e22;padding:16px 24px;border-radius:8px;border:1px solid #ef1c25;font-size:15px">${key}</pre>
      </body>`);
  } catch (e) {
    console.error(e);
    res.status(500).send("verification failed");
  }
});

app.get("/check", async (req, res) => {
  const userId = verifyKey(req.query.key);
  if (!userId) return res.json({ ok: false, reason: "bad_key", message: "المفتاح غير صالح" });

  try {
    const member = await isGuildMember(userId);
    if (!member) return res.json({ ok: false, reason: "left_guild", message: "لم تعد عضوًا في السيرفر" });
    return res.json({ ok: true });
  } catch (e) {
    console.error(e);
    return res.json({ ok: false, reason: "backend_error", message: "خطأ مؤقت" });
  }
});

app.listen(PORT, () => console.log(`guard on :${PORT}`));

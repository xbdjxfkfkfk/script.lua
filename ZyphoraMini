local function applyEsp(char)
    if not char or not S.ESP or char:FindFirstChild("ZyHighlight") then return end
    local h = Instance.new("Highlight")
    h.Name = "ZyHighlight"
    h.FillColor = C.accent
    h.FillTransparency = 0.5

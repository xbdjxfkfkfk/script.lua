local function cleanup()
    if not alive then return end
    alive = false
    state.Fly = false
    stopFlight()
    state.LocalInvisible = false
    applyLocalInvisible()
    state.Speed = false
    applySpeed()
    state.Noclip = false
    restoreCollisions()
    clearHighlights()
    clearTitlePreview()
    stopDrag()
    stopCameraFollow(true)
    clearRadar()
    saveSettings()
    for player in pairs(adminVisuals) do clearAdminVisual(player) end
    for _, conn in ipairs(connections) do conn:Disconnect() end
    gui:Destroy()
    if rawget(_G, "NOVA_SuiteV16ProCleanup") == cleanup then
        _G.NOVA_SuiteV16ProCleanup = nil
    end
end

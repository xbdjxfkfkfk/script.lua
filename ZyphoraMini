local function restoreVis()for obj,v in pairs(vis) do if obj.Parent then if obj:IsA('BasePart') then obj.LocalTransparencyModifier=v else obj.Transparency=v end end end;table.clear(vis)end
local function applyVis()
 if not S.Invis then return end
 local ch=LP.Character;if not ch then return end
 for _,o in ipairs(ch:GetDescendants()) do
  if o:IsA('BasePart') then if vis[o]==nil then vis[o]=o.LocalTransparencyModifier end;o.LocalTransparencyModifier=1
  elseif o:IsA('Decal') then if vis[o]==nil then vis[o]=o.Transparency end;o.Transparency=1 end
 end
end
local function stopSpeed()if trackedHum and trackedHum.Parent and originalSpeed then trackedHum.WalkSpeed=originalSpeed end;trackedHum=nil;originalSpeed=nil end
local function applySpeed()
 if not S.Speed then return end
 local h=hum();if not h then return end
 if trackedHum~=h then trackedHum=h;originalSpeed=h.WalkSpeed end
 h.WalkSpeed=S.Walk
end
local function seatRoot()
 local h=hum();local seat=h and h.SeatPart
 if not seat or not seat:IsA('VehicleSeat') then return nil end
 local m=seat:FindFirstAncestorOfClass('Model');return (m and m.PrimaryPart) or seat
end

local dragWords = {"drag", "grab", "carry", "bring", "سحب", "حمل"}
local function attemptLocalDrag()
    if not dragTarget or dragTarget.Parent ~= Players then stopDrag(); return end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local char = localCharacter()
    local humanoid = localHumanoid()
    if not humanoid or not backpack then
        say("شخصيتك أو حقيبتك غير جاهزة", false)
        return
    end
    local tool = nil
    for _, holder in ipairs({backpack, char}) do
        if holder then
            for _, object in ipairs(holder:GetChildren()) do
                if object:IsA("Tool") and object:GetAttribute("NOVA_LocalCopy") ~= true then
                    local lower = object.Name:lower()
                    for _, word in ipairs(dragWords) do
                        if lower:find(word, 1, true) then tool = object; break end
                    end
                end
                if tool then break end
            end
        end
        if tool then break end
    end
    if tool then
        local ok = pcall(function() humanoid:EquipTool(tool) end)
        say(ok and ("تم تجهيز أداة «" .. tool.Name .. "». استخدمها بالطريقة المسموحة داخل الماب")
            or "تعذّر تجهيز أداة السحب", ok)
    else
        say("ما فيه أداة سحب أصلية متاحة بحقيبتك؛ السحب الفعلي يحتاج دعم الماب", false)
    end
    stopDrag()
end


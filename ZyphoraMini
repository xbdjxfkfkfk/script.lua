-- Never write another player's HumanoidRootPart.CFrame: it creates a local
-- illusion/vanishing character and cannot grant reliable server-side dragging.
local function hasNativeDragKeyword(value)
    local name = tostring(value or ""):lower()
    for _, word in ipairs({"drag", "grab", "carry", "سحب", "مسك", "حمل", "جرّ", "جر "}) do
        if name:find(word, 1, true) then return true end
    end
    return false
end
local function ownedNativeDragTool()
    for _, holder in ipairs({LocalPlayer:FindFirstChildOfClass("Backpack"), localCharacter()}) do
        if holder then
            for _, tool in ipairs(holder:GetChildren()) do
                if tool:IsA("Tool") and tool:GetAttribute("NOVA_LocalCopy") ~= true
                    and hasNativeDragKeyword(tool.Name) then
                    return tool
                end
            end
        end
    end
    return nil
end
local function nearbyNativeDragPrompt(player)
    local char = player and player.Character
    if not char then return nil end
    local inspected = 0
    for _, obj in ipairs(char:GetDescendants()) do
        inspected = inspected + 1
        if inspected > 160 then break end
        if obj:IsA("ProximityPrompt") and obj.Enabled
            and (hasNativeDragKeyword(obj.ActionText) or hasNativeDragKeyword(obj.Name)) then
            return obj
        end
    end
    return nil
end
local function prepareNativeDrag(player)
    if not player or player == LocalPlayer or player.Parent ~= Players then
        say("اختر لاعبًا من القائمة أولًا", false)
        return
    end
    local prompt = nearbyNativeDragPrompt(player)
    if prompt then
        say("السحب الرسمي متاح عبر تفاعل «" .. tostring(prompt.ActionText) .. "». اقترب من اللاعب واستخدم زر التفاعل المعتاد.", true)
        return
    end
    local tool = ownedNativeDragTool()
    if tool then
        local hum = localHumanoid()
        if not hum then say("شخصيتك غير جاهزة لتجهيز الأداة", false); return end
        local ok = pcall(function() hum:EquipTool(tool) end)
        if ok then
            say("جُهّزت أداة «" .. tool.Name .. "». استخدمها على اللاعب بالطريقة الأصلية للماب؛ السيرفر يحدد نجاح السحب.", true)
        else
            say("ما قدرت أجهز أداة السحب الموجودة بحقيبتك", false)
        end
    else
        say("ما فيه أداة أو تفاعل سحب رسمي متاح لك الآن. لن أحرّك اللاعب محليًا حتى لا يختفي عندك.", false)
    end
end


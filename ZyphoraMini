local function rarity(obj)
 local raw=info(obj,{'Rarity','Tier','rarity','tier','Grade','Quality','ندرة'})
 if raw==nil then return 'غير معروف',Color3.fromRGB(230,230,230),-1 end
 local s=tostring(raw):lower()
 local n=tonumber(s:match('t(%d+)'))
 local aliases={['common']=1,['عادي']=1,['uncommon']=2,['أخضر']=2,['rare']=3,['نادر']=3,['epic']=4,['بنفسجي']=4,['legendary']=5,['ذهبي']=5,['mythic']=6,['خرافي']=6,['divine']=7,['أحمر']=7}
 local rank=n or aliases[s] or -1
 -- T numbers are map-dependent: do not assert their exact rarity.
 local names={[1]='عادي',[2]='أخضر',[3]='أزرق',[4]='بنفسجي',[5]='ذهبي',[6]='خرافي',[7]='أحمر'}
 local cs={[1]=Color3.fromRGB(235,235,235),[2]=Color3.fromRGB(58,210,105),[3]=Color3.fromRGB(60,157,255),[4]=Color3.fromRGB(169,87,245),[5]=Color3.fromRGB(255,199,43),[6]=Color3.fromRGB(250,65,202),[7]=Color3.fromRGB(255,72,75)}
 if n then return 'T'..n..' (تصنيف الماب)',cs[n] or cs[1],rank end
 return names[rank] or tostring(raw),cs[rank] or cs[1],rank
end
local function isAnimal(m)
 if not m:IsA('Model') or Players:GetPlayerFromCharacter(m) then return false end
 local s=m.Name:lower()
 return s:find('dhab',1,true)~=nil or s:find('lizard',1,true)~=nil or s:find('reptile',1,true)~=nil or s:find('ضب',1,true)~=nil or s:find('animal',1,true)~=nil
end
local animals={};local vehicles={};local lastScan=0
local function scan()
 table.clear(animals);table.clear(vehicles)
 for _,o in ipairs(WS:GetDescendants()) do
  if o:IsA('Model') then
   if isAnimal(o) then local r=o.PrimaryPart or o:FindFirstChildWhichIsA('BasePart',true);if r then animals[#animals+1]={model=o,part=r} end end
   if o:FindFirstChildWhichIsA('VehicleSeat',true) then vehicles[#vehicles+1]=o end
  end
 end
 lastScan=os.clock()
end
local function closest(filter)
 local r=root();if not r then return nil end
 local best,dist=nil,math.huge
 for _,a in ipairs(animals) do
  if a.model.Parent and a.part.Parent then
   local ra,_,rank=rarity(a.model)
   local passes=state.Rarity=='الكل' or ra==state.Rarity or (state.Rarity=='نادر' and rank==3)
   local namePass=not filter or filter=='' or a.model.Name:lower():find(filter:lower(),1,true)
   local d=(a.part.Position-r.Position).Magnitude
   if passes and namePass and d<dist then best=a;dist=d end
  end
 end
 return best,dist
end

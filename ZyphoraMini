--====================================
local function UpdateCarSpeed()
    if carConnection then
        carConnection:Disconnect()
        carConnection = nil
    end
    
    if Config.CarSpeed then
        carConnection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            
            local hum = char:FindFirstChild("Humanoid")
            if not hum or not hum.SeatPart then return end
            
            local vehicle = hum.SeatPart:FindFirstAncestorOfClass("Model")
            if not vehicle then return end
            
            -- تسريع السيارة
            for _, v in pairs(vehicle:GetDescendants()) do
                if v:IsA("VehicleSeat") then
                    v.MaxSpeed = Config.CarSpeedValue
                    v.Torque = 100
                end
            end
        end)
    end
end


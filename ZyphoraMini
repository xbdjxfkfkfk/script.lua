        ClearTextOnFocus = false,
        MultiLine = false,
        TextEditable = true,
        Active = true,
        ZIndex = 4,
        TextColor3 = C.white,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        PlaceholderText = "اكتب الرقم",
        PlaceholderColor3 = C.muted
    }, f)
    round(value, 6)
    inst("UIStroke", {Color = C.purple, Thickness = 1.2, Transparency = 0.2}, value)
    
    local function commit(raw)
        local cleaned = tostring(raw):gsub("٫", "."):gsub("٬", ""):gsub("،", ".")
        local numerals = {"٠", "١", "٢", "٣", "٤", "٥", "٦", "٧", "٨", "٩"}
        for i, digit in ipairs(numerals) do cleaned = cleaned:gsub(digit, tostring(i - 1)) end
        cleaned = cleaned:gsub("^%s+", ""):gsub("%s+$", "")
        local n = tonumber(cleaned)
        if not n or n ~= n or n == math.huge or n == -math.huge then
            msg("أدخل رقمًا صحيحًا: " .. title)
        else
            S[key] = math.clamp(math.floor(n * 100 + 0.5) / 100, min, max)
        end
        value.Text = tostring(S[key])
    end
    
    conn(minus.MouseButton1Click, function() commit(S[key] - step) end)
    conn(plus.MouseButton1Click, function() commit(S[key] + step) end)
    conn(value.FocusLost, function() commit(value.Text) end)
    
    return f
end


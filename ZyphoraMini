-- حلقة الطيران + النوكليب + الثبات -- منفصلة عن أي زر
RunService.Heartbeat:Connect(function(dt)
	local c = getChar()
	if not c then return end
	local hrp, hum = c.HumanoidRootPart, c:FindFirstChildOfClass("Humanoid")

	if State.Fly then
		local bv = hrp:FindFirstChild("STRQ_FlyBV")
		local gy = hrp:FindFirstChild("STRQ_FlyGyro")
		if bv and gy then
			local cam = Camera.CFrame
			local move = Vector3.zero
			if UserInput:IsKeyDown(Enum.KeyCode.W)            then move += cam.LookVector end
			if UserInput:IsKeyDown(Enum.KeyCode.S)            then move -= cam.LookVector end
			if UserInput:IsKeyDown(Enum.KeyCode.A)            then move -= cam.RightVector end
			if UserInput:IsKeyDown(Enum.KeyCode.D)            then move += cam.RightVector end
			if UserInput:IsKeyDown(Enum.KeyCode.Space)        then move += Vector3.new(0, 1, 0) end
			if UserInput:IsKeyDown(Enum.KeyCode.LeftControl)  then move -= Vector3.new(0, 1, 0) end
			if move.Magnitude > 0.01 then
				bv.Velocity = move.Unit * State.FlySpeed
			else
				bv.Velocity = Vector3.zero
			end
			gy.CFrame = CFrame.new(hrp.Position, hrp.Position + cam.LookVector)
		end
	end

	if State.Noclip then
		for _, p in ipairs(c:GetDescendants()) do
			if p:IsA("BasePart") and p.CanCollide then
				p.CanCollide = false
			end
		end
	end

	if hum and not State.Fly and hum.WalkSpeed ~= State.Speed and State.Speed >= 16 then
		pcall(function() hum.WalkSpeed = State.Speed end)
	end
	pcall(function()
		if hum then
			hum.UseJumpPower = true
			hum.JumpPower = State.Jump
		end
	end)
end)

-- إعادة الأجزاء بعد الموت (طيران/سرعة، لا تسقط)

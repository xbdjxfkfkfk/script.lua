local function playerReady(p)
    connect(p.CharacterAdded,function(char)
        if p==me then
            task.delay(.5,function()
                if not alive or me.Character~=char then return end
                if localHidden then applyLocalHidden() end
                if fly then startFlight() end
                if not watchedId then restoreCamera() end
            end)
        else
            task.delay(.4,function()
                if alive and esp then decorate(p) end
                if alive and watchedId==p.UserId then
                    local hum=char:FindFirstChildOfClass("Humanoid")
                    if hum and workspace.CurrentCamera then workspace.CurrentCamera.CameraSubject=hum end
                end
            end)
        end
    end)
end
for _,p in ipairs(Players:GetPlayers()) do playerReady(p) end
connect(Players.PlayerAdded,playerReady)

local function cleanup()
    if not alive then return end
    alive=false
    fly=false
    stopFlight()
    esp=false
    decorateAll()
    localHidden=false
    applyLocalHidden()
    bright=false
    applyLight()
    restoreCamera()
    for _,c in ipairs(cons) do pcall(function() c:Disconnect() end) end
    if gui.Parent then gui:Destroy() end
end
_G.NOVA_V8_STOP=cleanup

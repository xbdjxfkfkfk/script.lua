local minimized = false

connect(MinBtn.MouseButton1Click, function()
    minimized = not minimized

    TabBar.Visible = not minimized
    PageContainer.Visible = not minimized
    Footer.Visible = not minimized

    Main.Size = minimized
        and UDim2.fromOffset(510, 47)
        or UDim2.fromOffset(510, 450)

    MinBtn.Text = minimized and "+" or "−"
end)

local function cleanup()
    if not alive then return end
    alive = false

    S.CarFly = false
    S.CarSpeed = false
    S.LizardAim = false
    S.LizardScan = false

    clearESP()
    clearLizardRadar()
    restoreVisibility()
    disableSpeed()

    for _, con in ipairs(connections) do
        con:Disconnect()
    end

    table.clear(connections)

    if GLOBAL.ZyphoraCleanup == cleanup then
        GLOBAL.ZyphoraCleanup = nil
    end

    if GUI.Parent then
        GUI:Destroy()
    end
end

GLOBAL.ZyphoraCleanup = cleanup

connect(CloseBtn.MouseButton1Click, cleanup)
connect(GUI.Destroying, cleanup)

connect(LP.CharacterAdded, function()
    restoreVisibility()
    trackedHumanoid = nil
    originalWalkSpeed = nil
end)


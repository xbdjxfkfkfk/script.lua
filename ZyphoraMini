local function slider(title, key, min, max, default)
    local f = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 55),
        BackgroundColor3 = Color3.fromRGB(25, 20, 40),
        BorderSizePixel = 0
    }, content)
    round(f, 12)
    
    inst("TextLabel", {
        Size = UDim2.new(0.6, 0, 0, 20),
        Position = UDim2.fromOffset(14, 6),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Color3.new(1,1,1),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left
    }, f)
    
    local val = inst("TextLabel", {
        Size = UDim2.new(0.3, 0, 0, 20),
        Position = UDim2.new(0.7, -10, 0, 6),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = Color3.fromRGB(200, 150, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right
    }, f)
    
    local bg = inst("Frame", {
        Size = UDim2.new(1, -28, 0, 6),
        Position = UDim2.fromOffset(14, 36),
        BackgroundColor3 = Color3.fromRGB(40, 35, 55),
        BorderSizePixel = 0
    }, f)
    round(bg, 3)
    
    local fill = inst("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(180, 100, 255),
        BorderSizePixel = 0
    }, bg)
    round(fill, 3)
    
    local handle = inst("Frame", {
        Size = UDim2.fromOffset(18, 18),
        Position = UDim2.new((default - min) / (max - min), -9, 0.5, -9),
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0
    }, bg)
    round(handle, 9)
    
    -- توهج المقبض
    local handleGlow = inst("ImageLabel", {
        Size = UDim2.new(1, 8, 1, 8),
        Position = UDim2.new(0, -4, 0, -4),
        BackgroundTransparency = 1,
        Image = "rbxassetid://5028857084",
        ImageColor3 = Color3.fromRGB(180, 100, 255),
        ImageTransparency = 0.6,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(24, 24, 276, 276)
    }, handle)
    
    S[key] = default
    local dragging = false
    
    local function update(input)
        local rel = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * rel)
        S[key] = v
        val.Text = tostring(v)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        handle.Position = UDim2.new(rel, -9, 0.5, -9)
    end
    
    conn(handle.InputBegan, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end end)
    conn(bg.InputBegan, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true update(input) end end)
    conn(UIS.InputEnded, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
    conn(UIS.InputChanged, function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end end)
end


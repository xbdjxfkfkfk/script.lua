local function basePart(model)
    if not model then return nil end
    if model:IsA("BasePart") then return model end
    if model:IsA("Model") then return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true) end
    return nil
end
local function safeNumber(number)
    return type(number) == "number" and number == number and number > -math.huge and number < math.huge
end
local function convertNumber(raw)
    local result = tostring(raw):gsub("٫", "."):gsub("٬", ""):gsub("،", ".")
    local numerals = {"٠", "١", "٢", "٣", "٤", "٥", "٦", "٧", "٨", "٩"}
    local persian = {"۰", "۱", "۲", "۳", "۴", "۵", "۶", "۷", "۸", "۹"}
    for i = 1, 10 do
        result = result:gsub(numerals[i], tostring(i - 1))
        result = result:gsub(persian[i], tostring(i - 1))
    end
    local value = tonumber(result)
    if not safeNumber(value) then return nil end
    return value
end
local function invoke(action, payload)
    if not remoteFunction then return false, "لا يوجد سكربت سيرفر Lx في ReplicatedStorage" end
    local ok, success, result = pcall(function()
        return remoteFunction:InvokeServer(action, payload)
    end)
    if not ok then return false, "خطأ الاتصال بالسيرفر: " .. tostring(success) end
    return success == true, result
end


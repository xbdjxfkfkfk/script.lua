local function btn(title, icon, key, color)
    local b = inst("TextButton", {Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = Color3.fromRGB(20, 20, 28), BorderSizePixel = 0, Text = ""}, content)
    round(b, 8)
    

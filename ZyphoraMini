local function connect(signal, fn)
    local c = signal:Connect(fn)
    connections[#connections + 1] = c
    return c
end
local function element(class, props, parent)
    local item = Instance.new(class)
    for k, v in pairs(props or {}) do item[k] = v end
    item.Parent = parent
    return item
end
local function corner(object, px)
    element('UICorner', {CornerRadius=UDim.new(0, px or 9)}, object)
end
local BG = Color3.fromRGB(13, 13, 16)
local CARD = Color3.fromRGB(34, 34, 40)
local RED = Color3.fromRGB(213, 35, 48)
local WHITE = Color3.fromRGB(250, 250, 250)
local MUTED = Color3.fromRGB(194, 196, 202)
local function say(message)
    if alive and statusLabel and statusLabel.Parent then
        statusLabel.Text = tostring(message)
    end
end
local function root()
    local character = player.Character
    return character and character:FindFirstChild('HumanoidRootPart')
end
local function humanoid()
    local character = player.Character
    return character and character:FindFirstChildOfClass('Humanoid')
end
local function positionOf(object)
    if not object or not object.Parent then return nil end
    if object:IsA('BasePart') then return object.Position end
    if object:IsA('Model') then
        -- Empty organizational models have pivots too; do not invent a physical destination.
        if not object:FindFirstChildWhichIsA('BasePart', true) then return nil end
        local ok, pivot = pcall(function() return object:GetPivot() end)
        if ok then return pivot.Position end
    end
    return nil
end
local function partOf(object)
    if not object then return nil end
    if object:IsA('BasePart') then return object end
    if object:IsA('Model') then
        return object.PrimaryPart or object:FindFirstChildWhichIsA('BasePart', true)
    end
    return nil
end
local function matches(name, terms)
    local lower = string.lower(name)
    for _, term in ipairs(terms) do
        if string.find(lower, string.lower(term), 1, true) then return true end
    end
    return false
end
local function insidePlayer(object)
    local ancestor = object
    while ancestor and ancestor ~= Workspace do
        if ancestor:IsA('Model') and Players:GetPlayerFromCharacter(ancestor) then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end
local function topNamedObject(object, terms)
    -- Do not report every wheel/part of the same named object separately.
    local current = object.Parent
    while current and current ~= Workspace do
        if (current:IsA('Model') or current:IsA('BasePart'))
            and matches(current.Name, terms) then
            return false
        end
        current = current.Parent
    end
    return true
end

local DESTINATIONS = {
    {name='تاجر الخلا', terms={'تاجر الخلا', 'merchant', 'trader', 'dealer'}},
    {name='الديرة / البيع', terms={'ديرة', 'نقطة البيع', 'sellpoint', 'sell zone', 'buyer'}},
    {name='الفيروز', terms={'فيروز', 'turquoise'}},
    {name='القولد / الذهب', terms={'قولد', 'gold', 'ذهب'}},
    {name='الألماسي', terms={'ألماسي', 'الماسي', 'diamond'}},
    {name='العالم الثاني', terms={'العالم الثاني', 'second world', 'world2', 'world 2'}},
    {name='الضبان', terms={'ضب', 'ضبان', 'lizard', 'dhab', 'dhub', 'uromastyx'}},
}
local RESOURCE_TERMS = {'فيروز', 'turquoise', 'gold', 'ذهب', 'قولد', 'diamond', 'الماس', 'ألماس', 'الياقوت', 'ruby', 'تبر', 'gem'}
local ANIMAL_TERMS = DESTINATIONS[7].terms

local function animalCandidate(object)
    if not object:IsA('Model') or insidePlayer(object) then return false end
    local declared = CollectionService:HasTag(object, 'Lizard')
        or CollectionService:HasTag(object, 'Dhab')
        or CollectionService:HasTag(object, 'ضب')
    local species = tostring(object:GetAttribute('Species') or object:GetAttribute('AnimalType') or '')
    if not (declared or matches(species, ANIMAL_TERMS) or matches(object.Name, ANIMAL_TERMS)) then return false end
    if not partOf(object) then return false end
    if object:FindFirstChildWhichIsA('VehicleSeat', true) then return false end
    local parent = object.Parent
    while parent and parent ~= Workspace do
        if parent:IsA('Model') and parent:FindFirstChildWhichIsA('VehicleSeat', true) then
            return false
        end
        parent = parent.Parent
    end
    local health = object:FindFirstChildOfClass('Humanoid')
    if health and health.Health <= 0 then return false end
    return true
end
local function getRarity(object)
    for _, attr in ipairs({'Rarity', 'Tier', 'Grade', 'RarityName', 'ندرة'}) do
        local v = object:GetAttribute(attr)
        if v ~= nil then return tostring(v) end
        local child = object:FindFirstChild(attr, true)
        if child and child:IsA('ValueBase') then return tostring(child.Value) end
    end
    return 'غير محدد'
end

local function destroyMarkers()
    for _, marker in pairs(activeMarkers) do
        pcall(function() marker:Destroy() end)
    end
    table.clear(activeMarkers)
end
local function stop()
    if not alive then return end
    alive = false
    pendingToken += 1
    searchToken += 1
    destroyMarkers()
    if lightSnapshot then
        for key, value in pairs(lightSnapshot.properties) do
            pcall(function() Lighting[key] = value end)
        end
        for atmosphere, values in pairs(lightSnapshot.atmospheres) do
            if atmosphere.Parent then
                for key, value in pairs(values) do
                    pcall(function() atmosphere[key] = value end)
                end
            end
        end
    end
    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end
    if gui.Parent then gui:Destroy() end
    if _G.LxRedlineV80Cleanup == stop then _G.LxRedlineV80Cleanup = nil end
end
_G.LxRedlineV80Cleanup = stop


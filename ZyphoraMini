local function nameMatches(obj,words)
 local n=string.lower(obj.Name)
 for _,w in ipairs(words) do if string.find(n,w,1,true) then return true end end
 return false
end
resourcePart=function(obj)
 if obj:IsA('BasePart') then return obj end
 if obj:IsA('Model') then return part(obj) end
 return nil
end
validResource=function(obj)
 if not (obj:IsA('Model') or obj:IsA('BasePart')) or not obj:IsDescendantOf(WS) then return false end
 if playerAncestor(obj) or blockedAncestor(obj) or lizard(obj) then return false end
 if not nameMatches(obj,resourceWords) then return false end
 -- Prefer a single model over every individual part inside it.
 local par=obj.Parent
 while par and par~=WS do
  if (par:IsA('Model') or par:IsA('BasePart')) and nameMatches(par,resourceWords) then return false end
  par=par.Parent
 end
 return resourcePart(obj)~=nil
end
nearestNamed=function(words)
 local r=root();if not r then return nil,nil end
 local best,d=nil,math.huge
 for _,obj in ipairs(WS:GetDescendants()) do
  if (obj:IsA('Model') or obj:IsA('BasePart')) and nameMatches(obj,words) and not playerAncestor(obj) and not blockedAncestor(obj) then
   local p=resourcePart(obj)
   if p and (p.Position-r.Position).Magnitude<d then best=p;d=(p.Position-r.Position).Magnitude end
  end
 end
 return best,d
end

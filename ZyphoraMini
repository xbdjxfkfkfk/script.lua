do
    local page = tabs["الكاميرا"].page
    sectionLabel(page, "🎥 الكاميرا")

    makeSlider(page, "📏 بعد الكاميرا (زوم)", 14, 500, 60, function(v)
        LocalPlayer.CameraMaxZoomDistance = v
        LocalPlayer.CameraMinZoomDistance = 10
    end)

    -- زوم قوي: يشوف الخريطة كلها
    makeButton(page, "🗺️ زوم الخريطة كاملة (شوف الكل)", Color3.fromRGB(90, 50, 180), function()
        LocalPlayer.CameraMaxZoomDistance = 2000
        LocalPlayer.CameraMinZoomDistance = 10
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
    end)

    -- كاميرا إضافية: كاميرا حر (FreeCam) تشوف اللعيبة من بعيد
    local freecamBtn
    freecamBtn = makeToggle(page, "🛸 كاميرا حر (FreeCam — تشوف اللعبين من بعيد)", function(on)
        State.FreeCam = on
        if on then
            Camera.CameraType = Enum.CameraType.Scriptable
        else
            Camera.CameraType = Enum.CameraType.Custom
            local c = getChar()
            if c then Camera.CameraSubject = c:FindFirstChildOfClass("Humanoid") end
        end
    end)

    -- حلقة التحكم بالكاميرا الحر
    RunService.RenderStepped:Connect(function(dt)
        if State.FreeCam then
            local cam = Camera
            local move = Vector3.zero
            local look = cam.CFrame.LookVector
            local right = cam.CFrame.RightVector
            local spd = 40 + (UserInput:IsKeyDown(Enum.KeyCode.LeftShift) and 90 or 0)
            if UserInput:IsKeyDown(Enum.KeyCode.W) then move = move + look end
            if UserInput:IsKeyDown(Enum.KeyCode.S) then move = move - look end
            if UserInput:IsKeyDown(Enum.KeyCode.A) then move = move - right end
            if UserInput:IsKeyDown(Enum.KeyCode.D) then move = move + right end
            if UserInput:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0,1,0) end
            if UserInput:IsKeyDown(Enum.KeyCode.E) then move = move - Vector3.new(0,1,0) end
            cam.CFrame = cam.CFrame + move * spd * dt
        end
    end)

    -- ESP تشغيل/تطفي
    makeToggle(page, "🔍 ESP — تشوف أسماء اللعبين من بعيد", function(on)
        State.ESP = on
    end)

    --══════════════ الاختياي / برجع النامة ══════════════--
    local invisCache = {}
    makeToggle(page, "🫥 اختفاء (محد يشوفني) + الرجوع", function(on)
        State.Invis = on
        local c = getChar()
        if not c then return end
        if on then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") or p:IsA("Decal") then
                    invisCache[p] = p.Transparency
                    pcall(function() p.Transparency = 1 end)
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
                if p:IsA("ParticleEmitter") or p:IsA("Trail") or p:IsA("Beam") then
                    p.Enabled = false
                end
            end
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then
                h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                h.NameDisplayDistance = 0
            end
        else
            for p, t in pairs(invisCache) do
                if p and p.Parent then
                    pcall(function() p.Transparency = t end)
                    if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.CanCollide = true end
                end
            end
            invisCache = {}
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then
                h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
            end
        end
    end)

    -- لو الاختياي شغال، الجزء الجديد يظل شفاف
    RunService.Heartbeat:Connect(function()
        if State.Invis then
            local c = getChar()
            if c then
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") and p.Transparency < 1 then
                        pcall(function() p.Transparency = 1 end)
                    end
                end
            end
        end
    end)

    --══════════════ تكبير القامة ══════════════--
    makeButton(page, "📏 كبر/صغر قامتي (حجم شخصيتي)", Color3.fromRGB(80, 60, 160), function()
        local c = getChar()
        if not c then return end
        local hum = c:FindFirstChildOfClass("Humanoid")
        if hum then
            local cur = hum.BodyHeightScale.Value
            local next = cur >= 4 and 1 or cur + 1
            hum.BodyHeightScale.Value = next
            hum.BodyWidthScale.Value = next
            hum.BodyDepthScale.Value = next
            hum.HeadScale.Value = next
        end
    end)
end


    Radar._GuiList = nil

    function Radar:Init()
        -- Build a small scroll list inside UI.Content
        local listFrame = inst("ScrollingFrame",{
            Size = UDim2.new(0.45, -20, 1, -20),
            Position = UDim2.new(0.55,10,0,10),

local function bindMove(b, name)
    local function set(v)
        if name=="fwd" then flyForward=v
        elseif name=="back" then flyBack=v
        elseif name=="left" then flyLeft=v
        else flyRight=v end
    end
    track(b.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
            set(true)
            i.Changed:Connect(function()
                if i.UserInputState==Enum.UserInputState.End then set(false) end
            end)
        end
    end))
    track(b.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then set(false) end
    end))
end

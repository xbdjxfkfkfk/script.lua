local function ClearESP()
    for _, obj in pairs(espObjects) do
        if obj then obj:Destroy() end
    end
    espObjects = {}
end

local function CreateLizardESP(model)
    local lizardType, color = GetLizardType(model)
    
    -- التحقق من الإعدادات
    if not ShouldShow(lizardType) then return end
    
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
    if not root then return end
    
    -- Highlight
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_" .. model.Name
    highlight.FillColor = color
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0.2
    highlight.Adornee = model
    highlight.Parent = ScreenGui
    
    table.insert(espObjects, highlight)
    
    -- Billboard
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "Billboard_" .. model.Name
    billboard.Size = UDim2.new(0, 100, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.Adornee = root
    billboard.AlwaysOnTop = true
    billboard.Parent = ScreenGui
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.6, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = model.Name
    nameLabel.TextColor3 = color
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 11
    nameLabel.TextStrokeTransparency = 0.3
    nameLabel.Parent = billboard
    
    local typeLabel = Instance.new("TextLabel")
    typeLabel.Size = UDim2.new(1, 0, 0.4, 0)
    typeLabel.Position = UDim2.new(0, 0, 0.6, 0)
    typeLabel.BackgroundTransparency = 1
    typeLabel.Text = "[" .. lizardType .. "]"
    typeLabel.TextColor3 = Color3.new(1, 1, 1)
    typeLabel.Font = Enum.Font.Gotham
    typeLabel.TextSize = 9
    typeLabel.TextStrokeTransparency = 0.3
    typeLabel.Parent = billboard
    
    table.insert(espObjects, billboard)
    
    -- إشعار للضبان النادرة
    if Config.RareNotify and (lizardType == "Legendary" or lizardType == "Fancy") then
        if not notifiedRares[model] then
            notifiedRares[model] = true
            Notify("🚨 ضبان " .. lizardType .. " ظهر: " .. model.Name, color)
        end
    end
end

local function UpdateESP()
    ClearESP()
    if not Config.ESP then return end
    
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") then
            local name = v.Name:lower()
            if name:find("lizard") or name:find("ضبان") or name:find("snake") then
                CreateLizardESP(v)
            end
        end
    end
end


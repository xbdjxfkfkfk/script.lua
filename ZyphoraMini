    function Discord:Verify()
        if not HttpService.HttpEnabled then
            warn("[Discord] HTTP disabled – cannot verify")
            return
        end
        spawn(function()
            local success, resp = pcall(function()
                return HttpService:RequestAsync({
                    Url = Discord._Endpoint,
                    Method = "GET",
                    Headers = {
                        ["User-Agent"] = "Lx_REDLINE/1.0",
                    },
                })
            end)

-- Player ESP
local function clearESP()
    for _, con in ipairs(espConnections) do
        con:Disconnect()
    end
    table.clear(espConnections)

    for _, obj in pairs(espObjects) do
        if obj then obj:Destroy() end
    end
    table.clear(espObjects)
end

local function watchPlayer(player)
    if player == LP then return end

    local function attach(char)
        if not alive or not S.ESP or not char then
            return
        end

        if espObjects[player] then
            espObjects[player]:Destroy()
        end

        local h = make("Highlight", {
            Name = "ZyphoraPlayerESP",
            Adornee = char,
            FillColor = C.accent,
            FillTransparency = 0.7,
            OutlineColor = C.text,
            OutlineTransparency = 0,
            DepthMode =
                Enum.HighlightDepthMode.AlwaysOnTop
        }, GUI)

        espObjects[player] = h
    end

    attach(player.Character)

    bind(player.CharacterAdded, attach, espConnections)
end

local function setESP(enabled)
    clearESP()
    S.ESP = enabled

    if enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            watchPlayer(player)
        end

        bind(Players.PlayerAdded, watchPlayer, espConnections)

        bind(Players.PlayerRemoving, function(player)
            if espObjects[player] then
                espObjects[player]:Destroy()
                espObjects[player] = nil
            end
        end, espConnections)
    end
end

-- Speed
local function setSpeed(enabled)
    S.Speed = enabled

    local hum = getHumanoid()
    if not hum then return end

    if enabled then
        if activeHumanoid ~= hum then
            activeHumanoid = hum
            originalSpeed = hum.WalkSpeed
        end

        hum.WalkSpeed = 16 * S.Multiplier
    else
        if activeHumanoid == hum and originalSpeed then
            hum.WalkSpeed = originalSpeed
        end

        activeHumanoid = nil
        originalSpeed = nil
    end
end

-- Local invisibility
local function restoreVisibility()
    for obj, value in pairs(transparencyCache) do
        if obj and obj.Parent then
            if obj:IsA("BasePart") then
                obj.LocalTransparencyModifier = value
            elseif obj:IsA("Decal") then
                obj.Transparency = value
            end
        end
    end

    table.clear(transparencyCache)
end

local function applyInvisibility()
    local char = getCharacter()
    if not char then return end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            if transparencyCache[obj] == nil then
                transparencyCache[obj] =
                    obj.LocalTransparencyModifier
            end

            obj.LocalTransparencyModifier = 1

        elseif obj:IsA("Decal") then
            if transparencyCache[obj] == nil then
                transparencyCache[obj] = obj.Transparency
            end

            obj.Transparency = 1
        end
    end
end

local function setInvisible(enabled)
    restoreVisibility()
    S.Invis = enabled

    if enabled then
        applyInvisibility()
    end
end

-- Wildlife radar
local wildlifeKeywords = {
    "lizard",
    "dhab",
    "reptile",
    "lhib",
    "ضب"
}

local function isWildlife(obj)
    if not obj:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(obj) then
        return false
    end

    local lower = string.lower(obj.Name)

    for _, keyword in ipairs(wildlifeKeywords) do
        if string.find(lower, keyword, 1, true) then
            return true
        end
    end

    return false
end

local function clearWildlife()
    for _, gui in pairs(wildlifeObjects) do
        if gui then gui:Destroy() end
    end

    table.clear(wildlifeObjects)
    table.clear(wildlifeQueue)
    table.clear(wildlifeQueued)
    table.clear(wildlifeSnapshot)
    wildlifeScanIndex = 1
end

local function queueWildlife(obj)
    if not obj or wildlifeQueued[obj] then return end
    wildlifeQueued[obj] = true
    table.insert(wildlifeQueue, obj)
end

local function addWildlife(obj)
    if not S.LizardScan or not isWildlife(obj) then
        return
    end

    if wildlifeObjects[obj] then return end

    local part = obj.PrimaryPart
        or obj:FindFirstChildWhichIsA("BasePart", true)

    if not part then return end

    local bb = make("BillboardGui", {
        Name = "ZyphoraWildlifeV17",
        Adornee = part,
        Size = UDim2.fromOffset(235, 55),
        StudsOffsetWorldSpace = Vector3.new(0, 4, 0),
        AlwaysOnTop = true,
        MaxDistance = 300
    }, GUI)

    local frame = make("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = C.bg,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0
    }, bb)
    corner(frame, 8)

    make("UIStroke", {
        Color = C.green,
        Thickness = 1
    }, frame)

    make("TextLabel", {
        Size = UDim2.new(1, -12, 1, 0),
        Position = UDim2.fromOffset(6, 0),
        BackgroundTransparency = 1,
        Text = "🦎 " .. obj.Name,
        TextColor3 = C.green,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, frame)

    wildlifeObjects[obj] = bb
end

local function setWildlife(enabled)
    S.LizardScan = enabled
    clearWildlife()

    if enabled then
        wildlifeSnapshot = Workspace:GetDescendants()
        wildlifeScanIndex = 1
    end
end

-- Vehicles
local function findVehicle(obj)
    if not obj:IsA("Model") then return false end

    return obj:FindFirstChildWhichIsA(
        "VehicleSeat", true
    ) ~= nil
end

local function seatedVehicleRoot()
    local hum = getHumanoid()
    local seat = hum and hum.SeatPart

    if not seat or not seat:IsA("VehicleSeat") then
        return nil
    end

    local model = seat:FindFirstAncestorOfClass("Model")
    if not model then return nil end

    return model.PrimaryPart or seat
end


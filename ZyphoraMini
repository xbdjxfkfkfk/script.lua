local timer = 0
local flyTimer = 0
local charFlyTimer = 0
local speedTimer = 0
local carSpeedTimer = 0

conn(RunService.Heartbeat, function(dt)
    if not alive then return end
    
    timer += dt
    flyTimer += dt
    charFlyTimer += dt
    speedTimer += dt
    carSpeedTimer += dt
    
    -- Walk Speed
    if S.Speed and speedTimer >= 0.25 then
        speedTimer = 0
        local h = hum()
        if h then
            if speedHum ~= h then
                speedHum = h
                originalSpeed = h.WalkSpeed
            end
            if math.abs(h.WalkSpeed - S.Walk) > 0.1 then
                h.WalkSpeed = S.Walk
            end
        end
    end
    
    -- Car Speed
    if S.CarSpeed and carSpeedTimer >= 0.1 then
        carSpeedTimer = 0
        pcall(updateCarSpeed)
    end
    
    -- Car Fly
    if S.CarFly and flyTimer >= 1/30 then
        flyTimer = 0
        pcall(updateCarFly)
    end
    
    -- Player Fly
    if S.PlayerFly and charFlyTimer >= 1/30 then
        charFlyTimer = 0
        pcall(charFly.update)
    end
    
    -- Noclip
    updateNoclip()
    
    -- Visuals
    updateVisuals()
    
    -- Radar
    if timer >= 1.5 then
        timer = 0
        
        if S.Radar or S.Aim then
            pcall(refreshCache)
        end
        
        if S.Radar then
            local r = root()
            
            -- Update markers
            for m, bb in pairs(markers) do
                if not m.Parent or not living(m) or not lizard(m) then
                    bb:Destroy()
                    markers[m] = nil
                else
                    local p = part(m)
                    local d = r and p and math.floor((p.Position - r.Position).Magnitude) or 0
                    if d > S.RadarRange then
                        bb:Destroy()
                        markers[m] = nil
                    else
                        local infoLabel = bb:FindFirstChildOfClass("TextLabel", true)
                        if infoLabel then
                            infoLabel.Text = "⚖️ " .. animalWeight(m) .. "  |  📏 " .. d .. "m"
                        end
                    end
                end
            end
            
            -- Create new markers
            local shown = 0
            for _, e in ipairs(cache) do
                if shown >= 10 then break end
                if not markers[e.model] and living(e.model) and lizard(e.model) then
                    local d = r and (e.part.Position - r.Position).Magnitude or 0
                    if d <= S.RadarRange and (S.Filter == "الكل" or rarity(e.model) == S.Filter) then
                        makeMarker(e)
                        shown += 1
                    end
                end
            end
        else
            clearMarkers()
        end
    end
end)


local function initializeFeatures()
 local function read(model,names)
  for _,n in ipairs(names) do local v=model:GetAttribute(n);if v~=nil then return v end;local child=model:FindFirstChild(n,true);if child and child:IsA('ValueBase') then return child.Value end end
 end

 local vehicleNames={'car','truck','vehicle','pickup','trailer','chassis','wheel','tire','seat','سيار','مركب','شاص','كفر','عجل','قلص','مقطور'}
 local animalNames={'dhab','dhub','lizard','reptile','ضب','ضبان','dhabb','uromastyx','spinytailed','spiny-tailed'}
 local function matchesAny(value,words)
  local name=tostring(value):lower()
  for _,word in ipairs(words) do if name:find(word,1,true) then return true end end
  return false
 end

 local function playerAncestor(obj)
  local cursor=obj
  while cursor and cursor~=WS do
   if cursor:IsA('Model') and Players:GetPlayerFromCharacter(cursor) then return true end
   cursor=cursor.Parent
  end
  return false
 end

 local seatCache=setmetatable({}, {__mode='k'})
 local function hasDrivingSeat(container)
  local known=seatCache[container]
  if known~=nil then return known end
  local vehicleLike=matchesAny(container.Name,vehicleNames)
   or container:FindFirstChild('Chassis')~=nil
   or container:FindFirstChild('Wheels')~=nil
   or container:FindFirstChild('VehicleSeat')~=nil
   or container:FindFirstChild('DriveSeat')~=nil
  local found=false
  if vehicleLike then
   found=container:FindFirstChildWhichIsA('VehicleSeat',true)~=nil
    or container:FindFirstChildWhichIsA('Seat',true)~=nil
  end
  seatCache[container]=found
  return found
 end

 local function blockedAncestor(obj)
  local cursor=obj
  while cursor and cursor~=WS do
   if cursor:IsA('VehicleSeat') or cursor:IsA('Seat') then return true end
   if cursor:IsA('Model') then
    if Players:GetPlayerFromCharacter(cursor) then return true end
    if matchesAny(cursor.Name,vehicleNames) or hasDrivingSeat(cursor) then return true end
   end
   cursor=cursor.Parent
  end
  return false
 end

 local function lizard(model)
  if not model or not model:IsA('Model') or not model.Parent then return false end
  if blockedAncestor(model) then return false end
  local ownParts=0
  local ownRoot=nil
  for _,child in ipairs(model:GetChildren()) do
   if child:IsA('BasePart') then ownParts+=1;ownRoot=ownRoot or child end
  end
  local tagged=CollectionService:HasTag(model,'Lizard') or CollectionService:HasTag(model,'Dhab')
   or CollectionService:HasTag(model,'ضب') or CollectionService:HasTag(model,'Lizards')
   or CollectionService:HasTag(model,'AnimalLizard')
  local species=read(model,{'Species','AnimalType','CreatureType','PetType','MobType','نوع'})
  local typed=species~=nil and matchesAny(species,animalNames)
  local named=matchesAny(model.Name,animalNames)
  if not (tagged or typed or named) then return false end
  local physical=ownParts>0 or model.PrimaryPart~=nil
  if not physical and not (tagged or typed) then return false end
  if model:FindFirstChildWhichIsA('VehicleSeat',true) or model:FindFirstChildWhichIsA('Seat',true) then return false end
  local cursor=model.Parent
  while cursor and cursor~=WS do
   if cursor:IsA('Model') and (CollectionService:HasTag(cursor,'Lizard')
    or CollectionService:HasTag(cursor,'Dhab') or CollectionService:HasTag(cursor,'ضب')) then return false end
   cursor=cursor.Parent
  end
  if tagged or typed then return model:FindFirstChildWhichIsA('BasePart',true)~=nil end
  local ok,_,size=pcall(function()return model:GetBoundingBox()end)
  if not ok or not size then return false end
  if math.max(size.X,size.Y,size.Z)>18 then return false end
  return ownParts>0 or model.PrimaryPart~=nil
 end

 local function part(model) return model.PrimaryPart or model:FindFirstChildWhichIsA('BasePart',true) end
 local function living(model)
  local h=model:FindFirstChildOfClass('Humanoid')
  if h and h.Health<=0 then return false end
  local dead=read(model,{'Dead','IsDead','Killed','Defeated','Collected'})
  if dead==true or dead==1 or dead=='true' then return false end
  local health=read(model,{'Health','HP','CurrentHealth'})
  if tonumber(health) and tonumber(health)<=0 then return false end
  return model.Parent~=nil
 end

 local rarities={['t1']='عادي',['t2']='مميز',['t3']='نادر',['t4']='فاخر',['t5']='أسطوري',['t6']='خرافي',common='عادي',uncommon='مميز',rare='نادر',epic='فاخر',legendary='أسطوري',mythic='خرافي'}
 local rarityColors={['عادي']=Color3.fromRGB(230,230,230),['مميز']=Color3.fromRGB(65,220,110),['نادر']=Color3.fromRGB(75,155,255),['فاخر']=Color3.fromRGB(170,90,240),['أسطوري']=Color3.fromRGB(255,192,60),['خرافي']=Color3.fromRGB(245,65,80)}
 local function rarity(m)
  local raw=tostring(read(m,{'Rarity','Tier','Grade','Rank','RarityName','ندرة'}) or ''):lower():gsub('^%s+',''):gsub('%s+$','')
  return rarities[raw] or (rarityColors[raw] and raw) or 'غير محدد'
 end

 local function speciesName(model)
  local raw=read(model,{'Species','AnimalType','CreatureType','PetType','MobType','نوع'})
  if raw~=nil and tostring(raw)~='' then return tostring(raw) end
  return model.Name
 end

 local function animalSize(model)
  local v=read(model,{'Size','Scale','SizeValue','AnimalSize','DhabSize','CreatureSize','SizeStat','الحجم','حجم'})
  if v==nil then return 'غير متاح' end
  local n=tonumber(v)
  if n then
   if n~=n or n==math.huge or n==-math.huge then return 'غير متاح' end
   return string.format('%.2f',n):gsub('%.?0+$','')
  end
  if typeof(v)=='Vector3' then return string.format('%.1f × %.1f × %.1f',v.X,v.Y,v.Z) end
  return tostring(v)
 end

 local function animalWeight(model)
  local names={'Weight','WeightKG','WeightKg','Weight_kg','WeightInKg','AnimalWeight',
   'CreatureWeight','DhabWeight','LizardWeight','BodyWeight','KG','Kg','kg',
   'الوزن','وزن','الوزن_كجم','الوزن_بالكيلو'}
  local v=read(model,names)
  if v==nil then
   for _,folderName in ipairs({'Stats','Statistics','Data','Metadata','Attributes','Info','Properties','معلومات','بيانات'}) do
    local folder=model:FindFirstChild(folderName,true)
    if folder then
     v=read(folder,names)
     if v~=nil then break end
    end
   end
  end
  if v==nil then return 'غير متاح' end
  local n=tonumber(v)
  if n then
   if n~=n or n==math.huge or n==-math.huge or n<0 then return 'غير متاح' end
   return (string.format('%.2f',n):gsub('%.?0+$',''))..' كجم'
  end
  if typeof(v)=='string' and #v>0 then return v end
  return 'غير متاح'
 end

 local indexed=setmetatable({}, {__mode='k'})
 local scanQueue={}
 local lastQueueCompact=0
 local queued=setmetatable({}, {__mode='k'})
 local scanCursor=1

 local function enqueueAnimal(m)
  if m and m:IsA('Model') and not queued[m] then queued[m]=true;scanQueue[#scanQueue+1]=m end
 end

 local cache={}
 local function trackAnimal(m)
  if m:IsA('Model') and lizard(m) and living(m) then indexed[m]=true end
 end

 task.spawn(function()
  local pending={WS};local index=1
  while alive and index<=#pending do
   local obj=pending[index];index+=1
   if obj:IsA('Model') then
    enqueueAnimal(obj)
    local ok,why=pcall(trackAnimal,obj)
    if not ok then warn('[Lx lizard indexing]',tostring(why):sub(1,100)) end
   end
   local children=obj:GetChildren()
   for _,child in ipairs(children) do pending[#pending+1]=child end
   if index%35==0 then task.wait(0.04) end
  end
 end)

 conn(WS.DescendantAdded,function(obj)
  if obj:IsA('Model') then enqueueAnimal(obj);task.defer(function() if alive and obj.Parent then trackAnimal(obj) end end) elseif obj:IsA('BasePart') or obj:IsA('ValueBase') then local parentModel=obj:FindFirstAncestorOfClass('Model');if parentModel then enqueueAnimal(parentModel);task.defer(function()if alive and parentModel.Parent then trackAnimal(parentModel) end end)end end
 end)


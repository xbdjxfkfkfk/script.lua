local function createTab(name, index)
    local tBtn = Instance.new("TextButton")
    tBtn.Size = UDim2.new(0, 120, 1, 0)
    tBtn.BackgroundColor3 = index == 1 and C.accent or C.panel
    tBtn.Text = name
    tBtn.TextColor3 = C.text
    tBtn.Font = Enum.Font.GothamBold
    tBtn.TextSize = 11
    tBtn.LayoutOrder = index
    tBtn.Parent = TabBar
    Instance.new("UICorner", tBtn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = index == 1
    page.CanvasSize = UDim2.new(0, 0, 0, 400)
    page.ScrollBarThickness = 4
    page.Parent = PageContainer

    local pLayout = Instance.new("UIListLayout", page)
    pLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pLayout.Padding = UDim.new(0, 6)

    tBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.Visible = false end
        for _, b in pairs(tabButtons) do b.BackgroundColor3 = C.panel end
        page.Visible = true
        tBtn.BackgroundColor3 = C.accent
    end)

    pages[index] = page
    tabButtons[index] = tBtn
    return page
end

local function mkBtn(parent, text, cb)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -6, 0, 36)
    b.BackgroundColor3 = C.panel
    b.Text = text
    b.TextColor3 = C.text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(function() cb(b) end)
    return b
end


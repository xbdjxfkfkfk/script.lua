local function refreshCarList()
    for _, child in ipairs(cScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local foundCars = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj:FindFirstChild("VehicleSeat") or obj:FindFirstChild("Seat") or obj.Name:lower():find("car") or obj.Name:lower():find("vehicle") or obj.Name:lower():find("truck")) then
            if not foundCars[obj.Name] then
                foundCars[obj.Name] = true
                local cb = Instance.new("TextButton")
                cb.Size = UDim2.new(1, -5, 0, 30)
                cb.BackgroundColor3 = C.panel
                cb.Text = "🚙 سحب: " .. obj.Name
                cb.TextColor3 = C.text
                cb.Font = Enum.Font.Gotham
                cb.TextSize = 11
                cb.Parent = cScroll
                Instance.new("UICorner", cb).CornerRadius = UDim.new(0, 6)
                cb.MouseButton1Click:Connect(function()
                    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    if root and primary then
                        obj:PivotTo(root.CFrame + Vector3.new(5, 3, 0))
                    end
                end)
            end
        end
    end
    cScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(100, #cScroll:GetChildren() * 34))
end


        Font = Enum.Font.GothamBold, BackgroundColor3 = COLORS.panel2,
    }, rowFrame)
    round(minus, 8)
    local plus = make("TextButton", {
        Size = UDim2.fromOffset(44, 36), Position = UDim2.new(1, -49, 0, 5),
        Text = "+", TextSize = 23, TextColor3 = COLORS.white,
        Font = Enum.Font.GothamBold, BackgroundColor3 = COLORS.panel2,
    }, rowFrame)
    round(plus, 8)
    local val = make("TextLabel", {
        Size = UDim2.new(1, -112, 1, 0), Position = UDim2.fromOffset(56, 0),
        Text = labelText .. ": " .. tostring(state[key]),
        Font = Enum.Font.GothamMedium, TextSize = 13,
        TextColor3 = COLORS.white, BackgroundTransparency = 1,
    }, rowFrame)
    local function update(delta)
        state[key] = math.clamp(state[key] + delta, min, max)
        val.Text = labelText .. ": " .. tostring(state[key])
        if onChanged then onChanged() end
    end
    listen(minus.MouseButton1Click, function() if alive then update(-increment) end end)
    listen(plus.MouseButton1Click, function() if alive then update(increment) end end)
end

local function stopFlight()
    if fly.velocity then fly.velocity:Destroy() end
    if fly.orient then fly.orient:Destroy() end
    if fly.attach then fly.attach:Destroy() end
    if fly.humanoid and fly.humanoid.Parent then
        fly.humanoid.PlatformStand = false
        fly.humanoid.AutoRotate = (fly.autoRotate ~= false)
    end
    fly.attach, fly.velocity, fly.orient, fly.humanoid = nil, nil, nil, nil
end
local function startFlight()
    stopFlight()
    local hrp = localRoot()
    local hum = localHumanoid()
    if not hrp or not hum then
        state.Fly = false
        say("الشخصية غير جاهزة للطيران", false)
        return false
    end
    fly.humanoid = hum
    fly.autoRotate = hum.AutoRotate
    fly.attach = make("Attachment", {Name = "NovaFlightAttachment"}, hrp)
    fly.velocity = make("LinearVelocity", {
        Name = "NovaFlightVelocity", Attachment0 = fly.attach,
        RelativeTo = Enum.ActuatorRelativeTo.World,
        VectorVelocity = Vector3.zero,
        MaxForce = math.huge,
    }, hrp)
    pcall(function() fly.velocity.ForceLimitsEnabled = false end)
    fly.orient = make("AlignOrientation", {
        Name = "NovaFlightOrientation", Attachment0 = fly.attach,
        Mode = Enum.OrientationAlignmentMode.OneAttachment,
        MaxTorque = math.huge, Responsiveness = 14,
    }, hrp)
    hum.AutoRotate = false
    hum.PlatformStand = true
    say("الطيران: وجّه الكاميرا للأعلى أو للأسفل وتحرك للأمام بالقير", true)
    return true
end

-- Gamepad thumbstick readings directly to work even if Humanoid is in PlatformStand.
local thumb = Vector2.zero
local function currentThumb()
    -- Poll prevents stale stick values when input focus changes.
    local success, inputs = pcall(UserInputService.GetGamepadState, UserInputService, Enum.UserInputType.Gamepad1)
    if success then
        local found = false
        for _, input in ipairs(inputs) do
            if input.KeyCode == Enum.KeyCode.Thumbstick1 then
                thumb = Vector2.new(input.Position.X, input.Position.Y)
                found = true
                break
            end
        end
        if not found then thumb = Vector2.zero end
    else
        thumb = Vector2.zero
    end
    if thumb.Magnitude < 0.14 then return Vector2.zero end
    return thumb
end
local function keyDown(key)
    return UserInputService:IsKeyDown(key)
end
local function updateFlight()
    if not state.Fly then return end
    local root = localRoot()
    if not root or not fly.velocity or fly.velocity.Parent ~= root then
        startFlight()
        return
    end
    local cam = Workspace.CurrentCamera
    if not cam then return end

    -- FULL camera LookVector, including pitch: up/down naturally follows your aim.
    local look = cam.CFrame.LookVector
    local right = cam.CFrame.RightVector
    local stick = currentThumb()
    local forwardInput = stick.Y
    local sidewaysInput = stick.X

    if keyDown(Enum.KeyCode.W) then forwardInput = forwardInput + 1 end
    if keyDown(Enum.KeyCode.S) then forwardInput = forwardInput - 1 end
    if keyDown(Enum.KeyCode.D) then sidewaysInput = sidewaysInput + 1 end
    if keyDown(Enum.KeyCode.A) then sidewaysInput = sidewaysInput - 1 end

    -- Strafe remains horizontal to avoid accidental climbing while turning.
    local horizontalRight = Vector3.new(right.X, 0, right.Z)
    if horizontalRight.Magnitude > 0.01 then
        horizontalRight = horizontalRight.Unit
    else
        horizontalRight = Vector3.xAxis
    end
    local movement = (look * forwardInput) + (horizontalRight * sidewaysInput)
    if movement.Magnitude > 1 then movement = movement.Unit end
    if movement.Magnitude < 0.03 then movement = Vector3.zero end
    fly.velocity.VectorVelocity = movement * state.FlySpeed

    -- The character faces where you aim, including looking up/down.
    fly.orient.CFrame = cam.CFrame.Rotation
end

local function applySpeed()
    local hum = localHumanoid()
    if hum and not state.Fly then
        if not original.WalkSpeed then original.WalkSpeed = hum.WalkSpeed end
        hum.WalkSpeed = state.Speed and state.WalkSpeed or original.WalkSpeed
    end
end
local function applyLocalInvisible()
    local character = localCharacter()
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = state.LocalInvisible and 1 or 0
        end
    end
end

local function getRole(player)
    if game.CreatorType == Enum.CreatorType.User then
        if player.UserId == game.CreatorId then
            return "مالك التجربة (هوية مؤكدة)", "owner"
        end
    elseif game.CreatorType == Enum.CreatorType.Group then
        local ok, rank = pcall(function() return player:GetRankInGroup(game.CreatorId) end)
        if ok and rank then
            if rank == 255 then
                return "مالك المجموعة (رتبة 255)", "owner"
            elseif rank >= 200 then
                return "رتبة مجموعة عالية " .. tostring(rank) .. " — ليست إثبات أدمن", "possible"
            end
        end
    end
    return "صلاحيات الأدمن غير معروفة", "unknown"
end
local function clearHighlights()
    for player, data in pairs(highlighted) do
        if data and data.Parent then data:Destroy() end
        highlighted[player] = nil
    end
end
local function refreshHighlights()
    if not state.ESP then
        clearHighlights()
        return
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and not highlighted[player] then
                highlighted[player] = make("Highlight", {
                    Name = "NovaLocalESP", Adornee = char,
                    FillColor = COLORS.purple, OutlineColor = COLORS.white,
                    FillTransparency = .66, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                }, gui)
            elseif highlighted[player] and highlighted[player].Adornee ~= char then
                highlighted[player]:Destroy()
                highlighted[player] = nil
            end
        end
    end
end

local function clearAdminVisual(player)
    local data = adminVisuals[player]
    if data then
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
        adminVisuals[player] = nil
    end
end
local function refreshAdminVision()
    if not state.AdminESP then
        for player in pairs(adminVisuals) do clearAdminVisual(player) end
        return
    end
    for player in pairs(adminVisuals) do
        if player.Parent ~= Players then clearAdminVisual(player) end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local head = char and char:FindFirstChild("Head")
            local role, kind = getRole(player)
            if kind ~= "owner" and kind ~= "possible" then
                clearAdminVisual(player)
            elseif not char or not head then
                clearAdminVisual(player)
            else
                local existing = adminVisuals[player]
                if existing and existing.char ~= char then
                    clearAdminVisual(player)
                    existing = nil
                end
                if not existing then
                    local isOwner = kind == "owner"
                    local color = isOwner and COLORS.green or COLORS.orange
                    local tag = isOwner and "👑 مالك التجربة / المجموعة" or "🛡️ رتبة مجموعة عالية (غير مؤكدة)"
                    local highlight = make("Highlight", {
                        Name = "NovaAdminVisionLocal", Adornee = char,
                        FillColor = color, OutlineColor = color,
                        FillTransparency = .7, OutlineTransparency = 0,
                        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                    }, gui)
                    local billboard = make("BillboardGui", {
                        Name = "NovaAdminVisionTag", Adornee = head,
                        AlwaysOnTop = true, Size = UDim2.fromOffset(300, 48),
                        StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0),
                    }, gui)
                    local label = make("TextLabel", {
                        Name = "RoleText", Size = UDim2.fromScale(1, 1),
                        Text = tag .. "\n@" .. player.Name,
                        TextColor3 = color, TextStrokeColor3 = Color3.new(0, 0, 0),
                        TextStrokeTransparency = .15, BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold, TextSize = 13,
                        TextWrapped = true,
                    }, billboard)
                    adminVisuals[player] = {char = char, highlight = highlight, billboard = billboard, label = label}
                end
            end
        end
    end
end

local function stopDrag()
    dragTarget = nil
end
local function attemptLocalDrag()
    if not dragTarget then return end
    if dragTarget.Parent ~= Players or dragTarget == LocalPlayer then
        stopDrag()
        return
    end
    local myRoot = localRoot()
    local theirRoot = dragTarget.Character and dragTarget.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not theirRoot then return end
    -- This is deliberately local-only and is NOT an authorized server Bring command.
    -- Most experiences instantly correct remote players' positions.
    pcall(function()
        theirRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -5)
    end)
end

local function tryTeleport(player)
    if not player or player == LocalPlayer or player.Parent ~= Players then
        say("اختر لاعبًا موجودًا أولًا", false)
        return
    end
    local fromRoot = localRoot()
    local toRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not fromRoot or not toRoot then
        say("ما قدرت أوصل لموقع اللاعب الآن", false)
        return
    end
    fromRoot.CFrame = toRoot.CFrame * CFrame.new(0, 0, 4)
    say("انتقلت قرب " .. player.Name .. " محليًا؛ قد يعيدك السيرفر", true)
end


-- 1) ESP — Highlight, applies to current + future players
-- ═══════════════════════════════════════════════════════════
local ESP_CONN
local function stripESP(char)
    if not char then return end
    local h = char:FindFirstChild("ZyphoraHighlight")
    if h then h:Destroy() end
end
local function applyESP(char)
    if not char or not S.ESP then return end
    if char:FindFirstChild("ZyphoraHighlight") then return end
    local h = Instance.new("Highlight")
    h.Name = "ZyphoraHighlight"
    h.FillColor = Color3.fromRGB(0, 170, 255)
    h.FillTransparency = 0.45
    h.OutlineColor = Color3.fromRGB(255, 255, 255)
    h.OutlineTransparency = 0
    h.Adornee = char
    h.Parent = char
end
local function wirePlayer(p)
    if p == LocalPlayer then return end
    applyESP(p.Character)
    p.CharacterAdded:Connect(function(c)
        task.wait(0.2)
        applyESP(c)
    end)
end

local EspBtn = mkBtn("👁️ كشف اللاعبين (ESP): OFF", function(self)
    S.ESP = not S.ESP
    self.Text = S.ESP and "👁️ كشف اللاعبين (ESP): ON" or "👁️ كشف اللاعبين (ESP): OFF"

    if S.ESP then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                applyESP(p.Character)
            end
        end
        ESP_CONN = Players.PlayerAdded:Connect(wirePlayer)
        for _, p in ipairs(Players:GetPlayers()) do wirePlayer(p) end
    else
        if ESP_CONN then ESP_CONN:Disconnect(); ESP_CONN = nil end
        for _, p in ipairs(Players:GetPlayers()) do
            stripESP(p.Character)
        end
        for _, c in ipairs(workspace:GetChildren()) do
            if c:FindFirstChild("ZyphoraHighlight") then
                c.ZyphoraHighlight:Destroy()
            end
        end
    end
end)

-- ═══════════════════════════════════════════════════════════
-- 2) Car Fly — smooth vertical, release-safe
-- ═══════════════════════════════════════════════════════════
local carFlyThread
local function stopCarFly()
    if carFlyThread then
        task.cancel(carFlyThread)
        carFlyThread = nil
    end
end

local CarBtn = mkBtn("🚗 طيران السيارة: OFF", function(self)
    S.CarFly = not S.CarFly
    self.Text = S.CarFly and "🚗 طيران السيارة: ON" or "🚗 طيران السيارة: OFF"

    stopCarFly()
    if not S.CarFly then return end

    carFlyThread = task.spawn(function()
        while S.CarFly do
            local char = LocalPlayer.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.SeatPart then
                local seat = hum.SeatPart
                local model = seat:FindFirstAncestorOfClass("Model")
                if model then
                    local root = model:FindFirstChildWhichIsA("BasePart", true)
                    if root then
                        pcall(function()
                            root.AssemblyLinearVelocity = Vector3.new(
                                root.AssemblyLinearVelocity.X,
                                60,
                                root.AssemblyLinearVelocity.Z
                            )
                        end)
                    end
                end
            end
            task.wait(0.05)
        end
    end)
end)


    dst.Parent = esp
    esp.Parent = ESPFolder
    RunService.RenderStepped:Connect(function(dt)
        if State.ESP and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pos, vis = Camera:WorldToViewportPoint(hrp.Position)
                if vis then
                    esp.Adornee = hrp
                    esp.Enabled = true
                    nm.TextColor3 = getESPColor(plr)
                    dst.Text = tostring(math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)) .. "m"
                    return
                end
            end
        end
        esp.Enabled = false
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do makeESP(plr) end
Players.PlayerAdded:Connect(makeESP)
Players.PlayerRemoving:Connect(function(plr)
    local e = ESPFolder:FindFirstChild("ESP_" .. plr.Name)
    if e then e:Destroy() end
end)


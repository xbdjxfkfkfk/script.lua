local down=btn(flyButtons,"▼",UDim2.fromOffset(0,83),UDim2.fromOffset(76,69),function()end,theme.active)
local function verticalHold(button, dir)
    connect(button.InputBegan,function(input)
        if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then mobileVertical=dir end
    end)
    connect(button.InputEnded,function(input)
        if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
            if mobileVertical==dir then mobileVertical=0 end
        end
    end)
end
verticalHold(up,1)
verticalHold(down,-1)
local function stopFlight()
    if flyConnection then flyConnection:Disconnect(); flyConnection=nil end
    if flyVelocity then flyVelocity:Destroy(); flyVelocity=nil end
    if flyAttachment then flyAttachment:Destroy(); flyAttachment=nil end
    if flyHum and flyHum.Parent then
        flyHum.PlatformStand=false
        flyHum.AutoRotate=true
    end
    flyHum=nil
    mobileVertical=0
    flyButtons.Visible=false
end
local function startFlight()
    stopFlight()
    if not fly then return end
    local char=me.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health<=0 then notice("انتظر ظهور الشخصية") return end
    flyHum=hum
    flyAttachment=make("Attachment",root,{Name="NOVA_V8_Attachment"})
    flyVelocity=make("LinearVelocity",root,{
        Name="NOVA_V8_Flight", Attachment0=flyAttachment,
        VelocityConstraintMode=Enum.VelocityConstraintMode.Vector,
        RelativeTo=Enum.ActuatorRelativeTo.World,
        ForceLimitsEnabled=false, MaxForce=1e9,
        VectorVelocity=Vector3.zero,
    })
    hum.PlatformStand=true
    hum.AutoRotate=false
    flyButtons.Visible=UIS.TouchEnabled
    flyConnection=RS.RenderStepped:Connect(function()
        if not fly or not alive or not root.Parent or me.Character~=char then
            stopFlight(); return
        end
        local camera=workspace.CurrentCamera
        if not camera then return end
        local f=camera.CFrame.LookVector
        local r=camera.CFrame.RightVector
        local forward=Vector3.new(f.X,0,f.Z)
        local right=Vector3.new(r.X,0,r.Z)
        if forward.Magnitude>.001 then forward=forward.Unit end
        if right.Magnitude>.001 then right=right.Unit end
        local move=Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then move+=forward end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move-=forward end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move+=right end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move-=right end
        if UIS.TouchEnabled and move.Magnitude<.01 then move=hum.MoveDirection end
        if move.Magnitude>1 then move=move.Unit end
        local vertical=mobileVertical
        if UIS:IsKeyDown(Enum.KeyCode.Space) then vertical=1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl) then vertical=-1 end
        flyVelocity.VectorVelocity=(move+Vector3.new(0,vertical,0))*flySpeed
    end)
end


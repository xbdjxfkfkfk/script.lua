    local stroke = make("UIStroke", {Color = COLORS.stroke, Transparency = .65, Thickness = 1}, b)

    listen(b.MouseEnter, function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Color = COLORS.accent, Transparency = 0.2}):Play()
    end)
    listen(b.MouseLeave, function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Color = COLORS.stroke, Transparency = 0.65}):Play()
    end)

    listen(b.MouseButton1Click, function()
        if not alive then return end
        local ok, err = pcall(callback, b)
        if not ok then
            say("خطأ في التنفيذ: " .. safeText(err), false)
        end
    end)
    return b
end

local function toggle(text, key, onChanged)
    local b
    b = action((state[key] and "●  " or "○  ") .. text, function()
        state[key] = not state[key]
        b.Text = (state[key] and "●  " or "○  ") .. text
        b.BackgroundColor3 = state[key] and COLORS.activeBtn or COLORS.panel2
        if onChanged then
            local ok, err = pcall(onChanged, state[key])
            if not ok then
                state[key] = not state[key]
                b.Text = (state[key] and "●  " or "○  ") .. text
                b.BackgroundColor3 = state[key] and COLORS.activeBtn or COLORS.panel2
                say("تعذّر التفعيل: " .. safeText(err), false)
            end
        end
    end)
    if state[key] then b.BackgroundColor3 = COLORS.activeBtn end
    return b
end


 local vr=seatRoot()
 if vr and S.CarFly then
  local cam=WS.CurrentCamera
  if cam then
   local d=Vector3.zero;local cf=cam.CFrame
   if UIS:IsKeyDown(Enum.KeyCode.W) then d+=cf.LookVector end
   if UIS:IsKeyDown(Enum.KeyCode.S) then d-=cf.LookVector end
   if UIS:IsKeyDown(Enum.KeyCode.A) then d-=cf.RightVector end
   if UIS:IsKeyDown(Enum.KeyCode.D) then d+=cf.RightVector end
   if UIS:IsKeyDown(Enum.KeyCode.Space) then d+=Vector3.yAxis end
   if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then d-=Vector3.yAxis end
   vr.AssemblyLinearVelocity=d.Magnitude>.01 and d.Unit*S.Car or Vector3.zero
  end
 elseif vr and S.CarSpeed then
  -- Only increase forward motion while accelerating; steering remains native.
  local h=hum();local seat=h and h.SeatPart
  if seat and seat:IsA('VehicleSeat') and seat.ThrottleFloat>.05 then
   local velocity=vr.AssemblyLinearVelocity
   local flat=Vector3.new(velocity.X,0,velocity.Z)
   if flat.Magnitude>1 and flat.Magnitude<S.Car then
    local newSpeed=math.min(S.Car,flat.Magnitude+dt*45)
    local nextFlat=flat.Unit*newSpeed
    vr.AssemblyLinearVelocity=Vector3.new(nextFlat.X,velocity.Y,nextFlat.Z)
   end
  end
 end
end)

            say('الوجهة لم تعد موجودة؛ ابحث عنها من جديد'); return
        end
        pendingToken += 1
        local token = pendingToken
        local destination = selected
        local travelMode = mode
        say('انتقال إلى '..destination.name..' بعد 3 ثوانٍ. اضغط إلغاء للتراجع.')
        task.delay(3, function()
            if not alive or token ~= pendingToken then return end
            local destinationPosition = destination.object and positionOf(destination.object) or destination.position
            if not destinationPosition then say('الوجهة اختفت قبل الانتقال'); return end
            if travelMode=='car' then
                local h = humanoid()
                local seat = h and h.SeatPart
                if not seat or not seat:IsA('VehicleSeat') or seat.Occupant ~= h then
                    say('انتقال السيارة: اجلس في مقعد قيادة VehicleSeat أولاً'); return
                end
                local car = seat:FindFirstAncestorOfClass('Model')
                if not car then say('ما قدرت أحدد مجسم السيارة'); return end
                local ok, err = pcall(function()
                    local original = car:GetPivot()
                    car:PivotTo(CFrame.new(destinationPosition + Vector3.new(0,8,0)) * original.Rotation)
                end)
                if not ok then say('فشل تحريك السيارة: '..tostring(err):sub(1,80)); return end
            else
                local r = root()
                if not r then say('الشخصية غير جاهزة'); return end
                local ok, err = pcall(function()
                    r.CFrame = CFrame.new(destinationPosition + Vector3.new(0,5,0))
                end)
                if not ok then say('فشل التحريك المحلي: '..tostring(err):sub(1,80)); return end
            end
            say('تمت محاولة الانتقال. جاري فحص ثبات موقع اللاعب...')

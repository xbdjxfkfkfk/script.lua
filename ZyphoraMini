@echo off
setlocal EnableExtensions
cd /d "%~dp0"
title Lx REDLINE - Discord Membership Gate

echo ===============================================
echo   Lx REDLINE - Discord Membership Gate
echo ===============================================
echo.

where node >nul 2>nul
if errorlevel 1 (
  echo ERROR: Node.js is not installed.
  echo Install Node.js 20 or newer, then double-click this file again.
  start "" "https://nodejs.org/en/download"
  pause
  exit /b 1
)

for /f "tokens=1 delims=." %%V in ('node -p "process.versions.node"') do set NODE_MAJOR=%%V
if %NODE_MAJOR% LSS 20 (
  echo ERROR: Node.js 20 or newer is required. Detected version:
  node --version
  start "" "https://nodejs.org/en/download"
  pause
  exit /b 1
)

call node setup-env.js
if errorlevel 1 (
  echo ERROR: Could not prepare .env.
  pause
  exit /b 1
)

rem If required Discord values are still placeholders, let the user edit them.
findstr /c:"PUT_CLIENT_ID_HERE" /c:"PUT_CLIENT_SECRET_HERE" /c:"PUT_SERVER_ID_HERE" ".env" >nul
if not errorlevel 1 (
  echo.
  echo First setup: fill in the Discord Client ID, Client Secret and Server ID.
  echo See README_AR.txt for where to get them. SESSION_SECRET is generated automatically.
  echo The page can still open in setup mode if you do not have the values ready.
  start "" /wait notepad "%~dp0.env"
)

if not exist "node_modules\express\package.json" (
  echo.
  echo Installing required packages. Internet access is needed for this step...
  call npm install --no-audit --no-fund
  if errorlevel 1 (
    echo.
    echo ERROR: npm install failed. Check your internet connection and try again.
    pause
    exit /b 1
  )
)

echo.
echo Starting the membership gate on http://localhost:3000
echo Keep this window open while using the page.
start "" /b powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Sleep -Seconds 3; Start-Process 'http://localhost:3000'"
call npm start
set EXITCODE=%ERRORLEVEL%
echo.
echo Server stopped with code %EXITCODE%.
echo If the page says settings are missing, edit .env and restart this file.
pause
exit /b %EXITCODE%

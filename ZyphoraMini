-- Invisible
local function updateInvisible()
    local char = LP.Character
    if not char then return end
    
    if S.Invisible then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.LocalTransparencyModifier = 1 v.CastShadow = false end
            if v:IsA("Decal") or v:IsA("Texture") then v.LocalTransparencyModifier = 1 end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then v.Enabled = false end
        end
    else
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.LocalTransparencyModifier = 0 v.CastShadow = true end
            if v:IsA("Decal") or v:IsA("Texture") then v.LocalTransparencyModifier = 0 end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then v.Enabled = true end
        end
    end
end

-- Speed
local function updateSpeed()
    local char = LP.Character
    local h = char and char:FindFirstChildOfClass("Humanoid")

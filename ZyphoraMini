 return nil
end
local function rarity(m)
 local r=stat(m,{'Rarity','rarity','Tier','tier','Grade','الندرة'})
 if r==nil then return 'غير محدد',palette.sub end
 local s=tostring(r):lower()
 local defs={{'خرافي',Color3.fromRGB(245,66,82),{'mythic','divine','t6','خرافي'}},{'أسطوري',Color3.fromRGB(255,192,58),{'legendary','t5','ذهبي','أسطوري'}},{'فاخر',Color3.fromRGB(189,103,255),{'epic','t4','فاخر','بنفسجي'}},{'نادر',Color3.fromRGB(70,165,255),{'rare','t3','نادر','أزرق'}},{'مميز',Color3.fromRGB(80,219,132),{'uncommon','t2','مميز','أخضر'}},{'عادي',Color3.fromRGB(235,235,238),{'common','t1','عادي','أبيض'}}}
 for _,d in ipairs(defs) do for _,term in ipairs(d[3]) do if s==term then return d[1],d[2] end end end

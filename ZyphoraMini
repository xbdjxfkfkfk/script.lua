                notice("مشاهدة: " .. target.DisplayName)
            else
                notice("اللاعب غير جاهز للمشاهدة")
            end
        elseif typeName == "stop" then
            local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if h and workspace.CurrentCamera then workspace.CurrentCamera.CameraSubject = h end
            notice("تم إنهاء المشاهدة")
        else
            fire(what, selectedId)
        end
    end, row <= 2 and C.itemHi or C.item)
end

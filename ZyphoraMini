    if p==spectated then stopSpectate() end
    if p==selectedPlayer then selectedPlayer=nil end
    if namesOn then addMarkers() end
    refreshPlayers()
end)
for _,p in ipairs(Players:GetPlayers()) do
    if p~=player then
        p.CharacterAdded:Connect(function()
            if namesOn then task.delay(0.5,addMarkers) end
        end)
    end
end
player.CharacterAdded:Connect(function()
    stopFlight()
    task.delay(0.6,function()
        local _,hum=characterParts()
        if hum then
            hum.WalkSpeed=speed
            hum.UseJumpPower=true
            hum.JumpPower=jumpPower
        end
        if locallyHidden then setLocalInvisible(true) end
        if not spectated then stopSpectate() end
    end)
end)


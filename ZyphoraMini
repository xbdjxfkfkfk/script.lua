    FogEnd=Lighting.FogEnd, GlobalShadows=Lighting.GlobalShadows,
    Ambient=Lighting.Ambient, OutdoorAmbient=Lighting.OutdoorAmbient
}
local function characterParts()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return nil end
    return char, root, hum
end
local function stopFly()
    flyEnabled=false
    if flyVelocity then pcall(function() flyVelocity:Destroy() end) end
    if flyGyro then pcall(function() flyGyro:Destroy() end) end
    if flyAttachment then pcall(function() flyAttachment:Destroy() end) end
    flyVelocity, flyGyro, flyAttachment=nil,nil,nil
    if flyingHumanoid and flyingHumanoid.Parent then
        pcall(function()
            flyingHumanoid.PlatformStand=originalPlatformStand==true
            flyingHumanoid.AutoRotate=originalAutoRotate~=false
            flyingHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
    flyingRoot, flyingHumanoid=nil,nil
    for k in pairs(keyboard) do keyboard[k]=false end
    for k in pairs(held) do held[k]=false end
end
local function startFly()
    local _,root,hum=characterParts()
    if not root then return false, "الشخصية غير جاهزة" end
    if root.Anchored then return false, "الشخصية مثبتة من الماب" end
    stopFly()
    originalAutoRotate,originalPlatformStand=hum.AutoRotate,hum.PlatformStand
    flyingRoot,flyingHumanoid=root,hum
    local ok,err=pcall(function()
        flyAttachment=new("Attachment",{Name="NOVA_Flight_Attachment"},root)
        flyVelocity=new("LinearVelocity",{
            Name="NOVA_Flight_LinearVelocity",Attachment0=flyAttachment,
            RelativeTo=Enum.ActuatorRelativeTo.World,
            VelocityConstraintMode=Enum.VelocityConstraintMode.Vector,
            ForceLimitsEnabled=false,VectorVelocity=Vector3.zero
        },root)
        flyGyro=new("AlignOrientation",{
            Name="NOVA_Flight_Orientation",Attachment0=flyAttachment,
            Mode=Enum.OrientationAlignmentMode.OneAttachment,
            RigidityEnabled=false,Responsiveness=30,MaxTorque=1e9
        },root)
        hum.AutoRotate=false
        hum.PlatformStand=true
    end)
    if not ok then
        stopFly()
        return false,"تعذر تشغيل الطيران: "..tostring(err)
    end
    flyEnabled=true
    return true
end
local function applySpeed()
    local _, _, hum=characterParts()
    if hum then
        if not savedSpeed then savedSpeed=hum.WalkSpeed end
        hum.WalkSpeed=speedEnabled and speed or savedSpeed
    end
end


local function refreshPlayers()
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local filter=string.lower(search.Text)
    local playerList=Players:GetPlayers()
    table.sort(playerList,function(a,b) return a.DisplayName:lower()<b.DisplayName:lower() end)
    for _, target in ipairs(playerList) do
        if filter=="" or string.find(target.DisplayName:lower(),filter,1,true)
            or string.find(target.Name:lower(),filter,1,true) then
            local row=button(scroll,target.DisplayName.."  (@"..target.Name..")",0,0,325,44,function()
                selectedPlayer=target
                selectedLabel.Text="المحدد: "..target.DisplayName
                say("تم اختيار "..target.Name,true)
            end)
            row.Size=UDim2.new(1,-14,0,44)
            if target==selectedPlayer then row.BackgroundColor3=Color3.fromRGB(102,69,53) end
        end
    end
end
search:GetPropertyChangedSignal("Text"):Connect(refreshPlayers)
Players.PlayerAdded:Connect(refreshPlayers)
Players.PlayerRemoving:Connect(function(p)
    if selectedPlayer==p then selectedPlayer=nil; selectedLabel.Text="لاعب محدد: لا يوجد" end
    if spectateTarget==p then stopSpectate() end
    task.defer(refreshPlayers)
end)
refreshPlayers()


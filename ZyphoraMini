        Position=UDim2.fromOffset(x,y), Size=UDim2.fromOffset(width,height),
        BackgroundTransparency=1, Text=tostring(value), Font=bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextSize=size or 15, TextColor3=C.white, TextWrapped=true,
        TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Center,
    })
end
local function button(parent, value, x, y, width, height, fn)
    local b = make("TextButton", parent, {
        Position=UDim2.fromOffset(x,y), Size=UDim2.fromOffset(width,height),
        BackgroundColor3=C.pane2, BorderSizePixel=0, Text=tostring(value),
        TextColor3=C.white, TextSize=14, Font=Enum.Font.GothamSemibold,
        TextWrapped=true, AutoButtonColor=true, Active=true,
    })
    round(b,8)
    border(b,0.8)
    if fn then
        b.Activated:Connect(function()
            local ok, err=pcall(fn)
            if not ok then warn("NOVA button:",err) end
        end)
    end
    return b
end
local function input(parent, hint, x, y, w, h)

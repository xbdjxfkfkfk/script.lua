end

local function makeMarker(e)
    local m = e.model
    if markers[m] or not living(m) or not lizard(m) then return end
    
    local r = root()
    local dist = r and math.floor((e.part.Position - r.Position).Magnitude) or 0
    
    local bb = inst("BillboardGui", {
        Name = "LxESP",
        Adornee = e.part,
        Size = UDim2.fromOffset(220, 80),
        StudsOffsetWorldSpace = Vector3.new(0, 3, 0),
        AlwaysOnTop = true,
        MaxDistance = S.RadarRange
    }, gui)
    
    local rar = rarity(m)
    local rarColor = rarityColors[rar] or C.white
    
    local nameLabel = inst("TextLabel", {
        Size = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1,
        Text = speciesName(m),
        TextColor3 = rarColor,
        TextStrokeTransparency = 0.3,
        TextSize = 13,
        Font = Enum.Font.GothamBold
    }, bb)
    
    local rarityLabel = inst("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        Position = UDim2.new(0, 0, 0, 22),
        BackgroundTransparency = 1,
        Text = "[" .. rar .. "]",
        TextColor3 = rarColor,
        TextStrokeTransparency = 0.3,
        TextSize = 11,
        Font = Enum.Font.GothamBold
    }, bb)
    
    local infoLabel = inst("TextLabel", {
        Size = UDim2.new(1, 0, 0, 35),
        Position = UDim2.new(0, 0, 0, 42),
        BackgroundTransparency = 1,
        Text = "⚖️ " .. animalWeight(m) .. "  |  📏 " .. dist .. "m",
        TextColor3 = C.white,
        TextStrokeTransparency = 0.4,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        TextWrapped = true
    }, bb)
    
    markers[m] = bb
end

local function nearest(filter)
    local r = root()
    if not r then return nil end
    local best, dist = nil, math.huge
    for _, e in ipairs(cache) do
        if e.model.Parent and e.part.Parent and living(e.model) and lizard(e.model) then
            local d = (e.part.Position - r.Position).Magnitude
            if d < dist and d <= S.RadarRange and (not filter or filter == "الكل" or rarity(e.model) == filter) then
                best = e
                dist = d
            end
        end
    end
    return best, dist
end


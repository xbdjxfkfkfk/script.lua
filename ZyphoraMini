end

local function waitForDiscord()
    local gui, errorText, button = createGuardPanel()

    while true do
        if discordIsAlive() then
            gui:Destroy()
            return true
        end

        errorText.Text = "✕ Discord غير مفتوح أو غير متصل\nالسكربت لا يعمل إلا بعد الدخول إلى الخادم."
        button.Text = "فتح رابط Discord"
        task.wait(2)
    end
end

local passed = waitForDiscord()
if not passed then
    warn("Discord guard failed")
    return
end


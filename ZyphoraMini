local function toggle(page, title, callback)
    local active = false
    local busy = false
    local b
    b = button(page, title .. "  |  OFF", function()
        if busy then return end
        busy = true
        local newValue = not active
        local callOk, ok, reason = pcall(callback, newValue)
        busy = false
        if not callOk then log("فشل زر " .. title .. ": " .. tostring(ok), true) return end
        if ok ~= true then
            log(reason or (title .. " فشل"), true)
            return
        end
        active = newValue
        b.Text = title .. (active and "  |  ON ✓" or "  |  OFF ×")
        b.BackgroundColor3 = active and Color3.fromRGB(100, 28, 35) or COLORS.panel
        log(title .. (active and " : ON" or " : OFF"))
    end)
    local control = {}
    function control:set(value)
        active = value == true
        b.Text = title .. (active and "  |  ON ✓" or "  |  OFF ×")
        b.BackgroundColor3 = active and Color3.fromRGB(100, 28, 35) or COLORS.panel
    end
    function control:get() return active end
    toggles[#toggles + 1] = control
    return control
end
local function numberInput(page, title, initial, minValue, maxValue, increment, setter)
    local current = initial
    local f = create("Frame", {Size = UDim2.new(1, -3, 0, 73), BackgroundColor3 = COLORS.panel}, page)
    corner(f, 10)

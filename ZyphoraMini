-- NOVA Admin Discovery Add-on v1.0
-- Client-side inspector for genuinely accessible Tools and possible admin UI.
-- Does NOT unlock administrative privileges, access server-only Tools, or bypass ranks.
-- Run as a LocalScript in StarterPlayerScripts in an experience you manage,
-- or in another authorized client scripting environment.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
if not player then return end

local playerGui = player:WaitForChild("PlayerGui")
local backpack = player:WaitForChild("Backpack")
local GUI_NAME = "NOVA_Admin_Discovery_Addon"

-- Re-running the add-on removes its old interface.
local oldGui = playerGui:FindFirstChild(GUI_NAME)
if oldGui then oldGui:Destroy() end

local ui = Instance.new("ScreenGui")
ui.Name = GUI_NAME
ui.ResetOnSpawn = false
ui.IgnoreGuiInset = true
ui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ui.Parent = playerGui

local function make(className, props, parent)
    local obj = Instance.new(className)
    for prop, value in pairs(props or {}) do
        obj[prop] = value
    end
    obj.Parent = parent
    return obj
end

local function corner(obj, radius)
    make("UICorner", {CornerRadius = UDim.new(0, radius or 10)}, obj)
end

local function textLabel(parent, contents, size, position, color, textSize)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = contents,
        Size = size,
        Position = position,
        Font = Enum.Font.Gotham,
        TextColor3 = color or Color3.fromRGB(234, 240, 247),
        TextSize = textSize or 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    }, parent)
end

local function button(parent, contents, size, position, bg)
    local b = make("TextButton", {
        Text = contents,
        Size = size,
        Position = position,
        BackgroundColor3 = bg or Color3.fromRGB(50, 61, 84),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        AutoButtonColor = true,
    }, parent)
    corner(b, 8)
    return b
end

local container = make("Frame", {
    Name = "Panel",
    AnchorPoint = Vector2.new(0.5, 0.5),
    Size = UDim2.new(0, 470, 0, 510),
    Position = UDim2.fromScale(0.5, 0.5),
    BackgroundColor3 = Color3.fromRGB(23, 29, 42),
    BorderSizePixel = 0,
}, ui)
corner(container, 15)
make("UIStroke", {Color = Color3.fromRGB(63, 79, 111), Thickness = 1}, container)
make("UISizeConstraint", {MaxSize = Vector2.new(470, 510), MinSize = Vector2.new(310, 55)}, container)

local title = textLabel(container, "NOVA  |  Admin Discovery", UDim2.new(1, -96, 0, 38), UDim2.fromOffset(16, 10), Color3.fromRGB(240, 246, 255), 18)
title.Font = Enum.Font.GothamBold
local closeButton = button(container, "×", UDim2.fromOffset(29, 29), UDim2.new(1, -39, 0, 14), Color3.fromRGB(120, 46, 57))
local miniButton = button(container, "−", UDim2.fromOffset(29, 29), UDim2.new(1, -73, 0, 14))
local hint = textLabel(container, "يعرض أدواتك الفعلية والواجهات المحتملة، ولا يمنح صلاحيات أدمن.", UDim2.new(1, -32, 0, 36), UDim2.fromOffset(16, 49), Color3.fromRGB(172, 190, 213), 12)

local toolsTab = button(container, "أدواتي", UDim2.new(0.28, -4, 0, 33), UDim2.fromOffset(16, 91), Color3.fromRGB(35, 119, 164))
local panelsTab = button(container, "لوحات الأدمن", UDim2.new(0.34, -4, 0, 33), UDim2.new(0.31, 0, 0, 91))
local scanButton = button(container, "تحديث الفحص", UDim2.new(0.29, -9, 0, 33), UDim2.new(0.69, 0, 0, 91), Color3.fromRGB(44, 118, 78))

local search = make("TextBox", {
    Name = "Search",
    PlaceholderText = "ابحث عن أداة أو اسم لوحة...",
    Text = "",
    ClearTextOnFocus = false,
    TextColor3 = Color3.fromRGB(245, 247, 252),
    PlaceholderColor3 = Color3.fromRGB(161, 177, 196),
    Font = Enum.Font.Gotham,
    TextSize = 13,
    BackgroundColor3 = Color3.fromRGB(35, 44, 62),
    BorderSizePixel = 0,
    Size = UDim2.new(1, -32, 0, 34),
    Position = UDim2.fromOffset(16, 134),
}, container)
corner(search, 8)
make("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}, search)

local resultArea = make("ScrollingFrame", {
    Name = "Results",
    Size = UDim2.new(1, -32, 1, -242),
    Position = UDim2.fromOffset(16, 176),
    BackgroundTransparency = 1,
    BorderSizePixel = 0,
    ScrollBarThickness = 5,
    CanvasSize = UDim2.new(0, 0, 0, 0),
    AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, container)
local layout = make("UIListLayout", {
    Padding = UDim.new(0, 7),
    SortOrder = Enum.SortOrder.LayoutOrder,
}, resultArea)

local statusText = textLabel(container, "جارٍ التحميل...", UDim2.new(1, -32, 0, 50), UDim2.new(0, 16, 1, -59), Color3.fromRGB(180, 202, 221), 12)

local adminKeywords = {"admin", "adonis", "kohls", "command", "moderator", "staff", "moderation", "ادمن", "أدمن", "ادارة", "إدارة", "اوامر", "أوامر", "مشرف"}
local function looksAdministrative(str)
    str = string.lower(tostring(str or ""))
    for _, keyword in ipairs(adminKeywords) do
        if string.find(str, string.lower(keyword), 1, true) then
            return true
        end
    end
    return false
end

local tools = {}
local panels = {}
local activeTab = "tools"
local connections = {}
local closed = false

local function setStatus(msg)
    if not closed and statusText.Parent then
        statusText.Text = msg
    end
end

local function clearRows()
    for _, child in ipairs(resultArea:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
end

local function listRow(name, description, actionLabel, callback, enabled)
    local row = make("Frame", {
        Size = UDim2.new(1, -8, 0, 76),
        BackgroundColor3 = Color3.fromRGB(34, 44, 63),
        BorderSizePixel = 0,
    }, resultArea)
    corner(row, 8)
    local nm = textLabel(row, name, UDim2.new(1, -125, 0, 25), UDim2.fromOffset(12, 7), Color3.fromRGB(246, 248, 252), 13)
    nm.Font = Enum.Font.GothamBold
    textLabel(row, description, UDim2.new(1, -135, 0, 39), UDim2.fromOffset(12, 31), Color3.fromRGB(177, 194, 211), 11)
    if actionLabel then
        local b = button(row, actionLabel, UDim2.fromOffset(104, 32), UDim2.new(1, -115, 0.5, -16), enabled and Color3.fromRGB(38, 130, 100) or Color3.fromRGB(75, 78, 91))
        b.Active = enabled
        b.AutoButtonColor = enabled
        if enabled and callback then b.MouseButton1Click:Connect(callback) end
    end
    return row
end

local render
render = function()
    if closed then return end
    clearRows()
    toolsTab.BackgroundColor3 = activeTab == "tools" and Color3.fromRGB(35, 119, 164) or Color3.fromRGB(50, 61, 84)
    panelsTab.BackgroundColor3 = activeTab == "panels" and Color3.fromRGB(35, 119, 164) or Color3.fromRGB(50, 61, 84)
    local query = string.lower(search.Text)
    local shown = 0
    if activeTab == "tools" then
        for _, tool in ipairs(tools) do
            if tool.Parent and string.find(string.lower(tool.Name .. " " .. tool.ToolTip), query, 1, true) then
                shown = shown + 1
                local equipped = player.Character and tool.Parent == player.Character
                local adminFlag = looksAdministrative(tool.Name .. " " .. tool.ToolTip) and " | اسم مرتبط بالأدمن" or ""
                local location = equipped and "مجهزة حاليًا" or "في حقيبتك"
                local canEquip = tool.Enabled
                local label = equipped and "مجهزة" or (canEquip and "تجهيز" or "معطلة")
                listRow(tool.Name, location .. adminFlag .. (tool.ToolTip ~= "" and ("\n" .. tool.ToolTip) or ""), label, function()
                    local character = player.Character
                    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                    if not humanoid or humanoid.Health <= 0 then
                        setStatus("لا يمكن تجهيز الأداة قبل ظهور الشخصية.")
                        return
                    end
                    if not tool:IsDescendantOf(backpack) and not tool:IsDescendantOf(character) then
                        setStatus("الأداة لم تعد موجودة في حقيبتك. اضغط تحديث الفحص.")
                        return
                    end
                    if tool.Enabled then
                        local ok = pcall(function() humanoid:EquipTool(tool) end)
                        if ok then
                            setStatus("تم طلب تجهيز: " .. tool.Name .. ". استخدمها بالطريقة الأصلية في الماب؛ نجاح تأثيرها يعتمد على السيرفر.")
                            task.defer(render)
                        else
                            setStatus("تعذر تجهيز الأداة.")
                        end
                    end
                end, canEquip and not equipped)
            end
        end
    else
        for _, panelInfo in ipairs(panels) do
            local panel = panelInfo.gui
            if panel.Parent and string.find(string.lower(panel.Name), query, 1, true) then
                shown = shown + 1
                local state = panel.Enabled and "محمّلة ومفعلة" or "موجودة لكنها غير مفعلة"
                listRow(panel.Name, state .. "\nتحديد اللوحة لا يمنح إذنًا لاستعمال أوامر الإدارة.", "تفاصيل", function()
                    setStatus("اللوحة: " .. panel.Name .. " | " .. state .. ". افتحها من زر الماب الأصلي إذا كان متاحًا لك.")
                end, true)
            end
        end
    end
    if shown == 0 then
        listRow("لا توجد نتائج", "ما ظهر شيء مطابق للفحص أو لكلمة البحث.", nil, nil, false)
    end
end

local function scan()
    if closed then return end
    local seen = {}
    tools, panels = {}, {}
    local character = player.Character
    for _, parent in ipairs({backpack, character}) do
        if parent then
            for _, obj in ipairs(parent:GetChildren()) do
                if obj:IsA("Tool") and not seen[obj] then
                    seen[obj] = true
                    table.insert(tools, obj)
                end
            end
        end
    end
    table.sort(tools, function(a, b) return string.lower(a.Name) < string.lower(b.Name) end)

    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui ~= ui then
            local match = looksAdministrative(gui.Name)
            if not match then
                local inspected = 0
                for _, desc in ipairs(gui:GetDescendants()) do
                    inspected = inspected + 1
                    if inspected > 120 then break end
                    if (desc:IsA("Frame") or desc:IsA("TextButton") or desc:IsA("ImageButton")) and looksAdministrative(desc.Name) then
                        match = true
                        break
                    end
                end
            end
            if match then table.insert(panels, {gui = gui}) end
        end
    end
    table.sort(panels, function(a, b) return string.lower(a.gui.Name) < string.lower(b.gui.Name) end)
    setStatus(string.format("الفحص: %d أداة تملكها + %d واجهة إدارة محتملة. صلاحيات السيرفر لا يمكن إثباتها من العميل.", #tools, #panels))
    render()
end

local showing = true
closeButton.MouseButton1Click:Connect(function()
    closed = true
    for _, conn in ipairs(connections) do conn:Disconnect() end
    ui:Destroy()
end)
miniButton.MouseButton1Click:Connect(function()
    showing = not showing
    hint.Visible = showing
    toolsTab.Visible = showing
    panelsTab.Visible = showing
    scanButton.Visible = showing
    search.Visible = showing
    resultArea.Visible = showing
    statusText.Visible = showing
    container.Size = showing and UDim2.fromOffset(470, 510) or UDim2.fromOffset(470, 55)
    miniButton.Text = showing and "−" or "+"
end)
toolsTab.MouseButton1Click:Connect(function() activeTab = "tools"; render() end)
panelsTab.MouseButton1Click:Connect(function() activeTab = "panels"; render() end)
scanButton.MouseButton1Click:Connect(scan)
search:GetPropertyChangedSignal("Text"):Connect(render)

-- Hotkey to show/hide the interface without losing scan state.
table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    if processed or closed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then ui.Enabled = not ui.Enabled end
end))

-- Simple drag on the panel's title area.
do
    local dragging, dragOrigin, panelOrigin
    table.insert(connections, title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragOrigin = input.Position
            panelOrigin = container.Position
        end
    end))
    table.insert(connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragOrigin
            container.Position = UDim2.new(panelOrigin.X.Scale, panelOrigin.X.Offset + delta.X, panelOrigin.Y.Scale, panelOrigin.Y.Offset + delta.Y)
        end
    end))
    table.insert(connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
end

scan()

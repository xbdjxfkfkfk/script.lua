local function toggle(parent,label,desc,key,callback)
    local act
    act=option(parent,label,desc,"",function()
        callback(not state[key])
        refreshToggles()
    end)
    local function refresh()
        local yes=state[key]
        act.Text=yes and "● ON" or "○ OFF"
        act.BackgroundColor3=yes and K.accent2 or K.card
        act:SetAttribute("OnToggle",yes)
    end
    table.insert(buttonsToRefresh,refresh)
    refresh()
    return act
end
local function numeric(parent,label,desc,key,min,max,step,callback)
    local card=make("Frame", {
        Size=UDim2.new(1,-4,0,82),BackgroundColor3=K.panel,BorderSizePixel=0,
    },parent)
    round(card,10);edge(card,K.stroke,1,.48)
    local name=txt(card,label,14,true)
    name.Position=UDim2.fromOffset(12,6);name.Size=UDim2.new(1,-20,0,25)
    local hint=txt(card,desc,11,false,K.muted)
    hint.Position=UDim2.fromOffset(12,30);hint.Size=UDim2.new(.55,0,0,40);hint.TextWrapped=true
    local minus=button(card,"−",UDim2.fromOffset(35,34))
    minus.Position=UDim2.new(1,-157,.5,-5)
    local value=txt(card,tostring(state[key]),15,true,K.white)
    value.TextXAlignment=Enum.TextXAlignment.Center
    value.Position=UDim2.new(1,-118,.5,-5)
    value.Size=UDim2.fromOffset(64,34)
    local plus=button(card,"+",UDim2.fromOffset(35,34))
    plus.Position=UDim2.new(1,-48,.5,-5)
    local function refresh() value.Text=tostring(state[key]) end
    table.insert(buttonsToRefresh, refresh)
    local function change(delta)
        state[key]=math.clamp(state[key]+delta,min,max)
        callback(state[key])
        refresh()
    end
    track(minus.MouseButton1Click:Connect(function()change(-step)end))
    track(plus.MouseButton1Click:Connect(function()change(step)end))
    return card
end


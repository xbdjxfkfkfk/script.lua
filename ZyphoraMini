local function refreshTools()
    clearTools()
    local backpack=me:FindFirstChildOfClass("Backpack")
    local char=me.Character
    local count=0
    local localList={}
    if backpack then
        for _,obj in ipairs(backpack:GetChildren()) do if obj:IsA("Tool") then table.insert(localList,obj) end end
    end
    if char then
        for _,obj in ipairs(char:GetChildren()) do if obj:IsA("Tool") then table.insert(localList,obj) end end
    end
    for _,tool in ipairs(localList) do
        count+=1
        local b=button(toolScroll,"تجهيز أداة حقيبتك • "..tool.Name,0,0,534,43,function()
            local hum=getHum(me)
            if not hum then message("شخصيتك غير جاهزة",false);return end
            if tool.Parent==char then hum:UnequipTools() else hum:EquipTool(tool) end
            message("أداة شخصية: "..tool.Name,true)
        end)
        b.Size=UDim2.new(1,-17,0,43)
    end
    if count==0 then
        local b=button(toolScroll,"لا توجد أدوات في حقيبتك الآن",0,0,534,43,function()
            message("الملفات في ServerStorage غير متاحة للعميل دون إذن السيرفر",false)
        end)
        b.Size=UDim2.new(1,-17,0,43)
    end
    if serverRemote then
        serverCall("tools",nil,function(result)
            if not result.ok then return end
            for _,name in ipairs(result.items or {}) do
                local b=button(toolScroll,"أداة معتمدة من سيرفرك • "..name,0,0,534,43,function()
                    serverCall("tool",name,function(r)
                        if r.ok then task.delay(0.3,refreshTools) end
                    end)
                end)
                b.Size=UDim2.new(1,-17,0,43)
            end
        end)
    end
end

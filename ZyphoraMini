local function cleanup()
    if not live then return end
    live = false
    STATE.Speed = false
    STATE.LocalInvisible = false
    STATE.Noclip = false
    STATE.Fly = false
    if currentHumanoid and currentHumanoid.Parent and originalWalkSpeed then
        currentHumanoid.WalkSpeed = originalWalkSpeed
    end
    restoreVisuals()
    restoreCollision()
    stopFly()
    for player in pairs(outlines) do removeOutline(player) end
    if characterConnection then characterConnection:Disconnect() end
    for _, connection in ipairs(mainConnections) do connection:Disconnect() end
    for _, connection in pairs(playerConnections) do connection:Disconnect() end
end

track(gui.Destroying, cleanup)

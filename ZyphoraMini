local aimConn = nil

local function startAimbot()
    if aimConn then aimConn:Disconnect() end
    
    aimConn = RunService.RenderStepped:Connect(function(dt)
        if not S.Aim then return end
        
        local cam = WS.CurrentCamera
        if not cam then return end
        
        -- Update FOV circle
        local vp = cam.ViewportSize
        local radius = S.FOV / 2
        fovCircle.Size = UDim2.fromOffset(radius * 2, radius * 2)
        fovCircle.Position = UDim2.fromOffset(vp.X / 2, vp.Y / 2)
        fovCircle.Visible = true
        
        -- Find target
        local r = root()
        if not r then return end
        
        local center = Vector2.new(vp.X / 2, vp.Y / 2)
        local closest, closestDist = nil, math.huge
        
        for _, v in pairs(WS:GetDescendants()) do
            if v:IsA("Model") and isAnimal(v) then
                local head = v:FindFirstChild("Head") or v:FindFirstChildWhichIsA("BasePart")
                if head then
                    local d = (head.Position - r.Position).Magnitude
                    if d <= S.AimRange then
                        local pos, onScreen = cam:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local pd = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if pd <= radius and pd < closestDist then
                                closest = head
                                closestDist = pd
                            end
                        end
                    end
                end
            end
        end
        
        -- Aim at target
        if closest then
            local target = CFrame.lookAt(cam.CFrame.Position, closest.Position)
            local alpha = 1 - math.exp(-(S.AimSmooth / 10) * 30 * dt)
            cam.CFrame = cam.CFrame:Lerp(target, alpha)
        end
    end)
end

local function stopAimbot()
    if aimConn then aimConn:Disconnect() aimConn = nil end
    fovCircle.Visible = false
end

-- Watch for Aim toggle
task.spawn(function()
    while alive do
        if S.Aim and not aimConn then
            startAimbot()
        elseif not S.Aim and aimConn then
            stopAimbot()
        end
        task.wait(0.1)
    end
end)

--====================================
-- CAR FLY
--====================================

local flyObj = nil

local function updateCarFly()
    if not S.CarFly then
        if flyObj then
            flyObj:Destroy()
            flyObj = nil
        end
        return
    end
    
    local h = hum()
    if not h or not h.SeatPart then return end
    
    local seat = h.SeatPart
    local body = seat.AssemblyRootPart or seat
    
    if not flyObj or not flyObj.Parent then
        flyObj = Instance.new("LinearVelocity")
        flyObj.Attachment0 = body:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", body)
        flyObj.MaxForce = math.huge
        flyObj.Parent = body
    end
    
    local cam = WS.CurrentCamera
    if not cam then return end
    
    local dir = Vector3.new()
    if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.E) then dir += Vector3.new(0, 1, 0) end
    if UIS:IsKeyDown(Enum.KeyCode.Q) then dir -= Vector3.new(0, 1, 0) end
    
    flyObj.VectorVelocity = dir * S.CarFlySpeed
end


-- Touch + mouse drag of the header
local isDragging = false
local dragInput, dragStart, windowStart
track(header.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragInput = input
        dragStart = input.Position
        windowStart = main.Position
    end
end)
track(header.InputEnded, function(input)
    if input == dragInput then isDragging = false end
end)
track(UIS.InputChanged, function(input)
    if isDragging and (input == dragInput or (dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            windowStart.X.Scale, windowStart.X.Offset + delta.X / scale.Scale,
            windowStart.Y.Scale, windowStart.Y.Offset + delta.Y / scale.Scale
        )
    end
end)

track(UIS.JumpRequest, function()
    if STATE.InfiniteJump and currentHumanoid then
        currentHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

track(LP.CharacterAdded, function(character)
    task.defer(function()
        if live and character.Parent then attachCharacter(character) end
    end)
end)

local function watchPlayer(player)
    if player == LP then return end
    scanRank(player)
    if not playerConnections[player] then
        playerConnections[player] = player.CharacterAdded:Connect(function()
            task.defer(function()
                if live and refreshRoster then refreshRoster() end
            end)
        end)
    end
end

track(Players.PlayerAdded, function(player)
    watchPlayer(player)
    if refreshRoster then refreshRoster() end
end)
track(Players.PlayerRemoving, function(player)
    removeOutline(player)
    rankCache[player] = nil
    rankPending[player] = nil
    if playerConnections[player] then
        playerConnections[player]:Disconnect()
        playerConnections[player] = nil
    end
    task.defer(function()
        if live and refreshRoster then refreshRoster() end
    end)
end)

local localTimer, rosterTimer = 0, 0
track(RunService.Heartbeat, function(dt)
    if not live then return end
    localTimer = localTimer + dt
    rosterTimer = rosterTimer + dt
    verticalControls.Visible = STATE.Fly and not main.Visible
    if STATE.Fly then
        beginFly()
        if flightVelocity and currentHumanoid then
            local horizontal = currentHumanoid.MoveDirection
            local altitude = (flyingUp and 1 or 0) - (flyingDown and 1 or 0)
            local direction = horizontal + Vector3.new(0, altitude, 0)
            if direction.Magnitude > 1 then direction = direction.Unit end
            flightVelocity.VectorVelocity = direction * STATE.FlyValue
        end
    end
    if STATE.Noclip then applyNoclip() end
    if localTimer >= 0.18 then
        localTimer = 0
        if STATE.Speed then updateSpeed() end
        if STATE.LocalInvisible then applyInvisible() end
    end
    if rosterTimer >= 4 then
        rosterTimer = 0
        refreshRoster()
    end
end)

if LP.Character then attachCharacter(LP.Character) end
for _, player in ipairs(Players:GetPlayers()) do watchPlayer(player) end
refreshRoster()

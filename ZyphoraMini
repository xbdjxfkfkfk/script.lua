	for plrName, st in pairs(States or {}) do
		local plr = Players:FindFirstChild(plrName)
		if plr then
			local t = getHRP(plr)
			if t then
				if st.Freeze then
					pcall(function() t.Anchored = true end)
				end
				if st.Grab then
					local c = getChar()
					if c then
						pcall(function()
							t.CFrame = c.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
						end)
					end
				end
			end
		end
	end
end)


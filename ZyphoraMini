-- Freeze mitigation: keep the render thread strictly for flight.
-- Optional radar/ESP/visual-carry updates use slower Heartbeat ticks.
local elapsed, adminElapsed, dragElapsed, radarElapsed, noclipElapsed = 0, 0, 0, 0, 0
listen(RunService.RenderStepped, function()
    if alive and state.Fly then updateFlight() end
end)
listen(RunService.Heartbeat, function(dt)
    if not alive then return end
    dt = math.min(dt, .2)
    noclipElapsed = noclipElapsed + dt
    if state.Noclip and noclipElapsed >= .25 then
        noclipElapsed = 0
        applyNoclip()
    end
    if dragClone then
        dragElapsed = dragElapsed + dt
        if dragElapsed >= (state.LowPerformance and .17 or .12) then
            updateVisualDrag(dragElapsed)
            dragElapsed = 0
        end
    end
    if state.Radar then
        radarElapsed = radarElapsed + dt
        if radarElapsed >= (state.LowPerformance and 2 or .85) then
            radarElapsed = 0
            updateRadar()
        end
    end
    elapsed = elapsed + dt
    adminElapsed = adminElapsed + dt
    if elapsed >= (state.LowPerformance and 2 or .85) then
        elapsed = 0
        if state.LocalInvisible then applyLocalInvisible() end
        if state.Speed then applySpeed() end
        if state.ESP then refreshHighlights() end
    end
    if adminElapsed >= (state.LowPerformance and 8 or 4.5) then
        adminElapsed = 0
        if state.AdminESP then refreshAdminVision() end
    end
end)

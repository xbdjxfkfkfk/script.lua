-- =========================================================
-- Discord gate: block script until real Discord is active
-- If Discord disconnects while running, lock again
-- =========================================================
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
if not LP then
    warn("Lx: no LocalPlayer")
    return
end

local PG = LP:WaitForChild("PlayerGui", 12)
if not PG then
    warn("Lx: PlayerGui unavailable")
    return
end

-- To be honest: inside Roblox you cannot truly prove "real Discord account"
-- from the client alone. The practical method is verifying the local Discord
-- RPC server is active on localhost:6463.
local DISCORD_PORTS = {6463, 6464}

local function discordIsAlive()
    for _, port in ipairs(DISCORD_PORTS) do
        local ok, result = pcall(function()
            if syn and syn.request then
                return syn.request({
                    Url = "http://127.0.0.1:" .. port .. "/",
                    Method = "GET",
                    Headers = {
                        ["Content-Type"] = "application/json"
                    }
                })
            end

            if http and http.request then
                return http.request({
                    Url = "http://127.0.0.1:" .. port .. "/",
                    Method = "GET",
                    Headers = {
                        ["Content-Type"] = "application/json"
                    }
                })
            end

            if request then
                return request({
                    Url = "http://127.0.0.1:" .. port .. "/",
                    Method = "GET",
                    Headers = {
                        ["Content-Type"] = "application/json"
                    }
                })
            end

            return nil
        end)

        if ok and result then
            -- syn/http/request return different shapes depending on executor
            if type(result) == "table" then
                if result.Success ~= false and (result.StatusCode == nil or result.StatusCode >= 200) then
                    return true
                end
            elseif type(result) == "string" then
                if result ~= "" then
                    return true
                end
            elseif typeof(result) == "Instance" then
                if result.StatusCode ~= nil and result.StatusCode >= 200 then
                    return true
                end
            end
        end
    end

    return false
end


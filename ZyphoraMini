  flyAttachment=Instance.new('Attachment');flyAttachment.Name='LxFlyAttachment';flyAttachment.Parent=body
  flyVelocity=Instance.new('LinearVelocity')
  flyVelocity.Name='LxFlyVelocity'
  flyVelocity.Attachment0=flyAttachment
  flyVelocity.RelativeTo=Enum.ActuatorRelativeTo.World
  flyVelocity.VelocityConstraintMode=Enum.VelocityConstraintMode.Vector
  flyVelocity.MaxForce=math.max(100000,body.AssemblyMass*2500)
  flyVelocity.Parent=body
  flyOrientation=Instance.new('AlignOrientation')
  flyOrientation.Name='LxFlyOrientation'
  flyOrientation.Attachment0=flyAttachment
  flyOrientation.Mode=Enum.OrientationAlignmentMode.OneAttachment
  flyOrientation.Responsiveness=12
  flyOrientation.MaxTorque=math.max(100000,body.AssemblyMass*2500)
  flyOrientation.Parent=body
 end
 local cam=WS.CurrentCamera
 if not cam then flyState='الكاميرا غير متاحة';return end
 local look=cam.CFrame.LookVector
 local right=cam.CFrame.RightVector
 local forward=Vector3.new(look.X,0,look.Z)
 local side=Vector3.new(right.X,0,right.Z)
 if forward.Magnitude<.01 then forward=Vector3.new(seat.CFrame.LookVector.X,0,seat.CFrame.LookVector.Z) end
 if forward.Magnitude<.01 then forward=Vector3.new(0,0,-1) end
 forward=forward.Unit
 if side.Magnitude<.01 then side=Vector3.new(-forward.Z,0,forward.X) end
 side=side.Unit
 local input=Vector3.zero
 if UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up) then input+=forward end
 if UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down) then input-=forward end
 if UIS:IsKeyDown(Enum.KeyCode.D) then input+=side end
 if UIS:IsKeyDown(Enum.KeyCode.A) then input-=side end
 if UIS:IsKeyDown(Enum.KeyCode.E) then input+=Vector3.yAxis end
 if UIS:IsKeyDown(Enum.KeyCode.Q) then input-=Vector3.yAxis end
 local speed=math.clamp(S.FlySpeed,20,300)
 flyVelocity.VectorVelocity=input.Magnitude>0 and input.Unit*speed or Vector3.zero
 flyOrientation.CFrame=CFrame.lookAt(Vector3.zero,forward)
 flyState=string.format('الطيران نشط | سرعة %.0f | الحركة %s',speed,input.Magnitude>0 and 'نعم' or 'ثبات')
end

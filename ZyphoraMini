refreshRoster = function()
    if not live then return end
    local people = Players:GetPlayers()
    table.sort(people, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)
    for _, child in ipairs(rows:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local count = 0
    local owners = 0
    for _, player in ipairs(people) do
        if player ~= LP then
            count = count + 1
            local kind, reason = inspectPlayer(player)
            if kind == "owner" then owners = owners + 1 end
            local line = create("Frame", {
                BackgroundColor3 = Color3.fromRGB(34, 29, 51),
                Size = UDim2.new(1, 0, 0, 57),
            }, rows)
            corner(line, 8)
            local name = create("TextLabel", {
                Text = player.DisplayName .. " (@" .. player.Name .. ")",
                TextSize = 13, Font = Enum.Font.GothamBold,
                TextColor3 = TEXT,
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(11, 5),
                Size = UDim2.new(1, -22, 0, 23),
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
            }, line)
            local text = "غير معروف — " .. reason
            local color = MUTED
            if STATE.AdminDetect and kind == "owner" then
                text, color = "مالك مؤكد — " .. reason, GREEN
            elseif STATE.AdminDetect and kind == "possible" then
                text, color = "مؤشر فقط — " .. reason, AMBER
            end
            create("TextLabel", {
                Text = text,
                TextSize = 11, Font = Enum.Font.Gotham,
                TextColor3 = color,
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(11, 28),
                Size = UDim2.new(1, -22, 0, 24),
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
            }, line)
            scanRank(player)
        end
    end
    rosterTitle.Text = string.format("اللاعبون (%d) — مالكو التجربة الظاهرون: %d", count, owners)
    local newHeight = math.max(33, count * 62)
    rows.Size = UDim2.new(1, -18, 0, newHeight)
    roster.Size = UDim2.new(1, 0, 0, newHeight + 45)
    syncOutlines()
end


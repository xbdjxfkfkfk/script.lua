local alive = true
local cons = {}
local function connect(signal, callback)
    local c = signal:Connect(callback)
    cons[#cons + 1] = c
    return c
end
local theme = {
    bg = Color3.fromRGB(18, 19, 24),
    bar = Color3.fromRGB(29, 30, 38),
    side = Color3.fromRGB(23, 25, 32),
    surface = Color3.fromRGB(38, 41, 51),
    active = Color3.fromRGB(83, 53, 43),
    accent = Color3.fromRGB(246, 161, 102),
    text = Color3.fromRGB(245, 243, 241),
    subdued = Color3.fromRGB(170, 174, 187),
    success = Color3.fromRGB(121, 221, 158),
}
local function make(kind, parent, data)
    local x = Instance.new(kind)
    for k,v in pairs(data or {}) do x[k] = v end
    x.Parent = parent
    return x
end
local function round(x, n)
    make("UICorner", x, {CornerRadius = UDim.new(0, n or 9)})
end
local function outline(x)
    make("UIStroke", x, {Color = theme.accent, Thickness = 1, Transparency = .55})
end
local function txt(parent, value, size, pos, dim, color, strong)
    return make("TextLabel", parent, {
        BackgroundTransparency = 1, Position = pos, Size = dim,
        Text = value, TextSize = size or 15, TextColor3 = color or theme.text,
        Font = strong and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    })
end
local function btn(parent, value, pos, dim, fn, background)
    local b = make("TextButton", parent, {
        BackgroundColor3 = background or theme.surface,
        BorderSizePixel = 0, Text = value, TextColor3 = theme.text,
        Font = Enum.Font.GothamBold, TextSize = 14, TextWrapped = true,
        Position = pos, Size = dim, AutoButtonColor = true
    })
    round(b, 8)
    connect(b.Activated, fn)
    return b
end
local function box(parent, text, pos, dim)
    local b = make("TextBox", parent, {
        Position=pos, Size=dim, Text=text, ClearTextOnFocus=false,
        Font=Enum.Font.Gotham, TextSize=15,
        TextColor3=theme.text, BackgroundColor3=theme.surface,
        BorderSizePixel=0, PlaceholderColor3=theme.subdued,
    })
    round(b, 7)
    return b
end


local function addToggle(labelText, initialState, onToggle)
    local btn = inst("TextButton",{
        Size = UDim2.new(0,120,0,30),
        BackgroundColor3 = initialState and Color3.fromRGB(80,215,135) or Color3.fromRGB(184,186,190),
        TextColor3 = Color3.new(1,1,1),
        Text = labelText.." ["..(initialState and "ON" or "OFF").."]",
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        BorderSizePixel = 0,
    }, UI.Content)
    round(btn,6)

    btn.MouseButton1Click:Connect(function()
        initialState = not initialState
        btn.BackgroundColor3 = initialState and Color3.fromRGB(80,215,135) or Color3.fromRGB(184,186,190)
        btn.Text = labelText.." ["..(initialState and "ON" or "OFF").."]"
        onToggle(initialState)
    end)

    return btn
end


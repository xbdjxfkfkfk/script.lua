local function stopFlying()
    flightEnabled=false
    touchUp,touchDown=false,false
    if flightConnection then flightConnection:Disconnect() flightConnection=nil end
    for _, v in ipairs(flightObjects) do if v.Parent then v:Destroy() end end
    table.clear(flightObjects)
    local humanoid=me.Character and me.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.PlatformStand=false
        humanoid.AutoRotate=true
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    mobileFlyControls.Visible=false
end
local function startFlying()
    stopFlying()
    local character=me.Character
    local root=character and character:FindFirstChild("HumanoidRootPart")
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    if not root or not root:IsA("BasePart") or not humanoid then
        notify("الشخصية غير جاهزة للطيران.",false)
        return
    end
    flightEnabled=true
    -- Avoid getting stuck in a seated state before enabling the constraints.
    if humanoid.Sit then humanoid.Sit = false end
    local attachment=create("Attachment",root,{Name="NOVA_FlightAttachment"}) :: Attachment
    local velocity=create("LinearVelocity",root,{
        Name="NOVA_FlightVelocity",Attachment0=attachment,
        RelativeTo=Enum.ActuatorRelativeTo.World,
        MaxForce=math.huge,ForceLimitsEnabled=false,
        VectorVelocity=Vector3.zero,
    }) :: LinearVelocity
    local orientation=create("AlignOrientation",root,{
        Name="NOVA_FlightOrientation",Attachment0=attachment,
        Mode=Enum.OrientationAlignmentMode.OneAttachment,
        MaxTorque=math.huge,Responsiveness=25,RigidityEnabled=false,
    }) :: AlignOrientation
    flightObjects={orientation,velocity,attachment}
    humanoid.AutoRotate=false
    humanoid.PlatformStand=true
    mobileFlyControls.Visible=UserInputService.TouchEnabled
    flightConnection=RunService.RenderStepped:Connect(function()
        if not root.Parent or humanoid.Health<=0 then stopFlying() return end
        local camera=Workspace.CurrentCamera
        if not camera then return end
        local forward=Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z)
        if forward.Magnitude<.001 then forward=Vector3.new(0,0,-1) end
        forward=forward.Unit
        local right=Vector3.new(camera.CFrame.RightVector.X,0,camera.CFrame.RightVector.Z).Unit
        local move = humanoid.MoveDirection
        if activeControls then
            local raw = activeControls:GetMoveVector()
            -- Raw movement is camera-relative (negative Z is forward).
            move = forward * -raw.Z + right * raw.X
        else
            -- Fallback if the game's custom player module has no movement API.
            move = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move+=forward end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move-=forward end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move+=right end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move-=right end
            if UserInputService.TouchEnabled then move+=humanoid.MoveDirection end
        end
        local up=touchUp or UserInputService:IsKeyDown(Enum.KeyCode.Space)
        local down=touchDown or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        local direction=move+Vector3.new(0,(up and 1 or 0)-(down and 1 or 0),0)
        velocity.VectorVelocity=(direction.Magnitude>0 and direction.Unit or Vector3.zero)*flightSpeed
        orientation.CFrame=CFrame.lookAt(Vector3.zero,forward)
    end)
end


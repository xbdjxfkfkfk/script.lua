-- Touch/mouse draggable header. The NOVA button always stays visible.
local dragging=false
local startInput
local startPos
local touchInput
header.InputBegan:Connect(function(io)
    if io.UserInputType==Enum.UserInputType.MouseButton1 or io.UserInputType==Enum.UserInputType.Touch then
        dragging=true;startInput=io.Position;startPos=main.Position;touchInput=io
    end
end)
UserInputService.InputChanged:Connect(function(io)
    if dragging and (io==touchInput or io.UserInputType==Enum.UserInputType.MouseMovement) then
        local delta=io.Position-startInput
        main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,
            startPos.Y.Scale,startPos.Y.Offset+delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(io)
    if io==touchInput or (touchInput and touchInput.UserInputType==Enum.UserInputType.MouseButton1
        and io.UserInputType==Enum.UserInputType.MouseButton1) then
        dragging=false
    end
end)


-- Slider
local function slider(title, desc, key, min, max, default, order)
    local f = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 60),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0,
        LayoutOrder = order
    }, scroll)
    round(f, 8)
    
    inst("TextLabel", {
        Size = UDim2.new(0.7, 0, 0, 20),
        Position = UDim2.fromOffset(10, 5),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = C.white,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, f)
    
    local val = inst("TextLabel", {
        Size = UDim2.new(0.25, 0, 0, 20),
        Position = UDim2.new(0.75, -5, 0, 5),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = C.accent,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right
    }, f)
    
    inst("TextLabel", {
        Size = UDim2.new(1, -20, 0, 16),
        Position = UDim2.fromOffset(10, 24),
        BackgroundTransparency = 1,
        Text = desc or "",
        TextColor3 = C.muted,
        Font = Enum.Font.Gotham,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left
    }, f)
    
    local bg = inst("Frame", {
        Size = UDim2.new(1, -20, 0, 5),
        Position = UDim2.fromOffset(10, 45),
        BackgroundColor3 = Color3.fromRGB(40, 40, 50),
        BorderSizePixel = 0
    }, f)
    round(bg, 3)
    
    local fill = inst("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0
    }, bg)
    round(fill, 3)
    
    S[key] = default
    
    local dragging = false
    
    local function update(input)
        local rel = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * rel)
        S[key] = v
        val.Text = tostring(v)
        fill.Size = UDim2.new(rel, 0, 1, 0)
    end
    
    conn(bg.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input)
        end
    end)
    
    conn(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    conn(UIS.InputChanged, function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input)
        end
    end)
    
    return f
end


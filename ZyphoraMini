-- Engine
local speedTimer = 0
local wildlifeTimer = 0

bind(RunService.Heartbeat, function(dt)
    if not alive then return end

    speedTimer += dt
    wildlifeTimer += dt

    -- Vehicle fly
    if S.CarFly then
        local root = seatedVehicleRoot()
        local camera = Workspace.CurrentCamera

        if root and camera then
            local direction = Vector3.zero
            local cf = camera.CFrame

            if UIS:IsKeyDown(Enum.KeyCode.W) then
                direction += cf.LookVector
            end

            if UIS:IsKeyDown(Enum.KeyCode.S) then
                direction -= cf.LookVector
            end

            if UIS:IsKeyDown(Enum.KeyCode.A) then
                direction -= cf.RightVector
            end

            if UIS:IsKeyDown(Enum.KeyCode.D) then
                direction += cf.RightVector
            end

            if UIS:IsKeyDown(Enum.KeyCode.Space) then
                direction += Vector3.yAxis
            end

            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
                direction -= Vector3.yAxis
            end

            if direction.Magnitude > 0 then
                root.AssemblyLinearVelocity =
                    direction.Unit * (35 * S.Multiplier)
            else
                root.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end

    -- Periodic character updates
    if speedTimer >= 0.25 then
        speedTimer = 0

        if S.Speed then
            local hum = getHumanoid()

            if hum then
                hum.WalkSpeed = 16 * S.Multiplier
            end
        end

        if S.Invis then
            applyInvisibility()
        end
    end

    -- Budgeted wildlife processing
    if S.LizardScan and wildlifeTimer >= 0.1 then
        wildlifeTimer = 0

        local processed = 0

        while wildlifeScanIndex <= #wildlifeSnapshot
            and processed < 50 do

            local obj = wildlifeSnapshot[wildlifeScanIndex]
            wildlifeScanIndex += 1
            processed += 1

            if obj and obj.Parent and isWildlife(obj) then
                addWildlife(obj)
            end
        end

        local queued = 0

        while #wildlifeQueue > 0 and queued < 20 do
            local obj = table.remove(wildlifeQueue)
            wildlifeQueued[obj] = nil
            queued += 1

            if obj and obj.Parent and isWildlife(obj) then
                addWildlife(obj)
            end
        end

        for obj, gui in pairs(wildlifeObjects) do
            if not obj.Parent then
                gui:Destroy()
                wildlifeObjects[obj] = nil
            end
        end
    end
end)

bind(Workspace.DescendantAdded, function(obj)

-- Create a local-only visual clone BEFORE the server hides the real character.
-- Server hides the actual replicated avatar, while only this client renders the proxy.
local ghost, ghostConn, localHidden=false,nil,false
local function clearGhost()
    if ghostConn then ghostConn:Disconnect(); ghostConn=nil end
    if ghost then ghost:Destroy(); ghost=nil end
end
local function relpath(root,obj)
    local parts={}
    local n=obj
    while n and n~=root do
        table.insert(parts,1,n.Name .. ":" .. n.ClassName)
        n=n.Parent
    end
    return table.concat(parts,"/")
end
local function buildGhost()
    clearGhost()
    local c=me.Character
    if not c then return end
    local previous=c.Archivable
    c.Archivable=true
    local success, copy=pcall(function() return c:Clone() end)
    c.Archivable=previous
    if not success or not copy then return end
    copy.Name="NOVA_ONLY_I_CAN_SEE"
    local originalParts={}
    for _,p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then originalParts[relpath(c,p)]=p end
    end
    local pairsList={}
    for _,o in ipairs(copy:GetDescendants()) do
        if o:IsA("Script") or o:IsA("LocalScript") or o:IsA("ModuleScript")
            or o:IsA("Sound") or o:IsA("ParticleEmitter") or o:IsA("Beam")
            or o:IsA("Trail") then
            o:Destroy()
        elseif o:IsA("BasePart") then
            local source=originalParts[relpath(copy,o)]
            if source then table.insert(pairsList,{from=source,to=o}) end
            o.Anchored=true
            o.CanCollide=false
            o.CanTouch=false
            o.CanQuery=false
            o.CastShadow=false
            o.LocalTransparencyModifier=0
            if o.Name=="HumanoidRootPart" then o.Transparency=1
            elseif o.Transparency>=.98 then o.Transparency=0 end
        elseif o:IsA("Decal") or o:IsA("Texture") then
            if o.Transparency>=.98 then o.Transparency=0 end
        elseif o:IsA("Humanoid") then
            o.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
        end
    end
    ghost=copy
    ghost.Parent=workspace.CurrentCamera or workspace
    ghostConn=RunService.RenderStepped:Connect(function()
        if not ghost or me.Character~=c then clearGhost(); return end
        for _,item in ipairs(pairsList) do
            if item.from.Parent and item.to.Parent then
                item.to.CFrame=item.from.CFrame
            end
        end
    end)
end

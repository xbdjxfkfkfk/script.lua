local function toolKey(name)
    -- One instance per normalized name, regardless of how many templates exist.
    return safeText(name):gsub("^%s+", ""):gsub("%s+$", ""):lower()
end
local function toolInSomeoneCharacter(obj)
    if not obj:IsDescendantOf(Workspace) then return false end
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character and obj:IsDescendantOf(character) then return true end
    end
    return false
end
local function ownedToolNames()
    local owned = {}
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({backpack, LocalPlayer.Character}) do
        if holder then
            for _, item in ipairs(holder:GetChildren()) do
                if item:IsA("Tool") then owned[toolKey(item.Name)] = true end
            end
        end
    end
    return owned, backpack
end
local function copyToolOnce(source, owned)
    if not source:IsA("Tool") or toolInSomeoneCharacter(source) then
        return false, "skipped"
    end
    local name = toolKey(source.Name)
    if name == "" or owned[name] then
        return false, "duplicate"
    end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return false, "no-backpack" end
    local success, clone = pcall(function() return source:Clone() end)
    if not success or not clone then return false, "failed" end
    -- Mark client-created copies so the UI does not count them as server grants.
    pcall(function() clone:SetAttribute("NOVA_LocalCopy", true) end)
    local put = pcall(function() clone.Parent = backpack end)
    if not put or clone.Parent ~= backpack then
        pcall(function() clone:Destroy() end)
        return false, "failed"
    end
    owned[name] = true
    return true, "copied"
end
local function currentInventoryCounts()
    local keys, copiedKeys = {}, {}
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({backpack, LocalPlayer.Character}) do
        if holder then
            for _, item in ipairs(holder:GetChildren()) do
                if item:IsA("Tool") then
                    local key = toolKey(item.Name)
                    if key ~= "" then
                        keys[key] = true
                        if item:GetAttribute("NOVA_LocalCopy") == true then copiedKeys[key] = true end
                    end
                end
            end
        end
    end
    local total, localCount = 0, 0
    for _ in pairs(keys) do total = total + 1 end
    for _ in pairs(copiedKeys) do localCount = localCount + 1 end
    return total, localCount
end
local function copyVisibleTools(silent)
    if not alive then return end
    if toolScanRunning then
        if not silent then say("الفحص شغال الآن؛ انتظر حتى تظهر النتيجة", true) end
        return
    end
    local owned, backpack = ownedToolNames()
    if not backpack then
        say("الحقيبة غير جاهزة حاليًا", false)
        return
    end
    toolScanRunning = true
    if toolsInfo then toolsInfo.Text = "جارٍ الفحص على دفعات بدون إيقاف اللعب..." end
    local copied, duplicates, failed = 0, 0, 0
    local ok, scanned, truncated = pcall(function()
        return visitVisible(TOOL_CONTAINERS, 5000, function(candidate)
            if candidate:IsA("Tool") and not toolInSomeoneCharacter(candidate) then
                local key = toolKey(candidate.Name)
                if key ~= "" then visibleToolIndex[key] = candidate.Name end
                local didCopy, reason = copyToolOnce(candidate, owned)
                if didCopy then copied = copied + 1
                elseif reason == "duplicate" then duplicates = duplicates + 1
                elseif reason == "failed" then failed = failed + 1 end
                return false -- no need to traverse the internals of a Tool
            end
            return true
        end)
    end)
    toolScanRunning = false
    if not alive then return end
    local unique = 0
    for _ in pairs(visibleToolIndex) do unique = unique + 1 end
    local total, locally = currentInventoryCounts()
    refreshToolUI()
    if toolsInfo then
        toolsInfo.Text = "الحقيبة: " .. total .. " اسم (منها " .. locally .. " نسخ محلية)"
            .. " | مرئية: " .. unique .. " | نسخ جديدة: " .. copied
            .. " | مكررة: " .. duplicates .. " | تعذّر: " .. failed
            .. (truncated and " | الفحص محدود لخفة الأداء" or "")
        toolsInfo.Size = UDim2.new(1, 0, 0, 75)
    end
    if not ok then
        warn("NOVA Tool Scan: " .. safeText(scanned))
        if not silent then say("تعذّر فحص بعض أدوات الماب؛ بقية القوائم مستمرة", false) end
    elseif not silent then
        say("اكتمل فحص الأدوات الظاهرة: " .. copied .. " نسخ جديدة محليًا"
            .. (truncated and "، ووصلنا لحدّ الأداء" or ""), copied > 0)
    end
end

-- Auto-collect is opt-in. Scan only the newly replicated Tool, not the entire map.
local function newVisibleTool(obj)
    if not alive or not obj:IsA("Tool") or toolInSomeoneCharacter(obj) then return end
    local key = toolKey(obj.Name)
    if key == "" then return end
    visibleToolIndex[key] = obj.Name
    if state.AutoTools then
        task.defer(function()
            if not alive or not state.AutoTools or not obj.Parent then return end
            local owned = ownedToolNames()
            local didCopy = copyToolOnce(obj, owned)
            if didCopy then refreshToolUI() end
        end)
    end
end
-- Listening to DescendantAdded for *every* object in Workspace was a source
-- of unnecessary callback traffic on large, frequently changing maps.
-- Watch only direct new children; deep tools remain discoverable through
-- the manual incremental scan button.
for _, container in ipairs(TOOL_CONTAINERS) do
    listen(container.ChildAdded, function(obj)
        if obj:IsA("Tool") then newVisibleTool(obj) end
    end)
end

local adminToolTokens = {
    "admin", "moderator", "mod panel", "ban hammer", "banhammer",
    "kick tool", "kicktool", "owner tool", "admin wand",
    "ادمن", "أدمن", "مشرف"
}
local function visibleAdminTool(player)
    local char = player.Character
    if not char then return nil end
    -- Other players' Backpacks are normally not visible on the client.
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local lower = tool.Name:lower()
            for _, token in ipairs(adminToolTokens) do
                if lower:find(token, 1, true) then
                    return tool.Name
                end
            end
        end
    end
    return nil
end
local rankCache = {}
local rankQueued = {}
local rankQueue = {}
local rankWorkerRunning = false
local function queueGroupRank(player)
    if rankCache[player.UserId] ~= nil or rankQueued[player.UserId] then return end
    rankQueued[player.UserId] = true
    table.insert(rankQueue, player)
    if rankWorkerRunning then return end
    rankWorkerRunning = true
    task.spawn(function()
        while alive and #rankQueue > 0 do
            local candidate = table.remove(rankQueue, 1)
            if candidate and candidate.Parent == Players then
                local ok, rank = pcall(function()
                    return candidate:GetRankInGroup(game.CreatorId)
                end)
                rankCache[candidate.UserId] = (ok and type(rank) == "number") and rank or false
                if alive and state.AdminESP and refreshAdminVision then
                    local success, err = pcall(refreshAdminVision)
                    if not success then warn("NOVA rank visuals: " .. safeText(err)) end
                end
            end
            if candidate then rankQueued[candidate.UserId] = nil end
            task.wait(.35) -- avoid many concurrent rank requests
        end
        rankWorkerRunning = false
    end)
end
local function getRole(player, allowRankCheck)
    if game.CreatorType == Enum.CreatorType.User then
        if player.UserId == game.CreatorId then
            return "مالك التجربة (هوية مؤكدة)", "owner"
        end
    elseif game.CreatorType == Enum.CreatorType.Group then
        local rank = rankCache[player.UserId]
        if rank == nil and allowRankCheck then queueGroupRank(player) end
        if type(rank) == "number" then
            if rank == 255 then
                return "مالك المجموعة (رتبة 255)", "owner"
            elseif rank >= 200 then
                return "رتبة قروب " .. tostring(rank) .. " (ليست إثبات أدمن)", "possible"
            end
        end
    end
    local candidate = visibleAdminTool(player)
    if candidate then
        return "أداة ظاهرة: " .. safeText(candidate) .. " (اشتباه فقط)", "tool"
    end
    if game.CreatorType == Enum.CreatorType.Group and rankCache[player.UserId] == nil then
        return allowRankCheck and "الرتبة قيد التحقق" or "الرتبة لم تُفحص", allowRankCheck and "pending" or "unknown"
    end
    return "صلاحيات الأدمن غير معروفة", "unknown"
end
local function clearHighlights()
    for player, data in pairs(highlighted) do
        if data and data.Parent then data:Destroy() end
        highlighted[player] = nil
    end
end
local function refreshHighlights()
    if not state.ESP then
        clearHighlights()
        return
    end
    for player, mark in pairs(highlighted) do
        if player.Parent ~= Players or not mark or not mark.Parent then
            if mark and mark.Parent then mark:Destroy() end
            highlighted[player] = nil
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and not highlighted[player] then
                highlighted[player] = make("Highlight", {
                    Name = "NovaLocalESP", Adornee = char,
                    FillColor = COLORS.purple, OutlineColor = COLORS.white,
                    FillTransparency = .66, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                }, gui)
            elseif highlighted[player] and highlighted[player].Adornee ~= char then
                highlighted[player]:Destroy()
                highlighted[player] = nil
            end
        end
    end
end

local function clearAdminVisual(player)
    local data = adminVisuals[player]
    if data then
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
        adminVisuals[player] = nil
    end
end
refreshAdminVision = function()
    if not state.AdminESP then
        for player in pairs(adminVisuals) do clearAdminVisual(player) end
        return
    end
    for player in pairs(adminVisuals) do
        if player.Parent ~= Players then clearAdminVisual(player) end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local head = char and char:FindFirstChild("Head")
            local role, kind = getRole(player, true)
            if kind ~= "owner" and kind ~= "possible" and kind ~= "tool" then
                clearAdminVisual(player)
            elseif not char or not head then
                clearAdminVisual(player)
            else
                local existing = adminVisuals[player]
                if existing and (existing.char ~= char or existing.kind ~= kind) then
                    clearAdminVisual(player)
                    existing = nil
                end
                if not existing then
                    local isOwner = kind == "owner"
                    local color = isOwner and COLORS.green or (kind == "tool" and Color3.fromRGB(245, 216, 105) or COLORS.orange)
                    local tag = isOwner and "👑 مالك التجربة / المجموعة" or
                        (kind == "tool" and "🔎 أداة إدارية محتملة (غير مؤكدة)" or "🛡️ رتبة قروب عالية (غير مؤكدة)")
                    local highlight = make("Highlight", {
                        Name = "NovaAdminVisionLocal", Adornee = char,
                        FillColor = color, OutlineColor = color,
                        FillTransparency = .7, OutlineTransparency = 0,
                        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                    }, gui)
                    local billboard = make("BillboardGui", {
                        Name = "NovaAdminVisionTag", Adornee = head,
                        AlwaysOnTop = true, Size = UDim2.fromOffset(300, 48),
                        StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0),
                    }, gui)
                    local label = make("TextLabel", {
                        Name = "RoleText", Size = UDim2.fromScale(1, 1),
                        Text = safeText(tag) .. "\n@" .. safeText(player.Name),
                        TextColor3 = color, TextStrokeColor3 = Color3.new(0, 0, 0),
                        TextStrokeTransparency = .15, BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold, TextSize = 13,
                        TextWrapped = true,
                    }, billboard)
                    adminVisuals[player] = {char = char, kind = kind, highlight = highlight, billboard = billboard, label = label}
                end
            end
        end
    end
end

-- Visual Drag: clone only the target's visible avatar for the current client.
-- The real target is never moved, hidden, or modified (except a temporary local
-- Archivable flag to permit cloning, which is restored immediately).
local activeDragTool = nil
local dragClone = nil
local dragSourceCharacter = nil
local dragVisualTag = nil
local dragButton = nil
local nativeDragButton = nil
local NATIVE_DRAG_BUTTON_TEXT = "🧰 تفعيل أداة سحب الماب (إن وجدت)"
local VISUAL_DRAG_BUTTON_TEXT = "🧲 سحب شكلي: خذ سكن اللاعب معك"

local function carryOffset()
    if carryMode == "behind" then return CFrame.new(0, 0, carryDistance) end
    if carryMode == "front" then return CFrame.new(0, 0, -carryDistance) end
    return CFrame.new(carryDistance, 0, -1.2)
end
local function carryModeName()
    if carryMode == "behind" then return "خلفك" end
    if carryMode == "front" then return "قدامك" end
    return "جنبك"
end

local function clearVisualDrag()
    if dragVisualTag then
        dragVisualTag:Destroy()
        dragVisualTag = nil
    end
    if dragClone then
        dragClone:Destroy()
        dragClone = nil
    end
    dragSourceCharacter = nil
end

local function stopDrag()
    dragTarget = nil
    clearVisualDrag()
    if activeDragTool then
        pcall(function() activeDragTool:Deactivate() end)
        activeDragTool = nil
    end
    if dragButton and dragButton.Parent then
        dragButton.Text = VISUAL_DRAG_BUTTON_TEXT
    end
    if nativeDragButton and nativeDragButton.Parent then
        nativeDragButton.Text = NATIVE_DRAG_BUTTON_TEXT
    end
end

local function buildVisualAvatar(player)
    local source = player and player.Character
    local head = source and source:FindFirstChild("Head")
    local sourceRoot = source and source:FindFirstChild("HumanoidRootPart")
    if not source or not head or not sourceRoot then
        return false, "شخصية اللاعب لم تكتمل بعد. انتظر ظهوره وجرب مرة ثانية"
    end
    local descendants = source:GetDescendants()
    if #descendants > 160 then
        return false, "سكن اللاعب يحتوي عناصر كثيرة؛ تم إلغاء النسخ لتجنب التعليق"
    end

    local oldArchivable = source.Archivable
    source.Archivable = true
    local ok, copy = pcall(function() return source:Clone() end)
    source.Archivable = oldArchivable
    if not ok or not copy then
        return false, "ما قدرت أنسخ سكن اللاعب الظاهر على جهازك"
    end

    copy.Name = "NOVA_VisualCarry_" .. safeText(player.UserId)
    for _, obj in ipairs(copy:GetDescendants()) do
        if obj:IsA("LuaSourceContainer") or obj:IsA("Tool") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Anchored = true
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
            obj.CastShadow = false
            if obj.Name == "HumanoidRootPart" then obj.Transparency = 1 end
        elseif obj:IsA("Sound") or obj:IsA("ParticleEmitter")
            or obj:IsA("Trail") or obj:IsA("Beam") then
            obj:Destroy()
        end
    end
    local hum = copy:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        hum.NameDisplayDistance = 0
        hum.HealthDisplayDistance = 0
    end

    local myRoot = localRoot()
    if not myRoot then
        copy:Destroy()
        return false, "شخصيتك لم تكتمل بعد"
    end
    local position = myRoot.CFrame * carryOffset()
    copy:PivotTo(position)
    copy.Parent = Workspace

    local copyHead = copy:FindFirstChild("Head")
    if copyHead then
        local tag = make("BillboardGui", {
            Name = "NOVA_VisualCarryLabel",
            Adornee = copyHead,
            Size = UDim2.fromOffset(250, 44),
            StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0),
            AlwaysOnTop = true,
        }, gui)
        make("TextLabel", {
            Name = "Label", Size = UDim2.fromScale(1, 1),
            Text = "نسخة شكلية • @" .. safeText(player.Name),
            TextColor3 = COLORS.purple,
            TextStrokeColor3 = Color3.new(0, 0, 0),
            TextStrokeTransparency = .2,
            TextWrapped = true,
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamBold, TextSize = 13,
        }, tag)
        dragVisualTag = tag
    end

    dragClone = copy
    dragSourceCharacter = source
    return true
end

local function startVisualDrag(player)
    if not player or player.Parent ~= Players or player == LocalPlayer then
        say("اختر لاعبًا من القائمة أولًا", false)
        return false
    end
    stopDrag()
    local ok, reason = buildVisualAvatar(player)
    if not ok then
        say(reason, false)
        return false
    end
    dragTarget = player
    say("نسخة من سكن @" .. safeText(player.Name) .. " صارت بجانبك وتتحرك معك. هذا محلي فقط", true)
    return true
end

local function updateVisualDrag(dt)
    if not dragClone or not dragTarget then return end
    if dragTarget.Parent ~= Players or not dragClone.Parent then
        stopDrag()
        return
    end
    local root = localRoot()
    if not root then return end
    local targetCFrame = root.CFrame * carryOffset()
    local existing = dragClone:GetPivot()
    local separation = (existing.Position - targetCFrame.Position).Magnitude
    if separation > 40 then
        dragClone:PivotTo(targetCFrame)
    else
        if separation < .06 then return end
        dragClone:PivotTo(existing:Lerp(targetCFrame, math.clamp((dt or .10) * 8, .14, .8)))
    end
end
local dragWords = {"drag", "grab", "carry", "bring", "pull", "rope", "lasso", "سحب", "حمل", "شد", "حبل"}
local function findNativeDragTool()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local character = localCharacter()
    local equipped, stored = nil, nil
    for _, holder in ipairs({character, backpack}) do
        if holder then
            for _, candidate in ipairs(holder:GetChildren()) do
                if candidate:IsA("Tool") and candidate:GetAttribute("NOVA_LocalCopy") ~= true then
                    local name = (safeText(candidate.Name) .. " " .. safeText(candidate.ToolTip)):lower()
                    for _, token in ipairs(dragWords) do
                        if name:find(token, 1, true) then
                            if holder == character then equipped = candidate else stored = candidate end
                            break
                        end
                    end
                end
                if equipped then break end
            end
        end
        if equipped then break end
    end
    return equipped or stored
end
local function useNativeDragTool(player)
    if not player or player.Parent ~= Players or player == LocalPlayer then
        say("اختر لاعبًا موجودًا في قائمة اللاعبين", false)
        return false
    end
    local hum = localHumanoid()
    local character = localCharacter()
    if not hum or hum.Health <= 0 or not character then
        say("انتظر تحميل شخصيتك قبل استخدام الأداة", false)
        return false
    end
    local tool = findNativeDragTool()
    if not tool then
        say("ما عندك أداة سحب أصلية في الحقيبة. تحتاج أداة يمنحها سيرفر الماب", false)
        return false
    end
    if not tool.Enabled then
        say("أداة السحب «" .. safeText(tool.Name) .. "» معطّلة داخل الماب", false)
        return false
    end
    if tool.Parent ~= character then
        local ok = pcall(function() hum:EquipTool(tool) end)
        if not ok or tool.Parent ~= character then
            say("تعذّر تجهيز أداة السحب؛ الماب قد يمنع استعمالها", false)
            return false
        end
    end
    local ok = pcall(function() tool:Activate() end)
    if not ok then
        say("تعذّر تشغيل أداة السحب الأصلية", false)
        return false
    end
    activeDragTool = tool
    say("طلبت تشغيل «" .. safeText(tool.Name) .. "» للاعب @" .. safeText(player.Name)
        .. ". وجّه الأداة إلى اللاعب؛ نجاح السحب يتحدد من نظام الماب", true)
    return true
end

local function tryTeleport(player)
    if not player or player == LocalPlayer or player.Parent ~= Players then
        say("اختر لاعبًا موجودًا أولًا", false)
        return
    end
    local fromRoot = localRoot()
    local toRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not fromRoot or not toRoot then
        say("ما قدرت أوصل لموقع اللاعب الآن", false)
        return
    end
    fromRoot.CFrame = toRoot.CFrame * CFrame.new(0, 0, 4)
    say("انتقلت قرب " .. player.Name .. " محليًا؛ قد يعيدك السيرفر", true)
end

-- Spectator mode: default Roblox camera for free orbit/zoom, plus a fixed
-- fallback for experiences that continuously override CameraSubject.
-- No player positions are modified. Only the local viewer camera is changed.
local followTarget = nil
local followFixed = false
local previousCameraType = nil
local followRenderBound = false
local CAMERA_BIND_KEY = "NOVA_v16Pro_SAFE_Spectate_" .. tostring(LocalPlayer.UserId)
local flyButton -- assigned when the flight section is created below
local cameraStatusLabel = nil
local function cameraStatus(message)
    if cameraStatusLabel and cameraStatusLabel.Parent then
        cameraStatusLabel.Text = message
    end
end
local function stopCameraFollow(silent)
    local wasFollowing = followTarget ~= nil
    followTarget = nil
    followFixed = false
    if followRenderBound then
        pcall(function() RunService:UnbindFromRenderStep(CAMERA_BIND_KEY) end)
        followRenderBound = false
    end
    local cam = Workspace.CurrentCamera
    if cam then
        -- Always return to the LOCAL character, not the prior spectator target.
        local hum = localHumanoid()
        if hum then cam.CameraSubject = hum end
        local oldType = previousCameraType
        if oldType == nil or oldType == Enum.CameraType.Scriptable then
            oldType = Enum.CameraType.Custom
        end
        cam.CameraType = oldType
    end
    previousCameraType = nil
    cameraStatus("الكاميرا: شخصيتي | اختر لاعبًا واضغط متابعة")
    if not silent then
        say(wasFollowing and "رجعت الكاميرا لشخصيتك" or "أعدت ضبط الكاميرا لشخصيتك", true)
    end
end
local function refreshCameraFollow(dt)
    if not followTarget then return end
    if followTarget.Parent ~= Players then
        stopCameraFollow(false)
        return
    end
    local cam = Workspace.CurrentCamera
    local character = followTarget.Character
    local h = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not cam or not h or not root then
        cameraStatus("ننتظر تحميل شخصية @" .. followTarget.Name .. " ...")
        return
    end
    if followFixed then
        if cam.CameraType ~= Enum.CameraType.Scriptable then
            cam.CameraType = Enum.CameraType.Scriptable
        end
        local aimPoint = root.Position + Vector3.new(0, 2, 0)
        local cameraPosition = (root.CFrame * CFrame.new(0, 4, 12)).Position
        local desired = CFrame.lookAt(cameraPosition, aimPoint)
        local alpha = math.clamp((dt or .016) * 12, 0.06, 1)
        cam.CFrame = cam.CFrame:Lerp(desired, alpha)
        cam.Focus = CFrame.new(aimPoint)
    else
        -- Reaffirm after the default CameraModule update. A single change every
        -- 0.75s was insufficient in experiences that reset camera properties.
        if cam.CameraType ~= Enum.CameraType.Custom then
            cam.CameraType = Enum.CameraType.Custom
        end
        if cam.CameraSubject ~= h then
            cam.CameraSubject = h
        end
    end
end
local function startCameraFollow(player, fixed)
    if not player or player.Parent ~= Players or player == LocalPlayer then
        say("اختر لاعبًا من قائمة الأسماء أولًا", false)
        return false
    end
    local cam = Workspace.CurrentCamera
    local character = player.Character
    local targetHumanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not cam or not targetHumanoid or not root then
        say("شخصية اللاعب غير جاهزة، انتظر لحظة وجرب", false)
        return false
    end
    if state.Fly then
        -- Spectating while flying made the old button appear to do nothing.
        state.Fly = false
        stopFlight()
        if flyButton and flyButton.Parent then

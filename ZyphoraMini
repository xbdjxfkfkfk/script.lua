-- Model metadata is game-specific. Never invent rarity/power.
-- Metadata is specific to each experience; read replicated attributes/values only.
local keywords={'ضب','lizard','dhab','reptile','lhib','uromastyx'}
local function stat(m,names)
 for _,container in ipairs({m,m:FindFirstChild('Config'),m:FindFirstChild('Stats'),m:FindFirstChild('Data')}) do
  if container then
   for _,n in ipairs(names) do
    local a=container:GetAttribute(n)
    if a~=nil then return a end
    local v=container:FindFirstChild(n)
    if v and (v:IsA('StringValue') or v:IsA('NumberValue') or v:IsA('IntValue')) then return v.Value end
   end
  end
 end
 for _,n in ipairs(names) do
  local v=m:FindFirstChild(n,true)
  if v and (v:IsA('StringValue') or v:IsA('NumberValue') or v:IsA('IntValue')) then return v.Value end
 end
 return nil
end
local function info(m)
 return {rarity=stat(m,{'Rarity','Tier','Grade','Rank','الندرة'}),power=stat(m,{'Power','Strength','Damage','قوة'}),size=stat(m,{'Size','Scale','Weight','حجم','وزن'}),kind=stat(m,{'Type','Species','Kind','نوع'})}
end
local function isLizard(m)
 if not m:IsA('Model') or Players:GetPlayerFromCharacter(m) then return false end
 for _,player in ipairs(Players:GetPlayers()) do
  if player.Character and (m==player.Character or m:IsDescendantOf(player.Character)) then return false end
 end
 local n=string.lower(m.Name)
 for _,word in ipairs(keywords) do if n:find(word,1,true) then return true end end
 local kind=stat(m,{'Type','Species','Kind','نوع'})
 if kind then
  local k=string.lower(tostring(kind))
  for _,word in ipairs(keywords) do if k:find(word,1,true) then return true end end
 end
 return false
end
local function part(m) return m.PrimaryPart or m:FindFirstChildWhichIsA('BasePart',true) end
local function rarityColor(value)
 local t=string.lower(tostring(value or ''))
 if t:find('خرافي',1,true) or t:find('mythic',1,true) or t:find('divine',1,true) or t:find('red',1,true) or t:find('أحمر',1,true) then return Color3.fromRGB(255,62,72) end
 if t:find('ذهبي',1,true) or t:find('gold',1,true) or t:find('legendary',1,true) then return Color3.fromRGB(255,200,45) end
 if t:find('بنفسجي',1,true) or t:find('purple',1,true) or t:find('epic',1,true) then return Color3.fromRGB(171,94,255) end
 if t:find('أزرق',1,true) or t:find('blue',1,true) or t=='rare' then return Color3.fromRGB(53,165,255) end
 if t:find('أخضر',1,true) or t:find('green',1,true) or t=='uncommon' then return Color3.fromRGB(51,223,123) end
 return Color3.fromRGB(235,237,244)
end
local lizards={}
local function scanLizards()
 table.clear(lizards)
 for _,obj in ipairs(WS:GetDescendants()) do
  if isLizard(obj) then
   local p=part(obj)
   if p then lizards[#lizards+1]={model=obj,root=p} end
  end
 end
end
local function targetLizard(query)
 local me=root();if not me then return nil end
 local chosen,best=nil,math.huge;query=string.lower(query or '')
 for _,e in ipairs(lizards) do
  if e.model.Parent and e.root.Parent and (query=='' or string.lower(e.model.Name):find(query,1,true)) then
   local d=(e.root.Position-me.Position).Magnitude
   if d<best then best=d;chosen=e end
  end
 end
 return chosen
end

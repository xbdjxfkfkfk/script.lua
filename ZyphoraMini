-- Invisible System
local function updateInvisible()
    local char = LP.Character
    if not char then return end
    
    if S.Invisible then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") or v:IsA("Decal") then
                v.LocalTransparencyModifier = 1
            end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") then
                v.Enabled = false
            end
        end
    else
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") or v:IsA("Decal") then
                v.LocalTransparencyModifier = 0
            end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") then
                v.Enabled = true
            end
        end
    end
end

-- Fly System
local flyVel = nil

local function updateFly()
    local char = LP.Character
    local r = char and char:FindFirstChild("HumanoidRootPart")
    if not r then return end
    
    if S.Fly and not flyVel then
        flyVel = Instance.new("LinearVelocity")
        flyVel.MaxForce = math.huge
        flyVel.VectorVelocity = Vector3.zero
        flyVel.Parent = r
    elseif not S.Fly and flyVel then
        flyVel:Destroy()
        flyVel = nil
    end
    
    if S.Fly and flyVel then
        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.E) or UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.Q) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
        
        flyVel.VectorVelocity = dir * S.FlySpeed
    end
end

-- Drag System
local dragConnection = nil

local function updateDrag()
    if S.DragPlayers and draggedPlayer then
        local targetChar = draggedPlayer.Character
        local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        local myRoot = root()
        
        if targetRoot and myRoot then
            targetRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -5)
        end
    end
end

-- Player ESP
local espHighlights = {}

local function updatePlayerESP()
    if S.PlayerESP then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and not espHighlights[p] then
                local h = Instance.new("Highlight")
                h.FillColor = Color3.fromRGB(255, 0, 0)
                h.OutlineColor = Color3.new(1, 1, 1)
                h.Adornee = p.Character
                h.Parent = gui
                espHighlights[p] = h
            end
        end
    else
        for p, h in pairs(espHighlights) do
            if h then h:Destroy() end
            espHighlights[p] = nil
        end
    end
end

-- Main Loop
conn(RunService.Heartbeat, function()
    if not alive then return end
    updateInvisible()
    updateFly()
    updateDrag()
    updatePlayerESP()
end)

-- Cleanup
local function cleanup()
    alive = false
    if flyVel then flyVel:Destroy() end
    for p, h in pairs(espHighlights) do if h then h:Destroy() end end
    for _, c in pairs(conns) do c:Disconnect() end
    gui:Destroy()
end

conn(close.MouseButton1Click, cleanup)


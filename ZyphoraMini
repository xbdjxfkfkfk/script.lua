local function buildReport()
    local eventCount, functionCount, checked = 0, 0, 0
    for _, obj in ipairs(RS:GetDescendants()) do
        checked = checked + 1
        if obj:IsA("RemoteEvent") then eventCount = eventCount + 1 end
        if obj:IsA("RemoteFunction") then functionCount = functionCount + 1 end
        if checked >= 10000 then break end
    end
    local lines = {
        "NOVA SUITE v5 — معلومات مرئية للعميل",
        "الماب: " .. tostring(game.PlaceId),
        "التجربة: " .. tostring(game.GameId),
        "عدد اللاعبين: " .. tostring(#Players:GetPlayers()),
        "عناصر ReplicatedStorage المفحوصة: " .. tostring(checked),
        "RemoteEvents مرئية: " .. tostring(eventCount),
        "RemoteFunctions مرئية: " .. tostring(functionCount),
        "تنبيه: هذه أعداد وليست ثغرات مثبتة.",
        "---",
    }
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            local kind, reason = inspectPlayer(player)
            lines[#lines + 1] = player.Name .. " [" .. tostring(player.UserId) .. "] => " .. kind .. ": " .. reason
        end
    end
    report.Text = table.concat(lines, "\n")
    setStatus("تم إنشاء تقرير معلومات الماب؛ يمكن نسخه وإرساله للتحليل", true)
end


local function serverCall(action,argument,callback)
    if not serverRemote then
        message("غير متصل بسيرفر NOVA: الأوامر الإدارية متاحة داخل مابك بعد تركيب الخادم",false)
        return
    end
    task.spawn(function()
        local ok,result=pcall(function() return serverRemote:InvokeServer(action,argument) end)
        if not ok or type(result)~="table" then
            message("تعذّر تنفيذ "..action.." من السيرفر",false)
            return
        end
        message(result.msg or (result.ok and "تم التنفيذ" or "فشل الأمر"),result.ok)
        if callback then callback(result) end
    end)
end
local function targetAction(action)
    if not selected or not selected.Parent then
        message("حدد اسم اللاعب أولًا",false)
        return
    end
    serverCall(action,selected.UserId)
end


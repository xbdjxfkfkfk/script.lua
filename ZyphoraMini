        round(listFrame,8)

        local layout = inst("UIListLayout",{
            Padding = UDim.new(0,6),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, listFrame)

        Radar._GuiList = listFrame
    end

    function Radar:Enable()
        if self.Enabled then return end
        self.Enabled = true
        if not self._GuiList then self:Init() end

        self._DetectConn = RunService.Heartbeat:Connect(function()
            local plr = Players.LocalPlayer
            local char = plr.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end

            -- Very cheap detection: only check for objects with a specific tag
            local candidates = workspace:GetDescendants()
            for _,obj in ipairs(candidates) do
                if obj:IsA("BasePart") and CollectionService:HasTag(obj, "Lizard") then
                    if not self._Detections[obj] then
                        local info = {
                            Name = obj.Name,
                            Rarity = obj:GetAttribute("Rarity") or "Common",
                            Size = obj.Size,
                            Weight = obj:GetMass(),
                            Distance = (obj.Position - root.Position).Magnitude,
                        }
                        self._Detections[obj] = info
                        self:_AddGuiEntry(info)
                    else
                        -- update distance only
                        self._Detections[obj].Distance = (obj.Position - root.Position).Magnitude
                    end
                end
            end
        end)
    end

    function Radar:_AddGuiEntry(info)
        local entry = inst("Frame",{
            Size = UDim2.new(1,0,0,30),
            BackgroundColor3 = Color3.fromRGB(240,240,240),

-- =========================================================
-- Discord Guard v3 — Membership lock + fast re-lock
-- =========================================================

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LP = Players.LocalPlayer
if not LP then warn("Guard: no LocalPlayer") return end
local PG = LP:WaitForChild("PlayerGui", 12)
if not PG then warn("Guard: PlayerGui unavailable") return end

-- ================== CONFIG ==================
local API_BASE      = "https://FILL-YOUR-BACKEND.example.com"
local AUTH_URL      = API_BASE .. "/auth"
local POLL_INTERVAL = 15      -- كل ١٥ ثانية يفحص
local NET_TOLERANCE = 3       -- ٣ فشل شبكة متتالية قبل القفل
local KEY_FILE      = "discord_guard_key.txt"
-- ============================================

local guardGui   = nil
local isLocked   = false
local netFails   = 0
local currentKey = nil

-- ---------- HTTP ----------
local function getRequestFn()
    if syn and type(syn.request) == "function" then return syn.request end
    if http and type(http.request) == "function" then return http.request end
    if type(request) == "function" then return request end
    if type(http_request) == "function" then return http_request end
    return nil
end

local function urlEncode(s)
    return (tostring(s):gsub("([^%w%-%._~])", function(c)
        return string.format("%%%02X", string.byte(c))
    end))
end

-- ---------- key storage ----------
local function saveKey(k) pcall(function() if writefile then writefile(KEY_FILE, k) end end) end
local function clearKey() pcall(function() if delfile and isfile and isfile(KEY_FILE) then delfile(KEY_FILE) end end) end
local function loadKey()
    local k
    pcall(function()
        if isfile and isfile(KEY_FILE) and readfile then k = readfile(KEY_FILE) end
    end)
    if k then k = k:gsub("%s+", "") end
    if k == "" then k = nil end
    return k
end

-- ---------- backend ----------
-- returns ok(boolean), reason(string), message(string|nil)
local function checkMembership(key)
    local reqFn = getRequestFn()
    if not reqFn then return false, "no_http", "الإكسكيوتور ما يدعم HTTP" end
    if not key or key == "" then return false, "no_key", "لا يوجد مفتاح" end

    local ok, res = pcall(function()
        return reqFn({
            Url = API_BASE .. "/check?key=" .. urlEncode(key),
            Method = "GET",
            Headers = { ["Content-Type"] = "application/json" },
            Timeout = 10000,
        })
    end)
    if not ok or res == nil then return false, "net_fail", "تعذر الاتصال بالسيرفر" end

    local body
    if type(res) == "table" then body = res.Body or res.body
    elseif type(res) == "string" then body = res end
    if not body or body == "" then return false, "net_fail", "رد فارغ" end

    local pok, parsed = pcall(function() return HttpService:JSONDecode(body) end)
    if not pok or type(parsed) ~= "table" then return false, "net_fail", "رد غير صالح" end

    if parsed.ok == true then return true, "ok", nil end
    return false, tostring(parsed.reason or "denied"), tostring(parsed.message or "غير مصرح")
end

-- ---------- open link ----------
local function copyAuthLink() pcall(function() if setclipboard then setclipboard(AUTH_URL) end end) end
local function openAuthLink()
    pcall(function()
        local env = getgenv and getgenv() or _G
        if env and type(env.openUrl) == "function" then env.openUrl(AUTH_URL) end
    end)
end

-- ---------- GUI ----------
local function destroyGuard()
    if guardGui and guardGui.Parent then guardGui:Destroy() end
    guardGui = nil
end

local function buildPanel(cfg)
    destroyGuard()
    local gui = Instance.new("ScreenGui")
    gui.Name = "DiscordGuard"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 9999
    gui.Parent = PG

    local h = cfg.height or 240
    local panel = Instance.new("Frame")
    panel.Size = UDim2.fromOffset(460, h)
    panel.Position = UDim2.new(0.5, -230, 0.5, -h/2)
    panel.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
    panel.BorderSizePixel = 0
    panel.Parent = gui

    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 10); c.Parent = panel
    local st = Instance.new("UIStroke"); st.Color = Color3.fromRGB(239, 28, 37); st.Thickness = 2; st.Parent = panel

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -40, 0, 30)
    title.Position = UDim2.new(0, 20, 0, 15)
    title.BackgroundTransparency = 1
    title.Text = cfg.title or "Discord مطلوب"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 18
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = panel

    local body = Instance.new("TextLabel")
    body.Size = UDim2.new(1, -40, 0, 65)
    body.Position = UDim2.new(0, 20, 0, 50)
    body.BackgroundTransparency = 1
    body.Text = cfg.message or ""
    body.TextColor3 = Color3.fromRGB(220, 220, 220)
    body.Font = Enum.Font.Gotham
    body.TextSize = 13
    body.TextWrapped = true
    body.TextYAlignment = Enum.TextYAlignment.Top
    body.Parent = panel

    local input
    if cfg.showInput then
        input = Instance.new("TextBox")
        input.Size = UDim2.new(1, -40, 0, 36)
        input.Position = UDim2.new(0, 20, 0, 118)
        input.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
        input.TextColor3 = Color3.fromRGB(255, 255, 255)
        input.PlaceholderText = "الصق المفتاح هنا"
        input.PlaceholderColor3 = Color3.fromRGB(120, 120, 125)
        input.Font = Enum.Font.Code
        input.TextSize = 13
        input.ClearTextOnFocus = false
        input.Parent = panel
        local ic = Instance.new("UICorner"); ic.CornerRadius = UDim.new(0, 6); ic.Parent = input
    end

    local function makeBtn(text, x, w, color, cb)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, w, 0, 40)
        b.Position = UDim2.new(0, x, 1, -52)
        b.BackgroundColor3 = color
        b.Text = text
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 13
        b.Parent = panel
        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 8); bc.Parent = b
        b.MouseButton1Click:Connect(cb)
        return b
    end

    if cfg.showInput then
        makeBtn("تحقق", 20, 130, Color3.fromRGB(239, 28, 37), function()
            if not input then return end
            local k = input.Text:gsub("%s+", "")
            if k == "" then body.Text = "أدخل المفتاح أولاً." return end
            body.Text = "جاري التحقق..."
            local ok, reason, msg = checkMembership(k)
            if ok then
                currentKey = k; saveKey(k); netFails = 0
                destroyGuard(); isLocked = false
                if cfg.onVerified then cfg.onVerified() end
            else
                body.Text = "✕ فشل: " .. tostring(msg or reason)
            end
        end)
        makeBtn("احصل على مفتاح", 170, 200, Color3.fromRGB(88, 101, 242), function()
            copyAuthLink(); openAuthLink()
            body.Text = "تم فتح الرابط. سجّل الدخول ثم الصق المفتاح."
        end)
    else
        -- زر "إعادة المحاولة" — يستخدم المفتاح المحفوظ
        makeBtn(cfg.buttonText or "إعادة المحاولة", 20, 220, Color3.fromRGB(239, 28, 37), function()
            body.Text = "جاري التحقق..."
            local ok, reason, msg = checkMembership(currentKey)
            if ok then
                netFails = 0
                destroyGuard(); isLocked = false
                if cfg.onVerified then cfg.onVerified() end
            else
                body.Text = "✕ " .. tostring(msg or reason) .. "\nتأكد إنك داخل السيرفر ثم اضغط إعادة المحاولة."
            end
        end)
        makeBtn("رابط السيرفر", 260, 180, Color3.fromRGB(88, 101, 242), function()
            copyAuthLink(); openAuthLink()
            body.Text = "تم فتح الرابط. ادخل السيرفر ثم اضغط إعادة المحاولة."
        end)
    end

    guardGui = gui
    return body
end

local function showKeyPanel(msg)
    isLocked = true
    buildPanel({
        title = "Discord مطلوب",
        message = msg or "لازم تدخل سيرفر Discord حقنا أول.\nاضغط \"احصل على مفتاح\"، سجّل دخول بحسابك، ثم الصق المفتاح.",
        showInput = true,
        height = 265,
    })
end

local function showReLockPanel(msg)
    isLocked = true
    buildPanel({
        title = "Discord مطلوب",
        message = msg or "✕ طلعت من سيرفر Discord.\nادخل السيرفر مرة ثانية ثم اضغط إعادة المحاولة.",
        showInput = false,
        buttonText = "إعادة المحاولة",
        height = 210,
    })
end

-- ---------- main ----------
local started = false
local function runMain()
    -- =========================================================
    -- السكربت الحقيقي يبدأ هنا
    -- =========================================================
    -- launchRedline()
end

local function onVerified()
    if not started then
        started = true
        runMain()
    end
end

local function lockOnLeave(message)
    if not isLocked then
        showReLockPanel(message)
    end
end

local function startWatchdog()
    task.spawn(function()
        while true do
            task.wait(POLL_INTERVAL)
            local ok, reason, msg = checkMembership(currentKey)

            if ok then
                netFails = 0
                if isLocked then
                    destroyGuard()
                    isLocked = false
                    if onVerified then onVerified() end
                end
            else
                if reason == "left_guild" then
                    -- طلع من السيرفر → قفل فورًا
                    lockOnLeave("✕ طلعت من سيرفر Discord.\nادخل السيرفر مرة ثانية ثم اضغط إعادة المحاولة.")
                elseif reason == "bad_key" then
                    -- المفتاح انتهى/غير صالح → يطلب مفتاح جديد
                    currentKey = nil; clearKey(); started = false
                    showKeyPanel("✕ مفتاحك غير صالح. احصل على مفتاح جديد.")
                    return
                else
                    -- مشكلة شبكة → تحمّل كم محاولة
                    netFails = netFails + 1
                    if netFails >= NET_TOLERANCE then
                        lockOnLeave("✕ تعذر التحقق من العضوية.\nتأكد إنك داخل السيرفر ثم اضغط إعادة المحاولة.")
                    end
                end
            end
        end
    end)
end

local function boot()
    local saved = loadKey()
    if saved then
        local ok, reason, msg = checkMembership(saved)
        if ok then
            currentKey = saved
            destroyGuard(); isLocked = false
            onVerified()
            startWatchdog()
            return
        elseif reason == "left_guild" then
            currentKey = saved
            showReLockPanel("✕ أنت مو داخل سيرفر Discord.\nادخل السيرفر ثم اضغط إعادة المحاولة.")
            startWatchdog()
            return
        else
            clearKey()
        end
    end
    showKeyPanel()
end

local ok, err = pcall(boot)
if not ok then
    warn("Guard startup error:", err)
    showReLockPanel("خطأ: " .. tostring(err):sub(1, 300))
end

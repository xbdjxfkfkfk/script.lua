remote.OnServerInvoke = function(player, action, data)
    if type(action) ~= "string" or #action > 35 then return {ok=false, msg="أمر غير صالح"} end
    if action == "status" then return {ok=true, admin=isAdmin(player), msg=isAdmin(player) and "الأدمن مفعل" or "لا توجد صلاحية إدارة"} end
    if not isAdmin(player) then return {ok=false, msg="هذه الأوامر تتطلب صلاحية سيرفر"} end
    local now = os.clock()
    if lastCall[player] and now - lastCall[player] < 0.13 then return {ok=false, msg="خفف سرعة الضغط"} end
    lastCall[player] = now

    if action == "hide" then
        local ok, msg = setHidden(player, data == true)
        return {ok=ok, msg=msg, value=data == true}
    elseif action == "tools" then
        local names = {}
        for _, tool in ipairs(catalog:GetChildren()) do
            if tool:IsA("Tool") then table.insert(names, tool.Name) end
        end
        table.sort(names)
        return {ok=true, items=names, msg="أدوات الماب المصرح بها"}
    elseif action == "tool" then
        if type(data) ~= "string" or #data > 90 then return {ok=false, msg="اسم غير صالح"} end
        local found = catalog:FindFirstChild(data)
        local backpack = player:FindFirstChildOfClass("Backpack")
        if not found or not found:IsA("Tool") or not backpack then return {ok=false, msg="الأداة غير متاحة"} end
        local tool = found:Clone()
        tool.Parent = backpack
        return {ok=true, msg="تمت إضافة " .. found.Name .. " للحقيبة"}
    elseif action == "speed" then
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        local number = tonumber(data)
        if not hum or not number or number < 8 or number > 100 then return {ok=false, msg="اختر سرعة بين 8 و100"} end
        hum.WalkSpeed = number
        return {ok=true, msg="السرعة: " .. number}
    elseif action == "jump" then
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        local number = tonumber(data)
        if not hum or not number or number < 20 or number > 150 then return {ok=false, msg="اختر قفزًا بين 20 و150"} end
        hum.UseJumpPower = true
        hum.JumpPower = number
        return {ok=true, msg="القفز: " .. number}
    end

    local target = resolveTarget(data)
    if not target then return {ok=false, msg="حدد لاعبًا موجودًا أولًا"} end
    if action == "teleport" then
        local myChar, _, myHum = getRoot(player)
        local _, targetRoot = getRoot(target)
        if not (myChar and targetRoot) then return {ok=false, msg="أحد اللاعبين لم يجهز بعد"} end
        myHum.Sit = false
        myChar:PivotTo(targetRoot.CFrame * CFrame.new(0, 2, 4))
        return {ok=true, msg="انتقلت إلى " .. target.DisplayName}
    elseif action == "bring" then
        local _, ownRoot = getRoot(player)
        local targetChar, _, targetHum = getRoot(target)
        if not (ownRoot and targetChar) then return {ok=false, msg="أحد اللاعبين لم يجهز بعد"} end
        targetHum.Sit = false
        targetChar:PivotTo(ownRoot.CFrame * CFrame.new(3, 1, -3))
        return {ok=true, msg="تم سحب " .. target.DisplayName .. " قربك"}
    elseif action == "freeze" or action == "unfreeze" then
        local ok, msg = setFrozen(target, action == "freeze")
        return {ok=ok, msg=msg}
    elseif action == "givefly" then
        notify:FireClient(target, "flygrant", true)
        return {ok=true, msg="تم إرسال صلاحية الطيران للاعب"}
    end
    return {ok=false, msg="الأمر غير معروف"}
end

local function onPlayer(player)
    player.CharacterAdded:Connect(function()
        hidden[player] = nil
        frozen[player] = nil
        notify:FireClient(player, "invisibility", false)

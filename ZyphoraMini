local function getRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getCurrentVehicleModel()
    local hum = getHum()
    local seat = hum and hum.SeatPart
    if not seat then return nil end
    return seat:FindFirstAncestorOfClass("Model")
end

local function getNearbyVehicles(radius)
    radius = radius or 400
    local root = getRoot()
    if not root then return {} end
    local out = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("VehicleSeat") or v:IsA("Seat") then
            local model = v:FindFirstAncestorOfClass("Model")
            if model and not out[model] then
                local pivot = model:GetPivot()
                if (pivot.Position - root.Position).Magnitude <= radius then
                    out[model] = true
                end
            end
        end
    end
    local list = {}
    for m in pairs(out) do table.insert(list, m) end
    return list
end


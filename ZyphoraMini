-- Startup stays visible even if server isn't installed or is unreachable.
task.spawn(function()
    local folder = ReplicatedStorage:WaitForChild("Lx_REDLINE_v77", 8)
    if not folder then
        previewing = true
        welcome.Visible = false
        welcomeStatus.Text = "السيرفر غير جاهز\nأضف Lx_REDLINE_PRO_v77_SERVER.lua إلى ServerScriptService"
        log("القائمة في وضع المعاينة: ركّب سكربت السيرفر لتعمل وظائف التحكم", true)
        return
    end
    remoteFunction = folder:FindFirstChild("Action")
    remoteEvent = folder:FindFirstChild("Events")
    if not remoteFunction or not remoteFunction:IsA("RemoteFunction") or not remoteEvent then
        previewing = true
        welcome.Visible = false
        welcomeStatus.Text = "ملفات الاتصال ناقصة في ReplicatedStorage/Lx_REDLINE_v77"
        log("القائمة في وضع المعاينة: RemoteFunction أو RemoteEvent غير موجود", true)
        return
    end
    connect(remoteEvent.OnClientEvent, function(eventName, result)
        if eventName == "AuthChanged" then
            setAuthorized(result == true, result and "عضوية صالحة" or "انتهت العضوية أو فشل التحقق")
        elseif eventName == "TeleportResult" then
            log(tostring(result))
        elseif eventName == "ForcedStop" then
            flyMode = nil
            carFlyControl:set(false)
            playerFlyControl:set(false)
            carSpeedControl:set(false)
            touchFrame.Visible = false
            log("أوقف السيرفر التحكم: " .. tostring(result))
        end
    end)
    refreshAuth()
end)

end -- LxStartup
local started, reason = pcall(LxStartup)
if not started then
    warn("[Lx REDLINE v77 startup error] " .. tostring(reason))
    pcall(function()
        local players = game:GetService("Players")
        local player = players.LocalPlayer
        if not player then return end
        local parent = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 5)
        if not parent then return end
        local prior = parent:FindFirstChild("Lx_REDLINE_v77_STARTUP_ERROR")
        if prior then prior:Destroy() end
        local gui = Instance.new("ScreenGui")
        gui.Name = "Lx_REDLINE_v77_STARTUP_ERROR"
        gui.ResetOnSpawn = false
        gui.DisplayOrder = 2000
        gui.Parent = parent
        local panel = Instance.new("TextLabel")
        panel.Name = "LxErrorReport"
        panel.Size = UDim2.fromOffset(340, 124)
        panel.Position = UDim2.fromOffset(12, 130)
        panel.BackgroundColor3 = Color3.fromRGB(85, 15, 24)
        panel.TextColor3 = Color3.fromRGB(255, 255, 255)
        panel.TextSize = 14
        panel.TextWrapped = true
        panel.Text = "Lx v77 | خطأ بدء التشغيل\n" .. tostring(reason):sub(1, 340)
        panel.Parent = gui
    end)
end

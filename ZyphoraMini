-- NOVA PRO v9 | ServerScriptService
local Players = game:GetService("Players")
local Storage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")
local ADMIN_IDS = { -- Put additional trusted Roblox UserIds here
    -- [123456789] = true,
}
local function isAdmin(p)
    return (RunService:IsStudio() and game.CreatorId == 0)
        or ADMIN_IDS[p.UserId] == true
        or (game.CreatorType == Enum.CreatorType.User and p.UserId == game.CreatorId)
end
local folder = Storage:FindFirstChild("NOVA_PRO_v9")
if not folder then
    folder = Instance.new("Folder")
    folder.Name = "NOVA_PRO_v9"
    folder.Parent = Storage
end
for _, name in ipairs({"Request", "Reply"}) do
    local found = folder:FindFirstChild(name)
    if found then found:Destroy() end
    local event = Instance.new("RemoteEvent")
    event.Name = name
    event.Parent = folder
end
local Request = folder.Request
local Reply = folder.Reply
local hidden = {}
local originals = setmetatable({}, {__mode = "k"})
local requests = {}
local cooldowns = {}
local approved = ServerStorage:FindFirstChild("NOVA_ApprovedTools")
if not approved then
    approved = Instance.new("Folder")
    approved.Name = "NOVA_ApprovedTools"
    approved.Parent = ServerStorage
end
local function send(p, tag, data)
    if p and p.Parent == Players then Reply:FireClient(p, tag, data) end
end
local function notify(p, s) send(p, "Notice", s) end
local function targetOf(id)
    if type(id) ~= "number" or id ~= math.floor(id) then return nil end
    return Players:GetPlayerByUserId(id)
end
local function getRoot(p)
    local char = p and p.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if char and hum and root and hum.Health > 0 then return char, root, hum end
    return nil
end
local function setVisual(obj, makeHidden)
    if makeHidden then
        if originals[obj] == nil then
            if obj:IsA("BasePart") then
                originals[obj] = {obj.Transparency, obj.CastShadow}
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                originals[obj] = {obj.Transparency}
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail")
                or obj:IsA("Highlight") or obj:IsA("BillboardGui") then
                originals[obj] = {obj.Enabled}
            elseif obj:IsA("Humanoid") then
                originals[obj] = {obj.DisplayDistanceType}
            end
        end
        if obj:IsA("BasePart") then
            obj.Transparency = 1
            obj.CastShadow = false
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail")
            or obj:IsA("Highlight") or obj:IsA("BillboardGui") then
            obj.Enabled = false
        elseif obj:IsA("Humanoid") then
            obj.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        end
    else
        local old = originals[obj]
        if not old then return end
        if obj:IsA("BasePart") then
            obj.Transparency = old[1]
            obj.CastShadow = old[2]
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = old[1]
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail")
            or obj:IsA("Highlight") or obj:IsA("BillboardGui") then
            obj.Enabled = old[1]
        elseif obj:IsA("Humanoid") then
            obj.DisplayDistanceType = old[1]
        end
        originals[obj] = nil
    end
end
local function applyHidden(p)
    local char = p.Character
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        setVisual(obj, hidden[p.UserId] == true)
    end
end
local function bindPlayer(p)
    p.CharacterAdded:Connect(function(char)
        char.DescendantAdded:Connect(function(obj)
            if hidden[p.UserId] then
                task.defer(function()
                    if obj.Parent and hidden[p.UserId] then setVisual(obj, true) end
                end)
            end
        end)
        task.defer(function()
            char:WaitForChild("HumanoidRootPart", 10)
            if p.Character == char then applyHidden(p) end
        end)
    end)
end
Players.PlayerAdded:Connect(bindPlayer)
for _, p in ipairs(Players:GetPlayers()) do bindPlayer(p) end
Players.PlayerRemoving:Connect(function(p)
    hidden[p.UserId] = nil
    requests[p.UserId] = nil
    cooldowns[p] = nil
end)
local function listTools()
    local result = {}
    for _, obj in ipairs(approved:GetChildren()) do
        if obj:IsA("Tool") then table.insert(result, obj.Name) end
    end
    table.sort(result)
    return result
end
Request.OnServerEvent:Connect(function(actor, action, id, arg)
    if type(action) ~= "string" or #action > 32 then return end
    if action == "Hello" then
        send(actor, "Welcome", {admin = isAdmin(actor), tools = isAdmin(actor) and listTools() or {}})
        return
    end
    local now = os.clock()
    if now - (cooldowns[actor] or -100) < 0.18 then return end
    cooldowns[actor] = now
    if action == "BringReply" then
        local pending = requests[actor.UserId]
        requests[actor.UserId] = nil
        if not pending or now - pending.at > 20 then return end
        local requester = targetOf(pending.from)
        if not requester or not isAdmin(requester) then return end
        if arg ~= true then
            notify(requester, "اللاعب رفض طلب الانتقال")
            return
        end
        local ownChar = getRoot(actor)
        local _, adminRoot = getRoot(requester)
        if not ownChar or not adminRoot then return end
        ownChar:PivotTo(adminRoot.CFrame * CFrame.new(4, 0, -4))
        notify(actor, "تم الانتقال بعد موافقتك")
        notify(requester, "وافق اللاعب وانتقل إليك")
        return
    end
    if not isAdmin(actor) then
        notify(actor, "هذه الميزة خاصة بمشرفي هذه التجربة")
        return
    end
    if action == "Invisible" then
        hidden[actor.UserId] = not hidden[actor.UserId]
        applyHidden(actor)
        send(actor, "InvisibleStatus", hidden[actor.UserId])
        notify(actor, hidden[actor.UserId] and "تم إخفاء الشخصية من الخادم" or "تمت إعادة إظهار الشخصية")
    elseif action == "Teleport" then
        local target = targetOf(id)
        if not target or target == actor then notify(actor, "اختر لاعبًا آخر موجودًا") return end
        local char = getRoot(actor)
        local _, targetRoot = getRoot(target)
        if not char or not targetRoot then notify(actor, "شخصية اللاعب غير جاهزة") return end
        char:PivotTo(targetRoot.CFrame * CFrame.new(4, 0, 2))
        notify(actor, "تم الانتقال إلى " .. target.DisplayName)
    elseif action == "BringInvite" then
        local target = targetOf(id)
        if not target or target == actor then notify(actor, "اختر لاعبًا آخر") return end
        requests[target.UserId] = {from = actor.UserId, at = now}
        send(target, "BringInvite", {from = actor.UserId, name = actor.DisplayName})
        notify(actor, "أُرسل طلب انتقال إلى " .. target.DisplayName)
    elseif action == "Speed" then
        local _, _, hum = getRoot(actor)
        local n = tonumber(arg)
        if not hum or not n or n ~= n then notify(actor, "قيمة السرعة غير صالحة") return end
        hum.WalkSpeed = math.clamp(n, 8, 70)
        notify(actor, "تم تطبيق السرعة")
    elseif action == "GiveTool" then
        if type(arg) ~= "string" or #arg > 80 then return end
        local tool = approved:FindFirstChild(arg)
        local bag = actor:FindFirstChildOfClass("Backpack")
        if not tool or not tool:IsA("Tool") or not bag then
            notify(actor, "الأداة غير موجودة في المخزن المعتمد")
            return
        end
        tool:Clone().Parent = bag
        notify(actor, "تم تسليم الأداة: " .. tool.Name)
    end
end)

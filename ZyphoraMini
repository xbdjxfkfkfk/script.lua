    return connection
end
local function make(kind, props, parent)
    local obj = Instance.new(kind)
    for key, value in pairs(props or {}) do obj[key] = value end
    obj.Parent = parent
    return obj
end
local function round(obj, r)
    return make("UICorner", {CornerRadius = UDim.new(0, r or 10)}, obj)
end
local function edge(obj, color, thickness, transparency)
    return make("UIStroke", {
        Color = color or K.stroke, Thickness = thickness or 1,
        Transparency = transparency or 0,
    }, obj)
end
local function txt(parent, text, size, strong, color)
    return make("TextLabel", {
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = text, Font = strong and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextSize = size or 14, TextColor3 = color or K.white,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, parent)
end
local function button(parent, text, size)
    local b = make("TextButton", {
        AutoButtonColor = false, Text = text,
        Font = Enum.Font.GothamBold, TextSize = 13,
        TextColor3 = K.white, BackgroundColor3 = K.card,
        BorderSizePixel = 0, Size = size or UDim2.fromOffset(100, 35),
    }, parent)
    round(b, 9)
    edge(b)
    track(b.MouseEnter:Connect(function()
        if b.Parent then TweenService:Create(b, TweenInfo.new(.14), {BackgroundColor3 = K.hover}):Play() end
    end))
    track(b.MouseLeave:Connect(function()
        if b.Parent then TweenService:Create(b, TweenInfo.new(.14), {BackgroundColor3 = b:GetAttribute("OnToggle") and K.accent2 or K.card}):Play() end
    end))
    return b
end
local function getChar()
    local char = Me.Character
    if not char then return nil, nil, nil end
    return char, char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end
local function validTarget()
    local p = state.selected
    if not p or p.Parent ~= Players then return nil, nil, nil end
    local ch = p.Character
    if not ch then return p, nil, nil end
    return p, ch:FindFirstChildOfClass("Humanoid"), ch:FindFirstChild("HumanoidRootPart")
end

-- All flight actuators are owned by the local character, not another player.
local function stopFly()
    state.fly = false
    flyUp, flyDown = false, false
    flyForward, flyBack, flyLeft, flyRight = false, false, false, false
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    for _,obj in ipairs({flyVelocity, flyOrientation, flyAttachment}) do
        if obj then obj:Destroy() end
    end
    flyAttachment, flyVelocity, flyOrientation = nil, nil, nil
    local _, hum = getChar()
    if hum then
        hum.PlatformStand = false
        hum.AutoRotate = true
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end
local function startFly()
    local _, hum, root = getChar()
    if not hum or not root then notify("الشخصية غير جاهزة", true); return false end
    stopFly()
    local attachment = make("Attachment", {Name="NOVA_FlightAttachment"}, root)
    local linear = make("LinearVelocity", {
        Name="NOVA_FlightVelocity", Attachment0=attachment,
        VelocityConstraintMode=Enum.VelocityConstraintMode.Vector,
        RelativeTo=Enum.ActuatorRelativeTo.World,
        ForceLimitsEnabled=false,
        VectorVelocity=Vector3.zero,
    }, root)
    local align = make("AlignOrientation", {
        Name="NOVA_FlightAlign", Attachment0=attachment,
        Mode=Enum.OrientationAlignmentMode.OneAttachment,
        RigidityEnabled=false, Responsiveness=35,
        MaxTorque=math.huge,
    }, root)
    flyAttachment, flyVelocity, flyOrientation = attachment, linear, align
    hum.PlatformStand = true
    hum.AutoRotate = false
    state.fly = true
    flyConnection = RunService.RenderStepped:Connect(function()
        local _, h, r = getChar()
        local camera = workspace.CurrentCamera
        if not state.fly or not h or not r or r ~= root or not camera then
            stopFly()
            return
        end
        local move = h.MoveDirection
        local horizontal = Vector3.new(move.X, 0, move.Z)
        -- Keyboard fallback; on touch/controller MoveDirection uses native controls.
        if (horizontal.Magnitude < 0.03 or flyForward or flyBack or flyLeft or flyRight) and not UIS:GetFocusedTextBox() then
            local cf = camera.CFrame
            local forward = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
            local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
            if forward.Magnitude > 0.01 then forward = forward.Unit end
            if right.Magnitude > 0.01 then right = right.Unit end
            if flyForward or UIS:IsKeyDown(Enum.KeyCode.W) then horizontal += forward end
            if flyBack or UIS:IsKeyDown(Enum.KeyCode.S) then horizontal -= forward end
            if flyRight or UIS:IsKeyDown(Enum.KeyCode.D) then horizontal += right end
            if flyLeft or UIS:IsKeyDown(Enum.KeyCode.A) then horizontal -= right end
        end
        local vertical = 0
        if flyUp or UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then vertical += 1 end
        if flyDown or UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) then vertical -= 1 end
        local direction = horizontal + Vector3.new(0, vertical, 0)
        linear.VectorVelocity = direction.Magnitude > .001 and direction.Unit * state.flySpeed or Vector3.zero
        local face = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
        if face.Magnitude > .001 then align.CFrame = CFrame.lookAt(r.Position, r.Position + face.Unit) end
    end)
    notify("الطيران يعمل — W/A/S/D أو عصا الحركة، E/Q للارتفاع والنزول")
    return true
end

local function restoreCollision()
    for part, value in pairs(collisions) do
        if part and part.Parent then pcall(function() part.CanCollide = value end) end
    end
    table.clear(collisions)
end
local function updateSelfTransparency()
    local ch = Me.Character
    if not ch then return end
    for _,part in ipairs(ch:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = state.hideSelf and 1 or 0
        end
    end
end
local function restoreLighting()
    Lighting.Brightness = original.brightness
    Lighting.ClockTime = original.clock
    Lighting.FogStart = original.fogStart
    Lighting.FogEnd = original.fogEnd
    Lighting.GlobalShadows = original.shadows
    for obj, snapshot in pairs(atmosphereOriginal) do
        if obj.Parent then
            obj.Density = snapshot.density
            obj.Haze = snapshot.haze
            obj.Glare = snapshot.glare
        end
    end
    table.clear(atmosphereOriginal)
end
local function setFullbright(enabled)
    state.fullbright = enabled
    if not enabled then restoreLighting(); return end
    Lighting.Brightness = 3
    Lighting.ClockTime = 14
    Lighting.FogStart = 0
    Lighting.FogEnd = 1000000
    Lighting.GlobalShadows = false
    for _,a in ipairs(Lighting:GetChildren()) do
        if a:IsA("Atmosphere") then
            atmosphereOriginal[a] = atmosphereOriginal[a] or {
                density=a.Density, haze=a.Haze, glare=a.Glare,
            }
            a.Density = 0
            a.Haze = 0
            a.Glare = 0
        end
    end
end
local function clearVisual(p)
    local v = ESP[p]
    if not v then return end
    for _,instance in pairs(v) do
        if typeof(instance) == "Instance" then instance:Destroy() end
    end
    ESP[p] = nil
end
updateESP = function(p)
    if p == Me then return end
    clearVisual(p)
    if not state.esp and not state.names then return end
    local ch = p.Character
    local head = ch and ch:FindFirstChild("Head")
    if not ch then return end
    local entry = {}
    if state.esp then
        local high = make("Highlight", {
            Name="NOVA_LocalHighlight", Adornee=ch,
            DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,
            FillColor=K.accent, OutlineColor=K.white,
            FillTransparency=.68, OutlineTransparency=.08,
        }, ch)
        entry.highlight = high
    end
    if state.names and head then
        local bb = make("BillboardGui", {
            Name="NOVA_LocalName", Adornee=head,
            AlwaysOnTop=true, Size=UDim2.fromOffset(210,38),
            StudsOffsetWorldSpace=Vector3.new(0,2.7,0),
            MaxDistance=3500,
        }, PlayerGui)
        local bg = make("Frame", {
            Size=UDim2.fromScale(1,1), BackgroundColor3=K.bg,
            BackgroundTransparency=.23, BorderSizePixel=0,
        }, bb)
        round(bg,9)
        edge(bg,K.accent,1,.35)
        local text = txt(bg, p.DisplayName.."  @"..p.Name, 13, true)
        text.Size = UDim2.new(1,-16,1,0)
        text.Position = UDim2.fromOffset(8,0)
        text.TextScaled = false
        text.TextTruncate = Enum.TextTruncate.AtEnd
        entry.tag = bb
    end
    ESP[p] = entry
end
local function updateAllESP()
    for _,p in ipairs(Players:GetPlayers()) do updateESP(p) end
end

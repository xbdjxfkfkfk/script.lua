local function cleanup()
    if not alive then return end
    alive = false
    stopLocalEffects()
    if remoteEvent then pcall(function() remoteEvent:FireServer("StopAll", {}) end) end
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    table.clear(connections)
    if _G.__LxStatusText == statusText then _G.__LxStatusText = nil end
    if _G.LxREDLINECleanup_v77 == cleanup then _G.LxREDLINECleanup_v77 = nil end
    if gui and gui.Parent then gui:Destroy() end
end
_G.LxREDLINECleanup_v77 = cleanup

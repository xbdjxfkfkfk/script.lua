local function button(t,fn)
 local b=create('TextButton',{Size=UDim2.new(1,-8,0,40),BackgroundColor=Color3.fromRGB(43,49,70),Text=t,TextColor3=Color3.new(1,1,1),Font=Enum.Font.GothamMedium,TextSize=14},content)
 create('UICorner',{CornerRadius=UDim.new(0,8)},b)
 b.MouseButton1Click:Connect(fn)
 return b
end
local function humanoid()
 local ch=player.Character
 return ch and ch:FindFirstChildOfClass('Humanoid')
end
local selected=nil
local speed=16
local flight=false
local flightConnection=nil
local invisible=false
local originals={}
local function setInvisible(on)
 invisible=on
 local ch=player.Character
 if not ch then return end
 for _,part in ipairs(ch:GetDescendants()) do
  if part:IsA('BasePart') then
   if on then originals[part]=part.LocalTransparencyModifier;part.LocalTransparencyModifier=1
   else part.LocalTransparencyModifier=originals[part] or 0 end
  end
 end
end
local function stopFlight()
 flight=false
 if flightConnection then flightConnection:Disconnect();flightConnection=nil end
 local ch=player.Character
 local root=ch and ch:FindFirstChild('HumanoidRootPart')
 if root then
  local lv=root:FindFirstChild('NovaFlightVelocity');if lv then lv:Destroy() end
  local att=root:FindFirstChild('NovaFlightAttachment');if att then att:Destroy() end
 end
 local hum=humanoid();if hum then hum.PlatformStand=false end
end
local function startFlight()
 stopFlight()
 local ch=player.Character
 local root=ch and ch:FindFirstChild('HumanoidRootPart')
 local hum=humanoid()
 if not root or not hum then return end
 flight=true
 local att=create('Attachment',{Name='NovaFlightAttachment'},root)
 local lv=create('LinearVelocity',{Name='NovaFlightVelocity',Attachment0=att,MaxForce=100000,VectorVelocity=Vector3.zero,RelativeTo=Enum.ActuatorRelativeTo.World},root)
 hum.PlatformStand=true
 flightConnection=RunService.RenderStepped:Connect(function()
  if not root.Parent then stopFlight();return end
  local camera=workspace.CurrentCamera
  local dir=hum.MoveDirection
  local up=(UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0)-(UIS:IsKeyDown(Enum.KeyCode.LeftControl) and 1 or 0)
  lv.VectorVelocity=(dir+Vector3.new(0,up,0))*55
  if camera and dir.Magnitude>0 then root.CFrame=CFrame.lookAt(root.Position,root.Position+Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z)) end
 end)
end
local tabs={}
local function showHome()
 clear();label('لوحة تحكم محلية. ميزات الخادم تحتاج صلاحيات مالك التجربة.')
 button('السرعة: '..speed,function() speed=speed==16 and 32 or speed==32 and 50 or 16;local h=humanoid();if h then h.WalkSpeed=speed end;showHome() end)
 button('الطيران: '..(flight and 'ON' or 'OFF'),function() if flight then stopFlight() else startFlight() end;showHome() end)
 button('القفز العالي',function() local h=humanoid();if h then h.UseJumpPower=true;h.JumpPower=90 end end)
 button('إعادة الحركة الافتراضية',function()stopFlight();speed=16;local h=humanoid();if h then h.WalkSpeed=16;h.JumpPower=50 end;showHome() end)
end
local function showPlayers()
 clear();label('اختر لاعبًا للمشاهدة أو الانتقال إليه محليًا.')
 local search=create('TextBox',{Size=UDim2.new(1,-8,0,39),PlaceholderText='بحث عن اسم اللاعب...',Text='',ClearTextOnFocus=false,BackgroundColor=Color3.fromRGB(43,49,70),TextColor3=Color3.new(1,1,1),PlaceholderColor3=Color3.fromRGB(160,170,190),Font=Enum.Font.Gotham,TextSize=14},content)
 create('UICorner',{CornerRadius=UDim.new(0,8)},search)
 local results=create('Frame',{Size=UDim2.new(1,-8,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1},content)
 create('UIListLayout',{Padding=UDim.new(0,5)},results)
 local function render()
  for _,c in ipairs(results:GetChildren()) do if c:IsA('TextButton') then c:Destroy() end end
  for _,p in ipairs(Players:GetPlayers()) do
   if p~=player and (search.Text=='' or string.find(string.lower(p.Name..' '..p.DisplayName),string.lower(search.Text),1,true)) then
    local b=create('TextButton',{Size=UDim2.new(1,0,0,34),Text=p.DisplayName..'  (@'..p.Name..')',BackgroundColor=Color3.fromRGB(40,46,65),TextColor3=Color3.new(1,1,1),Font=Enum.Font.Gotham,TextSize=13},results)
    b.MouseButton1Click:Connect(function()selected=p;showPlayers() end)
   end
  end
 end
 search:GetPropertyChangedSignal('Text'):Connect(render);render()
 label('المحدد: '..(selected and selected.Name or 'لا أحد'))
 button('مشاهدة اللاعب المحدد',function()
  local h=selected and selected.Character and selected.Character:FindFirstChildOfClass('Humanoid')
  if h then workspace.CurrentCamera.CameraSubject=h end
 end)
 button('إيقاف المشاهدة',function()local h=humanoid();if h then workspace.CurrentCamera.CameraSubject=h end end)
 button('انتقال محلي للاعب المحدد',function()
  local target=selected and selected.Character and selected.Character:FindFirstChild('HumanoidRootPart')
  local mine=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
  if target and mine then mine.CFrame=target.CFrame*CFrame.new(3,0,0) end
 end)
 label('المحادثة الصوتية تتحكم فيها إعدادات Roblox ونظام المسافة في التجربة.')
end

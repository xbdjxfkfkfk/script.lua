-- Notification Helper to display errors visually on screen if any happen
local function notify(msg)
    pcall(function()
        local sg = LP:FindFirstChild("PlayerGui")
        if not sg then return end
        local f = Instance.new("Frame")
        f.Size = UDim2.new(0, 300, 0, 50)
        f.Position = UDim2.new(0.5, -150, 0, 50)
        f.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
        f.Parent = sg
        Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
        local t = Instance.new("TextLabel")
        t.Size = UDim2.new(1, 0, 1, 0)
        t.BackgroundTransparency = 1
        t.TextColor3 = Color3.fromRGB(0, 255, 128)
        t.TextFont = Enum.Font.GothamBold
        t.TextSize = 12
        t.Text = msg
        t.Parent = f
        task.delay(4, function() f:Destroy() end)
    end)
end


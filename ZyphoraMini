        TextXAlignment = Enum.TextXAlignment.Left
    }, b)
    
    inst("TextLabel", {
        Size = UDim2.new(1, -20, 0, 18),
        Position = UDim2.fromOffset(10, 26),
        BackgroundTransparency = 1,
        Text = desc or "",
        TextColor3 = C.muted,

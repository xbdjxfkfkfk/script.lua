end)

-- Optional trusted v12 server support. UI is fully created even if the remote is absent.
task.spawn(function()
    local remote=ReplicatedStorage:FindFirstChild("NOVA12_Request")
    if not remote then
        message("القائمة جاهزة | وضع محلي: ماب بدون سيرفر NOVA",true)
        return
    end
    if not remote:IsA("RemoteFunction") then
        message("خطأ: NOVA12_Request ليس RemoteFunction",false)
        return
    end
    serverRemote=remote
    local notify=ReplicatedStorage:FindFirstChild("NOVA12_Notify")
    if notify and notify:IsA("RemoteEvent") then
        notify.OnClientEvent:Connect(function(event,val)
            if event=="flygrant" and val==true and not flight then toggleFlight() end
            if event=="invisibility" and val==false then selfHidden=false;clearLocalCopy() end
        end)
    end
    serverCall("status",nil,function(result)
        isAdmin=result.ok==true and result.admin==true
        message(isAdmin and "قائمة NOVA جاهزة | صلاحية الأدمن متصلة بسيرفر مابك"
            or "قائمة NOVA جاهزة | لا توجد صلاحية أدمن في هذا السيرفر",isAdmin)
    end)
end)


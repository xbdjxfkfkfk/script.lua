-- Invisible System (Full Map)
local function updateInvisible()
    local char = LP.Character
    if not char then return end
    
    if S.Invisible then
        -- Hide all parts
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.LocalTransparencyModifier = 1
                v.CastShadow = false
            end
            if v:IsA("Decal") or v:IsA("Texture") then
                v.LocalTransparencyModifier = 1
            end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
                v.Enabled = false
            end
            if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
                v.Enabled = false
            end
        end
        
        -- Hide name tag
        local head = char:FindFirstChild("Head")
        if head then
            local nameTag = head:FindFirstChild("Nametag")
            if nameTag then nameTag.Enabled = false end
        end
    else
        -- Show all parts
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.LocalTransparencyModifier = 0
                v.CastShadow = true
            end
            if v:IsA("Decal") or v:IsA("Texture") then
                v.LocalTransparencyModifier = 0
            end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
                v.Enabled = true
            end
            if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
                v.Enabled = true
            end
        end
    end
end

-- Speed System
local function updateSpeed()
    local char = LP.Character
    local h = char and char:FindFirstChildOfClass("Humanoid")
    if not h then return end
    
    if S.Speed then
        h.WalkSpeed = S.WalkSpeed
    else
        h.WalkSpeed = 16
    end
end

-- Fly System
local flyVel = nil

local function updateFly()
    local char = LP.Character
    local r = char and char:FindFirstChild("HumanoidRootPart")
    if not r then return end
    
    if S.Fly and not flyVel then
        flyVel = Instance.new("LinearVelocity")
        flyVel.MaxForce = math.huge
        flyVel.VectorVelocity = Vector3.zero
        flyVel.Parent = r
    elseif not S.Fly and flyVel then
        flyVel:Destroy()
        flyVel = nil
    end
    
    if S.Fly and flyVel then
        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.E) or UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.Q) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
        
        flyVel.VectorVelocity = dir * S.FlySpeed
    end
end

-- Main Loop
conn(RunService.Heartbeat, function()
    if not alive then return end
    updateInvisible()
    updateSpeed()
    updateFly()
end)


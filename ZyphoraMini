    }, f)
    
    inst("TextLabel", {
        Size = UDim2.new(1, -60, 0, 20),
        Position = UDim2.fromOffset(10, 28),
        BackgroundTransparency = 1,
        Text = desc or "",
        Font = Enum.Font.Gotham,

local function cleanup()
    if not live then return end
    live=false;S.fly=false;S.invisible=false
    stopFly();applyInvisible();clearPlayerVisuals()
    local hum=LP.Character and LP.Character:FindFirstChildOfClass('Humanoid')
    if hum and savedHumanoidSpeed then hum.WalkSpeed=savedHumanoidSpeed end
    if S.spectate and hum and Workspace.CurrentCamera then Workspace.CurrentCamera.CameraSubject=hum end
    for _,connection in ipairs(connections) do connection:Disconnect() end
    gui:Destroy()
    if _G.__ProfessionalLocalV5Cleanup==cleanup then _G.__ProfessionalLocalV5Cleanup=nil end
end
_G.__ProfessionalLocalV5Cleanup=cleanup

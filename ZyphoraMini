local function updateMarkers()
 local me=root(); if not me then return end
 local seen={}
 for _,e in ipairs(animals) do if e.m.Parent and e.p.Parent and animal(e.m) and living(e.m) and matches(e) then
  local d=(e.p.Position-me.Position).Magnitude
  if d<=state.range then
   marker(e); local o=markers[e.m]; local r,c=rarity(e.m); local weight=stat(e.m,{'Weight','weight','Mass','الوزن'}); local size=stat(e.m,{'Size','size','Scale','الحجم'});
   o.top.Text=r; o.top.TextColor3=c; o.gui.Adornee=e.p
   o.bottom.Text=(weight~=nil and compact(weight)..' كجم  •  ' or '')..(size~=nil and compact(size)..' م  •  ' or '')..string.format('%.0f',d)..' وحدة'
   o.gui.MaxDistance=state.range; seen[e.m]=true
  end
 end end
 for m,o in pairs(markers) do if not seen[m] then o.gui:Destroy(); markers[m]=nil end end
end

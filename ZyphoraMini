local function waitForDiscord()
    createGuardPanel("Discord مطلوب", "✕ Discord غير مفتوح أو غير متصل\nالسكربت لا يعمل إلا بعد الدخول إلى الخادم.", "فتح رابط Discord")

    while true do
        if discordIsAlive() then
            destroyGuard()
            return true
        end

        task.wait(2)
    end
end

local passed = waitForDiscord()
if not passed then
    warn("Discord guard failed")
    return
end


-- Add trusted administrators' numeric UserIds here for group-owned experiences.
local ADMIN_IDS = {
    -- [123456789] = true,
}
local function isAdmin(player)
    if RunService:IsStudio() then return true end -- Testing only; never on published servers.
    if ADMIN_IDS[player.UserId] then return true end
    return game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId
end
local hidden = {}
local frozen = {}
local lastCall = {}

local function setHidden(player, enable)
    local character = player.Character
    if not character then return false, "الشخصية غير موجودة" end
    if not enable then
        local state = hidden[player]
        if state and state.character == character then
            for instance, value in pairs(state.props) do
                if instance and instance.Parent then
                    if instance:IsA("BasePart") or instance:IsA("Decal") or instance:IsA("Texture") then
                        instance.Transparency = value
                    else
                        instance.Enabled = value
                    end
                end
            end
        end
        hidden[player] = nil
        notify:FireClient(player, "invisibility", false)
        return true, "رجعت مرئيًا للجميع"
    end
    if hidden[player] and hidden[player].character == character then
        return true, "الاختفاء شغال"
    end
    local state = {character = character, props = {}}
    for _, item in ipairs(character:GetDescendants()) do
        if item:IsA("BasePart") or item:IsA("Decal") or item:IsA("Texture") then
            state.props[item] = item.Transparency
            item.Transparency = 1
        elseif item:IsA("ParticleEmitter") or item:IsA("Trail") or item:IsA("Beam")
            or item:IsA("BillboardGui") or item:IsA("Highlight") or item:IsA("PointLight")
            or item:IsA("SpotLight") or item:IsA("SurfaceLight") then
            state.props[item] = item.Enabled
            item.Enabled = false
        end
    end
    hidden[player] = state
    notify:FireClient(player, "invisibility", true)
    return true, "مختفٍ عن اللاعبين (قد تكشفك أنظمة مخصصة بالماب)"
end

local function setFrozen(target, enable)
    local character = target.Character
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then return false, "شخصية اللاعب غير جاهزة" end
    if enable then
        if frozen[target] and frozen[target].character == character then return true, "مجمد مسبقًا" end
        frozen[target] = {character = character, root = root, hum = hum,
            anchored = root.Anchored, speed = hum.WalkSpeed,
            jumpPower = hum.JumpPower, jumpHeight = hum.JumpHeight, autoRotate = hum.AutoRotate}
        root.Anchored = true
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.JumpHeight = 0
        hum.AutoRotate = false
        return true, "تم تجميد " .. target.Name
    end
    local state = frozen[target]
    if state and state.character == character and state.root.Parent and state.hum.Parent then
        state.root.Anchored = state.anchored
        state.hum.WalkSpeed = state.speed
        state.hum.JumpPower = state.jumpPower
        state.hum.JumpHeight = state.jumpHeight
        state.hum.AutoRotate = state.autoRotate
    end
    frozen[target] = nil
    return true, "تم فك التجميد"
end

local function getRoot(plr)
    local char = plr.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (char and root and hum and hum.Health > 0) then return nil end
    return char, root, hum
end

local function resolveTarget(userId)
    if type(userId) ~= "number" then return nil end
    if userId ~= math.floor(userId) then return nil end
    return Players:GetPlayerByUserId(userId)
end

remote.OnServerInvoke = function(player, action, data)
    if type(action) ~= "string" or #action > 35 then return {ok=false, msg="أمر غير صالح"} end
    if action == "status" then return {ok=true, admin=isAdmin(player), msg=isAdmin(player) and "الأدمن مفعل" or "لا توجد صلاحية إدارة"} end
    if not isAdmin(player) then return {ok=false, msg="هذه الأوامر تتطلب صلاحية سيرفر"} end
    local now = os.clock()
    if lastCall[player] and now - lastCall[player] < 0.13 then return {ok=false, msg="خفف سرعة الضغط"} end
    lastCall[player] = now

    if action == "hide" then
        local ok, msg = setHidden(player, data == true)
        return {ok=ok, msg=msg, value=data == true}
    elseif action == "tools" then
        local names = {}
        for _, tool in ipairs(catalog:GetChildren()) do
            if tool:IsA("Tool") then table.insert(names, tool.Name) end
        end
        table.sort(names)
        return {ok=true, items=names, msg="أدوات الماب المصرح بها"}
    elseif action == "tool" then
        if type(data) ~= "string" or #data > 90 then return {ok=false, msg="اسم غير صالح"} end
        local found = catalog:FindFirstChild(data)
        local backpack = player:FindFirstChildOfClass("Backpack")
        if not found or not found:IsA("Tool") or not backpack then return {ok=false, msg="الأداة غير متاحة"} end
        local tool = found:Clone()
        tool.Parent = backpack
        return {ok=true, msg="تمت إضافة " .. found.Name .. " للحقيبة"}
    elseif action == "speed" then
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        local number = tonumber(data)
        if not hum or not number or number < 8 or number > 100 then return {ok=false, msg="اختر سرعة بين 8 و100"} end
        hum.WalkSpeed = number
        return {ok=true, msg="السرعة: " .. number}
    elseif action == "jump" then
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        local number = tonumber(data)
        if not hum or not number or number < 20 or number > 150 then return {ok=false, msg="اختر قفزًا بين 20 و150"} end
        hum.UseJumpPower = true
        hum.JumpPower = number
        return {ok=true, msg="القفز: " .. number}
    end

    local target = resolveTarget(data)
    if not target then return {ok=false, msg="حدد لاعبًا موجودًا أولًا"} end
    if action == "teleport" then
        local myChar, _, myHum = getRoot(player)
        local _, targetRoot = getRoot(target)
        if not (myChar and targetRoot) then return {ok=false, msg="أحد اللاعبين لم يجهز بعد"} end
        myHum.Sit = false
        myChar:PivotTo(targetRoot.CFrame * CFrame.new(0, 2, 4))
        return {ok=true, msg="انتقلت إلى " .. target.DisplayName}
    elseif action == "bring" then
        local _, ownRoot = getRoot(player)
        local targetChar, _, targetHum = getRoot(target)
        if not (ownRoot and targetChar) then return {ok=false, msg="أحد اللاعبين لم يجهز بعد"} end
        targetHum.Sit = false
        targetChar:PivotTo(ownRoot.CFrame * CFrame.new(3, 1, -3))
        return {ok=true, msg="تم سحب " .. target.DisplayName .. " قربك"}
    elseif action == "freeze" or action == "unfreeze" then
        local ok, msg = setFrozen(target, action == "freeze")
        return {ok=ok, msg=msg}
    elseif action == "givefly" then
        notify:FireClient(target, "flygrant", true)
        return {ok=true, msg="تم إرسال صلاحية الطيران للاعب"}
    end
    return {ok=false, msg="الأمر غير معروف"}
end

local function onPlayer(player)
    player.CharacterAdded:Connect(function()
        hidden[player] = nil
        frozen[player] = nil
        notify:FireClient(player, "invisibility", false)
    end)
end
Players.PlayerAdded:Connect(onPlayer)

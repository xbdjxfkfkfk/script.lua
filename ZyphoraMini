local lightingKeys = {"Brightness", "Ambient", "OutdoorAmbient", "GlobalShadows", "ExposureCompensation", "FogEnd", "FogStart"}
local function captureLighting()
    if visualBackup then return end
    visualBackup = {fields = {}, atmospheres = {}}
    for _, key in ipairs(lightingKeys) do visualBackup.fields[key] = Lighting[key] end
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") then
            visualBackup.atmospheres[v] = {Density = v.Density, Haze = v.Haze, Glare = v.Glare}
        end
    end
end
local function updateLighting()
    if not (fogOff or fullbright) then
        if visualBackup then
            for k, v in pairs(visualBackup.fields) do pcall(function() Lighting[k] = v end) end
            for a, props in pairs(visualBackup.atmospheres) do
                if a.Parent then for k, v in pairs(props) do pcall(function() a[k] = v end) end end
            end
        end
        visualBackup = nil
        return
    end
    captureLighting()
    if fogOff then
        Lighting.FogEnd = 100000
        for _, a in ipairs(Lighting:GetChildren()) do
            if a:IsA("Atmosphere") then
                if not visualBackup.atmospheres[a] then
                    visualBackup.atmospheres[a] = {Density = a.Density, Haze = a.Haze, Glare = a.Glare}
                end
                a.Density = 0
                a.Haze = 0
                a.Glare = 0
            end
        end
    else
        Lighting.FogEnd = visualBackup.fields.FogEnd
        for a, vals in pairs(visualBackup.atmospheres) do
            if a.Parent then a.Density = vals.Density a.Haze = vals.Haze a.Glare = vals.Glare end
        end
    end
    if fullbright then
        Lighting.Brightness = 2.5
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(185, 185, 185)
        Lighting.OutdoorAmbient = Color3.fromRGB(185, 185, 185)
    else
        for _, k in ipairs({"Brightness", "GlobalShadows", "Ambient", "OutdoorAmbient"}) do
            Lighting[k] = visualBackup.fields[k]
        end
    end
end

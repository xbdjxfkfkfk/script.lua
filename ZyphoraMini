 local function rebuildAnimalList()
  for _,x in ipairs(animalList:GetChildren()) do if x:IsA('Frame') then x:Destroy() end end
  if not S.Radar then
   label(animalList,'الرادار متوقف','فعّل كشف الضبان لعرض الأحجام والمسافات')
   return
  end
  local r=root()
  if not r then label(animalList,'الشخصية غير جاهزة');return end
  local entries={}
  for _,e in ipairs(cache) do
   if e.model.Parent and e.part.Parent and living(e.model) and lizard(e.model) then
    local d=(e.part.Position-r.Position).Magnitude
    if d<=S.RadarRange and (S.Filter=='الكل' or rarity(e.model)==S.Filter) then
     entries[#entries+1]={model=e.model,distance=d}
    end
   end
  end
  table.sort(entries,function(a,b)return a.distance<b.distance end)
  if #entries==0 then label(animalList,'لا توجد ضبان مطابقة','قد تكون خارج المدى أو لم تُحمّلها اللعبة');return end
  for i=1,math.min(#entries,25) do
   local e=entries[i]
   local rarityName=rarity(e.model)
   local card=inst('Frame',{Size=UDim2.new(1,-2,0,69),BackgroundColor3=C.card,BorderSizePixel=0,LayoutOrder=i},animalList)
   round(card,10)
   inst('UIStroke',{Color=rarityColors[rarityName] or C.purple,Thickness=1,Transparency=.25},card)
   inst('TextLabel',{Size=UDim2.new(1,-16,0,23),Position=UDim2.fromOffset(8,4),BackgroundTransparency=1,Text=speciesName(e.model)..' | '..rarityName,TextColor3=rarityColors[rarityName] or C.white,TextSize=12,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},card)
   inst('TextLabel',{Size=UDim2.new(1,-16,0,33),Position=UDim2.fromOffset(8,28),BackgroundTransparency=1,Text='الحجم: '..animalSize(e.model)..'  |  الوزن: '..animalWeight(e.model)..'  |  المسافة: '..math.floor(e.distance+.5)..' وحدة',TextColor3=C.white,TextSize=11,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true},card)
  end
 end


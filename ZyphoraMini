local nIdx = 0
local function notify(msg, kind)
    nIdx += 1
    local c = (kind == "on" and C.on) or C.accent
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 240, 0, 34)
    f.BackgroundColor3 = C.panel
    f.BorderSizePixel = 0
    f.LayoutOrder = nIdx
    f.Parent = NotiHolder
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)

    local s = Instance.new("UIStroke", f)
    s.Color = c; s.Thickness = 1.2; s.Transparency = 0.2

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, -10)
    bar.Position = UDim2.new(0, 4, 0, 5)
    bar.BackgroundColor3 = c
    bar.BorderSizePixel = 0
    bar.Parent = f
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 2)

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -20, 1, 0)
    l.Position = UDim2.new(0, 12, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = msg
    l.TextColor3 = C.text
    l.Font = Enum.Font.GothamMedium
    l.TextSize = 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = f

    f.Position = UDim2.new(0, 260, 0, 0)
    TweenService:Create(f, TweenInfo.new(0.22, Enum.EasingStyle.Quart),
        { Position = UDim2.new(0, 0, 0, 0) }):Play()
    task.delay(2.4, function()
        TweenService:Create(f, TweenInfo.new(0.28, Enum.EasingStyle.Quart),
            { Position = UDim2.new(0, 260, 0, 0) }):Play()
        task.delay(0.3, function() f:Destroy() end)
    end)
end

local function toggle(btn, bar, label, key, onFn, offFn)
    S[key] = not S[key]
    local on = S[key]
    btn.Text = "   " .. label .. ": " .. (on and "ON" or "OFF")
    bar.BackgroundColor3 = on and C.on or C.accent
    btn.TextColor3 = on and C.on or C.text
    if on and onFn then onFn() end
    if not on and offFn then offFn() end
    notify(label .. (on and " ON" or " OFF"), on and "on" or "off")
end


local function refreshCache()
 -- Reconsider a bounded number of previously loaded models. Some maps set
 -- their species/name attributes after the instance first appears.
 -- Compact removed models periodically; otherwise the queue grows forever.
 if #scanQueue>1500 and os.clock()-lastQueueCompact>15 then
  lastQueueCompact=os.clock()
  local fresh={}
  for _,model in ipairs(scanQueue) do
   if model and model:IsDescendantOf(WS) then fresh[#fresh+1]=model
   else queued[model]=nil end
  end
  scanQueue=fresh
  scanCursor=math.min(scanCursor,#scanQueue+1)
 end
 for _=1,math.min(24,#scanQueue) do
  if scanCursor>#scanQueue then scanCursor=1 end
  local m=scanQueue[scanCursor]
  scanCursor+=1
  if m and m.Parent then trackAnimal(m) end
 end
 table.clear(cache)
 for m in pairs(indexed) do
  if m.Parent and living(m) and lizard(m) then
   local p=part(m)
   if p and p.Parent then cache[#cache+1]={model=m,part=p} end
  else indexed[m]=nil end
 end
end
local function nearest(filter)
 local r=root();if not r then return nil end
 local best,dist=nil,math.huge
 for _,e in ipairs(cache) do
  if e.model.Parent and e.part.Parent and living(e.model) and lizard(e.model) then
   local d=(e.part.Position-r.Position).Magnitude
   if d<dist and d<=S.RadarRange and (not filter or filter=='الكل' or rarity(e.model)==filter) then best=e;dist=d end
  end
 end
 return best,dist
end

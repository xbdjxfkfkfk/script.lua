-- دوال
local conns = {}
local function conn(s, f)
    local c = s:Connect(f)
    table.insert(conns, c)
    return c
end

local function btn(text, order, color, fn)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 38)
    b.BackgroundColor3 = color or Color3.fromRGB(30, 30, 40)
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.LayoutOrder = order
    b.Parent = content
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    conn(b.MouseButton1Click, fn)
    return b
end

local function toggle(text, key, order)
    local b = btn(text .. ": OFF", order, Color3.fromRGB(30, 30, 40), function()
        S[key] = not S[key]
        b.Text = text .. (S[key] and ": ON ✓" or ": OFF ✕")
        b.BackgroundColor3 = S[key] and Color3.fromRGB(80, 60, 20) or Color3.fromRGB(30, 30, 40)
    end)
    return b
end

-- ESP
local espObjs = {}
toggle("👁️ ESP", "ESP", 1)
conn(RunService.Heartbeat, function()
    if S.ESP then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and not espObjs[p] then
                local h = Instance.new("Highlight")
                h.FillColor = Color3.new(1, 0, 0)
                h.Adornee = p.Character
                h.Parent = gui
                espObjs[p] = h
            end
        end
    else
        for p, h in pairs(espObjs) do
            if h then h:Destroy() end
            espObjs[p] = nil
        end
    end
end)

-- Aimbot
local aimConn = nil
toggle("🎯 Aimbot", "Aim", 2)
conn(RunService.Heartbeat, function()
    if S.Aim and not aimConn then
        aimConn = RunService.RenderStepped:Connect(function(dt)
            local cam = workspace.CurrentCamera
            local closest, dist = nil, S.AimRange
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LP and p.Character then
                    local head = p.Character:FindFirstChild("Head")
                    if head then
                        local d = (head.Position - cam.CFrame.Position).Magnitude
                        if d < dist then
                            local pos, onScreen = cam:WorldToViewportPoint(head.Position)
                            if onScreen then
                                local pd = (Vector2.new(pos.X, pos.Y) - Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)).Magnitude
                                if pd < 100 then
                                    closest = head
                                    dist = d
                                end
                            end
                        end
                    end
                end
            end
            if closest then
                local alpha = 1 - math.exp(-S.AimSmooth * 30 * dt)
                cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, closest.Position), alpha)
            end
        end)
    elseif not S.Aim and aimConn then
        aimConn:Disconnect()
        aimConn = nil
    end
end)

-- Car Speed
toggle("🚗 Car Speed", "CarSpeed", 3)
conn(RunService.Heartbeat, function()
    if S.CarSpeed then
        local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if h and h.SeatPart and h.SeatPart:IsA("VehicleSeat") then
            h.SeatPart.MaxSpeed = S.CarTarget
        end
    end
end)

-- Walk Speed
toggle("🏃 Speed", "Walk", 4)
conn(RunService.Heartbeat, function()
    if S.Walk then
        local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = S.WalkSpeed end
    end
end)

-- Fly
local flyObj = nil
toggle("✈️ Fly", "Fly", 5)
conn(RunService.Heartbeat, function()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if S.Fly and root and not flyObj then
        flyObj = Instance.new("BodyVelocity")
        flyObj.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        flyObj.Parent = root
    elseif not S.Fly and flyObj then
        flyObj:Destroy()
        flyObj = nil
    end
    if S.Fly and flyObj then
        local cam = workspace.CurrentCamera
        local dir = Vector3.new()
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
        flyObj.Velocity = dir * S.FlySpeed
    end
end)

-- Noclip
toggle("👻 Noclip", "Noclip", 6)
conn(RunService.Stepped, function()
    if S.Noclip then
        local char = LP.Character
        if char then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end
end)


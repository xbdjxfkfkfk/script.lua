-- Slider
local function slider(title, key, min, max, default, color)
    local f = inst("Frame", {Size = UDim2.new(1, 0, 0, 80), BackgroundColor3 = Color3.fromRGB(35, 28, 52), BorderSizePixel = 0}, content)
    round(f, 16)
    
    inst("TextLabel", {Size = UDim2.new(0.6, 0, 0, 30), Position = UDim2.fromOffset(20, 10), BackgroundTransparency = 1, Text = title, TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left}, f)
    
    local val = inst("TextLabel", {Size = UDim2.new(0.3, 0, 0, 30), Position = UDim2.new(0.7, -16, 0, 10), BackgroundTransparency = 1, Text = tostring(default), TextColor3 = color or Color3.fromRGB(255, 190, 255), Font = Enum.Font.GothamBold, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Right}, f)
    
    local bg = inst("Frame", {Size = UDim2.new(1, -40, 0, 14), Position = UDim2.fromOffset(20, 56), BackgroundColor3 = Color3.fromRGB(58, 50, 85), BorderSizePixel = 0}, f)
    round(bg, 7)
    
    local fill = inst("Frame", {Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BackgroundColor3 = color or Color3.fromRGB(255, 190, 255), BorderSizePixel = 0}, bg)
    round(fill, 7)
    
    local handle = inst("Frame", {Size = UDim2.fromOffset(28, 28), Position = UDim2.new((default - min) / (max - min), -14, 0.5, -14), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0}, bg)
    round(handle, 14)
    
    S[key] = default
    local dragging = false
    
    local function update(input)
        local rel = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * rel)
        S[key] = v
        val.Text = tostring(v)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        handle.Position = UDim2.new(rel, -14, 0.5, -14)
    end
    
    conn(handle.InputBegan, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end end)
    conn(bg.InputBegan, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true update(input) end end)
    conn(UIS.InputEnded, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
    conn(UIS.InputChanged, function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end end)
    
    return f
end

